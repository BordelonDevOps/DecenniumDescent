{
  "name": "decennium-descent-companion",
  "version": "0.3.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 8500 --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "format": "biome format --write .",
    "ingest:canon": "python tools/ingest_canon_data.py",
    "ingest:spells:diff": "python tools/spell_school_diff.py",
    "ingest:spells": "python tools/spell_school_diff.py --apply",
    "ingest:bestiary": "python scripts/build_known_descent_bestiary.py",
    "validate:magic": "python tools/validate_magic_system.py",
    "validate:abilities": "node --no-warnings tools/validate_class_abilities.mjs",
    "validate:rules": "npm run lint && npm run validate:magic && npm run validate:abilities && npm run validate:public-canon && npm run validate:gameplay && npm run validate:prestige && npm run validate:state",
    "validate:public-canon": "python tools/validate_public_canon.py",
    "build:bestiary": "python scripts/build_known_descent_bestiary.py",
    "validate:gameplay": "python tools/validate_gameplay_loop.py",
    "build:gameplay": "python scripts/build_gameplay_loop_bible.py && python scripts/build_quickstart_reference.py",
    "validate:prestige": "python tools/validate_prestige_snapshot.py",
    "validate:state": "python tools/validate_gameplay_state.py",
    "test:ai:prepare": "python playtests/ai-calibration-suite/tools/run_all_math.py",
    "test:ai:preflight": "python playtests/ai-calibration-suite/tools/preflight.py"
  },
  "dependencies": {
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.12",
    "@types/three": "^0.185.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.475.0",
    "next": "^15.3.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "same-runtime": "^0.0.1",
    "tailwind-merge": "^3.3.0",
    "tailwindcss-animate": "^1.0.7",
    "three": "^0.185.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@eslint/eslintrc": "^3.3.1",
    "@types/node": "^20.17.50",
    "@types/react": "^18.3.22",
    "@types/react-dom": "^18.3.7",
    "eslint": "^9.27.0",
    "eslint-config-next": "15.1.7",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3"
  }
}
