{
  "meta": {
    "title": "Decennium Descent Gameplay Loop",
    "version": "1.0",
    "status": "canonical",
    "effective": "2026-08-05",
    "designRule": "Decennium Descent should have 5e's readability and speed, Pathfinder 2e's tactical clarity and balance discipline, and its own expedition, extraction, Haven, and seasonal systems.",
    "publicDepthBoundary": "The most famous recognized expedition failed at the Sixth Gate; deeper truth remains Director-only."
  },
  "modes": {
    "encounter": {
      "roundSeconds": 6,
      "turn": [
        "movement",
        "action",
        "bonusActionWhenGranted",
        "objectInteraction",
        "reactionBeforeNextTurn"
      ]
    },
    "expedition": {
      "watchHours": 8,
      "watchesPerDay": 3,
      "names": [
        "Morning",
        "Afternoon",
        "Evening"
      ]
    },
    "haven": {
      "defaultTurn": "1 day"
    }
  },
  "resolution": {
    "formula": "d20 + ability modifier + proficiency when trained + circumstance modifiers",
    "tierDcs": {
      "routine": 10,
      "tier1": 12,
      "tier2": 13,
      "tier3": 15,
      "tier4": 16,
      "tier5": 18,
      "tier6": 19
    },
    "difficultyAdjustments": {
      "hard": 3,
      "severe": 6,
      "favorable": -3
    },
    "degrees": {
      "criticalSuccess": "total >= DC + 10",
      "success": "total >= DC",
      "failure": "total < DC",
      "criticalFailure": "total <= DC - 10"
    },
    "naturalRoll": {
      "20": "improve one degree",
      "1": "worsen one degree"
    },
    "assistance": {
      "bonusPerTrainedAssistant": 1,
      "maximumAssistants": 3
    }
  },
  "opening": {
