{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Frozen Character Fixture",
  "type": "object",
  "required": [
    "id",
    "name",
    "level",
    "race",
    "class",
    "persona",
    "sourceHash",
    "maxHp",
    "armorClass",
    "speed",
    "abilities",
    "resources",
    "actions"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "level": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20
    },
    "race": {
      "type": "string"
    },
    "class": {
      "type": "string"
    },
    "path": {
      "type": [
        "string",
        "null"
      ]
    },
    "persona": {
      "type": "string"
    },
    "sourceHash": {
      "type": "string"
    },
    "maxHp": {
      "type": "integer",
      "minimum": 1
    },
    "armorClass": {
      "type": "integer",
      "minimum": 1
    },
    "speed": {
      "type": "integer",
      "minimum": 0
    },
    "abilities": {
      "type": "object"
    },
    "resources": {
      "type": "object"
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "bonusActions": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "reactions": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "passives": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "equipment": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}