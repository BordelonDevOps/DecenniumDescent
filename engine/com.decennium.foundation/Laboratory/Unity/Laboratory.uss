.lab-panel {
    position: absolute;
    left: 12px;
    top: 12px;
    width: 340px;
    padding: 12px;
    background-color: rgb(22, 27, 34);
    color: rgb(240, 244, 248);
    font-size: 15px;
}
.lab-panel Label { white-space: normal; margin-bottom: 8px; }
#labHeading { -unity-font-style: bold; font-size: 18px; }
.lab-panel Button {
    background-color: rgb(48, 61, 78);
    color: rgb(255, 255, 255);
    padding: 7px;
    margin-bottom: 5px;
    -unity-text-align: middle-center;
    white-space: normal;
}
.lab-panel Button:hover { background-color: rgb(67, 85, 108); }
.lab-panel Button:disabled { color: rgb(160, 168, 178); }
.lab-panel Button:focus { border-width: 2px; border-color: rgb(100, 185, 255); }
.lab-row { flex-direction: row; }
.lab-row Button { flex-grow: 1; margin-right: 4px; }
.lab-result { color: rgb(255, 213, 128); }
