ll\": null,\n                  \"refrain\": 0,\n                  \"preparedFamiliesUsed\": [],\n                  \"position\": [\n                    150,\n                    0,\n                    0\n                  ],\n                  \"alive\": true,\n                  \"conscious\": true,\n                  \"conditions\": [],\n                  \"concentration\": null,\n                  \"reaction\": true,\n                  \"action\": true,\n                  \"bonusAction\": true,\n                  \"movementSpent\": 0,\n                  \"regularStart\": 0,\n                  \"nextRegularStart\": 6,\n                  \"counterRecharge\": 0,\n                  \"wounds\": 0,\n                  \"critical\": false,\n                  \"companionCommandUsed\": false,\n                  \"companionOffenseUsed\": false\n                }\n              },\n              \"applications\": {},\n              \"objects\": {\n                \"wall\": {\n                  \"opaque\": true,\n                  \"planeX\": 15,\n                  \"blocksSubjectObserverLoE\": true\n                }\n              },\n              \"privateMemories\": {\n                \"observer\": {\n                  \"episodes\": [\n                    {\n                      \"id\": \"old\",\n                      \"time\": -100,\n                      \"identity\": \"subject\"\n                    },\n                    {\n                      \"id\": \"recent\",\n                      \"time\": -2,\n                      \"identity\": \"subject\"\n                    }\n                  ],\n                  \"mask\": []\n                },\n                \"outsider\": {\n                  \"episodes\": [\n                    {\n                      \"id\": \"outsideOld\",\n                      \"time\": -100,\n                      \"identity\": \"subject\"\n                    }\n                  ],\n                  \"mask\": []\n                }\n   