ition\": [\n                10,\n                0,\n                0\n              ],\n              \"size\": \"Medium\",\n              \"bodyMassLb\": 170,\n              \"hp\": 52,\n              \"maxHp\": 80,\n              \"AC\": 12,\n              \"rp\": 31,\n              \"maxRp\": 48,\n              \"dissonance\": 0,\n              \"lastSpell\": \"simulacrum\",\n              \"refrain\": 0,\n              \"preparedFamiliesUsed\": [\n                \"simulacrum\"\n              ],\n              \"concentration\": null,\n              \"ordinaryFocusReplica\": true,\n              \"replicaGearLb\": 10,\n              \"replicaGearLoad\": 1,\n              \"noBirthRoundVoluntaryAction\": true,\n              \"reaction\": false,\n              \"copyFunctionsExecutable\": false,\n              \"sourceOwnerLineageId\": \"derivative/creator/creator\"\n            }\n          },\n          \"privateMemories\": {},\n          \"sourceLedger\": {\n            \"derivativeAccount\": {\n              \"key\": [\n                \"creator\",\n                \"creator\"\n              ],\n              \"rp\": 31,\n              \"dissonance\": 0,\n              \"lastSpell\": \"simulacrum\",\n              \"refrain\": 0,\n              \"usedFamilies\": [\n                \"simulacrum\"\n              ],\n              \"liveBody\": \"SI-A\",\n              \"casterLineageId\": \"derivative/creator/creator\"\n            }\n          },\n          \"note\": \"Complete stated finite fixture state; unspecified optional reactions are declined. No actual encounter runtime is asserted.\"\n        },\n        \"after\": {\n          \"actors\": {\n            \"creator\": {\n              \"profile\": \"W13I\",\n              \"hp\": 52,\n              \"maxHp\": 80,\n              \"tempHp\": 0,\n              \"rp\": 31,\n              \"maxRp\": 48,\n              \"dissonance\": 0,\n              \"lastSpell\": \"simulacrum\",\n              \"refrai