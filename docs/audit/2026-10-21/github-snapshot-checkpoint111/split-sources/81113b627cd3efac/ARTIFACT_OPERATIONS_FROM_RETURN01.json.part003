dissonance\": 0,\n              \"lastSpell\": null,\n              \"refrain\": 0,\n              \"preparedFamiliesUsed\": [],\n              \"position\": [\n                10,\n                0,\n                0\n              ],\n              \"alive\": true,\n              \"conscious\": true,\n              \"conditions\": [],\n              \"concentration\": null,\n              \"reaction\": true,\n              \"action\": true,\n              \"bonusAction\": true,\n              \"movementSpent\": 0,\n              \"regularStart\": 0,\n              \"nextRegularStart\": 6,\n              \"counterRecharge\": 0,\n              \"wounds\": 0,\n              \"critical\": false,\n              \"companionCommandUsed\": false,\n              \"companionOffenseUsed\": false\n            },\n            \"carrier\": {\n              \"profile\": \"W13I\",\n              \"hp\": 80,\n              \"maxHp\": 80,\n              \"tempHp\": 0,\n              \"rp\": 48,\n              \"maxRp\": 48,\n              \"dissonance\": 0,\n              \"lastSpell\": null,\n              \"refrain\": 0,\n              \"preparedFamiliesUsed\": [],\n              \"position\": [\n                15,\n                0,\n                0\n              ],\n              \"alive\": true,\n              \"conscious\": true,\n              \"conditions\": [],\n              \"concentration\": null,\n              \"reaction\": true,\n              \"action\": false,\n              \"bonusAction\": true,\n              \"movementSpent\": 0,\n              \"regularStart\": 0,\n              \"nextRegularStart\": 6,\n              \"counterRecharge\": 0,\n              \"wounds\": 0,\n              \"critical\": false,\n              \"companionCommandUsed\": false,\n              \"companionOffenseUsed\": false,\n              \"strengthOverride\": 14,\n              \"gearInCustody\": []\n            }\n          },\n          \"applications\": {\n            \"SEQ\": {\n              \"deadline\": 20,\n              \"guardConsumed\": true,\n              \"state\": \"rescued\"\n            }\n          },\n          \"objects\": {\n            \"supportFloor\": {\n              \"continuous\": true\n            }\n          },\n          \"privateMemories\": {},\n          \"sourceLedger\": {\n            \"patientBiology\": {\n              \"breathRemaining\": 60,\n              \"metabolicRemaining\": 3600\n            }\n          },\n          \"note\": \"Complete stated finite fixture state; unspecified optional reactions are declined. No actual encounter runtime is asserted.\"\n        },\n        \"conclusions\": {\n          \"patientHP\": 50,\n          \"guardRemainsUsed\": true,\n          \"carrierAction\": false\n        },\n        \"qualifications\": [],\n        \"disposition\": \"COHERENT_AT_DISCLOSED_SOURCE_INPUTS\",\n        \"sourceQualification\": \"Complete class engines, legal selected/automatic cards, prepared/known fixture additions, physical bodies and budgets are attached. These are explicit source-built finite teaching actors, not a claim to an authenticated live campaign encounter or a creature CR.\",\n        \"budgetSemantics\": \"Action/BonusAction/Reaction booleans are remaining underlying ledgers, not action eligibility outside an actual source-qualified phase or while Incapacitated. Supplied regular-START refreshes are materialized before events; explicit relevant END/idle-D transitions remain in the trace. Other uninvoked actions are declined. Long uninterrupted work/rest branches explicitly use real elapsed noncombat work, not thousands of fabricated Actions.\",\n        \"sourceRefs\": [\n          {\n            \"archive\": \"inputs/DD_Rank7_Identity_Casting_5_Source_Conference_01.zip\",\n            \"member\": \"sources/DescentReviewChanges/ReviewBible/data/public/spell_playtests/catalog.json\",\n            \"bytes\": 4945319,\n            \"sha256\": \"f52cf6a4a4673897615a74c7c6