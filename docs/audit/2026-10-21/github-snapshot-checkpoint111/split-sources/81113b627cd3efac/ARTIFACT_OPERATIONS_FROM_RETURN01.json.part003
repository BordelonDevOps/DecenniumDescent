true,\n                  \"action\": true,\n                  \"bonusAction\": true,\n                  \"movementSpent\": 0,\n                  \"regularStart\": 0,\n                  \"nextRegularStart\": 6,\n                  \"counterRecharge\": 0,\n                  \"wounds\": 0,\n                  \"critical\": false,\n                  \"companionCommandUsed\": false,\n                  \"companionOffenseUsed\": false,\n                  \"deathSuccesses\": 1,\n                  \"deathFailures\": 1,\n                  \"stable\": false\n                }\n              },\n              \"applications\": {},\n              \"objects\": {\n                \"oldDuplicate\": {\n                  \"id\": \"prior-live\",\n                  \"hp\": 30,\n                  \"rp\": 5,\n                  \"state\": \"active\",\n                  \"position\": [\n                    10,\n                    0,\n                    0\n                  ]\n                }\n              },\n              \"privateMemories\": {},\n              \"sourceLedger\": {\n                \"oldCapOwner\": \"creator\"\n              },\n              \"note\": \"Complete stated finite fixture state; unspecified optional reactions are declined. No actual encounter runtime is asserted.\"\n            },\n            \"after\": {\n              \"actors\": {\n                \"creator\": {\n                  \"profile\": \"W13I\",\n                  \"hp\": 80,\n                  \"maxHp\": 80,\n                  \"tempHp\": 0,\n                  \"rp\": 31,\n                  \"maxRp\": 48,\n                  \"dissonance\": 0,\n                  \"lastSpell\": \"simulacrum\",\n                  \"refrain\": 0,\n                  \"preparedFamiliesUsed\": [\n                    \"simulacrum\"\n                  ],\n                  \"position\": [\n                    0,\n                    0,\n                    0\n                  ],\n                  \"alive\": true,\n                  \"conscious\": true,\n                  \"conditions\": [],\n                  \"concentration\": null,\n                  \"reaction\": true,\n                  \"action\": false,\n                  \"bonusAction\": true,\n                  \"movementSpent\": 0,\n                  \"regularStart\": 0,\n                  \"nextRegularStart\": 6,\n                  \"counterRecharge\": 0,\n                  \"wounds\": 0,\n                  \"critical\": false,\n                  \"companionCommandUsed\": false,\n                  \"companionOffenseUsed\": false\n                },\n                \"donor\": {\n                  \"profile\": \"W13I\",\n                  \"hp\": 0,\n                  \"maxHp\": 80,\n                  \"tempHp\": 0,\n                  \"rp\": 48,\n                  \"maxRp\": 48,\n                  \"dissonance\": 0,\n                  \"lastSpell\": null,\n                  \"refrain\": 0,\n                  \"preparedFamiliesUsed\": [],\n                  \"position\": [\n                    20,\n                    0,\n                    0\n                  ],\n                  \"alive\": true,\n                  \"conscious\": false,\n                  \"conditions\": [\n                    \"Dying\",\n                    \"Prone\"\n                  ],\n                  \"concentration\": null,\n                  \"reaction\": true,\n                  \"action\": true,\n                  \"bonusAction\": true,\n                  \"movementSpent\": 0,\n                  \"regularStart\": 0,\n                  \"nextRegularStart\": 6,\n                  \"counterRecharge\": 0,\n                  \"wounds\": 0,\n                  \"critical\": false,\n                  \"companionCommandUsed\": false,\n                  \"companionOffenseUsed\": false,\n                  \"deathSuccesses\": 1,\n                  \"deathFailures\": 1,\n                  \"stable\": false\n                }\n              },\n              \"applications\": {},\n              \"objects\": {\n                \"oldDuplicate\": {\n                  \"id\": \"prior-live\",\n                  \"hp\": 30,\n                  \"rp\": 5,\n                  \"state\": \"active\",\n                  \"position\": [\n                    10,\n                    0,\n                    0\n                  ]\n                }\n              },\n              \"privateMemories\": {},\n              \"sourceLedger\": {\n                \"oldCapOwner\": \"creator\",\n                \"creationAttempt\": {\n                  \"snapshotHp\": 0,\n                  \"state\": \"immediate-finite-ending\",\n                  \"newLiveBody\": false,\n                  \"replacementCommitted\": false\n                }\n              },\n              \"note\": \"Complete stated finite fixture state; unspecified optional reactions are declined. No actual encounter runtime is asserted.\"\n            },\n            \"regularStartsBeforeEvent\": [],\n            \"sourceRefs\": []\n          }\n        ],\n        \"expectedFinalState\": {\n          \"actors\": {\n            \"creator\": {\n              \"profile\": \"W13I\",\n              \"hp\": 80,\n              \"maxHp\": 80,\n              \"tempHp\": 0,\n              \"rp\": 31,\n              \"maxRp\": 48,\n              \"dissonance\": 0,\n              \"lastSpell\": \"simulacrum\",\n              \"refrain\": 0,\n              \"preparedFamiliesUsed\": [\n                \"simulacrum\"\n              ],\n              \"position\": [\n                0,\n                0,\n                0\n              ],\n              \"alive\": true,\n              \"conscious\": true,\n              \"conditions\": [],\n              \"concentration\": null,\n              \"reaction\": true,\n              \"action\": false,\n              \"bonusAction\": true,\n              \"movementSpent\": 0,\n              \"regularStart\": 0,\n              \"nextRegularStart\": 6,\n              \"counterRecharge\": 0,\n              \"wounds\": 0,\n              \"critical\": false,\n              \"companionCommandUsed\": false,\n              \"companionOffenseUsed\": false\n            },\n            \"donor\": {\n              \"profile\": \"W13I\",\n              \"hp\": 0,\n              \"maxHp\": 80,\n              \"tempHp\": 0,\n              \"rp\": 48,\n              \"maxRp\": 48,\n              \"dissonance\": 0,\n              \"lastSpell\": null,\n              \"refrain\": 0,\n              \"preparedFamiliesUsed\": [],\n              \"position\": [\n                20,\n                0,\n                0\n              ],\n              \"alive\": true,\n              \"conscious\": false,\n              \"conditions\": [\n                \"Dying\",\n                \"Prone\"\n              ],\n              \"concentration\": null,\n              \"reaction\": true,\n              \"action\": true,\n              \"bonusAction\": true,\n              \"movementSpent\": 0,\n              \"regularStart\": 0,\n              \"nextRegularStart\": 6,\n              \"counterRecharge\": 0,\n              \"wounds\": 0,\n              \"critical\": false,\n              \"companionCommandUsed\": false,\n              \"companionOffenseUsed\": false,\n              \"deathSuccesses\": 1,\n              \"deathFailures\": 1,\n              \"stable\": false\n            }\n          },\n          \"applications\": {},\n          \"objects\": {\n            \"oldDuplicate\": {\n              \"id\": \"prior-live\",\n              \"hp\": 30,\n              \"rp\": 5,\n              \"state\": \"active\",\n              \"position\": [\n                10,\n                0,\n                0\n              ]\n            }\n          },\n          \"privateMemories\": {},\n          \"sourceLedger\": {\n            \"oldCapOwner\": \"creator\",\n            \"creationAttempt\": {\n              \"snapshotHp\": 0,\n              \"state\": \"immediate-finite-ending\",\n              \"newLiveBody\": false,\n              \"replacementCommitted\": false\n            }\n          },\n          \"note\": \"Complete stated finite fixture state; unspecified optional reactions are declined. No actual encounter runtime is asserted.\"\n        },\n        \"conclusions\": {\n          \"creatorRP\": 31,\n          \"donorHP\": 0,\n          \"oldLiveBodyHP\": 30,\n          \"newLiveBody\": false,\n          \"donorDeathCounters\": [\n            1,\n            1\n          ]\n        },\n        \"qualifications\": [],\n        \"disposition\": \"COHERENT_AT_DISCLOSED_SOURCE_INPUTS\",\n        \"sourceQualification\": \"Explicit RIC5-SI zero-HP creation-lifecycle choice plus actual CHA/zero-HP rules; neither a rated monster nor a production encounter.\",\n        \"budgetSemantics\": \"Action/BonusAction/Reaction booleans are remaining underlying ledgers, not action eligibility outside an actual source-qualified phase or while Incapacitated. Supplied regular-START refreshes are materialized before events; explicit relevant END/idle-D transitions remain in the trace. Other uninvoked actions are declined. Long uninterrupted work/rest branches explicitly use real elapsed noncombat work, not thousands of fabricated Actions.\",\n        \"sourceRefs\": [\n          {\n            \"archive\": \"inputs/DD_Rank7_Identity_Casting_5_Source_Conference_01.zip\",\n            \"member\": \"sources/DescentReviewChanges/ReviewBible/data/public/spell_playtests/catalog.json\",\n            \"bytes\": 4945319,\n            \"sha256\": \"f52cf6a4a4673897615a74c7c67dcba798c431362d4357e71ee552cc7c5d31f8\",\n            \"pointer\": \"/spells/565\",\n            \"role\": \"Complete preserved source/access object\"\n          },\n          {\n            \"archive\": \"inputs/DD_Rank7_Identity_Casting_5_Source_Conference_01.zip\",\n            \"member\": \"sources/DescentReviewChanges/ReviewBible