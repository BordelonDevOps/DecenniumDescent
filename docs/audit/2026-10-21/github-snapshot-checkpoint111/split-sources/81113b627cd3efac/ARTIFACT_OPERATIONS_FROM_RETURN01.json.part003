rivateMemories\": {\n                \"donor\": {\n                  \"accessible\": [\n                    \"a personally remembered room description\"\n                  ],\n                  \"inaccessible\": [\n                    \"sealed-memory-placeholder-no-access\"\n                  ]\n                }\n              },\n              \"sourceLedger\": {\n                \"account\": {\n                  \"rp\": 48,\n                  \"dissonance\": 0,\n                  \"casterLineageId\": \"derivative/creator/donor\",\n                  \"lastSpell\": null,\n                  \"refrain\": 0\n                }\n              },\n              \"note\": \"Complete stated finite fixture state; unspecified optional reactions are declined. No actual encounter runtime is asserted.\"\n            },\n            \"regularStartsBeforeEvent\": []\n          }\n        ],\n        \"expectedFinalState\": {\n          \"actors\": {\n            \"creator\": {\n              \"profile\": \"W13I\",\n              \"hp\": 80,\n              \"maxHp\": 80,\n              \"tempHp\": 0,\n              \"rp\": 48,\n              \"maxRp\": 48,\n              \"dissonance\": 0,\n              \"lastSpell\": null,\n              \"refrain\": 0,\n              \"preparedFamiliesUsed\": [],\n              \"position\": [\n                0,\n                0,\n                0\n              ],\n              \"alive\": true,\n              \"conscious\": true,\n              \"conditions\": [],\n              \"concentration\": null,\n              \"reaction\": true,\n              \"action\": true,\n              \"bonusAction\": true,\n              \"movementSpent\": 0,\n              \"regularStart\": 0,\n              \"nextRegularStart\": 6,\n              \"counterRecharge\": 0,\n              \"wounds\": 0,\n              \"critical\": false,\n              \"companionCommandUsed\": false,\n              \"companionOffenseUsed\": false\n            },\n            \"donor\": {\n              \"profile\": \"W13I\",\n              \"hp\": 35,\n              \"maxHp\": 80,\n              \"tempHp\": 0,\n              \"rp\": 6,\n              \"maxRp\": 48,\n              \"dissonance\": 0,\n              \"lastSpell\": \"ray-of-frost\",\n              \"refrain\": 1,\n              \"preparedFamiliesUsed\": [\n                \"ray-of-frost\"\n              ],\n              \"position\": [\n                20,\n                0,\n                0\n              ],\n              \"alive\": true,\n              \"conscious\": true,\n              \"conditions\": [],\n              \"concentration\": null,\n              \"reaction\": true,\n              \"action\": true,\n              \"bonusAction\": true,\n              \"movementSpent\": 0,\n              \"regularStart\": 0,\n              \"nextRegularStart\": 6,\n              \"counterRecharge\": 0,\n              \"wounds\": 0,\n              \"critical\": false,\n              \"companionCommandUsed\": false,\n              \"companionOffenseUsed\": false\n            }\n          },\n          \"applications\": {},\n          \"objects\": {\n            \"realLantern\": {\n              \"owner\": \"creator\",\n              \"position\": [\n                0,\n                0,\n                0\n              ],\n              \"weightLb\": 2,\n              \"load\": 0.2,\n              \"actualCharges\": 0\n            },\n            \"duplicate\": {\n              \"id\": \"SI-existing\",\n              \"position\": [\n                10,\n                0,\n                0\n              ],\n              \"hp\": 80,\n              \"maxHp\": 80,\n              \"rp\": 48,\n              \"state\": \"active\",\n              \"sourceOwnerLineageId\": \"derivative/creator/donor\"\n            }\n          },\n          \"privateMemories\": {\n            \"donor\": {\n              \"accessible\": [\n                \"a personally remembered room description\"\n              ],\n              \"inaccessible\": [\n                \"sealed-memory-placeholder-no-access\"\n              ]\n            }\n          },\n          \"sourceLedger\": {\n            \"account\": {\n              \"rp\": 48,\n              \"dissonance\": 0,\n              \"casterLineageId\": \"derivative/creator/donor\",\n              \"lastSpell\": null,\n              \"refrain\": 0\n            }\n          },\n          \"note\": \"Complete stated finite fixture state; unspecified optional reactions are declined. No actual encounter runtime is asserted.\"\n        },\n        \"conclusions\": {\n          \"rp\": 48,\n          \"noForeignNoRecoveryRule\": true\n        },\n        \"qualifications\": [],\n        \"independentBranches\": [],\n        \"disposition\": \"CONDITIONAL_ACTUAL_REST_INPUTS_AND_BENEFICIAL_REST_BUDGET_REQUIRED\",\n        \"sourceQualification\": \"Complete class engines, legal selected/automatic cards, prepared/known fixture additions, physical bodies and budgets are attached. These are explicit source-built finite teaching actors, not a claim to an authenticated live campaign encounter or a creature CR.\",\n        \"budgetSemantics\": \"Action/BonusAction/Reaction booleans are remaining underlying ledgers, not action eligibility outside an actual source-qualified phase or while Incapacitated. Supplied regular-START refreshes are materialized before events; explicit relevant END/idle-D transitions remain in the trace. Other uninvoked actions are declined. Long uninterrupted work/rest branches explicitly use real elapsed noncombat work, not thousands of fabricated Actions.\"\n      },\n      {\n        \"id\": \"RIC5-05-B-g\",\n        \"spellId\": \"simulacrum\",\n        \"title\": \"A living zero-HP donor is not a resurrection or an inherited Null root\",\n        \"kind\": \"NEW source-qualified authored encounter; not engine executed\",\n        \"geometry\": \"Coordinates in feet; each actor occupies its stated5-foot body volume about its listed horizontal anchor, with feet on z=0 solid floor unless explicitly overridden. Flat open lit chamber, full legal perception/line of effect, no unseen extra defenses, ordinary paths/support. Numeric area witnesses and exceptions are stated per event.\",\n        \"actorDefinitions\": {\n          \"creator\": {\n            \"kind\": \"Source-qualified illustrative character, not a verified campaign actor or rated monster\",\n            \"class\": \"Wizard\",\n            \"classLevel\": 13,\n            \"totalLevel\": 13,\n            \"PB\": 5,\n            \"S\": 3,\n            \"STR\": 10,\n            \"DEX\": 14,\n            \"CON\": 14,\n            \"INT\": 18,\n            \"WIS\": 12,\n            \"CHA\": 10,\n            \"maxHp\": 80,\n            \"hpConstruction\": \"d6 class: initial6+CON2=8, twelve supplied legal hit-die results4+CON2=6 each;8+72=80. This is a stated fixture history, not generated random character evidence.\",\n            \"maxRp\": 48,\n            \"maxRank\": 7,\n            \"Limit\": 11,\n            \"AC\": 12,\n            \"speedFeet\": 30,\n            \"size\": \"Medium\",\n            \"bodyBoxFeet\": [\n              5,\n              5,\n              5\n            ],\n            \"bodyMassLb\": 170,\n            \"actualGear\": {\n              \"focus-pack\": {\n                \"grossWeightLb\": 10,\n                \"load\": 1,\n                \"contents\": \"real ordinary wooden focus and mundane personal carrying effects; no consumed materials/charged item; gross figures include every item once\"\n              }\n            },\n            \"saves\": {\n              \"STR\": 0,\n              \"DEX\": 2,\n              \"CON\": 2,\n              \"INT\": 9,\n              \"WIS\": 6,\n              \"CHA\": 0\n            },\n            \"spellAttack\": 9,\n            \"spellDc\": 17,\n            \"school\": \"Illusion\",\n            \"schoolAttack\": 11,\n            \"schoolDc\": 19,\n            \"schoolConcentrationSave\": 4,\n            \"ordinaryConcentrationSave\": 2,\n            \"arcaneWard\": \"force resistance: this prepared Illusion set has no intrinsic damage type; no fire/cold/psychic resistance invented\",\n            \"hero\": \"Spellbinder\",\n            \"bookAndPreparation\": {\n              \"newRank7BookAdditionsAt13\": [\n                \"cast-echo\",\n                \"meta-surge\",\n                \"erase-from-reality\",\n                \"sequester\",\n                \"simulacrum\"\n              ],\n              \"ordinaryPrepared\": [\n                \"cast-echo\",\n                \"meta-surge\",\n                \"erase-from-reality\",\n                \"sequester\",\n                \"simulacrum\",\n                \"fireball\",\n                \"shield\",\n                \"counterspell\",\n                \"continual-flame\",\n                \"mirror-image\",\n                \"detect-magic\",\n                \"true-seeing\"\n              ],\n              \"count\": 12,\n              \"baseCapacity\": 17,\n              \"additionalFloatingAndSchoolSlotsUnused\": true,\n              \"olderSpells\": \"Actual source-qualified book/cantrip additions at earlier legal Wizard levels; ordinary Counterspell acquired at5+, True Seeing at11, Continual Flame at3; no feat or copying grant needed.\",\n              \"ordinaryKnownCantrips\": [\n                \"ray-of-frost\",\n                \"chill-touch\",\n                \"resonance-shield\",\n                \"minor-image\",\n                \"disrupt-memory\"\n              ],\n              \"unusedBaseMatrixPositions\": 5\n            },\n            \"selectedAcquisition\": [\n              {\n                \"classLevel\": 1,\n                \"cards\": [\n                  {\n                    \"id\": \"wizard.base.arcane-recovery\",\n                    \"name\": \"Arcane Recovery\",\n                    \"className\": \"Wizard\",\n                    \"band\": \"Base\",\n                    \"path\": null,\n                    \"sourceKind\": \"passive\",\n                    \"minimumClassLevel\": 1,\n                    \"acquisition\": \"selection\",\n                    \"activation\": \"Passive\",\n                    \"cost\": \"0\",\n                    \"rangeAndTarget\": \"Self\",\n                    \"duration\": \"Instantaneous during a completed short rest\",\n                    \"frequency\": \"1/long rest\",\n                    \"effect\": \"Arcane Recovery. Tags: base, passive, resonance. Once between long rests when you complete a short rest, restore RP equal to half your Wizard class level rounded up, never above your normal maximum. This is RP recovery, not a second pool, and cannot trigger spell-cast, Refrain or Dissonance effects.\",\n                    \"source\": {\n                      \"extract\": \"docs/reference/Player_Rulebook_v6_source_text.txt\",\n                      \"line\": 5196,\n                      \"originalText\": \"Arcane Recovery: Once per day during a short rest, recover RP equal to half your Wizard level (rounded up), up to your normal maximum.\"\n                    },\n                    \"designStatus\": \"provisional-playtest\",\n                    \"spellRank\": null\n                  },\n                  {\n                    \"id\": \"wizard.base.spell-scribing\",\n                    \"name\": \"Spell Scribing\",\n                    \"className\": \"Wizard\",\n                    \"band\": \"Base\",\n                    \"path\": null,\n                    \"sourceKind\": \"passive\",\n                    \"minimumClassLevel\": 1,\n                    \"acquisition\": \"selection\",\n                    \"activation\": \"Passive\",\n                    \"cost\": \"0\",\n                    \"rangeAndTarget\": \"Your spellbook\",\n                    \"duration\": \"Permanent\",\n                    \"frequency\": \"Always\",\n                    \"effect\": \"Spell Scribing. Tags: base, passive, spellbook. Copying a legal found Wizard spell into your spellbook requires 1 hour and 25 gp of inks and components per spell rank, treating rank 0 as rank 1 for this calculation, instead of the pilot baseline 2 hours and 50 gp. Level-up spells remain free.\",\n                    \"source\": {\n                      \"extract\": \"docs/reference/Player_Rulebook_v6_source_text.txt\",\n                      \"line\": 5197,\n                      \"originalText\": \"Spell Scribing: Copy spells into your spellbook at half the normal cost and time.\"\n                    },\n                    \"designStatus\": \"provisional-playtest\",\n                    \"spellRank\": null\n                  },\n                  {\n                    \"id\": \"wizard.base.arcane-bolt\",\n                    \"name\": \"Arcane Bolt\",\n                    \"className\": \"Wizard\",\n                    \"band\": \"Base\",\n                    \"path\": null,\n                    \"sourceKind\": \"active\",\n                    \"minimumClassLevel\": 1,\n                    \"acquisition\": \"selection\",\n                    \"activation\": \"Action\",\n                    \"cost\": \"1 RP\",\n                    \"rangeAndTarget\": \"One creature within 60 feet\",\n                    \"duration\": \"Instantaneous\",\n                    \"frequency\": \"At will while RP remains\",\n                    \"effect\": \"Arcane Bolt. Tags: base, active, wizard-spell, universal, damage. Make a Wizard spell attack. On a hit deal S d6 + M force damage. Arcane Bolt is an always-prepared class matrix once acquired and uses the normal first-distinct-matrix and Refrain rules.\",\n                    \"source\": {\n                      \"extract\": \"docs/reference/Player_Rulebook_v6_source_text.txt\",\n                      \"line\": 5203,\n                      \"originalText\": \"Arcane Bolt: Launch a bolt of pure arcane energy that deals force damage to a single target.\"\n                    },\n                    \"designStatus\": \"provisional-playtest\",\n                    \"spellRank\": 1\n                  },\n                  {\n                    \"id\": \"wizard.base.minor-conjuration\",\n                    \"name\": \"Minor Conjuration\",\n                    \"className\": \"Wizard\",\n                    \"band\": \"Base\",\n                    \"path\": null,\n                    \"sourceKind\": \"active\",\n                    \"minimumClassLevel\": 1,\n                    \"acquisition\": \"selection\",\n                    \"activation\": \"Action\",\n                    \"cost\": \"1 RP\",\n                    \"rangeAndTarget\": \"One unoccupied space within 10 feet\",\n                    \"duration\": \"1 hour\",\n                    \"frequency\": \"At will while RP remains; one object at a time\",\n                    \"effect\": \"Minor Conjuration. Tags: base, active, wizard-spell, conjuration. Create one nonmagical unattended object that fits inside a 1-foot cube, weighs no more than 10 pounds and is made of common nonvaluable material such as wood, cloth, clay, iron or glass. It cannot be food, poison, currency, a spell component with listed cost, ammunition with special properties or a functional complex mechanism. Creating another dismisses the first.\",\n                    \"source\": {\n                      \"extract\": \"docs/reference/Player_Rulebook_v6_source_text.txt\",\n                      \"line\": 5204,\n                      \"originalText\": \"Minor Conjuration: Create a temporary, small inanimate object that lasts for 1 hour.\"\n                    },\n                    \"designStatus\": \"provisional-playtest\",\n                    \"spellRank\": 1\n                  }\n                ]\n              },\n              {\n                \"classLevel\": 2,\n                \"cards\": [\n                  {\n                    \"id\": \"wizard.base.arcane-insight\",\n                    \"name\": \"Arcane Insight\",\n                    \"className\": \"Wizard\",\n                    \"band\": \"Base\",\n                    \"path\": null,\n                    \"sourceKind\": \"passive\",\n                    \"minimumClassLevel\": 1,\n                    \"acquisition\": \"selection\",\n                    \"activation\": \"Passive\",\n                    \"cost\": \"0\",\n                    \"rangeAndTarget\": \"Self\",\n                    \"duration\": \"Permanent\",\n                    \"frequency\": \"Always\",\n                    \"effect\": \"Arcane Insight. Tags: base, passive, knowledge. Gain proficiency in Arcana, or expertise if already proficient. When examining an active magical effect, spell residue, magic item or arcane construction, you may make an Intelligence (Arcana) check to determine its broad school, function or unusual matrix behavior. The Director sets the normal knowledge DC; failure supplies no invented fact.\",\n                    \"source\": {\n                      \"extract\": \"docs/reference/Player_Rulebook_v6_source_text.txt\",\n                      \"line\": 5198,\n                      \"originalText\": \"Arcane Insight: Identify magical effects and items with greater accuracy than non-wizards.\"\n                    },\n                    \"designStatus\": \"provisional-playtest\",\n                    \"spellRank\": null\n                  },\n                  {\n                    \"id\": \"wizard.base.matrix-efficiency\",\n                    \"name\": \"Matrix Efficiency\",\n                    \"className\": \"Wizard\",\n                    \"band\": \"Base\",\n                    \"path\": null,\n                    \"sourceKind\": \"passive\",\n                    \"minimumClassLevel\": 1,\n                    \"acquisition\": \"selection\",\n                    \"activation\": \"Passive\",\n                    \"cost\": \"0\",\n                    \"rangeAndTarget\": \"Self\",\n                    \"duration\": \"Daily preparation\",\n                    \"frequency\": \"Always\",\n                    \"effect\": \"Matrix Efficiency. Tags: base, passive, matrix. Your normal full daily Spell Matrix preparation time is reduced from 1 hour to 45 minutes. This does not reduce the separate 10-minute midday substitution ritual, spell scribing, rituals or spellbook reconstruction unless another feature explicitly says so.\",\n                    \"source\": {\n                      \"extract\": \"docs/reference/Player_Rulebook_v6_source_text.txt\",\n                      \"line\": 5199,\n                      \"originalText\": \"Matrix Efficiency: Reduce the preparation time for spells by 25%.\"\n                    },\n                    \"designStatus\": \"provisional-playtest\",\n                    \"spellRank\": null\n                  }\n                ]\n              },\n              {\n                \"classLevel\": 3,\n                \"cards\": [\n                  {\n                    \"id\": \"wizard.arch.floating-preparation\",\n                    \"name\": \"Floating Preparation\",\n                    \"className\": \"Wizard\",\n                    \"band\": \"Arch\",\n                    \"path\": null,\n                    \"sourceKind\": \"passive\",\n                    \"minimumClassLevel\": 3,\n                    \"acquisition\": \"selection\",\n                    \"activation\": \"Passive\",\n                    \"cost\": \"0\",\n                    \"rangeAndTarget\": \"Self\",\n                    \"duration\": \"Daily preparation\",\n                    \"frequency\": \"Always\",\n                    \"effect\": \"Floating Preparation. Tags: arch, passive, matrix. Increase your maximum prepared Spell Matrix count by 1. The extra matrix can come from any school and obeys all ordinary spellbook and rank restrictions. It is a prepared matrix for every rule, including protected strain, duplicate-family tracking and Matrix Mastery modifications.\",\n                    \"source\": {\n                      \"extract\": \"docs/reference/Player_Rulebook_v6_source_text.txt\",\n                      \"line\": 5213,\n                      \"originalText\": \"Floating Preparation: Prepare 1 extra spell from any school each day\"\n                    },\n                    \"designStatus\": \"provisional-playtest\",\n                    \"spellRank\": null\n                  },\n                  {\n                    \"id\": \"wizard.arch.arcane-lock\",\n                    \"name\": \"Arcane Lock\",\n                    \"className\": \"Wizard\",\n                    \"band\": \"Arch\",\n                    \"path\": null,\n                    \"sourceKind\": \"active\",\n                    \"minimumClassLevel\": 3,\n                    \"acquisition\": \"selection\",\n                    \"activation\": \"Action\",\n                    \"cost\": \"2 RP\",\n                    \"rangeAndTarget\": \"One door, chest, portal or unattended object within touch\",\n                    \"duration\": \"8 hours\",\n                    \"frequency\": \"Recharge 2 rounds\",\n                    \"effect\": \"Arcane Lock. Tags: arch, active, wizard-spell, abjuration. Magically seal the target. Opening it without your permission requires a Strength check or thieves'/arcane-tool check against your Wizard spell DC. Dispel Magic can end the lock. You can designate up to M creatures who can bypass it. This does not make the object physically indestructible.\",\n                    \"source\": {\n                      \"extract\": \"docs/reference/Player_Rulebook_v6_source_text.txt\",\n                      \"line\": 5223,\n                      \"originalText\": \"Arcane Lock: Create a magical barrier that prevents entry or access to an object or area.\"\n                    },\n                    \"designStatus\": \"provisional-playtest\",\n                    \"spellRank\": 2\n                  }\n                ]\n              },\n              {\n                \"classLevel\": 4,\n                \"cards\": [\n                  {\n                    \"id\": \"wizard.base.scholarly-mind\",\n                    \"name\": \"Scholarly Mind\",\n                    \"className\": \"Wizard\",\n                    \"band\": \"Base\",\n                    \"path\": null,\n                    \"sourceKind\": \"passive\",\n                    \"minimumClassLevel\": 1,\n                    \"acquisition\": \"selection\",\n                    \"activation\": \"Passive\",\n                    \"cost\": \"0\",\n                    \"rangeAndTarget\": \"Self\",\n                    \"duration\": \"Permanent\",\n                    \"frequency\": \"Always\",\n                    \"effect\": \"Scholarly Mind. Tags: base, passive, knowledge. You have advantage on Intelligence checks whose primary purpose is recalling, researching or analyzing arcane theory, magical history, planar magical principles or constructed spell formulae. It does not grant advantage on spell attacks, Counterspell checks or general Investigation unrelated to arcane scholarship.\",\n                    \"source\": {\n                      \"extract\": \"docs/reference/Player_Rulebook_v6_source_text.txt\",\n                      \"line\": 5200,\n                      \"originalText\": \"Scholarly Mind: Gain advantage on Intelligence checks related to arcane knowledge.\"\n                    },\n                    \"designStatus\": \"provisional-playtest\",\n                    \"spellRank\": null\n                  }\n                ]\n              },\n              {\n                \"classLevel\": 5,\n                \"cards\": [\n                  {\n                    \"id\": \"wizard.arch.dispel-magic\",\n                    \"name\": \"Dispel Magic\",\n                    \"className\": \"Wizard\",\n                    \"band\": \"Arch\",\n                    \"path\": null,\n                    \"sourceKind\": \"active\",\n                    \"minimumClassLevel\": 5,\n                    \"acquisition\": \"selection\",\n                    \"activation\": \"Action\",\n                    \"cost\": \"3 RP\",\n                    \"rangeAndTarget\": \"One creature, object or magical effect within 60 feet\",\n                    \"duration\": \"Instantaneous\",\n                    \"frequency\": \"Recharge 2 rounds\",\n                    \"effect\": \"Dispel Magic. Tags: arch, active, wizard-spell, abjuration. Choose one ongoing spell effect you can perceive. If its rank is 3 or lower, end it. If it is rank 4 or higher, make an Intelligence check adding proficiency against DC 10 + spell rank; success ends it. Permanent artifact properties and effects explicitly immune to dispelling are unaffected.\",\n                    \"source\": {\n                      \"extract\": \"docs/reference/Player_Rulebook_v6_source_text.txt\",\n                      \"line\": 5224,\n                      \"originalText\": \"Dispel Magic: End magical effects in an area or on a target.\"\n                    },\n                    \"designStatus\": \"provisional-playtest\",\n                    \"spellRank\": 3\n                  }\n                ]\n              },\n              {\n                \"classLevel\": 6,\n                \"cards\": [\n                  {\n                    \"id\": \"wizard.arch.arcane-sight\",\n                    \"name\": \"Arcane Sight\",\n                    \"className\": \"Wizard\",\n                    \"band\": \"Arch\",\n                    \"path\": null,\n                    \"sourceKind\": \"active\",\n                    \"minimumClassLevel\": 3,\n                    \"acquisition\": \"selection\",\n                    \"activation\": \"Action\",\n                    \"cost\": \"2 RP\",\n                    \"rangeAndTarget\": \"Self; 60-foot sight\",\n                    \"duration\": \"Concentration, maximum 10 minutes\",\n                    \"frequency\": \"Recharge 2 rounds\",\n                    \"effect\": \"Arcane Sight. Tags: arch, active, wizard-spell, divination, concentration. While active you perceive magical auras within 60 feet and automatically know each visible aura's school or broad magical category. As an Action on a later turn, examine one aura to learn whether it is concentrated, summoned, cursed, warded or linked to another visible magical effect. Total cover blocks sight.\",\n                    \"source\": {\n                      \"extract\": \"docs/reference/Player_Rulebook_v6_source_text.txt\",\n                      \"line\": 5226,\n                      \"originalText\": \"Arcane Sight: See magical auras and effects for a short duration.\"\n                    },\n                    \"designStatus\": \"provisional-playtest\",\n                    \"spellRank\": 2\n                  }\n                ]\n              },\n              {\n                \"classLevel\": 7,\n                \"cards\": [\n                  {\n                    \"id\": \"wizard.arch.dimensional-pocket\",\n                    \"name\": \"Dimensional Pocket\",\n                    \"className\": \"Wizard\",\n                    \"band\": \"Arch\",\n                    \"path\": null,\n                    \"sourceKind\": \"active\",\n                    \"minimumClassLevel\": 7,\n                    \"acquisition\": \"selection\",\n                    \"activation\": \"Ritual\",\n                    \"cost\": \"3 RP\",\n                    \"rangeAndTarget\": \"One point within 5 feet\",\n                    \"duration\": \"8 hours\",\n                    \"frequency\": \"1/long rest\",\n                    \"effect\": \"Dimensional Pocket. Tags: arch, active, wizard-spell, conjuration, ritual. Create an extradimensional storage space holding up to 100 pounds or 10 cubic feet of unattended nonliving material. Retrieving or placing an item while adjacent to the opening uses an object interaction. Living creatures cannot enter. When duration ends, remaining contents appear harmlessly in the nearest unoccupied space.\",\n                    \"source\": {\n                      \"extract\": \"docs/reference/Player_Rulebook_v6_source_text.txt\",\n                      \"line\": 5225,\n                      \"originalText\": \"Dimensional Pocket: Create a small extradimensional space to store items.\"\n                    },\n                    \"designStatus\": \"provisional-playtest\",\n                    \"spellRank\": 4\n                  }\n                ]\n              },\n              {\n                \"classLevel\": 8,\n                \"cards\": [\n                  {\n                    \"id\": \"wizard.base.analyze-magic\",\n                    \"name\": \"Analyze Magic\",\n                    \"className\": \"Wizard\",\n                    \"band\": \"Base\",\n                    \"path\": null,\n                    \"sourceKind\": \"active\",\n                    \"minimumClassLevel\": 1,\n                    \"acquisition\": \"selection\",\n                    \"activation\": \"Action\",\n                    \"cost\": \"1 RP\",\n                    \"rangeAndTarget\": \"One magical creature, object or effect within 30 feet\",\n                    \"duration\": \"Instantaneous\",\n                    \"frequency\": \"Recharge 1 round\",\n                    \"effect\": \"Analyze Magic. Tags: base, active, wizard-spell, divination, knowledge. Make an Intelligence (Arcana) check against DC 10 + the effect's spell rank, treating a non-spell effect's Director-assigned tier as rank. On success learn its school or magical category, one active mechanical property and whether it is currently sustained, cursed or bound to another effect. Failure reveals only that magic is present.\",\n                    \"source\": {\n                      \"extract\": \"docs/reference/Player_Rulebook_v6_source_text.txt\",\n                      \"line\": 5206,\n                      \"originalText\": \"Analyze Magic: Study a magical effect or item to gain insight into its properties and function.\"\n                    },\n                    \"designStatus\": \"provisional-playtest\",\n                    \"spellRank\": 1\n                  }\n                ]\n              },\n              {\n                \"classLevel\": 9,\n                \"cards\": [\n                  {\n                    \"id\": \"wizard.arch.sigil-rewrite\",\n                    \"name\": \"Sigil Rewrite\",\n                    \"className\": \"Wizard\",\n                    \"band\": \"Arch\",\n                    \"path\": null,\n                    \"sourceKind\": \"passive\",\n                    \"minimumClassLevel\": 3,\n                    \"acquisition\": \"selection\",\n                    \"activation\": \"Bonus Action\",\n                    \"cost\": \"0\",\n                    \"rangeAndTarget\": \"Self and spellbook\",\n                    \"duration\": \"Instantaneous\",\n                    \"frequency\": \"1/long rest\",\n                    \"effect\": \"Sigil Rewrite. Tags: arch, passive-upgrade, matrix. Replace one prepared matrix with a different spell from your spellbook of exactly the same rank without performing the normal 10-minute ritual. The replacement receives no special Dissonance reset for a matrix family already used this encounter and must obey current Wizard rank eligibility.\",\n                    \"source\": {\n                      \"extract\": \"docs/reference/Player_Rulebook_v6_source_text.txt\",\n                      \"line\": 5214,\n                      \"originalText\": \"Sigil Rewrite: Once/day, instantly swap a spell you know for another of the same tier\"\n                    },\n                    \"designStatus\": \"provisional-playtest\",\n                    \"spellRank\": null\n                  }\n                ]\n              },\n              {\n                \"classLevel\": 10,\n                \"cards\": [\n                  {\n                    \"id\": \"wizard.hero.spellbinder.spell-preservation\",\n                    \"name\": \"Spell Preservation\",\n                    \"className\": \"Wizard\",\n                    \"band\": \"Hero\",\n                    \"path\": \"Spellbinder\",\n                    \"sourceKind\": \"passive\",\n                    \"minimumClassLevel\": 10,\n                    \"acquisition\": \"selection\",\n                    \"activation\": \"Passive\",\n                    \"cost\": \"0\",\n                    \"rangeAndTarget\": \"Your spellbook\",\n                    \"duration\": \"Permanent\",\n                    \"frequency\": \"Always\",\n                    \"effect\": \"Spell Preservation. Tags: hero, spellbinder, passive, spellbook. Your primary spellbook cannot be destroyed, erased or rendered permanently unreadable by non-artifact mundane or magical means. It can still be stolen, hidden, transported, suppressed, sealed by an artifact-level effect or voluntarily abandoned. Copies and backup books do not automatically receive this protection.\",\n                    \"source\": {\n                      \"extract\": \"docs/reference/Player_Rulebook_v6_source_text.txt\",\n                      \"line\": 5243,\n                      \"originalText\": \"Spell Preservation: Your spellbook cannot be destroyed by non-artifact means.\"\n                    },\n                    \"designStatus\": \"provisional-playtest\",\n                    \"spellRank\": null\n                  },\n                  {\n                    \"id\": \"wizard.hero.spellbinder.seal-magic\",\n                    \"name\": \"Seal Magic\",\n                    \"className\": \"Wizard\",\n                    \"band\": \"Hero\",\n                    \"path\": \"Spellbinder\",\n                    \"sourceKind\": \"active\",\n                    \"minimumClassLevel\": 10,\n                    \"acquisition\": \"selection\",\n                    \"activation\": \"Action\",\n                    \"cost\": \"4 RP\",\n                    \"rangeAndTarget\": \"One creature within 60 feet\",\n                    \"duration\": \"Maximum 3 rounds\",\n                    \"frequency\": \"Recharge 3 rounds\",\n                    \"effect\": \"Seal Magic. Tags: hero, spellbinder, wizard-spell, control. Choose one of the eight schools and target one creature. It makes a Wisdom save. On failure it cannot cast spells of the chosen school. At the end of each of its turns it repeats the save, ending the Seal on success. The effect ends automatically after 3 rounds and never prevents non-spell class techniques merely because they are magical.\",\n                    \"source\": {\n                      \"extract\": \"docs/reference/Player_Rulebook_v6_source_text.txt\",\n                      \"line\": 5249,\n                      \"originalText\": \"Seal Magic: Prevent a target from casting spells of a specific school (WIS save, 3 rounds)\"\n                    },\n                    \"designStatus\": \"provisional-playtest\",\n                    \"spellRank\": 5\n                  }\n                ]\n              },\n              {\n                \"classLevel\": 11,\n                \"cards\": [\n                  {\n                    \"id\": \"wizard.base.arcane-shield\",\n                    \"name\": \"Arcane Shield\",\n                    \"className\": \"Wizard\",\n                    \"band\": \"Base\",\n                    \"path\": null,\n                    \"sourceKind\": \"active\",\n                    \"minimumClassLevel\": 1,\n                    \"acquisition\": \"selection\",\n                    \"activation\": \"Reaction\",\n                    \"cost\": \"2 RP\",\n                    \"rangeAndTarget\": \"Self\",\n                    \"duration\": \"Until start of your next regular turn\",\n                    \"frequency\": \"Recharge 2 rounds\",\n                    \"effect\": \"Arcane Shield. Tags: base, active, wizard-spell, abjuration, protection. Trigger when an attack roll would hit you. Gain +2 AC against the triggering attack and until the start of your next regular turn, potentially causing the attack to miss. Temporary AC from another Arcane Shield does not stack.\",\n                    \"source\": {\n                      \"extract\": \"docs/reference/Player_Rulebook_v6_source_text.txt\",\n                      \"line\": 5205,\n                      \"originalText\": \"Arcane Shield: Create a barrier of magical force that provides temporary protection.\"\n                    },\n                    \"designStatus\": \"provisional-playtest\",\n                    \"spellRank\": 1\n                  }\n                ]\n              },\n              {\n                \"classLevel\": 12,\n                \"cards\": [\n                  {\n                    \"id\": \"wizard.hero.spellbinder.counterpulse\",\n                    \"name\": \"Counterpulse\",\n                    \"className\": \"Wizard\",\n                    \"band\": \"Hero\",\n                    \"path\": \"Spellbinder\",\n                    \"sourceKind\": \"active\",\n                    \"minimumClassLevel\": 12,\n                    \"acquisition\": \"selection\",\n                    \"activation\": \"Triggered\",\n                    \"cost\": \"1 RP\",\n                    \"rangeAndTarget\": \"Caster whose spell you successfully Counterspelled\",\n                    \"duration\": \"Until end of target's next turn\",\n                    \"frequency\": \"At most once per round\",\n                    \"effect\": \"Counterpulse. Tags: hero, spellbinder, counter, control. Immediately after your Counterspell succeeds, spend 1 RP. The countered caster is Silenced until the end of its next turn. This is part of the successful counter event rather than another spell cast and cannot trigger another Counterpulse.\",\n                    \"source\": {\n                      \"extract\": \"docs/reference/Player_Rulebook_v6_source_text.txt\",\n                      \"line\": 5251,\n                      \"originalText\": \"Counterpulse: Countering a spell silences the caster for 1 round\"\n                    },\n                    \"designStatus\": \"provisional-playtest\",\n                    \"spellRank\": null\n                  }\n                ]\n              },\n              {\n                \"classLevel\": 13,\n                \"cards\": [\n                  {\n                    \"id\": \"wizard.base.spellbook-study\",\n                    \"name\": \"Spellbook Study\",\n                    \"className\": \"Wizard\",\n                    \"band\": \"Base\",\n                    \"path\": null,\n                    \"sourceKind\": \"active\",\n                    \"minimumClassLevel\": 1,\n                    \"acquisition\": \"selection\",\n                    \"activation\": \"Ritual\",\n                    \"cost\": \"0 RP\",\n                    \"rangeAndTarget\": \"Self and spellbook\",\n                    \"duration\": \"10 minutes\",\n                    \"frequency\": \"1/long rest\",\n                    \"effect\": \"Spellbook Study. Tags: base, active, matrix, ritual. Replace one currently prepared matrix with one legal spell recorded in your spellbook. The replacement must be within your Wizard rank limit. This is the normal midday substitution permission; it does not alter the spellbook, create another prepared-matrix position or reset first-cast/Refrain history for an underlying matrix family already cast this encounter.\",\n                    \"source\": {\n                      \"extract\": \"docs/reference/Player_Rulebook_v6_source_text.txt\",\n                      \"line\": 5207,\n                      \"originalText\": \"Spellbook Study: Spend time studying your spellbook to prepare a different selection of spells.\"\n                    },\n                    \"designStatus\": \"provisional-playtest\",\n                    \"spellRank\": null\n                  }\n                ]\n              }\n            ],\n            \"automaticCards\": [\n              {\n                \"id\": \"wizard.arch.arcane-tradition\",\n                \"name\": \"Arcane Tradition\",\n                \"className\": \"Wizard\",\n                \"band\": \"Arch\",\n                \"path\": null,\n                \"sourceKind\": \"passive\",\n                \"minimumClassLevel\": 3,\n                \"acquisition\": \"automatic\",\n                \"activation\": \"Passive\",\n                \"cost\": \"0\",\n                \"rangeAndTarget\": \"Your level-1 Arcane School\",\n                \"duration\": \"Permanent\",\n                \"frequency\": \"Automatic at Wizard 3; not a selection\",\n                \"effect\": \"Arcane Tradition. Tags: arch, school, automatic. Your level-1 Arcane School becomes your Arcanist tradition; do not choose a second school. Prepare one additional matrix from that same school each day without counting it against your normal prepared-matrix maximum. It otherwise obeys all ordinary rank, spellbook, Dissonance and duplicate-family rules.\",\n                \"source\": {\n                  \"extract\": \"docs/reference/Player_Rulebook_v6_source_text.txt\",\n                  \"line\": 5217,\n                  \"originalText\": \"Arcane Tradition: Choose a school of magic to specialize in, gaining bonuses to spells of that school.\"\n                },\n                \"designStatus\": \"provisional-playtest\",\n                \"spellRank\": null\n              },\n              {\n                \"id\": \"wizard.base.counterspell\",\n                \"name\": \"Counterspell\",\n                \"className\": \"Wizard\",\n                \"band\": \"Base\",\n                \"path\": null,\n                \"sourceKind\": \"active\",\n                \"minimumClassLevel\": 2,\n                \"acquisition\": \"automatic\",\n                \"activation\": \"Reaction\",\n                \"cost\": \"3 RP\",\n                \"rangeAndTarget\": \"One creature you perceive casting a spell within 60 feet\",\n                \"duration\": \"Instantaneous\",\n                \"frequency\": \"Automatic at Wizard 2; recharge 2 rounds\",\n                \"effect\": \"Counterspell. Tags: arch-source, automatic, wizard-spell, abjuration, disruption. Trigger when a creature begins casting a spell. Make an Intelligence check adding proficiency against DC 10 + twice the spell's rank, treating rank 0 as 0. Success negates the triggering spell after its costs are paid; failure lets it resolve. This is gained automatically at Wizard 2 and is never also selected from the Arch pool.\",\n                \"source\": {\n                  \"extract\": \"docs/reference/Player_Rulebook_v6_source_text.txt\",\n                  \"line\": 5222,\n                  \"originalText\": \"Counterspell: Disrupt an enemy's spellcasting, potentially negating their spell entirely.\"\n                },\n                \"designStatus\": \"provisional-playtest\",\n                \"spellRank\": 1\n              },\n              {\n                \"id\": \"wizard.supplement.ritual-casting\",\n                \"name\": \"Ritual Casting\",\n                \"className\": \"Wizard\",\n                \"band\": \"Base\",\n                \"path\": null,\n                \"sourceKind\": \"supplement\",\n                \"minimumClassLevel\": 2,\n                \"acquisition\": \"automatic\",\n                \"activation\": \"Ritual\",\n                \"cost\": \"0 RP unless the individual ritual explicitly states otherwise\",\n                \"rangeAndTarget\": \"As the ritual spell\",\n                \"duration\": \"As the ritual spell\",\n                \"frequency\": \"At will outside encounters with sufficient time\",\n                \"effect\": \"Source progression line 5184. Cast a Wizard spell bearing the Ritual tag directly from your spellbook without preparing it. Increase its casting time by at least 10 minutes. Ritual Casting cannot be completed during an encounter, does not use an ordinary prepared-matrix position and does not generate or vent normal casting Dissonance.\",\n                \"prerequisite\": \"See class engine and progression.\",\n                \"source\": {\n                  \"line\": 5184,\n                  \"reference\": null,\n                  \"originalText\": \"| 2 | Counterspell Reaction, Ritual Casting |\",\n                  \"status\": \"source-derived\"\n                },\n                \"designStatus\": \"provisional-playtest\",\n                \"spellRank\": null\n              },\n              {\n                \"id\": \"wizard.supplement.school-mastery\",\n                \"name\": \"School Mastery\",\n                \"className\": \"Wizard\",\n                \"band\": \"Arch\",\n                \"path\": null,\n                \"sourceKind\": \"supplement\",\n                \"minimumClassLevel\": 5,\n                \"acquisition\": \"automatic\",\n                \"activation\": \"Passive\",\n                \"cost\": \"0\",\n                \"rangeAndTarget\": \"Your level-1 Arcane School\",\n                \"duration\": \"Permanent\",\n                \"frequency\": \"Automatic at Wizard 5\",\n                \"effect\": \"Source progression line 5186. This is the one School Mastery progression grant, not a second school choice or duplicate feat. Increase the level-1 Arcane School spell-attack and spell-save bonus from +1 to +2 total. Its school passive and bonus-spell rules otherwise remain unchanged.\",\n                \"prerequisite\": \"See class engine and progression.\",\n                \"source\": {\n                  \"line\": 5186,\n                  \"reference\": null,\n                  \"originalText\": \"| 5 | Bonus Feat: School Mastery |\",\n                  \"status\": \"source-derived\"\n                },\n                \"designStatus\": \"provisional-playtest\",\n                \"spellRank\": null\n              },\n              {\n                \"id\": \"wizard.supplement.arcane-ward\",\n                \"name\": \"Arcane Ward\",\n                \"className\": \"Wizard\",\n                \"band\": \"Arch\",\n                \"path\": null,\n                \"sourceKind\": \"supplement\",\n                \"minimumClassLevel\": 6,\n                \"acquisition\": \"automatic\",\n                \"activation\": \"Passive\",\n                \"cost\": \"0\",\n                \"rangeAndTarget\": \"Self\",\n                \"duration\": \"Until next long rest\",\n                \"frequency\": \"Choose after each long rest\",\n                \"effect\": \"Source progression line 5187. After preparing spells, choose one of acid, cold, fire, force, lightning, necrotic, psychic, radiant or thunder that is dealt by at least one prepared spell of your Arcane School. Gain resistance to that damage type until your next long rest. If none of your prepared school spells deals a damage type, choose force. This is provisional completion of the source's ambiguous 'chosen school's element' wording.\",\n                \"prerequisite\": \"See class engine and progression.\",\n                \"source\": {\n                  \"line\": 5187,\n                  \"reference\": null,\n                  \"originalText\": \"| 6 | Arcane Ward (resistance to chosen school's element) |\",\n                  \"status\": \"source-derived\"\n                },\n                \"designStatus\": \"provisional-playtest\",\n                \"spellRank\": null\n              },\n              {\n                \"id\": \"wizard.supplement.dual-cast\",\n                \"name\": \"Dual Cast\",\n                \"className\": \"Wizard\",\n                \"band\": \"Arch\",\n                \"path\": null,\n                \"sourceKind\": \"supplement\",\n                \"minimumClassLevel\": 9,\n                \"acquisition\": \"automatic\",\n                \"activation\": \"Action\",\n                \"cost\": \"Pay the complete RP costs of both spells\",\n                \"rangeAndTarget\": \"As each spell\",\n                \"duration\": \"As each spell\",\n                \"frequency\": \"1/short rest\",\n                \"effect\": \"Source progression line 5188. Choose two DIFFERENT prepared Wizard spells of rank 1 or 2, neither of which summons a creature or grants an additional Action. Cast both sequentially as one Action, paying both RP costs. They cannot both require concentration. Each matrix separately updates first-cast/Refrain history. Features that trigger merely from 'casting a spell' may trigger once for each actual matrix unless that feature itself says once per turn; no trigger may create another Dual Cast or additional full Action.\",\n                \"prerequisite\": \"See class engine and progression.\",\n                \"source\": {\n                  \"line\": 5188,\n                  \"reference\": null,\n                  \"originalText\": \"| 9 | Dual Cast (cast 2 Tier 1–2 spells in a round) |\",\n                  \"status\": \"source-derived\"\n                },\n                \"designStatus\": \"provisional-playtest\",\n                \"spellRank\": null\n              },\n              {\n                \"id\": \"wizard.supplement.overchannel\",\n                \"name\": \"Overchannel\",\n                \"className\": \"Wizard\",\n                \"band\": \"Hero\",\n                \"path\": null,\n                \"sourceKind\": \"supplement\",\n                \"minimumClassLevel\": 13,\n                \"acquisition\": \"automatic\",\n                \"activation\": \"Triggered\",\n                \"cost\": \"Pay the Core V 2 RP cost for one rank above the spell's normal cast rank\",\n                \"rangeAndTarget\": \"One prepared spell you are beginning to cast\",\n                \"duration\": \"For that cast\",\n                \"frequency\": \"1/long rest\",\n                \"effect\": \"Source progression line 5190. Cast one prepared spell as though it were one rank higher than the highest rank at which you could normally cast that SAME spell, provided the spell has an explicit higher-rank scaling rule. Overchannel does not teach or prepare a higher-rank spell, cannot exceed effective rank 9 and cannot be combined with another generic Overcast rule during this pilot. All normal Dissonance/Refrain rules still apply.\",\n                \"prerequisite\": \"See class engine and progression.\",\n                \"source\": {\n                  \"line\": 5190,\n                  \"reference\": null,\n                  \"originalText\": \"| 13 | Overchannel (cast a spell 1 tier higher once/day) |\",\n                  \"status\": \"source-derived\"\n                },\n                \"designStatus\": \"provisional-playtest\",\n                \"spellRank\": null\n              }\n            ],\n            \"completeEngine\": [\n              \"PROVISIONAL PLAYTEST CONTRACT. Intelligence is the Wizard class ability. S = 1/2/3/4 at Wizard levels 1/5/11/17. M = max(1, Intelligence modifier). Wizard spell attack = d20 + normal character proficiency bonus + Intelligence modifier. Wizard spell save DC = 8 + normal character proficiency bonus + Intelligence modifier.\",\n              \"The Wizard remains three distinct stages: Base Wizard at levels 1-2, Arch Arcanist at levels 3-9, and one Hero path at levels 10-20: Spellbinder, Elementalist or Necromancer. Hero paths are not additional starting classes and their features cannot be selected before their Wizard class-level gates.\",\n              \"SPELLBOOK. At Wizard 1 your spellbook contains six chosen rank-1 Wizard spells. Arcane School Specialization also adds one legal rank-1 bonus spell of your chosen school without replacing one of those six. For this provisional progression, add 2 legal Wizard spells to the book at each Wizard level 2-4, 3 at each level 5-8, 4 at each level 9-12, 5 at each level 13-16 and 6 at each level 17-20. Level-up additions cost no money or scribing time.\",\n              \"LEGAL RANKS. Maximum Wizard spell rank by Wizard class level is: rank 1 at levels 1-2, rank 2 at 3-4, rank 3 at 5-6, rank 4 at 7-8, rank 5 at 9-10, rank 6 at 11-12, rank 7 at 13-14, rank 8 at 15-16 and rank 9 at 17-20. Grand Tier at level 20 is a special casting permission, not a tenth ordinary rank. A Wizard may learn Wizard-list spells from any school up to the legal rank unless a spell itself has an additional prerequisite.\",\n              \"PREPARED SPELL MATRIX. After a long rest, prepare a number of matrices equal to Wizard level + Intelligence modifier, minimum 1, selecting only spells currently recorded in your spellbook and within your legal rank. You cast ordinary Wizard spells only from prepared matrices unless a feature explicitly overrides that restriction. Preparing the full daily matrix set normally requires 1 hour of spellbook study. Matrix Efficiency reduces this to 45 minutes.\",\n              \"DUPLICATE PREPARATION. You may prepare the same spell more than once, primarily to carry different Matrix Mastery configurations. Duplicate copies never create additional first-cast Dissonance exemptions. For Refrain and the protected strain rule, all prepared copies sharing the same underlying spell name belong to one matrix family regardless of modification.\",\n              \"MIDDAY SUBSTITUTION. Once between long rests, you may perform a 10-minute Spellbook Study ritual to replace one prepared matrix with another legal spell from your spellbook. The replacement cannot exceed your legal Wizard rank. Sigil Rewrite and Matrix Mastery may improve this process as explicitly stated.\",\n              \"SPELL ACQUISITION BY SCRIBING. A found Wizard spell may be copied into the spellbook if its rank is legal for you. Baseline scribing requires 2 hours and 50 gp of inks/materials per spell rank, treating rank 0 as 1 for this calculation. Spell Scribing halves both values to 1 hour and 25 gp per rank. Failure to finish the work consumes no spellbook entry but materials already expended during an interrupted hour are lost.\",\n              \"SPELLBOOK LOSS. Losing the spellbook does not erase matrices currently prepared in memory; you may continue casting those prepared matrices until you next rebuild or change preparation. A blank replacement book can be seeded with your currently prepared spells at 1 hour and 25 gp per effective spell rank each. An unprepared spell you previously recorded can be reconstructed from memory with 8 hours, 100 gp per rank and an Intelligence (Arcana) check against DC 10 + spell rank. Failure consumes that attempt's time and half its materials; another attempt can be made after a long rest. Recovering the original book automatically restores access to its surviving entries.\",\n              \"ARCANE SCHOOL SPECIALIZATION is automatic at Wizard 1. Choose exactly one of the eight schools. Your spell attacks with that school gain +1 and your Wizard save DC for that school's spells gains +1. You also add one legal rank-1 spell of that school to the spellbook. The source table explicitly supplies seven school passives; the eighth core school, Abjuration, is named elsewhere but its passive row is missing. Its provisional playtest passive is identified below rather than silently presented as recovered text.\",\n              \"ABJURATION, provisional completion for the omitted eighth row: once per round after you cast an Abjuration spell, gain temporary HP equal to PB until the start of your next regular turn. CONJURATION: creatures summoned by your Wizard spells gain +1 maximum HP per Wizard level. DIVINATION: once per long rest reroll one failed saving throw and use the new result. ENCHANTMENT: when a creature fails its initial save against one of your Enchantment spells, a printed control duration of at least 1 round may last one additional round, but every normally allowed repeat save still occurs. EVOCATION: when casting an area Evocation spell, exclude one creature from its initial damaging area; that creature automatically succeeds and takes no damage if success normally halves damage. ILLUSION: gain +2 on concentration saves made to maintain Illusion spells. NECROMANCY: once per turn during a real encounter when a hostile non-summoned creature dies from your Necromancy spell, gain 1 temporary HP; it is not permanent healing. TRANSMUTATION: after casting a Transmutation spell, gain +5 feet Speed until the end of that turn.\",\n              \"PROTECTED DISSONANCE INTERFACE. The first cast of each different prepared matrix family during an encounter generates 0 BASE Dissonance. This exemption affects only base strain. Refrain and explicitly printed strain costs still apply; the suite disables generic Overcast and does not layer historical Burn onto Dissonance. Repeating a matrix family follows normal Refrain immediately. Preparing duplicates or differently modified copies of the same underlying spell never refreshes the exemption.\",\n              \"Core Systems V 2 Resonance Points and spell-rank RP costs are authoritative for Wizard spellcasting. There are no historical spell slots in this pilot. Wizard cards tagged wizard-spell are always-prepared class matrices once acquired, do not consume a daily prepared-matrix position and use the same RP, concentration, Refrain and protected first-distinct-matrix rules as other Wizard spells. Their printed RP cost replaces any generic rank cost; never pay both.\",\n              \"RITUAL CASTING is automatic at Wizard 2. A Wizard spell in your spellbook with the Ritual tag can be cast from the book without being prepared by increasing its casting time by at least 10 minutes. A ritual cast costs 0 RP unless that ritual explicitly lists a consumed RP cost, cannot be used during an encounter and cannot generate or vent Dissonance through ordinary casting strain.\",\n              \"Only one concentration effect can normally be maintained. Starting a second concentration effect ends the first. Damage uses the current Core Systems concentration rule; required half-damage rounding is down for this pilot. Spell Tether and the level-17 Tethered Cast are the only Wizard-specific exceptions in this draft, and each has an explicit RP price, duration and one-tether cap.\",\n              \"MATRIX MASTERY MODIFICATIONS. After acquiring Matrix Mastery, each prepared ordinary spell matrix may carry at most one modification chosen during preparation. QUICK SUBSTITUTION: once per short rest, replace one matrix marked Quick Substitution with another spellbook spell of exactly the same rank using a 1-minute ritual instead of the normal 10-minute midday swap; the replacement loses the modification until the next long rest. COMPONENT ENHANCEMENT: when casting a damaging or healing matrix, spend 1 additional RP to add one extra die of the spell's primary damage or healing die to one roll; if the spell has no such die this modification has no effect. MATRIX LINKING: pair two different prepared matrix families during preparation; after legally casting one, the other costs 1 less RP, minimum 1, if cast before the end of your next regular turn, at most once per pair per round. STABILITY REINFORCEMENT: gain +2 on concentration saves caused by damage while maintaining that matrix. A matrix modification never creates another spell cast or proc event.\",\n              \"All sources share a maximum of one additional full Action per creature per round. Additional Actions cannot grant another additional Action, Bonus Action or Reaction. Spell copies, Matrix Sharing, Arcane Fusion, Dual Cast and similar effects pay all explicitly required RP and do not produce duplicate resource, cast-proc or action-grant chains beyond their written resolution.\",\n              \"Round recharge counters decrease once at the start of your regular initiative turn even if you cannot act. Extra Actions and extra turns do not tick recharge. Outside initiative, each uninterrupted 6 seconds counts as one tick. Only positive counters can be reset or shortened and each named ability can receive at most one reset or shortening per round.\",\n              \"SUMMON COMMAND LIMIT. All Wizard-controlled conjured, raised and bound companions share one damaging/control Companion Command per Wizard regular turn. Spend one Bonus Action to command exactly one such creature to move up to its Speed and use one damaging or control action from its stat block. Uncommanded creatures may reposition defensively and take Dodge but cannot deal damage or impose conditions. No summoned or raised creature can create XP, treasure, RP, Dissonance relief, additional corpses or kill-resource farms.\",\n              \"NECROMANCER STANDARD UNDEAD. Corpse Harvest and Auto-Raise share a maximum of three standard raised minions. Skeleton: AC 14, HP 6 + 2 × Wizard level, Speed 30; Bone Shot, range 30 feet, Wizard spell attack, 1d6+S necrotic. Zombie: AC 12, HP 10 + 3 × Wizard level, Speed 20; Slam, reach 5 feet, Wizard spell attack, 1d8+S necrotic. Goblin Thrall, available only from a goblinoid corpse: AC 13, HP 8 + 2 × Wizard level, Speed 30; Shiv, reach 5 feet, Wizard spell attack, 1d6+S necrotic. These are pre-Flesh-Ascendant statistics.\",\n              \"NECROMANCER AUTO-RAISE. Once per round when one of your standard undead minions personally lands the killing blow on an eligible humanoid and your standard-minion count is below three, its corpse rises at the end of the current turn as the same mechanical minion type that scored the kill, if physically possible. A new minion cannot act during that same round. Auto-Raise costs no Action or RP but can never exceed the three-minion cap or generate a new resource, corpse chain, XP or treasure event. Without Infernal Pact only humanoids qualify.\",\n              \"ELITE UNDEAD PETS. Necromancers may bind Boneflayer, Dreadblade and Wraithbound, at most one of each and three elite pets total. They use the same shared Companion Command limit as standard undead. Boneflayer: AC 14, HP 12 + 2 × Wizard level, Speed 30. Bone Shards: range 60, Wizard spell attack, 2d6+S necrotic. Fear Pulse replaces its attack: enemies within 10 feet make Wisdom saves; failure Frightened until end of next turn; recharge 3. Grave Miasma replaces its attack: 10-foot-radius point within 30 feet until start of your next turn; enemies entering or starting there take 1d6 necrotic once; recharge 3.\",\n              \"Dreadblade: AC 16, HP 16 + 3 × Wizard level, Speed 30. Disrupting Blade: reach 5 feet, Wizard spell attack, 1d8+S necrotic; a concentrating target immediately makes its concentration save with disadvantage. On a natural 20 the target is Weakened until the end of its next turn, taking -1 on attack rolls. Dreadblade has advantage on saves against forced movement.\",\n              \"Wraithbound: AC 14, HP 10 + 2 × Wizard level, Fly 40 and hover. While it has not attacked or imposed control since the end of its previous turn it is Invisible; attacking ends that state until the end of its next turn. Wraith Strike: reach 5 feet, Wizard spell attack, 1d8+S necrotic. On natural 20 the target makes a Constitution save against your Wizard DC; failure Stuns until the end of its next turn.\",\n              \"Flesh Ascendant's bonus applies after the listed base statistics: every undead creature you control gains +2 maximum HP per Wizard level. If at least two of your undead creatures are active, each gains +1 AC and +1 on saving throws. This does not increase the standard-minion or elite-pet caps.\",\n              \"DARK-TRAUMA INTERFACE. Necromancer features involving corpse desecration, infernal bargains, domination, body control or Mind Prison remain subject to the project's existing dark-content and trauma boundaries. A table may fade description to black without changing mechanics. No feature changes a player's real belief, permanently transfers ownership of a player character or silently retires a PC.\",\n              \"PROPOSED ACQUISITION. Wizard 1 automatically gains Arcane School Specialization, Spell Matrix System and the starting spellbook, then chooses 4 selectable Base cards, at least 2 Active. Wizard 2 automatically gains Counterspell and Ritual Casting, then chooses 2 additional selectable Base cards. Counterspell is not also placed in the Arch selection pool.\",\n              \"At Wizard 3 enter Arcanist, automatically gain Arcane Tradition as an upgrade of the SAME level-1 school rather than choosing another school, and choose 2 selectable Arch cards, at least 1 Active. Wizard 4 grants one eligible Base/Arch choice. Wizard 5 grants one Base/Arch choice plus automatic School Mastery. Wizard 6 grants one Base/Arch choice plus automatic Arcane Ward. Wizard 7 grants one eligible Arch choice. Wizard 8 grants one Base/Arch choice. Wizard 9 grants one eligible Arch choice plus automatic Dual Cast.\",\n              \"At Wizard 10 choose Spellbinder, Elementalist or Necromancer and gain 2 Hero cards from that path. ELEMENTALIST EXCEPTION: Elemental Affinity is automatic at path selection and counts as one of those two level-10 Hero acquisitions, so an Elementalist chooses only one additional Hero card at level 10. Levels 11, 13, 15, 17 and 19 each grant one eligible unselected Base/Arch choice. Levels 12, 14, 16 and 18 each grant one Hero-path choice. The chosen Final Theorem is automatic at Wizard 20. School Mastery, Counterspell, Arcane Tradition and all progression-table automatic features are never duplicated as selections.\",\n              \"All acquisition gates use Wizard class level rather than total character level. Normal proficiency bonus follows the game's ordinary total-character-level rule. A multiclass dip cannot unlock higher spell ranks, Arcanist cards, Hero cards, Final Theorems or progression-table features.\",\n              \"Class matrices tagged wizard-spell receive a rank in normalized card data equal to maximum ordinary Wizard rank at their minimum class-level gate (cap 9). Printed RP cost replaces generic rank cost. Counterspell is rank 1 at its explicit level 2 automatic grant. This explicit convention closes rank-dependent Counterspell/Dissonance interactions without inventing extra costs.\",\n              \"Cantrip completion: know 3 Wizard cantrips at 1, 4 at 4, 5 at 10, using the shared missing-repertoire fallback. Cantrips are known directly and do not consume prepared matrices. Always-prepared class matrices are additional cards, not extra arbitrary ordinary spells. Class spell ranks and the normalized activation field resolve incomplete source terminology.\"\n            ],\n            \"source\": {\n              \"path\": \"DescentReviewChanges/ReviewBible/data/public/class_playtests/wizard.json\",\n              \"pointers\": [\n                \"/engine\",\n                \"/schedule\",\n                \"/cards\",\n                \"/rpByClassLevel/12\"\n              ]\n            },\n            \"optionalChoicesInCases\": \"No Matrix Mastery, Spell Efficiency, Improved Concentration, Sigil Authority or Knowledge Shield acquired. Dual Cast, Overchannel, class Arcane Shield and optional Counterpulse are not invoked unless expressly declared. No Arcane Feedback at13.\",\n            \"creatureType\": \"Humanoid\",\n            \"profileScope\": \"An explicitly supplied finite class-built teaching creature profile using the complete actual class engine/cards. Not a newly rated bestiary creature, not authenticated campaign or ancestry acquisition, and not permission to fill an absent future profile.\",\n            \"languages\": [\n              \"Common\"\n            ],\n            \"otherIntrinsicDefenses\": [],\n            \"additionalSkillProficienciesClaimed\": [],\n            \"checks\": \"Use current ability modifier and actual acquired named card when applicable; save proficiency is not an ability-check proficiency. No Athletics proficiency is claimed.\",\n            \"actualActionsAvailable\": \"Each annotated actual regular START supplies the normal Action/BonusAction/Reaction/movement according to the real source; the event trace explicitly consumes each used budget. No extra action source is assumed.\",\n            \"asiHistory\": {\n              \"rolledINT\": 16,\n              \"class4\": \"INT+2 to18\",\n              \"class8\": \"STR+2 from8 to10\",\n              \"class12\": \"CHA+2 from8 to10\",\n              \"DEX\": 14,\n              \"CON\": 14,\n              \"WIS\": 12,\n              \"note\": \"Explicit legal generated-score/ASI fixture inputs; no extra feat is claimed.\"\n            }\n          },\n          \"donor\": {\n            \"kind\": \"Source-qualified illustrative character, not a verified campaign actor or rated monster\",\n            \"class\": \"Wizard\",\n            \"classLevel\": 13,\n            \"totalLevel\": 13,\n            \"PB\": 5,\n            \"S\": 3,\n            \"STR\": 10,\n            \"DEX\": 14,\n            \"CON\": 14,\n            \"INT\": 18,\n            \"WIS\": 12,\n            \"CHA\": 10,\n            \"maxHp\": 80,\n            \"hpConstruction\": \"d6 class: initial6+CON2=8, twelve supplied legal hit-die results4+CON2=6 each;8+72=80. This is a stated fixture history, not generated random character evidence.\",\n            \"maxRp\": 48,\n            \"maxRank\": 7,\n            \"Limit\": 11,\n            \"AC\": 12,\n            \"speedFeet\": 30,\n            \"size\": \"Medium\",\n            \"bodyBoxFeet\": [\n              5,\n              5,\n              5\n            ],\n            \"bodyMassLb\": 170,\n            \"actualGear\": {\n              \"focus-pack\": {\n                \"grossWeightLb\": 10,\n                \"load\": 1,\n                \"contents\": \"real ordinary wooden focus and mundane personal carrying effects; no consumed materials/charged item; gross figures include every item once\"\n              }\n            },\n            \"saves\": {\n              \"STR\": 0,\n              \"DEX\": 2,\n              \"CON\": 2,\n              \"INT\": 9,\n              \"WIS\": 6,\n              \"CHA\": 0\n            },\n            \"spellAttack\": 9,\n            \"spellDc\": 17,\n            \"school\": \"Illusion\",\n            \"schoolAttack\": 11,\n            \"schoolDc\": 19,\n            \"schoolConcentrationSave\": 4,\n            \"ordinaryConcentrationSave\": 2,\n            \"arcaneWard\": \"force resistance: this prepared Illusion set has no intrinsic damage type; no fire/cold/psychic resistance invented\",\n            \"hero\": \"Spellbinder\",\n            \"bookAndPreparation\": {\n              \"newRank7BookAdditionsAt13\": [\n                \"cast-echo\",\n                \"meta-surge\",\n                \"erase-from-reality\",\n                \"sequester\",\n                \"simulacrum\"\n              ],\n              \"ordinaryPrepared\": [\n                \"cast-echo\",\n                \"meta-surge\",\n                \"erase-from-reality\",\n                \"sequester\",\n                \"simulacrum\",\n                \"fireball\",\n                \"shield\",\n                \"counterspell\",\n                \"continual-flame\",\n                \"mirror-image\",\n                \"detect-magic\",\n                \"true-seeing\"\n              ],\n              \"count\": 12,\n              \"baseCapacity\": 17,\n              \"additionalFloatingAndSchoolSlotsUnused\": true,\n              \"olderSpells\": \"Actual source-qualified book/cantrip additions at earlier legal Wizard levels; ordinary Counterspell acquired at5+, True Seeing at11, Continual Flame at3; no feat or copying grant needed.\",\n              \"ordinaryKnownCantrips\": [\n                \"ray-of-frost\",\n                \"chill-touch\",\n                \"resonance-shield\",\n                \"minor-image\",\n                \"disrupt-memory\"\n              ],\n              \"unusedBaseMatrixPositions\": 5\n            },\n            \"selectedAcquisition\": [\n              {\n                \"classLevel\": 1,\n                \"cards\": [\n                  {\n                    \"id\": \"wizard.base.arcane-recovery\",\n                    \"name\": \"Arcane Recovery\",\n                    \"className\": \"Wizard\",\n                    \"band\": \"Base\",\n                    \"path\": null,\n                    \"sourceKind\": \"passive\",\n                    \"minimumClassLevel\": 1,\n                    \"acquisition\": \"selection\",\n                    \"activation\": \"Passive\",\n                    \"cost\": \"0\",\n                    \"rangeAndTarget\": \"Self\",\n                    \"duration\": \"Instantaneous during a completed short rest\",\n                    \"frequency\": \"1/long rest\",\n                    \"effect\": \"Arcane Recovery. Tags: base, passive, resonance. Once between long rests when you complete a short rest, restore RP equal to half your Wizard class level rounded up, never above your normal maximum. This is RP recovery, not a second pool, and cannot trigger spell-cast, Refrain or Dissonance effects.\",\n                    \"source\": {\n                      \"extract\": \"docs/reference/Player_Rulebook_v6_source_text.txt\",\n                      \"line\": 5196,\n                      \"originalText\": \"Arcane Recovery: Once per day during a short rest, recover RP equal to half your Wizard level (rounded up), up to your normal maximum.\"\n                    },\n                    \"designStatus\": \"provisional-playtest\",\n                    \"spellRank\": null\n                  },\n                  {\n                    \"id\": \"wizard.base.spell-scribing\",\n                    \"name\": \"Spell Scribing\",\n                    \"className\": \"Wizard\",\n                    \"band\": \"Base\",\n                    \"path\": null,\n                    \"sourceKind\": \"passive\",\n                    \"minimumClassLevel\": 1,\n                    \"acquisition\": \"selection\",\n                    \"activation\": \"Passive\",\n                    \"cost\": \"0\",\n                    \"rangeAndTarget\": \"Your spellbook\",\n                    \"duration\": \"Permanent\",\n                    \"frequency\": \"Always\",\n                    \"effect\": \"Spell Scribing. Tags: base, passive, spellbook. Copying a legal found Wizard spell into your spellbook requires 1 hour and 25 gp of inks and components per spell rank, treating rank 0 as rank 1 for this calculation, instead of the pilot baseline 2 hours and 50 gp. Level-up spells remain free.\",\n                    \"source\": {\n                      \"extract\": \"docs/reference/Player_Rulebook_v6_source_text.txt\",\n                      \"line\": 5197,\n                      \"originalText\": \"Spell Scribing: Copy spells into your spellbook at half the normal cost and time.\"\n                    },\n                    \"designStatus\": \"provisional-playtest\",\n                    \"spellRank\": null\n                  },\n                  {\n                    \"id\": \"wizard.base.arcane-bolt\",\n                    \"name\": \"Arcane Bolt\",\n                    \"className\": \"Wizard\",\n                    \"band\": \"Base\",\n                    \"path\": null,\n                    \"sourceKind\": \"active\",\n                    \"minimumClassLevel\": 1,\n                    \"acquisition\": \"selection\",\n                    \"activation\": \"Action\",\n                    \"cost\": \"1 RP\",\n                    \"rangeAndTarget\": \"One creature within 60 feet\",\n                    \"duration\": \"Instantaneous\",\n                    \"frequency\": \"At will while RP remains\",\n                    \"effect\": \"Arcane Bolt. Tags: base, active, wizard-spell, universal, damage. Make a Wizard spell attack. On a hit deal S d6 + M force damage. Arcane Bolt is an always-prepared class matrix once acquired and uses the normal first-distinct-matrix and Refrain rules.\",\n                    \"source\": {\n                      \"extract\": \"docs/reference/Player_Rulebook_v6_source_text.txt\",\n                      \"line\": 5203,\n                      \"originalText\": \"Arcane Bolt: Launch a bolt of pure arcane energy that deals force damage to a single target.\"\n                    },\n                    \"designStatus\": \"provisional-playtest\",\n                    \"spellRank\": 1\n                  },\n                  {\n                    \"id\": \"wizard.base.minor-conjuration\",\n                    \"name\": \"Minor Conjuration\",\n                    \"className\": \"Wizard\",\n                    \"band\": \"Base\",\n                    \"path\": null,\n                    \"sourceKind\": \"active\",\n                    \"minimumClassLevel\": 1,\n                    \"acquisition\": \"selection\",\n                    \"activation\": \"Action\",\n                    \"cost\": \"1 RP\",\n                    \"rangeAndTarget\": \"One unoccupied space within 10 feet\",\n                    \"duration\": \"1 hour\",\n                    \"frequency\": \"At will while RP remains; one object at a time\",\n                    \"effect\": \"Minor Conjuration. Tags: base, active, wizard-spell, conjuration. Create one nonmagical unattended object that fits inside a 1-foot cube, weighs no more than 10 pounds and is made of common nonvaluable material such as wood, cloth, clay, iron or glass. It cannot be food, poison, currency, a spell component with listed cost, ammunition with special properties or a functional complex mechanism. Creating another dismisses the first.\",\n                    \"source\": {\n                      \"extract\": \"docs/reference/Player_Rulebook_v6_source_text.txt\",\n                      \"line\": 5204,\n                      \"originalText\": \"Minor Conjuration: Create a temporary, small inanimate object that lasts for 1 hour.\"\n                    },\n                    \"designStatus\": \"provisional-playtest\",\n                    \"spellRank\": 1\n                  }\n                ]\n              },\n              {\n                \"classLevel\": 2,\n                \"cards\": [\n                  {\n                    \"id\": \"wizard.base.arcane-insight\",\n                    \"name\": \"Arcane Insight\",\n                    \"className\": \"Wizard\",\n                    \"band\": \"Base\",\n                    \"path\": null,\n                    \"sourceKind\": \"passive\",\n                    \"minimumClassLevel\": 1,\n                    \"acquisition\": \"selection\",\n                    \"activation\": \"Passive\",\n                    \"cost\": \"0\",\n                    \"rangeAndTarget\": \"Self\",\n                    \"duration\": \"Permanent\",\n                    \"frequency\": \"Always\",\n                    \"effect\": \"Arcane Insight. Tags: base, passive, knowledge. Gain proficiency in Arcana, or expertise if already proficient. When examining an active magical effect, spell residue, magic item or arcane construction, you may make an Intelligence (Arcana) check to determine its broad school, function or unusual matrix behavior. The Director sets the normal knowledge DC; failure supplies no invented fact.\",\n                    \"source\": {\n                      \"extract\": \"docs/reference/Player_Rulebook_v6_source_text.txt\",\n                      \"line\": 5198,\n                      \"originalText\": \"Arcane Insight: Identify magical effects and items with greater accuracy than non-wizards.\"\n                    },\n                    \"designStatus\": \"provisional-playtest\",\n                    \"spellRank\": null\n                  },\n                  {\n                    \"id\": \"wizard.base.matrix-efficiency\",\n                    \"name\": \"Matrix Efficiency\",\n                    \"className\": \"Wizard\",\n                    \"band\": \"Base\",\n                    \"path\": null,\n                    \"sourceKind\": \"passive\",\n                    \"minimumClassLevel\": 1,\n                    \"acquisition\": \"selection\",\n                    \"activation\": \"Passive\",\n                    \"cost\": \"0\",\n                    \"rangeAndTarget\": \"Self\",\n                    \"duration\": \"Daily preparation\",\n                    \"frequency\": \"Always\",\n                    \"effect\": \"Matrix Efficiency. Tags: base, passive, matrix. Your normal full daily Spell Matrix preparation time is reduced from 1 hour to 45 minutes. This does not reduce the separate 10-minute midday substitution ritual, spell scribing, rituals or spellbook reconstruction unless another feature explicitly says so.\",\n                    \"source\": {\n                      \"extract\": \"docs/reference/Player_Rulebook_v6_source_text.txt\",\n                      \"line\": 5199,\n                      \"originalText\": \"Matrix Efficiency: Reduce the preparation time for spells by 25%.\"\n                    },\n                    \"designStatus\": \"provisional-playtest\",\n                    \"spellRank\": null\n                  }\n                ]\n              },\n              {\n                \"classLevel\": 3,\n                \"cards\": [\n                  {\n                    \"id\": \"wizard.arch.floating-preparation\",\n                    \"name\": \"Floating Preparation\",\n                    \"className\": \"Wizard\",\n                    \"band\": \"Arch\",\n                    \"path\": null,\n                    \"sourceKind\": \"passive\",\n                    \"minimumClassLevel\": 3,\n                    \"acquisition\": \"selection\",\n                    \"activation\": \"Passive\",\n                    \"cost\": \"0\",\n                    \"rangeAndTarget\": \"Self\",\n                    \"duration\": \"Daily preparation\",\n                    \"frequency\": \"Always\",\n                    \"effect\": \"Floating Preparation. Tags: arch, passive, matrix. Increase your maximum prepared Spell Matrix count by 1. The extra matrix can come from any school and obeys all ordinary spellbook and rank restrictions. It is a prepared matrix for every rule, including protected strain, duplicate-family tracking and Matrix Mastery modifications.\",\n                    \"source\": {\n                      \"extract\": \"docs/reference/Player_Rulebook_v6_source_text.txt\",\n                      \"line\": 5213,\n                      \"originalText\": \"Floating Preparation: Prepare 1 extra spell from any school each day\"\n                    },\n                    \"designStatus\": \"provisional-playtest\",\n                    \"spellRank\": null\n                  },\n                  {\n                    \"id\": \"wizard.arch.arcane-lock\",\n                    \"name\": \"Arcane Lock\",\n                    \"className\": \"Wizard\",\n                    \"band\": \"Arch\",\n                    \"path\": null,\n                    \"sourceKind\": \"active\",\n                    \"minimumClassLevel\": 3,\n                    \"acquisition\": \"selection\",\n                    \"activation\": \"Action\",\n                    \"cost\": \"2 RP\",\n                    \"rangeAndTarget\": \"One door, chest, portal or unattended object within touch\",\n                    \"duration\": \"8 hours\",\n                    \"frequency\": \"Recharge 2 rounds\",\n                    \"effect\": \"Arcane Lock. Tags: arch, active, wizard-spell, abjuration. Magically seal the target. Opening it without your permission requires a Strength check or thieves'/arcane-tool check against your Wizard spell DC. Dispel Magic can end the lock. You can designate up to M creatures who can bypass it. This does not make the object physically indestructible.\",\n                    \"source\": {\n                      \"extract\": \"docs/reference/Player_Rulebook_v6_source_text.txt\",\n                      \"line\": 5223,\n                      \"originalText\": \"Arcane Lock: Create a magical barrier that prevents entry or access to an object or area.\"\n                    },\n                    \"designStatus\": \"provisional-playtest\",\n                    \"spellRank\": 2\n                  }\n                ]\n              },\n              {\n                \"classLevel\": 4,\n                \"cards\": [\n                  {\n                    \"id\": \"wizard.base.scholarly-mind\",\n                    \"name\": \"Scholarly Mind\",\n                    \"className\": \"Wizard\",\n                    \"band\": \"Base\",\n                    \"path\": null,\n                    \"sourceKind\": \"passive\",\n                    \"minimumClassLevel\": 1,\n                    \"acquisition\": \"selection\",\n                    \"activation\": \"Passive\",\n                    \"cost\": \"0\",\n                    \"rangeAndTarget\": \"Self\",\n                    \"duration\": \"Permanent\",\n                    \"frequency\": \"Always\",\n                    \"effect\": \"Scholarly Mind. Tags: base, passive, knowledge. You have advantage on Intelligence checks whose primary purpose is recalling, researching or analyzing arcane theory, magical history, planar magical principles or constructed spell formulae. It does not grant advantage on spell attacks, Counterspell checks or general Investigation unrelated to arcane scholarship.\",\n                    \"source\": {\n                      \"extract\": \"docs/reference/Player_Rulebook_v6_source_text.txt\",\n                      \"line\": 5200,\n                      \"originalText\": \"Scholarly Mind: Gain advantage on Intelligence checks related to arcane knowledge.\"\n                    },\n                    \"designStatus\": \"provisional-playtest\",\n                    \"spellRank\": null\n                  }\n                ]\n              },\n              {\n                \"classLevel\": 5,\n                \"cards\": [\n                  {\n                    \"id\": \"wizard.arch.dispel-magic\",\n                    \"name\": \"Dispel Magic\",\n                    \"className\": \"Wizard\",\n                    \"band\": \"Arch\",\n                    \"path\": null,\n                    \"sourceKind\": \"active\",\n                    \"minimumClassLevel\": 5,\n                    \"acquisition\": \"selection\",\n                    \"activation\": \"Action\",\n                    \"cost\": \"3 RP\",\n                    \"rangeAndTarget\": \"One creature, object or magical effect within 60 feet\",\n                    \"duration\": \"Instantaneous\",\n                    \"frequency\": \"Recharge 2 rounds\",\n                    \"effect\": \"Dispel Magic. Tags: arch, active, wizard-spell, abjuration. Choose one ongoing spell effect you can perceive. If its rank is 3 or lower, end it. If it is rank 4 or higher, make an Intelligence check adding proficiency against DC 10 + spell rank; success ends it. Permanent artifact properties and effects explicitly immune to dispelling are unaffected.\",\n                    \"source\": {\n                      \"extract\": \"docs/reference/Player_Rulebook_v6_source_text.txt\",\n                      \"line\": 5224,\n                      \"originalText\": \"Dispel Magic: End magical effects in an area or on a target.\"\n                    },\n                    \"designStatus\": \"provisional-playtest\",\n                    \"spellRank\": 3\n                  }\n                ]\n              },\n              {\n                \"classLevel\": 6,\n                \"cards\": [\n                  {\n                    \"id\": \"wizard.arch.arcane-sight\",\n                    \"name\": \"Arcane Sight\",\n                    \"className\": \"Wizard\",\n                    \"band\": \"Arch\",\n                    \"path\": null,\n                    \"sourceKind\": \"active\",\n                    \"minimumClassLevel\": 3,\n                    \"acquisition\": \"selection\",\n                    \"activation\": \"Action\",\n                    \"cost\": \"2 RP\",\n                    \"rangeAndTarget\": \"Self; 60-foot sight\",\n                    \"duration\": \"Concentration, maximum 10 minutes\",\n                    \"frequency\": \"Recharge 2 rounds\",\n                    \"effect\": \"Arcane Sight. Tags: arch, active, wizard-spell, divination, concentration. While active you perceive magical auras within 60 feet and automatically know each visible aura's school or broad magical category. As an Action on a later turn, examine one aura to learn whether it is concentrated, summoned, cursed, warded or linked to another visible magical effect. Total cover blocks sight.\",\n                    \"source\": {\n                      \"extract\": \"docs/reference/Player_Rulebook_v6_source_text.txt\",\n                      \"line\": 5226,\n                      \"originalText\": \"Arcane Sight: See magical auras and effects for a short duration.\"\n                    },\n                    \"designStatus\": \"provisional-playtest\",\n                    \"spellRank\": 2\n                  }\n                ]\n              },\n              {\n                \"classLevel\": 7,\n                \"cards\": [\n                  {\n                    \"id\": \"wizard.arch.dimensional-pocket\",\n                    \"name\": \"Dimensional Pocket\",\n                    \"className\": \"Wizard\",\n                    \"band\": \"Arch\",\n                    \"path\": null,\n                    \"sourceKind\": \"active\",\n                    \"minimumClassLevel\": 7,\n                    \"acquisition\": \"selection\",\n                    \"activation\": \"Ritual\",\n                    \"cost\": \"3 RP\",\n                    \"rangeAndTarget\": \"One point within 5 feet\",\n                    \"duration\": \"8 hours\",\n                    \"frequency\": \"1/long rest\",\n                    \"effect\": \"Dimensional Pocket. Tags: arch, active, wizard-spell, conjuration, ritual. Create an extradimensional storage space holding up to 100 pounds or 10 cubic feet of unattended nonliving material. Retrieving or placing an item while adjacent to the opening uses an object interaction. Living creatures cannot enter. When duration ends, remaining contents appear harmlessly in the nearest unoccupied space.\",\n                    \"source\": {\n                      \"extract\": \"docs/reference/Player_Rulebook_v6_source_text.txt\",\n                      \"line\": 5225,\n                      \"originalText\": \"Dimensional Pocket: Create a small extradimensional space to store items.\"\n                    },\n                    \"designStatus\": \"provisional-playtest\",\n                    \"spellRank\": 4\n                  }\n                ]\n              },\n              {\n                \"classLevel\": 8,\n                \"cards\": [\n                  {\n                    \"id\": \"wizard.base.analyze-magic\",\n                    \"name\": \"Analyze Magic\",\n                    \"className\": \"Wizard\",\n                    \"band\": \"Base\",\n                    \"path\": null,\n                    \"sourceKind\": \"active\",\n                    \"minimumClassLevel\": 1,\n                    \"acquisition\": \"selection\",\n                    \"activation\": \"Action\",\n                    \"cost\": \"1 RP\",\n                    \"rangeAndTarget\": \"One magical creature, object or effect within 30 feet\",\n                    \"duration\": \"Instantaneous\",\n                    \"frequency\": \"Recharge 1 round\",\n                    \"effect\": \"Analyze Magic. Tags: base, active, wizard-spell, divination, knowledge. Make an Intelligence (Arcana) check against DC 10 + the effect's spell rank, treating a non-spell effect's Director-assigned tier as rank. On success learn its school or magical category, one active mechanical property and whether it is currently sustained, cursed or bound to another effect. Failure reveals only that magic is present.\",\n                    \"source\": {\n                      \"extract\": \"docs/reference/Player_Rulebook_v6_source_text.txt\",\n                      \"line\": 5206,\n                      \"originalText\": \"Analyze Magic: Study a magical effect or item to gain insight into its properties and function.\"\n                    },\n                    \"designStatus\": \"provisional-playtest\",\n                    \"spellRank\": 1\n                  }\n                ]\n              },\n              {\n                \"classLevel\": 9,\n                \"cards\": [\n                  {\n                    \"id\": \"wizard.arch.sigil-rewrite\",\n                    \"name\": \"Sigil Rewrite\",\n                    \"className\": \"Wizard\",\n                    \"band\": \"Arch\",\n                    \"path\": null,\n                    \"sourceKind\": \"passive\",\n                    \"minimumClassLevel\": 3,\n                    \"acquisition\": \"selection\",\n                    \"activation\": \"Bonus Action\",\n                    \"cost\": \"0\",\n                    \"rangeAndTarget\": \"Self and spellbook\",\n                    \"duration\": \"Instantaneous\",\n                    \"frequency\": \"1/long rest\",\n                    \"effect\": \"Sigil Rewrite. Tags: arch, passive-upgrade, matrix. Replace one prepared matrix with a different spell from your spellbook of exactly the same rank without performing the normal 10-minute ritual. The replacement receives no special Dissonance reset for a matrix family already used this encounter and must obey current Wizard rank eligibility.\",\n                    \"source\": {\n                      \"extract\": \"docs/reference/Player_Rulebook_v6_source_text.txt\",\n                      \"line\": 5214,\n                      \"originalText\": \"Sigil Rewrite: Once/day, instantly swap a spell you know for another of the same tier\"\n                    },\n                    \"designStatus\": \"provisional-playtest\",\n                    \"spellRank\": null\n                  }\n                ]\n              },\n              {\n                \"classLevel\": 10,\n                \"cards\": [\n                  {\n                    \"id\": \"wizard.hero.spellbinder.spell-preservation\",\n                    \"name\": \"Spell Preservation\",\n                    \"className\": \"Wizard\",\n                    \"band\": \"Hero\",\n                    \"path\": \"Spellbinder\",\n                    \"sourceKind\": \"passive\",\n                    \"minimumClassLevel\": 10,\n                    \"acquisition\": \"selection\",\n                    \"activation\": \"Passive\",\n                    \"cost\": \"0\",\n                    \"rangeAndTarget\": \"Your spellbook\",\n                    \"duration\": \"Permanent\",\n                    \"frequency\": \"Always\",\n                    \"effect\": \"Spell Preservation. Tags: hero, spellbinder, passive, spellbook. Your primary spellbook cannot be destroyed, erased or rendered permanently unreadable by non-artifact mundane or magical means. It can still be stolen, hidden, transported, suppressed, sealed by an artifact-level effect or voluntarily abandoned. Copies and backup books do not automatically receive this protection.\",\n                    \"source\": {\n                      \"extract\": \"docs/reference/Player_Rulebook_v6_source_text.txt\",\n                      \"line\": 5243,\n                      \"originalText\": \"Spell Preservation: Your spellbook cannot be destroyed by non-artifact means.\"\n                    },\n                    \"designStatus\": \"provisional-playtest\",\n                    \"spellRank\": null\n                  },\n                  {\n                    \"id\": \"wizard.hero.spellbinder.seal-magic\",\n                    \"name\": \"Seal Magic\",\n                    \"className\": \"Wizard\",\n                    \"band\": \"Hero\",\n                    \"path\": \"Spellbinder\",\n                    \"sourceKind\": \"active\",\n                    \"minimumClassLevel\": 10,\n                    \"acquisition\": \"selection\",\n                    \"activation\": \"Action\",\n                    \"cost\": \"4 RP\",\n                    \"rangeAndTarget\": \"One creature within 60 feet\",\n                    \"duration\": \"Maximum 3 rounds\",\n                    \"frequency\": \"Recharge 3 rounds\",\n                    \"effect\": \"Seal Magic. Tags: hero, spellbinder, wizard-spell, control. Choose one of the eight schools and target one creature. It makes a Wisdom save. On failure it cannot cast spells of the chosen school. At the end of each of its turns it repeats the save, ending the Seal on success. The effect ends automatically after 3 rounds and never prevents non-spell class techniques merely because they are magical.\",\n                    \"source\": {\n                      \"extract\": \"docs/reference/Player_Rulebook_v6_source_text.txt\",\n                      \"line\": 5249,\n                      \"originalText\": \"Seal Magic: Prevent a target from casting spells of a specific school (WIS save, 3 rounds)\"\n                    },\n                    \"designStatus\": \"provisional-playtest\",\n                    \"spellRank\": 5\n                  }\n                ]\n              },\n              {\n                \"classLevel\": 11,\n                \"cards\": [\n                  {\n                    \"id\": \"wizard.base.arcane-shield\",\n                    \"name\": \"Arcane Shield\",\n                    \"className\": \"Wizard\",\n                    \"band\": \"Base\",\n                    \"path\": null,\n                    \"sourceKind\": \"active\",\n                    \"minimumClassLevel\": 1,\n                    \"acquisition\": \"selection\",\n                    \"activation\": \"Reaction\",\n                    \"cost\": \"2 RP\",\n                    \"rangeAndTarget\": \"Self\",\n                    \"duration\": \"Until start of your next regular turn\",\n                    \"frequency\": \"Recharge 2 rounds\",\n                    \"effect\": \"Arcane Shield. Tags: base, active, wizard-spell, abjuration, protection. Trigger when an attack roll would hit you. Gain +2 AC against the triggering attack and until the start of your next regular turn, potentially causing the attack to miss. Temporary AC from another Arcane Shield does not stack.\",\n                    \"source\": {\n                      \"extract\": \"docs/reference/Player_Rulebook_v6_source_text.txt\",\n                      \"line\": 5205,\n                      \"originalText\": \"Arcane Shield: Create a barrier of magical force that provides temporary protection.\"\n                    },\n                    \"designStatus\": \"provisional-playtest\",\n                    \"spellRank\": 1\n                  }\n                ]\n              },\n              {\n                \"classLevel\": 12,\n                \"cards\": [\n                  {\n                    \"id\": \"wizard.hero.spellbinder.counterpulse\",\n                    \"name\": \"Counterpulse\",\n                    \"className\": \"Wizard\",\n                    \"band\": \"Hero\",\n                    \"path\": \"Spellbinder\",\n                    \"sourceKind\": \"active\",\n                    \"minimumClassLevel\": 12,\n                    \"acquisition\": \"selection\",\n                    \"activation\": \"Triggered\",\n                    \"cost\": \"1 RP\",\n                    \"rangeAndTarget\": \"Caster whose spell you successfully Counterspelled\",\n                    \"duration\": \"Until end of target's next turn\",\n                    \"frequency\": \"At most once per round\",\n                    \"effect\": \"Counterpulse. Tags: hero, spellbinder, counter, control. Immediately after your Counterspell succeeds, spend 1 RP. The countered caster is Silenced until the end of its next turn. This is part of the successful counter event rather than another spell cast and cannot trigger another Counterpulse.\",\n                    \"source\": {\n                      \"extract\": \"docs/reference/Player_Rulebook_v6_source_text.txt\",\n                      \"line\": 5251,\n                      \"originalText\": \"Counterpulse: Countering a spell silences the caster for 1 round\"\n                    },\n                    \"designStatus\": \"provisional-playtest\",\n                    \"spellRank\": null\n                  }\n                ]\n              },\n              {\n                \"classLevel\": 13,\n                \"cards\": [\n                  {\n                    \"id\": \"wizard.base.spellbook-study\",\n                    \"name\": \"Spellbook Study\",\n                    \"className\": \"Wizard\",\n                    \"band\": \"Base\",\n                    \"path\": null,\n                    \"sourceKind\": \"active\",\n                    \"minimumClassLevel\": 1,\n                    \"acquisition\": \"selection\",\n                    \"activation\": \"Ritual\",\n                    \"cost\": \"0 RP\",\n                    \"rangeAndTarget\": \"Self and spellbook\",\n                    \"duration\": \"10 minutes\",\n                    \"frequency\": \"1/long rest\",\n                    \"effect\": \"Spellbook Study. Tags: base, active, matrix, ritual. Replace one currently prepared matrix with one legal spell recorded in your spellbook. The replacement must be within your Wizard rank limit. This is the normal midday substitution permission; it does not alter the spellbook, create another prepared-matrix position or reset first-cast/Refrain history for an underlying matrix family already cast this encounter.\",\n                    \"source\": {\n                      \"extract\": \"docs/reference/Player_Rulebook_v6_source_text.txt\",\n                      \"line\": 5207,\n                      \"originalText\": \"Spellbook Study: Spend time studying your spellbook to prepare a different selection of spells.\"\n                    },\n                    \"designStatus\": \"provisional-playtest\",\n                    \"spellRank\": null\n                  }\n                ]\n              }\n            ],\n            \"automaticCards\": [\n              {\n                \"id\": \"wizard.arch.arcane-tradition\",\n                \"name\": \"Arcane Tradition\",\n                \"className\": \"Wizard\",\n                \"band\": \"Arch\",\n                \"path\": null,\n                \"sourceKind\": \"passive\",\n                \"minimumClassLevel\": 3,\n                \"acquisition\": \"automatic\",\n                \"activation\": \"Passive\",\n                \"cost\": \"0\",\n                \"rangeAndTarget\": \"Your level-1 Arcane School\",\n                \"duration\": \"Permanent\",\n                \"frequency\": \"Automatic at Wizard 3; not a selection\",\n                \"effect\": \"Arcane Tradition. Tags: arch, school, automatic. Your level-1 Arcane School becomes your Arcanist tradition; do not choose a second school. Prepare one additional matrix from that same school each day without counting it against your normal prepared-matrix maximum. It otherwise obeys all ordinary rank, spellbook, Dissonance and duplicate-family rules.\",\n                \"source\": {\n                  \"extract\": \"docs/reference/Player_Rulebook_v6_source_text.txt\",\n                  \"line\": 5217,\n                  \"originalText\": \"Arcane Tradition: Choose a school of magic to specialize in, gaining bonuses to spells of that school.\"\n                },\n                \"designStatus\": \"provisional-playtest\",\n                \"spellRank\": null\n              },\n              {\n                \"id\": \"wizard.base.counterspell\",\n                \"name\": \"Counterspell\",\n                \"className\": \"Wizard\",\n                \"band\": \"Base\",\n                \"path\": null,\n                \"sourceKind\": \"active\",\n                \"minimumClassLevel\": 2,\n                \"acquisition\": \"automatic\",\n                \"activation\": \"Reaction\",\n                \"cost\": \"3 RP\",\n                \"rangeAndTarget\": \"One creature you perceive casting a spell within 60 feet\",\n                \"duration\": \"Instantaneous\",\n                \"frequency\": \"Automatic at Wizard 2; recharge 2 rounds\",\n                \"effect\": \"Counterspell. Tags: arch-source, automatic, wizard-spell, abjuration, disruption. Trigger when a creature begins casting a spell. Make an Intelligence check adding proficiency against DC 10 + twice the spell's rank, treating rank 0 as 0. Success negates the triggering spell after its costs are paid; failure lets it resolve. This is gained automatically at Wizard 2 and is never also selected from the Arch pool.\",\n                \"source\": {\n                  \"extract\": \"docs/reference/Player_Rulebook_v6_source_text.txt\",\n                  \"line\": 5222,\n                  \"originalText\": \"Counterspell: Disrupt an enemy's spellcasting, potentially negating their spell entirely.\"\n                },\n                \"designStatus\": \"provisional-playtest\",\n                \"spellRank\": 1\n              },\n              {\n                \"id\": \"wizard.supplement.ritual-casting\",\n                \"name\": \"Ritual Casting\",\n                \"className\": \"Wizard\",\n                \"band\": \"Base\",\n                \"path\": null,\n                \"sourceKind\": \"supplement\",\n                \"minimumClassLevel\": 2,\n                \"acquisition\": \"automatic\",\n                \"activation\": \"Ritual\",\n                \"cost\": \"0 RP unless the individual ritual explicitly states otherwise\",\n                \"rangeAndTarget\": \"As the ritual spell\",\n                \"duration\": \"As the ritual spell\",\n                \"frequency\": \"At will outside encounters with sufficient time\",\n                \"effect\": \"Source progression line 5184. Cast a Wizard spell bearing the Ritual tag directly from your spellbook without preparing it. Increase its casting time by at least 10 minutes. Ritual Casting cannot be completed during an encounter, does not use an ordinary prepared-matrix position and does not generate or vent normal casting Dissonance.\",\n                \"prerequisite\": \"See class engine and progression.\",\n                \"source\": {\n                  \"line\": 5184,\n                  \"reference\": null,\n                  \"originalText\": \"| 2 | Counterspell Reaction, Ritual Casting |\",\n                  \"status\": \"source-derived\"\n                },\n                \"designStatus\": \"provisional-playtest\",\n                \"spellRank\": null\n              },\n              {\n                \"id\": \"wizard.supplement.school-mastery\",\n                \"name\": \"School Mastery\",\n                \"className\": \"Wizard\",\n                \"band\": \"Arch\",\n                \"path\": null,\n                \"sourceKind\": \"supplement\",\n                \"minimumClassLevel\": 5,\n                \"acquisition\": \"automatic\",\n                \"activation\": \"Passive\",\n                \"cost\": \"0\",\n                \"rangeAndTarget\": \"Your level-1 Arcane School\",\n                \"duration\": \"Permanent\",\n                \"frequency\": \"Automatic at Wizard 5\",\n                \"effect\": \"Source progression line 5186. This is the one School Mastery progression grant, not a second school choice or duplicate feat. Increase the level-1 Arcane School spell-attack and spell-save bonus from +1 to +2 total. Its school passive and bonus-spell rules otherwise remain unchanged.\",\n                \"prerequisite\": \"See class engine and progression.\",\n                \"source\": {\n                  \"line\": 5186,\n                  \"reference\": null,\n                  \"originalText\": \"| 5 | Bonus Feat: School Mastery |\",\n                  \"status\": \"source-derived\"\n                },\n                \"designStatus\": \"provisional-playtest\",\n                \"spellRank\": null\n              },\n              {\n                \"id\": \"wizard.supplement.arcane-ward\",\n                \"name\": \"Arcane Ward\",\n                \"className\": \"Wizard\",\n                \"band\": \"Arch\",\n                \"path\": null,\n                \"sourceKind\": \"supplement\",\n                \"minimumClassLevel\": 6,\n                \"acquisition\": \"automatic\",\n                \"activation\": \"Passive\",\n                \"cost\": \"0\",\n                \"rangeAndTarget\": \"Self\",\n                \"duration\": \"Until next long rest\",\n                \"frequency\": \"Choose after each long rest\",\n                \"effect\": \"Source progression line 5187. After preparing spells, choose one of acid, cold, fire, force, lightning, necrotic, psychic, radiant or thunder that is dealt by at least one prepared spell of your Arcane School. Gain resistance to that damage type until your next long rest. If none of your prepared school spells deals a damage type, choose force. This is provisional completion of the source's ambiguous 'chosen school's element' wording.\",\n                \"prerequisite\": \"See class engine and progression.\",\n                \"source\": {\n                  \"line\": 5187,\n                  \"reference\": null,\n                  \"originalText\": \"| 6 | Arcane Ward (resistance to chosen school's element) |\",\n                  \"status\": \"source-derived\"\n                },\n                \"designStatus\": \"provisional-playtest\",\n                \"spellRank\": null\n              },\n              {\n                \"id\": \"wizard.supplement.dual-cast\",\n                \"name\": \"Dual Cast\",\n                \"className\": \"Wizard\",\n                \"band\": \"Arch\",\n                \"path\": null,\n                \"sourceKind\": \"supplement\",\n                \"minimumClassLevel\": 9,\n                \"acquisition\": \"automatic\",\n                \"activation\": \"Action\",\n                \"cost\": \"Pay the complete RP costs of both spells\",\n                \"rangeAndTarget\": \"As each spell\",\n                \"duration\": \"As each spell\",\n                \"frequency\": \"1/short rest\",\n                \"effect\": \"Source progression line 5188. Choose two DIFFERENT prepared Wizard spells of rank 1 or 2, neither of which summons a creature or grants an additional Action. Cast both sequentially as one Action, paying both RP costs. They cannot both require concentration. Each matrix separately updates first-cast/Refrain history. Features that trigger merely from 'casting a spell' may trigger once for each actual matrix unless that feature itself says once per turn; no trigger may create another Dual Cast or additional full Action.\",\n                \"prerequisite\": \"See class engine and progression.\",\n                \"source\": {\n                  \"line\": 5188,\n                  \"reference\": null,\n                  \"originalText\": \"| 9 | Dual Cast (cast 2 Tier 1–2 spells in a round) |\",\n                  \"status\": \"source-derived\"\n                },\n                \"designStatus\": \"provisional-playtest\",\n                \"spellRank\": null\n              },\n              {\n                \"id\": \"wizard.supplement.overchannel\",\n                \"name\": \"Overchannel\",\n                \"className\": \"Wizard\",\n                \"band\": \"Hero\",\n                \"path\": null,\n                \"sourceKind\": \"supplement\",\n                \"minimumClassLevel\": 13,\n                \"acquisition\": \"automatic\",\n                \"activation\": \"Triggered\",\n                \"cost\": \"Pay the Core V 2 RP cost for one rank above the spell's normal cast rank\",\n                \"rangeAndTarget\": \"One prepared spell you are beginning to cast\",\n                \"duration\": \"For that cast\",\n                \"frequency\": \"1/long rest\",\n                \"effect\": \"Source progression line 5190. Cast one prepared spell as though it were one rank higher than the highest rank at which you could normally cast that SAME spell, provided the spell has an explicit higher-rank scaling rule. Overchannel does not teach or prepare a higher-rank spell, cannot exceed effective rank 9 and cannot be combined with another generic Overcast rule during this pilot. All normal Dissonance/Refrain rules still apply.\",\n                \"prerequisite\": \"See class engine and progression.\",\n                \"source\": {\n                  \"line\": 5190,\n                  \"reference\": null,\n                  \"originalText\": \"| 13 | Overchannel (cast a spell 1 tier higher once/day) |\",\n                  \"status\": \"source-derived\"\n                },\n                \"designStatus\": \"provisional-playtest\",\n                \"spellRank\": null\n              }\n            ],\n            \"completeEngine\": [\n              \"PROVISIONAL PLAYTEST CONTRACT. Intelligence is the Wizard class ability. S = 1/2/3/4 at Wizard levels 1/5/11/17. M = max(1, Intelligence modifier). Wizard spell attack = d20 + normal character proficiency bonus + Intelligence modifier. Wizard spell save DC = 8 + normal character proficiency bonus + Intelligence modifier.\",\n              \"The Wizard remains three distinct stages: Base Wizard at levels 1-2, Arch Arcanist at levels 3-9, and one Hero path at levels 10-20: Spellbinder, Elementalist or Necromancer. Hero paths are not additional starting classes and their features cannot be selected before their Wizard class-level gates.\",\n              \"SPELLBOOK. At Wizard 1 your spellbook contains six chosen rank-1 Wizard spells. Arcane School Specialization also adds one legal rank-1 bonus spell of your chosen school without replacing one of those six. For this provisional progression, add 2 legal Wizard spells to the book at each Wizard level 2-4, 3 at each level 5-8, 4 at each level 9-12, 5 at each level 13-16 and 6 at each level 17-20. Level-up additions cost no money or scribing time.\",\n              \"LEGAL RANKS. Maximum Wizard spell rank by Wizard class level is: rank 1 at levels 1-2, rank 2 at 3-4, rank 3 at 5-6, rank 4 at 7-8, rank 5 at 9-10, rank 6 at 11-12, rank 7 at 13-14, rank 8 at 15-16 and rank 9 at 17-20. Grand Tier at level 20 is a special casting permission, not a tenth ordinary rank. A Wizard may learn Wizard-list spells from any school up to the legal rank unless a spell itself has an additional prerequisite.\",\n              \"PREPARED SPELL MATRIX. After a long rest, prepare a number of matrices equal to Wizard level + Intelligence modifier, minimum 1, selecting only spells currently recorded in your spellbook and within your legal rank. You cast ordinary Wizard spells only from prepared matrices unless a feature explicitly overrides that restriction. Preparing the full daily matrix set normally requires 1 hour of spellbook study. Matrix Efficiency reduces this to 45 minutes.\",\n              \"DUPLICATE PREPARATION. You may prepare the same spell more than once, primarily to carry different Matrix Mastery configurations. Duplicate copies never create additional first-cast Dissonance exemptions. For Refrain and the protected strain rule, all prepared copies sharing the same underlying spell name belong to one matrix family regardless of modification.\",\n              \"MIDDAY SUBSTITUTION. Once between long rests, you may perform a 10-minute Spellbook Study ritual to replace one prepared matrix with another legal spell from your spellbook. The replacement cannot exceed your legal Wizard rank. Sigil Rewrite and Matrix Mastery may improve this process as explicitly stated.\",\n              \"SPELL ACQUISITION BY SCRIBING. A found Wizard spell may be copied into the spellbook if its rank is legal for you. Baseline scribing requires 2 hours and 50 gp of inks/materials per spell rank, treating rank 0 as 1 for this calculation. Spell Scribing halves both values to 1 hour and 25 gp per rank. Failure to finish the work consumes no spellbook entry but materials already expended during an interrupted hour are lost.\",\n              \"SPELLBOOK LOSS. Losing the spellbook does not erase matrices currently prepared in memory; you may continue casting those prepared matrices until you next rebuild or change preparation. A blank replacement book can be seeded with your currently prepared spells at 1 hour and 25 gp per effective spell rank each. An unprepared spell you previously recorded can be reconstructed from memory with 8 hours, 100 gp per rank and an Intelligence (Arcana) check against DC 10 + spell rank. Failure consumes that attempt's time and half its materials; another attempt can be made after a long rest. Recovering the original book automatically restores access to its surviving entries.\",\n              \"ARCANE SCHOOL SPECIALIZATION is automatic at Wizard 1. Choose exactly one of the eight schools. Your spell attacks with that school gain +1 and your Wizard save DC for that school's spells gains +1. You also add one legal rank-1 spell of that school to the spellbook. The source table explicitly supplies seven school passives; the eighth core school, Abjuration, is named elsewhere but its passive row is missing. Its provisional playtest passive is identified below rather than silently presented as recovered text.\",\n              \"ABJURATION, provisional completion for the omitted eighth row: once per round after you cast an Abjuration spell, gain temporary HP equal to PB until the start of your next regular turn. CONJURATION: creatures summoned by your Wizard spells gain +1 maximum HP per Wizard level. DIVINATION: once per long rest reroll one failed saving throw and use the new result. ENCHANTMENT: when a creature fails its initial save against one of your Enchantment spells, a printed control duration of at least 1 round may last one additional round, but every normally allowed repeat save still occurs. EVOCATION: when casting an area Evocation spell, exclude one creature from its initial damaging area; that creature automatically succeeds and takes no damage if success normally halves damage. ILLUSION: gain +2 on concentration saves made to maintain Illusion spells. NECROMANCY: once per turn during a real encounter when a hostile non-summoned creature dies from your Necromancy spell, gain 1 temporary HP; it is not permanent healing. TRANSMUTATION: after casting a Transmutation spell, gain +5 feet Speed until the end of that turn.\",\n              \"PROTECTED DISSONANCE INTERFACE. The first cast of each different prepared matrix family during an encounter generates 0 BASE Dissonance. This exemption affects only base strain. Refrain and explicitly printed strain costs still apply; the suite disables generic Overcast and does not layer historical Burn onto Dissonance. Repeating a matrix family follows normal Refrain immediately. Preparing duplicates or differently modified copies of the same underlying spell never refreshes the exemption.\",\n              \"Core Systems V 2 Resonance Points and spell-rank RP costs are authoritative for Wizard spellcasting. There are no historical spell slots in this pilot. Wizard cards tagged wizard-spell are always-prepared class matrices once acquired, do not consume a daily prepared-matrix position and use the same RP, concentration, Refrain and protected first-distinct-matrix rules as other Wizard spells. Their printed RP cost replaces any generic rank cost; never pay both.\",\n              \"RITUAL CASTING is automatic at Wizard 2. A Wizard spell in your spellbook with the Ritual tag can be cast from the book without being prepared by increasing its casting time by at least 10 minutes. A ritual cast costs 0 RP unless that ritual explicitly lists a consumed RP cost, cannot be used during an encounter and cannot generate or vent Dissonance through ordinary casting strain.\",\n              \"Only one concentration effect can normally be maintained. Starting a second concentration effect ends the first. Damage uses the current Core Systems concentration rule; required half-damage rounding is down for this pilot. Spell Tether and the level-17 Tethered Cast are the only Wizard-specific exceptions in this draft, and each has an explicit RP price, duration and one-tether cap.\",\n              \"MATRIX MASTERY MODIFICATIONS. After acquiring Matrix Mastery, each prepared ordinary spell matrix may carry at most one modification chosen during preparation. QUICK SUBSTITUTION: once per short rest, replace one matrix marked Quick Substitution with another spellbook spell of exactly the same rank using a 1-minute ritual instead of the normal 10-minute midday swap; the replacement loses the modification until the next long rest. COMPONENT ENHANCEMENT: when casting a damaging or healing matrix, spend 1 additional RP to add one extra die of the spell's primary damage or healing die to one roll; if the spell has no such die this modification has no effect. MATRIX LINKING: pair two different prepared matrix families during preparation; after legally casting one, the other costs 1 less RP, minimum 1, if cast before the end of your next regular turn, at most once per pair per round. STABILITY REINFORCEMENT: gain +2 on concentration saves caused by damage while maintaining that matrix. A matrix modification never creates another spell cast or proc event.\",\n              \"All sources share a maximum of one additional full Action per creature per round. Additional Actions cannot grant another additional Action, Bonus Action or Reaction. Spell copies, Matrix Sharing, Arcane Fusion, Dual Cast and similar effects pay all explicitly required RP and do not produce duplicate resource, cast-proc or action-grant chains beyond their written resolution.\",\n              \"Round recharge counters decrease once at the start of your regular initiative turn even if you cannot act. Extra Actions and extra turns do not tick recharge. Outside initiative, each uninterrupted 6 seconds counts as one tick. Only positive counters can be reset or shortened and each named ability can receive at most one reset or shortening per round.\",\n              \"SUMMON COMMAND LIMIT. All Wizard-controlled conjured, raised and bound companions share one damaging/control Companion Command per Wizard regular turn. Spend one Bonus Action to command exactly one such creature to move up to its Speed and use one damaging or control action from its stat block. Uncommanded creatures may reposition defensively and take Dodge but cannot deal damage or impose conditions. No summoned or raised creature can create XP, treasure, RP, Dissonance relief, additional corpses or kill-resource farms.\",\n              \"NECROMANCER STANDARD UNDEAD. Corpse Harvest and Auto-Raise share a maximum of three standard raised minions. Skeleton: AC 14, HP 6 + 2 × Wizard level, Speed 30; Bone Shot, range 30 feet, Wizard spell attack, 1d6+S necrotic. Zombie: AC 12, HP 10 + 3 × Wizard level, Speed 20; Slam, reach 5 feet, Wizard spell attack, 1d8+S necrotic. Goblin Thrall, available only from a goblinoid corpse: AC 13, HP 8 + 2 × Wizard level, Speed 30; Shiv, reach 5 feet, Wizard spell attack, 1d6+S necrotic. These are pre-Flesh-Ascendant statistics.\",\n              \"NECROMANCER AUTO-RAISE. Once per round when one of your standard undead minions personally lands the killing blow on an eligible humanoid and your standard-minion count is below three, its corpse rises at the end of the current turn as the same mechanical minion type that scored the kill, if physically possible. A new minion cannot act during that same round. Auto-Raise costs no Action or RP but can never exceed the three-minion cap or generate a new resource, corpse chain, XP or treasure event. Without Infernal Pact only humanoids qualify.\",\n              \"ELITE UNDEAD PETS. Necromancers may bind Boneflayer, Dreadblade and Wraithbound, at most one of each and three elite pets total. They use the same shared Companion Command limit as standard undead. Boneflayer: AC 14, HP 12 + 2 × Wizard level, Speed 30. Bone Shards: range 60, Wizard spell attack, 2d6+S necrotic. Fear Pulse replaces its attack: enemies within 10 feet make Wisdom saves; failure Frightened until end of next turn; recharge 3. Grave Miasma replaces its attack: 10-foot-radius point within 30 feet until start of your next turn; enemies entering or starting there take 1d6 necrotic once; recharge 3.\",\n              \"Dreadblade: AC 16, HP 16 + 3 × Wizard level, Speed 30. Disrupting Blade: reach 5 feet, Wizard spell attack, 1d8+S necrotic; a concentrating target immediately makes its concentration save with disadvantage. On a natural 20 the target is Weakened until the end of its next turn, taking -1 on attack rolls. Dreadblade has advantage on saves against forced movement.\",\n              \"Wraithbound: AC 14, HP 10 + 2 × Wizard level, Fly 40 and hover. While it has not attacked or imposed control since the end of its previous turn it is Invisible; attacking ends that state until the end of its next turn. Wraith Strike: reach 5 feet, Wizard spell attack, 1d8+S necrotic. On natural 20 the target makes a Constitution save against your Wizard DC; failure Stuns until the end of its next turn.\",\n              \"Flesh Ascendant's bonus applies after the listed base statistics: every undead creature you control gains +2 maximum HP per Wizard level. If at least two of your undead creatures are active, each gains +1 AC and +1 on saving throws. This does not increase the standard-minion or elite-pet caps.\",\n              \"DARK-TRAUMA INTERFACE. Necromancer features involving corpse desecration, infernal bargains, domination, body control or Mind Prison remain subject to the project's existing dark-content and trauma boundaries. A table may fade description to black without changing mechanics. No feature changes a player's real belief, permanently transfers ownership of a player character or silently retires a PC.\",\n              \"PROPOSED ACQUISITION. Wizard 1 automatically gains Arcane School Specialization, Spell Matrix System and the starting spellbook, then chooses 4 selectable Base cards, at least 2 Active. Wizard 2 automatically gains Counterspell and Ritual Casting, then chooses 2 additional selectable Base cards. Counterspell is not also placed in the Arch selection pool.\",\n              \"At Wizard 3 enter Arcanist, automatically gain Arcane Tradition as an upgrade of the SAME level-1 school rather than choosing another school, and choose 2 selectable Arch cards, at least 1 Active. Wizard 4 grants one eligible Base/Arch choice. Wizard 5 grants one Base/Arch choice plus automatic School Mastery. Wizard 6 grants one Base/Arch choice plus automatic Arcane Ward. Wizard 7 grants one eligible Arch choice. Wizard 8 grants one Base/Arch choice. Wizard 9 grants one eligible Arch choice plus automatic Dual Cast.\",\n              \"At Wizard 10 choose Spellbinder, Elementalist or Necromancer and gain 2 Hero cards from that path. ELEMENTALIST EXCEPTION: Elemental Affinity is automatic at path selection and counts as one of those two level-10 Hero acquisitions, so an Elementalist chooses only one additional Hero card at level 10. Levels 11, 13, 15, 17 and 19 each grant one eligible unselected Base/Arch choice. Levels 12, 14, 16 and 18 each grant one Hero-path choice. The chosen Final Theorem is automatic at Wizard 20. School Mastery, Counterspell, Arcane Tradition and all progression-table automatic features are never duplicated as selections.\",\n              \"All acquisition gates use Wizard class level rather than total character level. Normal proficiency bonus follows the game's ordinary total-character-level rule. A multiclass dip cannot unlock higher spell ranks, Arcanist cards, Hero cards, Final Theorems or progression-table features.\",\n              \"Class matrices tagged wizard-spell receive a rank in normalized card data equal to maximum ordinary Wizard rank at their minimum class-level gate (cap 9). Printed RP cost replaces generic rank cost. Counterspell is rank 1 at its explicit level 2 automatic grant. This explicit convention closes rank-dependent Counterspell/Dissonance interactions without inventing extra costs.\",\n              \"Cantrip completion: know 3 Wizard cantrips at 1, 4 at 4, 5 at 10, using the shared missing-repertoire fallback. Cantrips are known directly and do not consume prepared matrices. Always-prepared class matrices are additional cards, not extra arbitrary ordinary spells. Class spell ranks and the normalized activation field resolve incomplete source terminology.\"\n            ],\n            \"source\": {\n              \"path\": \"DescentReviewChanges/ReviewBible/data/public/class_playtests/wizard.json\",\n              \"pointers\": [\n                \"/engine\",\n                \"/schedule\",\n                \"/cards\",\n                \"/rpByClassLevel/12\"\n              ]\n            },\n            \"optionalChoicesInCases\": \"No Matrix Mastery, Spell Efficiency, Improved Concentration, Sigil Authority or Knowledge Shield acquired. Dual Cast, Overchannel, class Arcane Shield and optional Counterpulse are not invoked unless expressly declared. No Arcane Feedback at13.\",\n            \"creatureType\": \"Humanoid\",\n            \"profileScope\": \"An explicitly supplied finite class-built teaching creature profile using the complete actual class engine/cards. Not a newly rated bestiary creature, not authenticated campaign or ancestry acquisition, and not permission to fill an absent future profile.\",\n            \"languages\": [\n              \"Common\"\n            ],\n            \"otherIntrinsicDefenses\": [],\n            \"additionalSkillProficienciesClaimed\": [],\n            \"checks\": \"Use current ability modifier and actual acquired named card when applicable; save proficiency is not an ability-check proficiency. No Athletics proficiency is claimed.\",\n            \"actualActionsAvailable\": \"Each annotated actual regular START supplies the normal Action/BonusAction/Reaction/movement according to the real source; the event trace explicitly consumes each used budget. No extra action source is assumed.\",\n            \"asiHistory\": {\n              \"rolledINT\": 16,\n              \"class4\": \"INT+2 to18\",\n              \"class8\": \"STR+2 from8 to10\",\n              \"class12\": \"CHA+2 from8 to10\",\n              \"DEX\": 14,\n              \"CON\": 14,\n              \"WIS\": 12,\n              \"note\": \"Explicit legal generated-score/ASI fixture inputs; no extra feat is claimed.\"\n            }\n          }\n        },\n        \"initialState\": {\n          \"actors\": {\n            \"creator\": {\n              \"profile\": \"W13I\",\n              \"hp\": 80,\n              \"maxHp\": 80,\n              \"tempHp\": 0,\n              \"rp\": 48,\n              \"maxRp\": 48,\n              \"dissonance\": 0,\n              \"lastSpell\": null,\n              \"refrain\": 0,\n              \"preparedFamiliesUsed\": [],\n              \"position\": [\n                0,\n                0,\n                0\n              ],\n              \"alive\": true,\n              \"conscious\": true,\n              \"conditions\": [],\n              \"concentration\": null,\n              \"reaction\": true,\n              \"action\": true,\n              \"bonusAction\": true,\n              \"movementSpent\": 0,\n              \"regularStart\": 0,\n              \"nextRegularStart\": 6,\n              \"counterRecharge\": 0,\n              \"wounds\": 0,\n              \"critical\": false,\n              \"companionCommandUsed\": false,\n              \"companionOffenseUsed\": false\n            },\n            \"donor\": {\n              \"profile\": \"W13I\",\n              \"hp\": 0,\n              \"maxHp\": 80,\n              \"tempHp\": 0,\n              \"rp\": 48,\n              \"maxRp\": 48,\n              \"dissonance\": 0,\n              \"lastSpell\": null,\n              \"refrain\": 0,\n              \"preparedFamiliesUsed\": [],\n              \"position\": [\n                20,\n                0,\n                0\n              ],\n              \"alive\": true,\n              \"conscious\": false,\n              \"conditions\": [\n                \"Dying\",\n                \"Prone\"\n              ],\n              \"concentration\": null,\n              \"reaction\": true,\n              \"action\": true,\n              \"bonusAction\": true,\n              \"movementSpent\": 0,\n              \"regularStart\": 0,\n              \"nextRegularStart\": 6,\n              \"counterRecharge\": 0,\n              \"wounds\": 0,\n              \"critical\": false,\n              \"companionCommandUsed\": false,\n              \"companionOffenseUsed\": false,\n              \"deathSuccesses\": 1,\n              \"deathFailures\": 1,\n              \"stable\": false\n            }\n          },\n          \"applications\": {},\n          \"objects\": {\n            \"oldDuplicate\": {\n              \"id\": \"prior-live\",\n              \"hp\": 30,\n              \"rp\": 5,\n              \"state\": \"active\",\n              \"position\": [\n                10,\n                0,\n                0\n              ]\n            }\n          },\n          \"privateMemories\": {},\n          \"sourceLedger\": {\n            \"oldCapOwner\": \"creator\"\n          },\n          \"note\": \"Complete stated finite fixture state; unspecified optional reactions are declined. No actual encounter runtime is asserted.\"\n        },\n        \"timeline\": [\n          {\n            \"timeSeconds\": 0.2,\n            \"event\": \"Actual paid Simulacrum, donor fails CHA\",\n            \"source\": [],\n            \"rng\": {\n              \"donorCHA\": [\n                8,\n                0,\n                8\n              ],\n              \"DC\": 19\n            },\n            \"explanation\": \"Unconscious from actual0HP does not auto-fail CHA; roll8fails19. Oldlivebodyremainsat10; prospectivearrival30isclear. This is a realunwillingadmission, not revivedconsent.\",\n            \"before\": {\n              \"actors\": {\n                \"creator\": {\n                  \"profile\": \"W13I\",\n                  \"hp\": 80,\n                  \"maxHp\": 80,\n                  \"tempHp\": 0,\n                  \"rp\": 48,\n                  \"maxRp\": 48,\n                  \"dissonance\": 0,\n                  \"lastSpell\": null,\n                  \"refrain\": 0,\n                  \"preparedFamiliesUsed\": [],\n                  \"position\": [\n                    0,\n                    0,\n                    0\n                  ],\n                  \"alive\": true,\n                  \"conscious\": true,\n                  \"conditions\": [],\n                  \"concentration\": null,\n                  \"reaction\": true,\n                  \"action\": true,\n                  \"bonusAction\": true,\n                  \"movementSpent\": 0,\n                  \"regularStart\": 0,\n                  \"nextRegularStart\": 6,\n                  \"counterRecharge\": 0,\n                  \"wounds\": 0,\n                  \"critical\": false,\n                  \"companionCommandUsed\": false,\n                  \"companionOffenseUsed\": false\n                },\n                \"donor\": {\n                  \"profile\": \"W13I\",\n                  \"hp\": 0,\n                  \"maxHp\": 80,\n                  \"tempHp\": 0,\n                  \"rp\": 48,\n                  \"maxRp\": 48,\n                  \"dissonance\": 0,\n                  \"lastSpell\": null,\n                  \"refrain\": 0,\n                  \"preparedFamiliesUsed\": [],\n                  \"position\": [\n                    20,\n                    0,\n                    0\n                  ],\n                  \"alive\": true,\n                  \"conscious\": false,\n                  \"conditions\": [\n                    \"Dying\",\n                    \"Prone\"\n                  ],\n                  \"concentration\": null,\n                  \"reaction\": true,\n                  \"action\": true,\n                  \"bonusAction\": true,\n                  \"movementSpent\": 0,\n                  \"regularStart\": 0,\n                  \"nextRegularStart\": 6,\n                  \"counterRecharge\": 0,\n                  \"wounds\": 0,\n                  \"critical\": false,\n                  \"companionCommandUsed\": false,\n                  \"companionOffenseUsed\": false,\n                  \"deathSuccesses\": 1,\n                  \"deathFailures\": 1,\n                  \"stable\": false\n                }\n              },\n              \"applications\": {},\n              \"objects\": {\n                \"oldDuplicate\": {\n                  \"id\": \"prior-live\",\n                  \"hp\": 30,\n                  \"rp\": 5,\n                  \"state\": \"active\",\n                  \"position\": [\n                    10,\n                    0,\n                    0\n                  ]\n                }\n              },\n              \"privateMemories\": {},\n              \"sourceLedger\": {\n                \"oldCapOwner\": \"creator\"\n              },\n              \"note\": \"Complete stated finite fixture state; unspecified optional reactions are declined. No actual encounter runtime is asserted.\"\n            },\n            \"after\": {\n              \"actors\": {\n                \"creator\": {\n                  \"profile\": \"W13I\",\n                  \"hp\": 80,\n                  \"maxHp\": 80,\n                  \"tempHp\": 0,\n                  \"rp\": 31,\n                  \"maxRp\": 48,\n                  \"dissonance\": 0,\n                  \"lastSpell\": \"simulacrum\",\n                  \"refrain\": 0,\n                  \"preparedFamiliesUsed\": [\n                    \"simulacrum\"\n                  ],\n                  \"position\": [\n                    0,\n                    0,\n                    0\n                  ],\n                  \"alive\": true,\n                  \"conscious\": true,\n                  \"conditions\": [],\n                  \"concentration\": null,\n                  \"reaction\": true,\n                  \"action\": false,\n                  \"bonusAction\": true,\n                  \"movementSpent\": 0,\n                  \"regularStart\": 0,\n                  \"nextRegularStart\": 6,\n                  \"counterRecharge\": 0,\n                  \"wounds\": 0,\n                  \"critical\": false,\n                  \"companionCommandUsed\": false,\n                  \"companionOffenseUsed\": false\n                },\n                \"donor\": {\n                  \"profile\": \"W13I\",\n                  \"hp\": 0,\n                  \"maxHp\": 80,\n                  \"tempHp\": 0,\n                  \"rp\": 48,\n                  \"maxRp\": 48,\n                  \"dissonance\": 0,\n                  \"lastSpell\": null,\n                  \"refrain\": 0,\n                  \"preparedFamiliesUsed\": [],\n                  \"position\": [\n                    20,\n                    0,\n                    0\n                  ],\n                  \"alive\": true,\n                  \"conscious\": false,\n                  \"conditions\": [\n                    \"Dying\",\n                    \"Prone\"\n                  ],\n                  \"concentration\": null,\n                  \"reaction\": true,\n                  \"action\": true,\n                  \"bonusAction\": true,\n                  \"movementSpent\": 0,\n                  \"regularStart\": 0,\n                  \"nextRegularStart\": 6,\n                  \"counterRecharge\": 0,\n                  \"wounds\": 0,\n                  \"critical\": false,\n                  \"companionCommandUsed\": false,\n                  \"companionOffenseUsed\": false,\n                  \"deathSuccesses\": 1,\n                  \"deathFailures\": 1,\n                  \"stable\": false\n                }\n              },\n              \"applications\": {},\n              \"objects\": {\n                \"oldDuplicate\": {\n                  \"id\": \"prior-live\",\n                  \"hp\": 30,\n                  \"rp\": 5,\n                  \"state\": \"active\",\n                  \"position\": [\n                    10,\n                    0,\n                    0\n                  ]\n                }\n              },\n              \"privateMemories\": {},\n              \"sourceLedger\": {\n                \"oldCapOwner\": \"creator\"\n              },\n              \"note\": \"Complete stated finite fixture state; unspecified optional reactions are declined. No actual encounter runtime is asserted.\"\n            },\n            \"regularStartsBeforeEvent\": []\n          },\n          {\n            \"timeSeconds\": 0.3,\n            \"event\": \"Zero-HP snapshot reaches explicit no-live-creation endpoint\",\n            \"source\": [],\n            \"rng\": {},\n            \"explanation\": \"No newdamageeventorNullroot. Originaldonor0HP,1success/1failureandProne remain; oldlivebody30HP/5RPremains. No corpse/loot, noHPrefundorhealing.\",\n            \"before\": {\n              \"actors\": {\n                \"creator\": {\n                  \"profile\": \"W13I\",\n                  \"hp\": 80,\n                  \"maxHp\": 80,\n                  \"tempHp\": 0,\n                  \"rp\": 31,\n                  \"maxRp\": 48,\n                  \"dissonance\": 0,\n                  \"lastSpell\": \"simulacrum\",\n                  \"refrain\": 0,\n                  \"preparedFamiliesUsed\": [\n                    \"simulacrum\"\n                  ],\n                  \"position\": [\n                    0,\n                    0,\n                    0\n                  ],\n                  \"alive\": true,\n                  \"conscious\": true,\n                  \"conditions\": [],\n                  \"concentration\": null,\n                  \"reaction\": true,\n                  \"action\": false,\n                  \"bonusAction\": true,\n                  \"movementSpent\": 0,\n                  \"regularStart\": 0,\n                  \"nextRegularStart\": 6,\n                  \"counterRecharge\": 0,\n                  \"wounds\": 0,\n                  \"critical\": false,\n                  \"companionCommandUsed\": false,\n                  \"companionOffenseUsed\": false\n                },\n                \"donor\": {\n                  \"profile\": \"W13I\",\n                  \"hp\": 0,\n                  \"maxHp\": 80,\n                  \"tempHp\": 0,\n                  \"rp\": 48,\n                  \"maxRp\": 48,\n                  \"dissonance\": 0,\n                  \"lastSpell\": null,\n                  \"refrain\": 0,\n                  \"preparedFamiliesUsed\": [],\n                  \"position\": [\n                    20,\n                    0,\n                    0\n                  ],\n                  \"alive\": true,\n                  \"conscious\": false,\n                  \"conditions\": [\n                    \"Dying\",\n                    \"Prone\"\n                  ],\n                  \"concentration\": null,\n                  \"reaction\": true,\n                  \"action\": true,\n                  \"bonusAction\": true,\n                  \"movementSpent\": 0,\n                  \"regularStart\": 0,\n                  \"nextRegularStart\": 6,\n                  \"counterRecharge\": 0,\n                  \"wounds\": 0,\n                  \"critical\": false,\n                  \"companionCommandUsed\": false,\n                  \"companionOffenseUsed\": false,\n                  \"deathSuccesses\": 1,\n                  \"deathFailures\": 1,\n                  \"stable\": false\n                }\n              },\n              \"applications\": {},\n              \"objects\": {\n                \"oldDuplicate\": {\n                  \"id\": \"prior-live\",\n                  \"hp\": 30,\n                  \"rp\": 5,\n                  \"state\": \"active\",\n                  \"position\": [\n                    10,\n                    0,\n                    0\n                  ]\n                }\n              },\n              \"privateMemories\": {},\n              \"sourceLedger\": {\n                \"oldCapOwner\": \"creator\"\n              },\n              \"note\": \"Complete stated finite fixture state; unspecified optional reactions are declined. No actual encounter runtime is asserted.\"\n            },\n            \"after\": {\n              \"actors\": {\n                \"creator\": {\n                  \"profile\": \"W13I\",\n                  \"hp\": 80,\n                  \"maxHp\": 80,\n                  \"tempHp\": 0,\n                  \"rp\": 31,\n                  \"maxRp\": 48,\n                  \"dissonance\": 0,\n                  \"lastSpell\": \"simulacrum\",\n                  \"refrain\": 0,\n                  \"preparedFamiliesUsed\": [\n                    \"simulacrum\"\n                  ],\n                  \"position\": [\n                    0,\n                    0,\n                    0\n                  ],\n                  \"alive\": true,\n                  \"conscious\": true,\n                  \"conditions\": [],\n                  \"concentration\": null,\n                  \"reaction\": true,\n                  \"action\": false,\n                  \"bonusAction\": true,\n                  \"movementSpent\": 0,\n                  \"regularStart\": 0,\n                  \"nextRegularStart\": 6,\n                  \"counterRecharge\": 0,\n                  \"wounds\": 0,\n                  \"critical\": false,\n                  \"companionCommandUsed\": false,\n                  \"companionOffenseUsed\": false\n                },\n                \"donor\": {\n                  \"profile\": \"W13I\",\n                  \"hp\": 0,\n                  \"maxHp\": 80,\n                  \"tempHp\": 0,\n                  \"rp\": 48,\n                  \"maxRp\": 48,\n                  \"dissonance\": 0,\n                  \"lastSpell\": null,\n                  \"refrain\": 0,\n                  \"preparedFamiliesUsed\": [],\n                  \"position\": [\n                    20,\n                    0,\n                    0\n                  ],\n                  \"alive\": true,\n                  \"conscious\": false,\n                  \"conditions\": [\n                    \"Dying\",\n                    \"Prone\"\n                  ],\n                  \"concentration\": null,\n                  \"reaction\": true,\n                  \"action\": true,\n                  \"bonusAction\": true,\n                  \"movementSpent\": 0,\n                  \"regularStart\": 0,\n                  \"nextRegularStart\": 6,\n                  \"counterRecharge\": 0,\n                  \"wounds\": 0,\n                  \"critical\": false,\n                  \"companionCommandUsed\": false,\n                  \"companionOffenseUsed\": false,\n                  \"deathSuccesses\": 1,\n                  \"deathFailures\": 1,\n                  \"stable\": false\n                }\n              },\n              \"applications\": {},\n              \"objects\": {\n                \"oldDuplicate\": {\n                  \"id\": \"prior-live\",\n                  \"hp\": 30,\n                  \"rp\": 5,\n                  \"state\": \"active\",\n                  \"position\": [\n                    10,\n                    0,\n                    0\n                  ]\n                }\n              },\n              \"privateMemories\": {},\n              \"sourceLedger\": {\n                \"oldCapOwner\": \"creator\",\n                \"creationAttempt\": {\n                  \"snapshotHp\": 0,\n                  \"state\": \"immediate-finite-ending\",\n                  \"newLiveBody\": false,\n                  \"replacementCommitted\": false\n                }\n              },\n              \"note\": \"Complete stated finite fixture state; unspecified optional reactions are declined. No actual encounter runtime is asserted.\"\n            },\n            \"regularStartsBeforeEvent\": []\n          }\n        ],\n        \"expectedFinalState\": {\n          \"actors\": {\n            \"creator\": {\n              \"profile\": \"W13I\",\n              \"hp\": 80,\n              \"maxHp\": 80,\n              \"tempHp\": 0,\n              \"rp\": 31,\n              \"maxRp\": 48,\n              \"dissonance\": 0,\n              \"lastSpell\": \"simulacrum\",\n              \"refrain\": 0,\n              \"preparedFamiliesUsed\": [\n                \"simulacrum\"\n              ],\n              \"position\": [\n                0,\n                0,\n                0\n              ],\n              \"alive\": true,\n              \"conscious\": true,\n              \"conditions\": [],\n              \"concentration\": null,\n              \"reaction\": true,\n              \"action\": false,\n              \"bonusAction\": true,\n              \"movementSpent\": 0,\n              \"regularStart\": 0,\n              \"nextRegularStart\": 6,\n              \"counterRecharge\": 0,\n              \"wounds\": 0,\n              \"critical\": false,\n              \"companionCommandUsed\": false,\n              \"companionOffenseUsed\": false\n            },\n            \"donor\": {\n              \"profile\": \"W13I\",\n              \"hp\": 0,\n              \"maxHp\": 80,\n              \"tempHp\": 0,\n              \"rp\": 48,\n              \"maxRp\": 48,\n              \"dissonance\": 0,\n              \"lastSpell\": null,\n              \"refrain\": 0,\n              \"preparedFamiliesUsed\": [],\n              \"position\": [\n                20,\n                0,\n                0\n              ],\n              \"alive\": true,\n              \"conscious\": false,\n              \"conditions\": [\n                \"Dying\",\n                \"Prone\"\n              ],\n              \"concentration\": null,\n              \"reaction\": true,\n              \"action\": true,\n              \"bonusAction\": true,\n              \"movementSpent\": 0,\n              \"regularStart\": 0,\n              \"nextRegularStart\": 6,\n              \"counterRecharge\": 0,\n              \"wounds\": 0,\n              \"critical\": false,\n              \"companionCommandUsed\": false,\n              \"companionOffenseUsed\": false,\n              \"deathSuccesses\": 1,\n              \"deathFailures\": 1,\n              \"stable\": false\n            }\n          },\n          \"applications\": {},\n          \"objects\": {\n            \"oldDuplicate\": {\n              \"id\": \"prior-live\",\n              \"hp\": 30,\n              \"rp\": 5,\n              \"state\": \"active\",\n              \"position\": [\n                10,\n                0,\n                0\n              ]\n            }\n          },\n          \"privateMemories\": {},\n          \"sourceLedger\": {\n            \"oldCapOwner\": \"creator\",\n            \"creationAttempt\": {\n              \"snapshotHp\": 0,\n              \"state\": \"immediate-finite-ending\",\n              \"newLiveBody\": false,\n              \"replacementCommitted\": false\n            }\n          },\n          \"note\": \"Complete stated finite fixture state; unspecified optional reactions are declined. No actual encounter runtime is asserted.\"\n        },\n        \"conclusions\": {\n          \"creatorRP\": 31,\n          \"donorHP\": 0,\n          \"oldLiveBodyHP\": 30,\n          \"newLiveBody\": false,\n          \"donorDeathCounters\": [\n            1,\n            1\n          ]\n        },\n        \"qualifications\": [],\n        \"disposition\": \"COHERENT_AT_DISCLOSED_SOURCE_INPUTS\",\n        \"sourceQualification\": \"Explicit RIC5-SI zero-HP creation-lifecycle choice plus actual CHA/zero-HP rules; neither a rated monster nor a production encounter.\",\n        \"budgetSemantics\": \"Action/BonusAction/Reaction booleans are remaining underlying ledgers, not action eligibility outside an actual source-qualified phase or while Incapacitated. Supplied regular-START refreshes are materialized before events; explicit relevant END/idle-D transitions remain in the trace. Other uninvoked actions are declined. Long uninterrupted work/rest branches explicitly use real elapsed noncombat work, not thousands of fabricated Actions.\"\n      }\n    ],\n    \"disposition\": \"COHERENT_PROPOSED_PROCEDURE_AT_DISCLOSED_SOURCE_INPUTS\",\n    \"sourceKeys\": [\n      \"sourceCandidate/records/4\",\n      \"WIZ\",\n      \"MAG\",\n      \"CAT\",\n      \"LOW\",\n      \"BODY\"\n    ],\n    \"sourceQualification\": \"Complete class engines, legal selected/automatic cards, prepared/known fixture additions, physical bodies and budgets are attached. These are explicit source-built finite teaching actors, not a claim to an authenticated live campaign encounter or a creature CR.\",\n    \"budgetSemantics\": \"Action/BonusAction/Reaction booleans are remaining underlying ledgers, not action eligibility outside an actual source-qualified phase or while Incapacitated. Supplied regular-START refreshes are materialized before events; explicit relevant END/idle-D transitions remain in the trace. Other uninvoked actions are declined. Long uninterrupted work/rest branches explicitly use real elapsed noncombat work, not thousands of fabricated Actions.\"\n  }\n]\n",
      "afterText": "[\n  {\n    \"id\": \"RIC5-01-A\",\n    \"spellId\": \"cast-echo\",\n    \"title\": \"A real damaging original and a fresh paid damaging child\",\n    \"kind\": \"NEW source-qualified authored encounter; not engine executed\",\n    \"geometry\": \"Coordinates in feet; each actor occupies its stated5-foot body volume about its listed horizontal anchor, with feet on z=0 solid floor unless explicitly overridden. Flat open lit chamber, full legal perception/line of effect, no unseen extra defenses, ordinary paths/support. Numeric area witnesses and exceptions are stated per event.\",\n    \"actorDefinitions\": {\n      \"echoer\": {\n        \"kind\": \"Source-qualified illustrative character, not a verified campaign actor or rated monster\",\n        \"class\": \"Wizard\",\n        \"classLevel\": 13,\n        \"totalLevel\": 13,\n        \"PB\": 5,\n        \"S\": 3,\n        \"STR\": 10,\n        \"DEX\": 14,\n        \"CON\": 14,\n        \"INT\": 18,\n        \"WIS\": 12,\n        \"CHA\": 10,\n        \"maxHp\": 80,\n        \"hpConstruction\": \"d6 class: initial6+CON2=8, twelve supplied legal hit-die results4+CON2=6 each;8+72=80. This is a stated fixture history, not generated random character evidence.\",\n        \"maxRp\": 48,\n        \"maxRank\": 7,\n        \"Limit\": 11,\n        \"AC\": 12,\n        \"speedFeet\": 30,\n        \"size\": \"Medium\",\n        \"bodyBoxFeet\": [\n          5,\n          5,\n          5\n        ],\n        \"bodyMassLb\": 170,\n        \"actualGear\": {\n          \"focus-pack\": {\n            \"grossWeightLb\": 10,\n            \"load\": 1,\n            \"contents\": \"real ordinary wooden focus and mundane personal carrying effects; no consumed materials/charged item; gross figures include every item once\"\n          }\n        },\n        \"saves\": {\n          \"STR\": 0,\n          \"DEX\": 2,\n          \"CON\": 2,\n          \"INT\": 9,\n          \"WIS\": 6,\n          \"CHA\": 0\n        },\n        \"spellAttack\": 9,\n        \"spellDc\": 17,\n        \"school\": \"Illusion\",\n        \"schoolAttack\": 11,\n        \"schoolDc\": 19,\n        \"schoolConcentrationSave\": 4,\n        \"ordinaryConcentrationSave\": 2,\n        \"arcaneWard\": \"force resistance: this prepared Illusion set has no intrinsic damage type; no fire/cold/psychic resistance invented\",\n        \"hero\": \"Spellbinder\",\n        \"bookAndPreparation\": {\n          \"newRank7BookAdditionsAt13\": [\n            \"cast-echo\",\n            \"meta-surge\",\n            \"erase-from-reality\",\n            \"sequester\",\n            \"simulacrum\"\n          ],\n          \"ordinaryPrepared\": [\n            \"cast-echo\",\n            \"meta-surge\",\n            \"erase-from-reality\",\n            \"sequester\",\n            \"simulacrum\",\n            \"fireball\",\n            \"shield\",\n            \"counterspell\",\n            \"continual-flame\",\n            \"mirror-image\",\n            \"detect-magic\",\n            \"true-seeing\"\n          ],\n          \"count\": 12,\n          \"baseCapacity\": 17,\n          \"additionalFloatingAndSchoolSlotsUnused\": true,\n          \"olderSpells\": \"Actual source-qualified book/cantrip additions at earlier legal Wizard levels; ordinary Counterspell acquired at5+, True Seeing at11, Continual Flame at3; no feat or copying grant needed.\",\n          \"ordinaryKnownCantrips\": [\n            \"ray-of-frost\",\n            \"chill-touch\",\n            \"resonance-shield\",\n            \"minor-image\",\n            \"disrupt-memory\"\n          ],\n          \"unusedBaseMatrixPositions\": 5\n        },\n        \"selectedAcquisition\": [\n          {\n            \"classLevel\": 1,\n            \"cards\": [\n              {\n                \"id\": \"wizard.base.arcane-recovery\",\n                \"name\": \"Arcane Recovery\",\n                \"className\": \"Wizard\",\n                \"band\": \"Base\",\n                \"path\": null,\n                \"sourceKind\": \"passive\",\n                \"minimumClassLevel\": 1,\n                \"acquisition\": \"selection\",\n                \"activation\": \"Passive\",\n                \"cost\": \"0\",\n                \"rangeAndTarget\": \"Self\",\n                \"duration\": \"Instantaneous during a completed short rest\",\n                \"frequency\": \"1/long rest\",\n                \"effect\": \"Arcane Recovery. Tags: base, passive, resonance. Once between long rests when you complete a short rest, restore RP equal to half your Wizard class level rounded up, never above your normal maximum. This is RP recovery, not a second pool, and cannot trigger spell-cast, Refrain or Dissonance effects.\",\n                \"source\": {\n                  \"extract\": \"docs/reference/Player_Rulebook_v6_source_text.txt\",\n                  \"line\": 5196,\n                  \"originalText\": \"Arcane Recovery: Once per day during a short rest, recover RP equal to half your Wizard level (rounded up), up to your normal maximum.\"\n                },\n                \"designStatus\": \"provisional-playtest\",\n                \"spellRank\": null\n              },\n              {\n                \"id\": \"wizard.base.spell-scribing\",\n                \"name\": \"Spell Scribing\",\n                \"className\": \"Wizard\",\n                \"band\": \"Base\",\n                \"path\": null,\n                \"sourceKind\": \"passive\",\n                \"minimumClassLevel\": 1,\n                \"acquisition\": \"selection\",\n                \"activation\": \"Passive\",\n                \"cost\": \"0\",\n                \"rangeAndTarget\": \"Your spellbook\",\n                \"duration\": \"Permanent\",\n                \"frequency\": \"Always\",\n                \"effect\": \"Spell Scribing. Tags: base, passive, spellbook. Copying a legal found Wizard spell into your spellbook requires 1 hour and 25 gp of inks and components per spell rank, treating rank 0 as rank 1 for this calculation, instead of the pilot baseline 2 hours and 50 gp. Level-up spells remain free.\",\n                \"source\": {\n                  \"extract\": \"docs/reference/Player_Rulebook_v6_source_text.txt\",\n                  \"line\": 5197,\n                  \"originalText\": \"Spell Scribing: Copy spells into your spellbook at half the normal cost and time.\"\n                },\n                \"designStatus\": \"provisional-playtest\",\n                \"spellRank\": null\n              },\n              {\n                \"id\": \"wizard.base.arcane-bolt\",\n                \"name\": \"Arcane Bolt\",\n                \"className\": \"Wizard\",\n                \"band\": \"Base\",\n                \"path\": null,\n                \"sourceKind\": \"active\",\n                \"minimumClassLevel\": 1,\n                \"acquisition\": \"selection\",\n                \"activation\": \"Action\",\n                \"cost\": \"1 RP\",\n                \"rangeAndTarget\": \"One creature within 60 feet\",\n                \"duration\": \"Instantaneous\",\n                \"frequency\": \"At will while RP remains\",\n                \"effect\": \"Arcane Bolt. Tags: base, active, wizard-spell, universal, damage. Make a Wizard spell attack. On a hit deal S d6 + M force damage. Arcane Bolt is an always-prepared class matrix once acquired and uses the normal first-distinct-matrix and Refrain rules.\",\n                \"source\": {\n                  \"extract\": \"docs/reference/Player_Rulebook_v6_source_text.txt\",\n                  \"line\": 5203,\n                  \"originalText\": \"Arcane Bolt: Launch a bolt of pure arcane energy that deals force damage to a single target.\"\n                },\n                \"designStatus\": \"provisional-playtest\",\n                \"spellRank\": 1\n              },\n              {\n                \"id\": \"wizard.base.minor-conjuration\",\n                \"name\": \"Minor Conjuration\",\n                \"className\": \"Wizard\",\n                \"band\": \"Base\",\n                \"path\": null,\n                \"sourceKind\": \"active\",\n                \"minimumClassLevel\": 1,\n                \"acquisition\": \"selection\",\n                \"activation\": \"Action\",\n                \"cost\": \"1 RP\",\n                \"rangeAndTarget\": \"One unoccupied space within 10 feet\",\n                \"duration\": \"1 hour\",\n                \"frequency\": \"At will while RP remains; one object at a time\",\n                \"effect\": \"Minor Conjuration. Tags: base, active, wizard-spell, conjuration. Create one nonmagical unattended object that fits inside a 1-foot cube, weighs no more than 10 pounds and is made of common nonvaluable material such as wood, cloth, clay, iron or glass. It cannot be food, poison, currency, a spell component with listed cost, ammunition with special properties or a functional complex mechanism. Creating another dismisses the first.\",\n                \"source\": {\n                  \"extract\": \"docs/reference/Player_Rulebook_v6_source_text.txt\",\n                  \"line\": 5204,\n                  \"originalText\": \"Minor Conjuration: Create a temporary, small inanimate object that lasts for 1 hour.\"\n                },\n                \"designStatus\": \"provisional-playtest\",\n                \"spellRank\": 1\n              }\n            ]\n          },\n          {\n            \"classLevel\": 2,\n            \"cards\": [\n              {\n                \"id\": \"wizard.base.arcane-insight\",\n                \"name\": \"Arcane Insight\",\n                \"className\": \"Wizard\",\n                \"band\": \"Base\",\n                \"path\": null,\n                \"sourceKind\": \"passive\",\n                \"minimumClassLevel\": 1,\n                \"acquisition\": \"selection\",\n                \"activation\": \"Passive\",\n                \"cost\": \"0\",\n                \"rangeAndTarget\": \"Self\",\n                \"duration\": \"Permanent\",\n                \"frequency\": \"Always\",\n                \"effect\": \"Arcane Insight. Tags: base, passive, knowledge. Gain proficiency in Arcana, or expertise if already proficient. When examining an active magical effect, spell residue, magic item or arcane construction, you may make an Intelligence (Arcana) check to determine its broad school, function or unusual matrix behavior. The Director sets the normal knowledge DC; failure supplies no invented fact.\",\n                \"source\": {\n                  \"extract\": \"docs/reference/Player_Rulebook_v6_source_text.txt\",\n                  \"line\": 5198,\n                  \"originalText\": \"Arcane Insight: Identify magical effects and items with greater accuracy than non-wizards.\"\n                },\n                \"designStatus\": \"provisional-playtest\",\n                \"spellRank\": null\n              },\n              {\n                \"id\": \"wizard.base.matrix-efficiency\",\n                \"name\": \"Matrix Efficiency\",\n                \"className\": \"Wizard\",\n                \"band\": \"Base\",\n                \"path\": null,\n                \"sourceKind\": \"passive\",\n                \"minimumClassLevel\": 1,\n                \"acquisition\": \"selection\",\n                \"activation\": \"Passive\",\n                \"cost\": \"0\",\n                \"rangeAndTarget\": \"Self\",\n                \"duration\": \"Daily preparation\",\n                \"frequency\": \"Always\",\n                \"effect\": \"Matrix Efficiency. Tags: base, passive, matrix. Your normal full daily Spell Matrix preparation time is reduced from 1 hour to 45 minutes. This does not reduce the separate 10-minute midday substitution ritual, spell scribing, rituals or spellbook reconstruction unless another feature explicitly says so.\",\n                \"source\": {\n                  \"extract\": \"docs/reference/Player_Rulebook_v6_source_text.txt\",\n                  \"line\": 5199,\n                  \"originalText\": \"Matrix Efficiency: Reduce the preparation time for spells by 25%.\"\n                },\n                \"designStatus\": \"provisional-playtest\",\n                \"spellRank\": null\n              }\n            ]\n          },\n          {\n            \"classLevel\": 3,\n            \"cards\": [\n              {\n                \"id\": \"wizard.arch.floating-preparation\",\n                \"name\": \"Floating Preparation\",\n                \"className\": \"Wizard\",\n                \"band\": \"Arch\",\n                \"path\": null,\n                \"sourceKind\": \"passive\",\n                \"minimumClassLevel\": 3,\n                \"acquisition\": \"selection\",\n                \"activation\": \"Passive\",\n                \"cost\": \"0\",\n                \"rangeAndTarget\": \"Self\",\n                \"duration\": \"Daily preparation\",\n                \"frequency\": \"Always\",\n                \"effect\": \"Floating Preparation. Tags: arch, passive, matrix. Increase your maximum prepared Spell Matrix count by 1. The extra matrix can come from any school and obeys all ordinary spellbook and rank restrictions. It is a prepared matrix for every rule, including protected strain, duplicate-family tracking and Matrix Mastery modifications.\",\n                \"source\": {\n                  \"extract\": \"docs/reference/Player_Rulebook_v6_source_text.txt\",\n                  \"line\": 5213,\n                  \"originalText\": \"Floating Preparation: Prepare 1 extra spell from any school each day\"\n                },\n                \"designStatus\": \"provisional-playtest\",\n                \"spellRank\": null\n              },\n              {\n                \"id\": \"wizard.arch.arcane-lock\",\n                \"name\": \"Arcane Lock\",\n                \"className\": \"Wizard\",\n                \"band\": \"Arch\",\n                \"path\": null,\n                \"sourceKind\": \"active\",\n                \"minimumClassLevel\": 3,\n                \"acquisition\": \"selection\",\n                \"activation\": \"Action\",\n                \"cost\": \"2 RP\",\n                \"rangeAndTarget\": \"One door, chest, portal or unattended object within touch\",\n                \"duration\": \"8 hours\",\n                \"frequency\": \"Recharge 2 rounds\",\n                \"effect\": \"Arcane Lock. Tags: arch, active, wizard-spell, abjuration. Magically seal the target. Opening it without your permission requires a Strength check or thieves'/arcane-tool check against your Wizard spell DC. Dispel Magic can end the lock. You can designate up to M creatures who can bypass it. This does not make the object physically indestructible.\",\n                \"source\": {\n                  \"extract\": \"docs/reference/Player_Rulebook_v6_source_text.txt\",\n                  \"line\": 5223,\n                  \"originalText\": \"Arcane Lock: Create a magical barrier that prevents entry or access to an object or area.\"\n                },\n                \"designStatus\": \"provisional-playtest\",\n                \"spellRank\": 2\n              }\n            ]\n          },\n          {\n            \"classLevel\": 4,\n            \"cards\": [\n              {\n                \"id\": \"wizard.base.scholarly-mind\",\n                \"name\": \"Scholarly Mind\",\n                \"className\": \"Wizard\",\n                \"band\": \"Base\",\n                \"path\": null,\n                \"sourceKind\": \"passive\",\n                \"minimumClassLevel\": 1,\n                \"acquisition\": \"selection\",\n                \"activation\": \"Passive\",\n                \"cost\": \"0\",\n                \"rangeAndTarget\": \"Self\",\n                \"duration\": \"Permanent\",\n                \"frequency\": \"Always\",\n                \"effect\": \"Scholarly Mind. Tags: base, passive, knowledge. You have advantage on Intelligence checks whose primary purpose is recalling, researching or analyzing arcane theory, magical history, planar magical principles or constructed spell formulae. It does not grant advantage on spell attacks, Counterspell checks or general Investigation unrelated to arcane scholarship.\",\n                \"source\": {\n                  \"extract\": \"docs/reference/Player_Rulebook_v6_source_text.txt\",\n                  \"line\": 5200,\n                  \"originalText\": \"Scholarly Mind: Gain advantage on Intelligence checks related to arcane knowledge.\"\n                },\n                \"designStatus\": \"provisional-playtest\",\n                \"spellRank\": null\n              }\n            ]\n          },\n          {\n            \"classLevel\": 5,\n            \"cards\": [\n              {\n                \"id\": \"wizard.arch.dispel-magic\",\n                \"name\": \"Dispel Magic\",\n                \"className\": \"Wizard\",\n                \"band\": \"Arch\",\n                \"path\": null,\n                \"sourceKind\": \"active\",\n                \"minimumClassLevel\": 5,\n                \"acquisition\": \"selection\",\n                \"activation\": \"Action\",\n                \"cost\": \"3 RP\",\n                \"rangeAndTarget\": \"One creature, object or magical effect within 60 feet\",\n                \"duration\": \"Instantaneous\",\n                \"frequency\": \"Recharge 2 rounds\",\n                \"effect\": \"Dispel Magic. Tags: arch, active, wizard-spell, abjuration. Choose one ongoing spell effect you can perceive. If its rank is 3 or lower, end it. If it is rank 4 or higher, make an Intelligence check adding proficiency against DC 10 + spell rank; success ends it. Permanent artifact properties and effects explicitly immune to dispelling are unaffected.\",\n                \"source\": {\n                  \"extract\": \"docs/reference/Player_Rulebook_v6_source_text.txt\",\n                  \"line\": 5224,\n                  \"originalText\": \"Dispel Magic: End magical effects in an area or on a target.\"\n                },\n                \"designStatus\": \"provisional-playtest\",\n                \"spellRank\": 3\n              }\n            ]\n          },\n          {\n            \"classLevel\": 6,\n            \"cards\": [\n              {\n                \"id\": \"wizard.arch.arcane-sight\",\n                \"name\": \"Arcane Sight\",\n                \"className\": \"Wizard\",\n                \"band\": \"Arch\",\n                \"path\": null,\n                \"sourceKind\": \"active\",\n                \"minimumClassLevel\": 3,\n                \"acquisition\": \"selection\",\n                \"activation\": \"Action\",\n                \"cost\": \"2 RP\",\n                \"rangeAndTarget\": \"Self; 60-foot sight\",\n                \"duration\": \"Concentration, maximum 10 minutes\",\n                \"frequency\": \"Recharge 2 rounds\",\n                \"effect\": \"Arcane Sight. Tags: arch, active, wizard-spell, divination, concentration. While active you perceive magical auras within 60 feet and automatically know each visible aura's school or broad magical category. As an Action on a later turn, examine one aura to learn whether it is concentrated, summoned, cursed, warded or linked to another visible magical effect. Total cover blocks sight.\",\n                \"source\": {\n                  \"extract\": \"docs/reference/Player_Rulebook_v6_source_text.txt\",\n                  \"line\": 5226,\n                  \"originalText\": \"Arcane Sight: See magical auras and effects for a short duration.\"\n                },\n                \"designStatus\": \"provisional-playtest\",\n                \"spellRank\": 2\n              }\n            ]\n          },\n          {\n            \"classLevel\": 7,\n            \"cards\": [\n              {\n                \"id\": \"wizard.arch.dimensional-pocket\",\n                \"name\": \"Dimensional Pocket\",\n                \"className\": \"Wizard\",\n                \"band\": \"Arch\",\n                \"path\": null,\n                \"sourceKind\": \"active\",\n                \"minimumClassLevel\": 7,\n                \"acquisition\": \"selection\",\n                \"activation\": \"Ritual\",\n                \"cost\": \"3 RP\",\n                \"rangeAndTarget\": \"One point within 5 feet\",\n                \"duration\": \"8 hours\",\n                \"frequency\": \"1/long rest\",\n                \"effect\": \"Dimensional Pocket. Tags: arch, active, wizard-spell, conjuration, ritual. Create an extradimensional storage space holding up to 100 pounds or 10 cubic feet of unattended nonliving material. Retrieving or placing an item while adjacent to the opening uses an object interaction. Living creatures cannot enter. When duration ends, remaining contents appear harmlessly in the nearest unoccupied space.\",\n                \"source\": {\n                  \"extract\": \"docs/reference/Player_Rulebook_v6_source_text.txt\",\n                  \"line\": 5225,\n                  \"originalText\": \"Dimensional Pocket: Create a small extradimensional space to store items.\"\n                },\n                \"designStatus\": \"provisional-playtest\",\n                \"spellRank\": 4\n              }\n            ]\n          },\n          {\n            \"classLevel\": 8,\n            \"cards\": [\n              {\n                \"id\": \"wizard.base.analyze-magic\",\n                \"name\": \"Analyze Magic\",\n                \"className\": \"Wizard\",\n                \"band\": \"Base\",\n                \"path\": null,\n                \"sourceKind\": \"active\",\n                \"minimumClassLevel\": 1,\n                \"acquisition\": \"selection\",\n                \"activation\": \"Action\",\n                \"cost\": \"1 RP\",\n                \"rangeAndTarget\": \"One magical creature, object or effect within 30 feet\",\n                \"duration\": \"Instantaneous\",\n                \"frequency\": \"Recharge 1 round\",\n                \"effect\": \"Analyze Magic. Tags: base, active, wizard-spell, divination, knowledge. Make an Intelligence (Arcana) check against DC 10 + the effect's spell rank, treating a non-spell effect's Director-assigned tier as rank. On success learn its school or magical category, one active mechanical property and whether it is currently sustained, cursed or bound to another effect. Failure reveals only that magic is present.\",\n                \"source\": {\n                  \"extract\": \"docs/reference/Player_Rulebook_v6_source_text.txt\",\n                  \"line\": 5206,\n                  \"originalText\": \"Analyze Magic: Study a magical effect or item to gain insight into its properties and function.\"\n                },\n                \"designStatus\": \"provisional-playtest\",\n                \"spellRank\": 1\n              }\n            ]\n          },\n          {\n            \"classLevel\": 9,\n            \"cards\": [\n              {\n                \"id\": \"wizard.arch.sigil-rewrite\",\n                \"name\": \"Sigil Rewrite\",\n                \"className\": \"Wizard\",\n                \"band\": \"Arch\",\n                \"path\": null,\n                \"sourceKind\": \"passive\",\n                \"minimumClassLevel\": 3,\n                \"acquisition\": \"selection\",\n                \"activation\": \"Bonus Action\",\n                \"cost\": \"0\",\n                \"rangeAndTarget\": \"Self and spellbook\",\n                \"duration\": \"Instantaneous\",\n                \"frequency\": \"1/long rest\",\n                \"effect\": \"Sigil Rewrite. Tags: arch, passive-upgrade, matrix. Replace one prepared matrix with a different spell from your spellbook of exactly the same rank without performing the normal 10-minute ritual. The replacement receives no special Dissonance reset for a matrix family already used this encounter and must obey current Wizard rank eligibility.\",\n                \"source\": {\n                  \"extract\": \"docs/reference/Player_Rulebook_v6_source_text.txt\",\n                  \"line\": 5214,\n                  \"originalText\": \"Sigil Rewrite: Once/day, instantly swap a spell you know for another of the same tier\"\n                },\n                \"designStatus\": \"provisional-playtest\",\n                \"spellRank\": null\n              }\n            ]\n          },\n          {\n            \"classLevel\": 10,\n            \"cards\": [\n              {\n                \"id\": \"wizard.hero.spellbinder.spell-preservation\",\n                \"name\": \"Spell Preservation\",\n                \"className\": \"Wizard\",\n                \"band\": \"Hero\",\n                \"path\": \"Spellbinder\",\n                \"sourceKind\": \"passive\",\n                \"minimumClassLevel\": 10,\n                \"acquisition\": \"selection\",\n                \"activation\": \"Passive\",\n                \"cost\": \"0\",\n                \"rangeAndTarget\": \"Your spellbook\",\n                \"duration\": \"Permanent\",\n                \"frequency\": \"Always\",\n                \"effect\": \"Spell Preservation. Tags: hero, spellbinder, passive, spellbook. Your primary spellbook cannot be destroyed, erased or rendered permanently unreadable by non-artifact mundane or magical means. It can still be stolen, hidden, transported, suppressed, sealed by an artifact-level effect or voluntarily abandoned. Copies and backup books do not automatically receive this protection.\",\n                \"source\": {\n                  \"extract\": \"docs/reference/Player_Rulebook_v6_source_text.txt\",\n                  \"line\": 5243,\n                  \"originalText\": \"Spell Preservation: Your spellbook cannot be destroyed by non-artifact means.\"\n                },\n                \"designStatus\": \"provisional-playtest\",\n                \"spellRank\": null\n              },\n              {\n                \"id\": \"wizard.hero.spellbinder.seal-magic\",\n                \"name\": \"Seal Magic\",\n                \"className\": \"Wizard\",\n                \"band\": \"Hero\",\n                \"path\": \"Spellbinder\",\n                \"sourceKind\": \"active\",\n                \"minimumClassLevel\": 10,\n                \"acquisition\": \"selection\",\n                \"activation\": \"Action\",\n                \"cost\": \"4 RP\",\n                \"rangeAndTarget\": \"One creature within 60 feet\",\n                \"duration\": \"Maximum 3 rounds\",\n                \"frequency\": \"Recharge 3 rounds\",\n                \"effect\": \"Seal Magic. Tags: hero, spellbinder, wizard-spell, control. Choose one of the eight schools and target one creature. It makes a Wisdom save. On failure it cannot cast spells of the chosen school. At the end of each of its turns it repeats the save, ending the Seal on success. The effect ends automatically after 3 rounds and never prevents non-spell class techniques merely because they are magical.\",\n                \"source\": {\n                  \"extract\": \"docs/reference/Player_Rulebook_v6_source_text.txt\",\n                  \"line\": 5249,\n                  \"originalText\": \"Seal Magic: Prevent a target from casting spells of a specific school (WIS save, 3 rounds)\"\n                },\n                \"designStatus\": \"provisional-playtest\",\n                \"spellRank\": 5\n              }\n            ]\n          },\n          {\n            \"classLevel\": 11,\n            \"cards\": [\n              {\n                \"id\": \"wizard.base.arcane-shield\",\n                \"name\": \"Arcane Shield\",\n                \"className\": \"Wizard\",\n                \"band\": \"Base\",\n                \"path\": null,\n                \"sourceKind\": \"active\",\n                \"minimumClassLevel\": 1,\n                \"acquisition\": \"selection\",\n                \"activation\": \"Reaction\",\n                \"cost\": \"2 RP\",\n                \"rangeAndTarget\": \"Self\",\n                \"duration\": \"Until start of your next regular turn\",\n                \"frequency\": \"Recharge 2 rounds\",\n                \"effect\": \"Arcane Shield. Tags: base, active, wizard-spell, abjuration, protection. Trigger when an attack roll would hit you. Gain +2 AC against the triggering attack and until the start of your next regular turn, potentially causing the attack to miss. Temporary AC from another Arcane Shield does not stack.\",\n                \"source\": {\n                  \"extract\": \"docs/reference/Player_Rulebook_v6_source_text.txt\",\n                  \"line\": 5205,\n                  \"originalText\": \"Arcane Shield: Create a barrier of magical force that provides temporary protection.\"\n                },\n                \"designStatus\": \"provisional-playtest\",\n                \"spellRank\": 1\n              }\n            ]\n          },\n          {\n            \"classLevel\": 12,\n            \"cards\": [\n              {\n                \"id\": \"wizard.hero.spellbinder.counterpulse\",\n                \"name\": \"Counterpulse\",\n                \"className\": \"Wizard\",\n                \"band\": \"Hero\",\n                \"path\": \"Spellbinder\",\n                \"sourceKind\": \"active\",\n                \"minimumClassLevel\": 12,\n                \"acquisition\": \"selection\",\n                \"activation\": \"Triggered\",\n                \"cost\": \"1 RP\",\n                \"rangeAndTarget\": \"Caster whose spell you successfully Counterspelled\",\n                \"duration\": \"Until end of target's next turn\",\n                \"frequency\": \"At most once per round\",\n                \"effect\": \"Counterpulse. Tags: hero, spellbinder, counter, control. Immediately after your Counterspell succeeds, spend 1 RP. The countered caster is Silenced until the end of its next turn. This is part of the successful counter event rather than another spell cast and cannot trigger another Counterpulse.\",\n                \"source\": {\n                  \"extract\": \"docs/reference/Player_Rulebook_v6_source_text.txt\",\n                  \"line\": 5251,\n                  \"originalText\": \"Counterpulse: Countering a spell silences the caster for 1 round\"\n                },\n                \"designStatus\": \"provisional-playtest\",\n                \"spellRank\": null\n              }\n            ]\n          },\n          {\n            \"classLevel\": 13,\n            \"cards\": [\n              {\n                \"id\": \"wizard.base.spellbook-study\",\n                \"name\": \"Spellbook Study\",\n                \"className\": \"Wizard\",\n                \"band\": \"Base\",\n                \"path\": null,\n                \"sourceKind\": \"active\",\n                \"minimumClassLevel\": 1,\n                \"acquisition\": \"selection\",\n                \"activation\": \"Ritual\",\n                \"cost\": \"0 RP\",\n                \"rangeAndTarget\": \"Self and spellbook\",\n                \"duration\": \"10 minutes\",\n                \"frequency\": \"1/long rest\",\n                \"effect\": \"Spellbook Study. Tags: base, active, matrix, ritual. Replace one currently prepared matrix with one legal spell recorded in your spellbook. The replacement must be within your Wizard rank limit. This is the normal midday substitution permission; it does not alter the spellbook, create another prepared-matrix position or reset first-cast/Refrain history for an underlying matrix family already cast this encounter.\",\n                \"source\": {\n                  \"extract\": \"docs/reference/Player_Rulebook_v6_source_text.txt\",\n                  \"line\": 5207,\n                  \"originalText\": \"Spellbook Study: Spend time studying your spellbook to prepare a different selection of spells.\"\n                },\n                \"designStatus\": \"provisional-playtest\",\n                \"spellRank\": null\n              }\n            ]\n          }\n        ],\n        \"automaticCards\": [\n          {\n            \"id\": \"wizard.arch.arcane-tradition\",\n            \"name\": \"Arcane Tradition\",\n            \"className\": \"Wizard\",\n            \"band\": \"Arch\",\n            \"path\": null,\n            \"sourceKind\": \"passive\",\n            \"minimumClassLevel\": 3,\n            \"acquisition\": \"automatic\",\n            \"activation\": \"Passive\",\n            \"cost\": \"0\",\n            \"rangeAndTarget\": \"Your level-1 Arcane School\",\n            \"duration\": \"Permanent\",\n            \"frequency\": \"Automatic at Wizard 3; not a selection\",\n            \"effect\": \"Arcane Tradition. Tags: arch, school, automatic. Your level-1 Arcane School becomes your Arcanist tradition; do not choose a second school. Prepare one additional matrix from that same school each day without counting it against your normal prepared-matrix maximum. It otherwise obeys all ordinary rank, spellbook, Dissonance and duplicate-family rules.\",\n            \"source\": {\n              \"extract\": \"docs/reference/Player_Rulebook_v6_source_text.txt\",\n              \"line\": 5217,\n              \"originalText\": \"Arcane Tradition: Choose a school of magic to specialize in, gaining bonuses to spells of that school.\"\n            },\n            \"designStatus\": \"provisional-playtest\",\n            \"spellRank\": null\n          },\n          {\n            \"id\": \"wizard.base.counterspell\",\n            \"name\": \"Counterspell\",\n            \"className\": \"Wizard\",\n            \"band\": \"Base\",\n            \"path\": null,\n            \"sourceKind\": \"active\",\n            \"minimumClassLevel\": 2,\n            \"acquisition\": \"automatic\",\n            \"activation\": \"Reaction\",\n            \"cost\": \"3 RP\",\n            \"rangeAndTarget\": \"One creature you perceive casting a spell within 60 feet\",\n            \"duration\": \"Instantaneous\",\n            \"frequency\": \"Automatic at Wizard 2; recharge 2 rounds\",\n            \"effect\": \"Counterspell. Tags: arch-source, automatic, wizard-spell, abjuration, disruption. Trigger when a creature begins casting a spell. Make an Intelligence check adding proficiency against DC 10 + twice the spell's rank, treating rank 0 as 0. Success negates the triggering spell after its costs are paid; failure lets it resolve. This is gained automatically at Wizard 2 and is never also selected from the Arch pool.\",\n            \"source\": {\n              \"extract\": \"docs/reference/Player_Rulebook_v6_source_text.txt\",\n              \"line\": 5222,\n              \"originalText\": \"Counterspell: Disrupt an enemy's spellcasting, potentially negating their spell entirely.\"\n            },\n            \"designStatus\": \"provisional-playtest\",\n            \"spellRank\": 1\n          },\n          {\n            \"id\": \"wizard.supplement.ritual-casting\",\n            \"name\": \"Ritual Casting\",\n            \"className\": \"Wizard\",\n            \"band\": \"Base\",\n            \"path\": null,\n            \"sourceKind\": \"supplement\",\n            \"minimumClassLevel\": 2,\n            \"acquisition\": \"automatic\",\n            \"activation\": \"Ritual\",\n            \"cost\": \"0 RP unless the individual ritual explicitly states otherwise\",\n            \"rangeAndTarget\": \"As the ritual spell\",\n            \"duration\": \"As the ritual spell\",\n            \"frequency\": \"At will outside encounters with sufficient time\",\n            \"effect\": \"Source progression line 5184. Cast a Wizard spell bearing the Ritual tag directly from your spellbook without preparing it. Increase its casting time by at least 10 minutes. Ritual Casting cannot be completed during an encounter, does not use an ordinary prepared-matrix position and does not generate or vent normal casting Dissonance.\",\n            \"prerequisite\": \"See class engine and progression.\",\n            \"source\": {\n              \"line\": 5184,\n              \"reference\": null,\n              \"originalText\": \"| 2 | Counterspell Reaction, Ritual Casting |\",\n              \"status\": \"source-derived\"\n            },\n            \"designStatus\": \"provisional-playtest\",\n            \"spellRank\": null\n          },\n          {\n            \"id\": \"wizard.supplement.school-mastery\",\n            \"name\": \"School Mastery\",\n            \"className\": \"Wizard\",\n            \"band\": \"Arch\",\n            \"path\": null,\n            \"sourceKind\": \"supplement\",\n            \"minimumClassLevel\": 5,\n            \"acquisition\": \"automatic\",\n            \"activation\": \"Passive\",\n            \"cost\": \"0\",\n            \"rangeAndTarget\": \"Your level-1 Arcane School\",\n            \"duration\": \"Permanent\",\n            \"frequency\": \"Automatic at Wizard 5\",\n            \"effect\": \"Source progression line 5186. This is the one School Mastery progression grant, not a second school choice or duplicate feat. Increase the level-1 Arcane School spell-attack and spell-save bonus from +1 to +2 total. Its school passive and bonus-spell rules otherwise remain unchanged.\",\n            \"prerequisite\": \"See class engine and progression.\",\n            \"source\": {\n              \"line\": 5186,\n              \"reference\": null,\n              \"originalText\": \"| 5 | Bonus Feat: School Mastery |\",\n              \"status\": \"source-derived\"\n            },\n            \"designStatus\": \"provisional-playtest\",\n            \"spellRank\": null\n          },\n          {\n            \"id\": \"wizard.supplement.arcane-ward\",\n            \"name\": \"Arcane Ward\",\n            \"className\": \"Wizard\",\n            \"band\": \"Arch\",\n            \"path\": null,\n            \"sourceKind\": \"supplement\",\n            \"minimumClassLevel\": 6,\n            \"acquisition\": \"automatic\",\n            \"activation\": \"Passive\",\n            \"cost\": \"0\",\n            \"rangeAndTarget\": \"Self\",\n            \"duration\": \"Until next long rest\",\n            \"frequency\": \"Choose after each long rest\",\n            \"effect\": \"Source progression line 5187. After preparing spells, choose one of acid, cold, fire, force, lightning, necrotic, psychic, radiant or thunder that is dealt by at least one prepared spell of your Arcane School. Gain resistance to that damage type until your next long rest. If none of your prepared school spells deals a damage type, choose force. This is provisional completion of the source's ambiguous 'chosen school's element' wording.\",\n            \"prerequisite\": \"See class engine and progression.\",\n            \"source\": {\n              \"line\": 5187,\n              \"reference\": null,\n              \"originalText\": \"| 6 | Arcane Ward (resistance to chosen school's element) |\",\n              \"status\": \"source-derived\"\n            },\n            \"designStatus\": \"provisional-playtest\",\n            \"spellRank\": null\n          },\n          {\n            \"id\": \"wizard.supplement.dual-cast\",\n            \"name\": \"Dual Cast\",\n            \"className\": \"Wizard\",\n            \"band\": \"Arch\",\n            \"path\": null,\n            \"sourceKind\": \"supplement\",\n            \"minimumClassLevel\": 9,\n            \"acquisition\": \"automatic\",\n            \"activation\": \"Action\",\n            \"cost\": \"Pay the complete RP costs of both spells\",\n            \"rangeAndTarget\": \"As each spell\",\n            \"duration\": \"As each spell\",\n            \"frequency\": \"1/short rest\",\n            \"effect\": \"Source progression line 5188. Choose two DIFFERENT prepared Wizard spells of rank 1 or 2, neither of which summons a creature or grants an additional Action. Cast both sequentially as one Action, paying both RP costs. They cannot both require concentration. Each matrix separately updates first-cast/Refrain history. Features that trigger merely from 'casting a spell' may trigger once for each actual matrix unless that feature itself says once per turn; no trigger may create another Dual Cast or additional full Action.\",\n            \"prerequisite\": \"See class engine and progression.\",\n            \"source\": {\n              \"line\": 5188,\n              \"reference\": null,\n              \"originalText\": \"| 9 | Dual Cast (cast 2 Tier 1–2 spells in a round) |\",\n              \"status\": \"source-derived\"\n            },\n            \"designStatus\": \"provisional-playtest\",\n            \"spellRank\": null\n          },\n          {\n            \"id\": \"wizard.supplement.overchannel\",\n            \"name\": \"Overchannel\",\n            \"className\": \"Wizard\",\n            \"band\": \"Hero\",\n            \"path\": null,\n            \"sourceKind\": \"supplement\",\n            \"minimumClassLevel\": 13,\n            \"acquisition\": \"automatic\",\n            \"activation\": \"Triggered\",\n            \"cost\": \"Pay the Core V 2 RP cost for one rank above the spell's normal cast rank\",\n            \"rangeAndTarget\": \"One prepared spell you are beginning to cast\",\n            \"duration\": \"For that cast\",\n            \"frequency\": \"1/long rest\",\n            \"effect\": \"Source progression line 5190. Cast one prepared spell as though it were one rank higher than the highest rank at which you could normally cast that SAME spell, provided the spell has an explicit higher-rank scaling rule. Overchannel does not teach or prepare a higher-rank spell, cannot exceed effective rank 9 and cannot be combined with another generic Overcast rule during this pilot. All normal Dissonance/Refrain rules still apply.\",\n            \"prerequisite\": \"See class engine and progression.\",\n            \"source\": {\n              \"line\": 5190,\n              \"reference\": null,\n              \"originalText\": \"| 13 | Overchannel (cast a spell 1 tier higher once/day) |\",\n              \"status\": \"source-derived\"\n            },\n            \"designStatus\": \"provisional-playtest\",\n            \"spellRank\": null\n          }\n        ],\n        \"completeEngine\": [\n          \"PROVISIONAL PLAYTEST CONTRACT. Intelligence is the Wizard class ability. S = 1/2/3/4 at Wizard levels 1/5/11/17. M = max(1, Intelligence modifier). Wizard spell attack = d20 + normal character proficiency bonus + Intelligence modifier. Wizard spell save DC = 8 + normal character proficiency bonus + Intelligence modifier.\",\n          \"The Wizard remains three distinct stages: Base Wizard at levels 1-2, Arch Arcanist at levels 3-9, and one Hero path at levels 10-20: Spellbinder, Elementalist or Necromancer. Hero paths are not additional starting classes and their features cannot be selected before their Wizard class-level gates.\",\n          \"SPELLBOOK. At Wizard 1 your spellbook contains six chosen rank-1 Wizard spells. Arcane School Specialization also adds one legal rank-1 bonus spell of your chosen school without replacing one of those six. For this provisional progression, add 2 legal Wizard spells to the book at each Wizard level 2-4, 3 at each level 5-8, 4 at each level 9-12, 5 at each level 13-16 and 6 at each level 17-20. Level-up additions cost no money or scribing time.\",\n          \"LEGAL RANKS. Maximum Wizard spell rank by Wizard class level is: rank 1 at levels 1-2, rank 2 at 3-4, rank 3 at 5-6, rank 4 at 7-8, rank 5 at 9-10, rank 6 at 11-12, rank 7 at 13-14, rank 8 at 15-16 and rank 9 at 17-20. Grand Tier at level 20 is a special casting permission, not a tenth ordinary rank. A Wizard may learn Wizard-list spells from any school up to the legal rank unless a spell itself has an additional prerequisite.\",\n          \"PREPARED SPELL MATRIX. After a long rest, prepare a number of matrices equal to Wizard level + Intelligence modifier, minimum 1, selecting only spells currently recorded in your spellbook and within your legal rank. You cast ordinary Wizard spells only from prepared matrices unless a feature explicitly overrides that restriction. Preparing the full daily matrix set normally requires 1 hour of spellbook study. Matrix Efficiency reduces this to 45 minutes.\",\n          \"DUPLICATE PREPARATION. You may prepare the same spell more than once, primarily to carry different Matrix Mastery configurations. Duplicate copies never create additional first-cast Dissonance exemptions. For Refrain and the protected strain rule, all prepared copies sharing the same underlying spell name belong to one matrix family regardless of modification.\",\n          \"MIDDAY SUBSTITUTION. Once between long rests, you may perform a 10-minute Spellbook Study ritual to replace one prepared matrix with another legal spell from your spellbook. The replacement cannot exceed your legal Wizard rank. Sigil Rewrite and Matrix Mastery may improve this process as explicitly stated.\",\n          \"SPELL ACQUISITION BY SCRIBING. A found Wizard spell may be copied into the spellbook if its rank is legal for you. Baseline scribing requires 2 hours and 50 gp of inks/materials per spell rank, treating rank 0 as 1 for this calculation. Spell Scribing halves both values to 1 hour and 25 gp per rank. Failure to finish the work consumes no spellbook entry but materials already expended during an interrupted hour are lost.\",\n          \"SPELLBOOK LOSS. Losing the spellbook does not erase matrices currently prepared in memory; you may continue casting those prepared matrices until you next rebuild or change preparation. A blank replacement book can be seeded with your currently prepared spells at 1 hour and 25 gp per effective spell rank each. An unprepared spell you previously recorded can be reconstructed from memory with 8 hours, 100 gp per rank and an Intelligence (Arcana) check against DC 10 + spell rank. Failure consumes that attempt's time and half its materials; another attempt can be made after a long rest. Recovering the original book automatically restores access to its surviving entries.\",\n          \"ARCANE SCHOOL SPECIALIZATION is automatic at Wizard 1. Choose exactly one of the eight schools. Your spell attacks with that school gain +1 and your Wizard save DC for that school's spells gains +1. You also add one legal rank-1 spell of that school to the spellbook. The source table explicitly supplies seven school passives; the eighth core school, Abjuration, is named elsewhere but its passive row is missing. Its provisional playtest passive is identified below rather than silently presented as recovered text.\",\n          \"ABJURATION, provisional completion for the omitted eighth row: once per round after you cast an Abjuration spell, gain temporary HP equal to PB until the start of your next regular turn. CONJURATION: creatures summoned by your Wizard spells gain +1 maximum HP per Wizard level. DIVINATION: once per long rest reroll one failed saving throw and use the new result. ENCHANTMENT: when a creature fails its initial save against one of your Enchantment spells, a printed control duration of at least 1 round may last one additional round, but every normally allowed repeat save still occurs. EVOCATION: when casting an area Evocation spell, exclude one creature from its initial damaging area; that creature automatically succeeds and takes no damage if success normally halves damage. ILLUSION: gain +2 on concentration saves made to maintain Illusion spells. NECROMANCY: once per turn during a real encounter when a hostile non-summoned creature dies from your Necromancy spell, gain 1 temporary HP; it is not permanent healing. TRANSMUTATION: after casting a Transmutation spell, gain +5 feet Speed until the end of that turn.\",\n          \"PROTECTED DISSONANCE INTERFACE. The first cast of each different prepared matrix family during an encounter generates 0 BASE Dissonance. This exemption affects only base strain. Refrain and explicitly printed strain costs still apply; the suite disables generic Overcast and does not layer historical Burn onto Dissonance. Repeating a matrix family follows normal Refrain immediately. Preparing duplicates or differently modified copies of the same underlying spell never refreshes the exemption.\",\n          \"Core Systems V 2 Resonance Points and spell-rank RP costs are authoritative for Wizard spellcasting. There are no historical spell slots in this pilot. Wizard cards tagged wizard-spell are always-prepared class matrices once acquired, do not consume a daily prepared-matrix position and use the same RP, concentration, Refrain and protected first-distinct-matrix rules as other Wizard spells. Their printed RP cost replaces any generic rank cost; never pay both.\",\n          \"RITUAL CASTING is automatic at Wizard 2. A Wizard spell in your spellbook with the Ritual tag can be cast from the book without being prepared by increasing its casting time by at least 10 minutes. A ritual cast costs 0 RP unless that ritual explicitly lists a consumed RP cost, cannot be used during an encounter and cannot generate or vent Dissonance through ordinary casting strain.\",\n          \"Only one concentration effect can normally be maintained. Starting a second concentration effect ends the first. Damage uses the current Core Systems concentration rule; required half-damage rounding is down for this pilot. Spell Tether and the level-17 Tethered Cast are the only Wizard-specific exceptions in this draft, and each has an explicit RP price, duration and one-tether cap.\",\n          \"MATRIX MASTERY MODIFICATIONS. After acquiring Matrix Mastery, each prepared ordinary spell matrix may carry at most one modification chosen during preparation. QUICK SUBSTITUTION: once per short rest, replace one matrix marked Quick Substitution with another spellbook spell of exactly the same rank using a 1-minute ritual instead of the normal 10-minute midday swap; the replacement loses the modification until the next long rest. COMPONENT ENHANCEMENT: when casting a damaging or healing matrix, spend 1 additional RP to add one extra die of the spell's primary damage or healing die to one roll; if the spell has no such die this modification has no effect. MATRIX LINKING: pair two different prepared matrix families during preparation; after legally casting one, the other costs 1 less RP, minimum 1, if cast before the end of your next regular turn, at most once per pair per round. STABILITY REINFORCEMENT: gain +2 on concentration saves caused by damage while maintaining that matrix. A matrix modification never creates another spell cast or proc event.\",\n          \"All sources share a maximum of one additional full Action per creature per round. Additional Actions cannot grant another additional Action, Bonus Action or Reaction. Spell copies, Matrix Sharing, Arcane Fusion, Dual Cast and similar effects pay all explicitly required RP and do not produce duplicate resource, cast-proc or action-grant chains beyond their written resolution.\",\n          \"Round recharge counters decrease once at the start of your regular initiative turn even if you cannot act. Extra Actions and extra turns do not tick recharge. Outside initiative, each uninterrupted 6 seconds counts as one tick. Only positive counters can be reset or shortened and each named ability can receive at most one reset or shortening per round.\",\n          \"SUMMON COMMAND LIMIT. All Wizard-controlled conjured, raised and bound companions share one damaging/control Companion Command per Wizard regular turn. Spend one Bonus Action to command exactly one such creature to move up to its Speed and use one damaging or control action from its stat block. Uncommanded creatures may reposition defensively and take Dodge but cannot deal damage or impose conditions. No summoned or raised creature can create XP, treasure, RP, Dissonance relief, additional corpses or kill-resource farms.\",\n          \"NECROMANCER STANDARD UNDEAD. Corpse Harvest and Auto-Raise share a maximum of three standard raised minions. Skeleton: AC 14, HP 6 + 2 × Wizard level, Speed 30; Bone Shot, range 30 feet, Wizard spell attack, 1d6+S necrotic. Zombie: AC 12, HP 10 + 3 × Wizard level, Speed 20; Slam, reach 5 feet, Wizard spell attack, 1d8+S necrotic. Goblin Thrall, available only from a goblinoid corpse: AC 13, HP 8 + 2 × Wizard level, Speed 30; Shiv, reach 5 feet, Wizard spell attack, 1d6+S necrotic. These are pre-Flesh-Ascendant statistics.\",\n          \"NECROMANCER AUTO-RAISE. Once per round when one of your standard undead minions personally lands the killing blow on an eligible humanoid and your standard-minion count is below three, its corpse rises at the end of the current turn as the same mechanical minion type that scored the kill, if physically possible. A new minion cannot act during that same round. Auto-Raise costs no Action or RP but can never exceed the three-minion cap or generate a new resource, corpse chain, XP or treasure event. Without Infernal Pact only humanoids qualify.\",\n          \"ELITE UNDEAD PETS. Necromancers may bind Boneflayer, Dreadblade and Wraithbound, at most one of each and three elite pets total. They use the same shared Companion Command limit as standard undead. Boneflayer: AC 14, HP 12 + 2 × Wizard level, Speed 30. Bone Shards: range 60, Wizard spell attack, 2d6+S necrotic. Fear Pulse replaces its attack: enemies within 10 feet make Wisdom saves; failure Frightened until end of next turn; recharge 3. Grave Miasma replaces its attack: 10-foot-radius point within 30 feet until start of your next turn; enemies entering or starting there take 1d6 necrotic once; recharge 3.\",\n          \"Dreadblade: AC 16, HP 16 + 3 × Wizard level, Speed 30. Disrupting Blade: reach 5 feet, Wizard spell attack, 1d8+S necrotic; a concentrating target immediately makes its concentration save with disadvantage. On a natural 20 the target is Weakened until the end of its next turn, taking -1 on attack rolls. Dreadblade has advantage on saves against forced movement.\",\n          \"Wraithbound: AC 14, HP 10 + 2 × Wizard level, Fly 40 and hover. While it has not attacked or imposed control since the end of its previous turn it is Invisible; attacking ends that state until the end of its next turn. Wraith Strike: reach 5 feet, Wizard spell attack, 1d8+S necrotic. On natural 20 the target makes a Constitution save against your Wizard DC; failure Stuns until the end of its next turn.\",\n          \"Flesh Ascendant's bonus applies after the listed base statistics: every undead creature you control gains +2 maximum HP per Wizard level. If at least two of your undead creatures are active, each gains +1 AC and +1 on saving throws. This does not increase the standard-minion or elite-pet caps.\",\n          \"DARK-TRAUMA INTERFACE. Necromancer features involving corpse desecration, infernal bargains, domination, body control or Mind Prison remain subject to the project's existing dark-content and trauma boundaries. A table may fade description to black without changing mechanics. No feature changes a player's real belief, permanently transfers ownership of a player character or silently retires a PC.\",\n          \"PROPOSED ACQUISITION. Wizard 1 automatically gains Arcane School Specialization, Spell Matrix System and the starting spellbook, then chooses 4 selectable Base cards, at least 2 Active. Wizard 2 automatically gains Counterspell and Ritual Casting, then chooses 2 additional selectable Base cards. Counterspell is not also placed in the Arch selection pool.\",\n          \"At Wizard 3 enter Arcanist, automatically gain Arcane Tradition as an upgrade of the SAME level-1 school rather than choosing another school, and choose 2 selectable Arch cards, at least 1 Active. Wizard 4 grants one eligible Base/Arch choice. Wizard 5 grants one Base/Arch choice plus automatic School Mastery. Wizard 6 grants one Base/Arch choice plus automatic Arcane Ward. Wizard 7 grants one eligible Arch choice. Wizard 8 grants one Base/Arch choice. Wizard 9 grants one eligible Arch choice plus automatic Dual Cast.\",\n          \"At Wizard 10 choose Spellbinder, Elementalist or Necromancer and gain 2 Hero cards from that path. ELEMENTALIST EXCEPTION: Elemental Affinity is automatic at path selection and counts as one of those two level-10 Hero acquisitions, so an Elementalist chooses only one additional Hero card at level 10. Levels 11, 13, 15, 17 and 19 each grant one eligible unselected Base/Arch choice. Levels 12, 14, 16 and 18 each grant one Hero-path choice. The chosen Final Theorem is automatic at Wizard 20. School Mastery, Counterspell, Arcane Tradition and all progression-table automatic features are never duplicated as selections.\",\n          \"All acquisition gates use Wizard class level rather than total character level. Normal proficiency bonus follows the game's ordinary total-character-level rule. A multiclass dip cannot unlock higher spell ranks, Arcanist cards, Hero cards, Final Theorems or progression-table features.\",\n          \"Class matrices tagged wizard-spell receive a rank in normalized card data equal to maximum ordinary Wizard rank at their minimum class-level gate (cap 9). Printed RP cost replaces generic rank cost. Counterspell is rank 1 at its explicit level 2 automatic grant. This explicit convention closes rank-dependent Counterspell/Dissonance interactions without inventing extra costs.\",\n          \"Cantrip completion: know 3 Wizard cantrips at 1, 4 at 4, 5 at 10, using the shared missing-repertoire fallback. Cantrips are known directly and do not consume prepared matrices. Always-prepared class matrices are additional cards, not extra arbitrary ordinary spells. Class spell ranks and the normalized activation field resolve incomplete source terminology.\"\n        ],\n        \"source\": {\n          \"path\": \"DescentReviewChanges/ReviewBible/data/public/class_playtests/wizard.json\",\n          \"pointers\": [\n            \"/engine\",\n            \"/schedule\",\n            \"/cards\",\n            \"/rpByClassLevel/12\"\n          ]\n        },\n        \"optionalChoicesInCases\": \"No Matrix Mastery, Spell Efficiency, Improved Concentration, Sigil Authority or Knowledge Shield acquired. Dual Cast, Overchannel, class Arcane Shield and optional Counterpulse are not invoked unless expressly declared. No Arcane Feedback at13.\",\n        \"creatureType\": \"Humanoid\",\n        \"profileScope\": \"An explicitly supplied finite class-built teaching creature profile using the complete actual class engine/cards. Not a newly rated bestiary creature, not authenticated campaign or ancestry acquisition, and not permission to fill an absent future profile.\",\n        \"languages\": [\n          \"Common\"\n        ],\n        \"otherIntrinsicDefenses\": [],\n        \"additionalSkillProficienciesClaimed\": [],\n        \"checks\": \"Use current ability modifier and actual acquired named card when applicable; save proficiency is not an ability-check proficiency. No Athletics proficiency is claimed.\",\n        \"actualActionsAvailable\": \"Each annotated actual regular START supplies the normal Action/BonusAction/Reaction/movement according to the real source; the event trace explicitly consumes each used budget. No extra action source is assumed.\",\n        \"asiHistory\": {\n          \"rolledINT\": 16,\n          \"class4\": \"INT+2 to18\",\n          \"class8\": \"STR+2 from8 to10\",\n          \"class12\": \"CHA+2 from8 to10\",\n          \"DEX\": 14,\n          \"CON\": 14,\n          \"WIS\": 12,\n          \"note\": \"Explicit legal generated-score/ASI fixture inputs; no extra feat is claimed.\"\n        }\n      },\n      \"donor\": {\n        \"kind\": \"Source-qualified illustrative character, not a verified campaign actor or rated monster\",\n        \"class\": \"Wizard\",\n        \"classLevel\": 13,\n        \"totalLevel\": 13,\n        \"PB\": 5,\n        \"S\": 3,\n        \"STR\": 10,\n        \"DEX\": 14,\n        \"CON\": 14,\n        \"INT\": 18,\n        \"WIS\": 12,\n        \"CHA\": 10,\n        \"maxHp\": 80,\n        \"hpConstruction\": \"d6 class: initial6+CON2=8, twelve supplied legal hit-die results4+CON2=6 each;8+72=80. This is a stated fixture history, not generated random character evidence.\",\n        \"maxRp\": 48,\n        \"maxRank\": 7,\n        \"Limit\": 11,\n        \"AC\": 12,\n        \"speedFeet\": 30,\n        \"size\": \"Medium\",\n        \"bodyBoxFeet\": [\n          5,\n          5,\n          5\n        ],\n        \"bodyMassLb\": 170,\n        \"actualGear\": {\n          \"focus-pack\": {\n            \"grossWeightLb\": 10,\n            \"load\": 1,\n            \"contents\": \"real ordinary wooden focus and mundane personal carrying effects; no consumed materials/charged item; gross figures include every item once\"\n          }\n        },\n        \"saves\": {\n          \"STR\": 0,\n          \"DEX\": 2,\n          \"CON\": 2,\n          \"INT\": 9,\n          \"WIS\": 6,\n          \"CHA\": 0\n        },\n        \"spellAttack\": 9,\n        \"spellDc\": 17,\n        \"school\": \"Illusion\",\n        \"schoolAttack\": 11,\n        \"schoolDc\": 19,\n        \"schoolConcentrationSave\": 4,\n        \"ordinaryConcentrationSave\": 2,\n        \"arcaneWard\": \"force resistance: this prepared Illusion set has no intrinsic damage type; no fire/cold/psychic resistance invented\",\n        \"hero\": \"Spellbinder\",\n        \"bookAndPreparation\": {\n          \"newRank7BookAdditionsAt13\": [\n            \"cast-echo\",\n            \"meta-surge\",\n            \"erase-from-reality\",\n            \"sequester\",\n            \"simulacrum\"\n          ],\n          \"ordinaryPrepared\": [\n            \"cast-echo\",\n            \"meta-surge\",\n            \"erase-from-reality\",\n            \"sequester\",\n            \"simulacrum\",\n            \"fireball\",\n            \"shield\",\n            \"counterspell\",\n            \"continual-flame\",\n            \"mirror-image\",\n            \"detect-magic\",\n            \"true-seeing\"\n          ],\n          \"count\": 12,\n          \"baseCapacity\": 17,\n          \"additionalFloatingAndSchoolSlotsUnused\": true,\n          \"olderSpells\": \"Actual source-qualified book/cantrip additions at earlier legal Wizard levels; ordinary Counterspell acquired at5+, True Seeing at11, Continual Flame at3; no feat or copying grant needed.\",\n          \"ordinaryKnownCantrips\": [\n            \"ray-of-frost\",\n            \"chill-touch\",\n            \"resonance-shield\",\n            \"minor-image\",\n            \"disrupt-memory\"\n          ],\n          \"unusedBaseMatrixPositions\": 5\n        },\n        \"selectedAcquisition\": [\n          {\n            \"classLevel\": 1,\n            \"cards\": [\n              {\n                \"id\": \"wizard.base.arcane-recovery\",\n                \"name\": \"Arcane Recovery\",\n                \"className\": \"Wizard\",\n                \"band\": \"Base\",\n                \"path\": null,\n                \"sourceKind\": \"passive\",\n                \"minimumClassLevel\": 1,\n                \"acquisition\": \"selection\",\n                \"activation\": \"Passive\",\n                \"cost\": \"0\",\n                \"rangeAndTarget\": \"Self\",\n                \"duration\": \"Instantaneous during a completed short rest\",\n                \"frequency\": \"1/long rest\",\n                \"effect\": \"Arcane Recovery. Tags: base, passive, resonance. Once between long rests when you complete a short rest, restore RP equal to half your Wizard class level rounded up, never above your normal maximum. This is RP recovery, not a second pool, and cannot trigger spell-cast, Refrain or Dissonance effects.\",\n                \"source\": {\n                  \"extract\": \"docs/reference/Player_Rulebook_v6_source_text.txt\",\n                  \"line\": 5196,\n                  \"originalText\": \"Arcane Recovery: Once per day during a short rest, recover RP equal to half your Wizard level (rounded up), up to your normal maximum.\"\n                },\n                \"designStatus\": \"provisional-playtest\",\n                \"spellRank\": null\n              },\n              {\n                \"id\": \"wizard.base.spell-scribing\",\n                \"name\": \"Spell Scribing\",\n                \"className\": \"Wizard\",\n                \"band\": \"Base\",\n                \"path\": null,\n                \"sourceKind\": \"passive\",\n                \"minimumClassLevel\": 1,\n                \"acquisition\": \"selection\",\n                \"activation\": \"Passive\",\n                \"cost\": \"0\",\n                \"rangeAndTarget\": \"Your spellbook\",\n                \"duration\": \"Permanent\",\n                \"frequency\": \"Always\",\n                \"effect\": \"Spell Scribing. Tags: base, passive, spellbook. Copying a legal found Wizard spell into your spellbook requires 1 hour and 25 gp of inks and components per spell rank, treating rank 0 as rank 1 for this calculation, instead of the pilot baseline 2 hours and 50 gp. Level-up spells remain free.\",\n                \"source\": {\n                  \"extract\": \"docs/reference/Player_Rulebook_v6_source_text.txt\",\n                  \"line\": 5197,\n                  \"originalText\": \"Spell Scribing: Copy spells into your spellbook at half the normal cost and time.\"\n                },\n                \"designStatus\": \"provisional-playtest\",\n                \"spellRank\": null\n              },\n              {\n                \"id\": \"wizard.base.arcane-bolt\",\n                \"name\": \"Arcane Bolt\",\n                \"className\": \"Wizard\",\n                \"band\": \"Base\",\n                \"path\": null,\n                \"sourceKind\": \"active\",\n                \"minimumClassLevel\": 1,\n                \"acquisition\": \"selection\",\n                \"activation\": \"Action\",\n                \"cost\": \"1 RP\",\n                \"rangeAndTarget\": \"One creature within 60 feet\",\n                \"duration\": \"Instantaneous\",\n                \"frequency\": \"At will while RP remains\",\n                \"effect\": \"Arcane Bolt. Tags: base, active, wizard-spell, universal, damage. Make a Wizard spell attack. On a hit deal S d6 + M force damage. Arcane Bolt is an always-prepared class matrix once acquired and uses the normal first-distinct-matrix and Refrain rules.\",\n                \"source\": {\n                  \"extract\": \"docs/reference/Player_Rulebook_v6_source_text.txt\",\n                  \"line\": 5203,\n                  \"originalText\": \"Arcane Bolt: Launch a bolt of pure arcane energy that deals force damage to a single target.\"\n                },\n                \"designStatus\": \"provisional-playtest\",\n                \"spellRank\": 1\n              },\n              {\n                \"id\": \"wizard.base.minor-conjuration\",\n                \"name\": \"Minor Conjuration\",\n                \"className\": \"Wizard\",\n                \"band\": \"Base\",\n                \"path\": null,\n                \"sourceKind\": \"active\",\n                \"minimumClassLevel\": 1,\n                \"acquisition\": \"selection\",\n                \"activation\": \"Action\",\n                \"cost\": \"1 RP\",\n                \"rangeAndTarget\": \"One unoccupied space within 10 feet\",\n                \"duration\": \"1 hour\",\n                \"frequency\": \"At will while RP remains; one object at a time\",\n                \"effect\": \"Minor Conjuration. Tags: base, active, wizard-spell, conjuration. Create one nonmagical unattended object that fits inside a 1-foot cube, weighs no more than 10 pounds and is made of common nonvaluable material such as wood, cloth, clay, iron or glass. It cannot be food, poison, currency, a spell component with listed cost, ammunition with special properties or a functional complex mechanism. Creating another dismisses the first.\",\n                \"source\": {\n                  \"extract\": \"docs/reference/Player_Rulebook_v6_source_text.txt\",\n                  \"line\": 5204,\n                  \"originalText\": \"Minor Conjuration: Create a temporary, small inanimate object that lasts for 1 hour.\"\n                },\n                \"designStatus\": \"provisional-playtest\",\n                \"spellRank\": 1\n              }\n            ]\n          },\n          {\n            \"classLevel\": 2,\n            \"cards\": [\n              {\n                \"id\": \"wizard.base.arcane-insight\",\n                \"name\": \"Arcane Insight\",\n                \"className\": \"Wizard\",\n                \"band\": \"Base\",\n                \"path\": null,\n                \"sourceKind\": \"passive\",\n                \"minimumClassLevel\": 1,\n                \"acquisition\": \"selection\",\n                \"activation\": \"Passive\",\n                \"cost\": \"0\",\n                \"rangeAndTarget\": \"Self\",\n                \"duration\": \"Permanent\",\n                \"frequency\": \"Always\",\n                \"effect\": \"Arcane Insight. Tags: base, passive, knowledge. Gain proficiency in Arcana, or expertise if already proficient. When examining an active magical effect, spell residue, magic item or arcane construction, you may make an Intelligence (Arcana) check to determine its broad school, function or unusual matrix behavior. The Director sets the normal knowledge DC; failure supplies no invented fact.\",\n                \"source\": {\n                  \"extract\": \"docs/reference/Player_Rulebook_v6_source_text.txt\",\n                  \"line\": 5198,\n                  \"originalText\": \"Arcane Insight: Identify magical effects and items with greater accuracy than non-wizards.\"\n                },\n                \"designStatus\": \"provisional-playtest\",\n                \"spellRank\": null\n              },\n              {\n                \"id\": \"wizard.base.matrix-efficiency\",\n                \"name\": \"Matrix Efficiency\",\n                \"className\": \"Wizard\",\n                \"band\": \"Base\",\n                \"path\": null,\n                \"sourceKind\": \"passive\",\n                \"minimumClassLevel\": 1,\n                \"acquisition\": \"selection\",\n                \"activation\": \"Passive\",\n                \"cost\": \"0\",\n                \"rangeAndTarget\": \"Self\",\n                \"duration\": \"Daily preparation\",\n                \"frequency\": \"Always\",\n                \"effect\": \"Matrix Efficiency. Tags: base, passive, matrix. Your normal full daily Spell Matrix preparation time is reduced from 1 hour to 45 minutes. This does not reduce the separate 10-minute midday substitution ritual, spell scribing, rituals or spellbook reconstruction unless another feature explicitly says so.\",\n                \"source\": {\n                  \"extract\": \"docs/reference/Player_Rulebook_v6_source_text.txt\",\n                  \"line\": 5199,\n                  \"originalText\": \"Matrix Efficiency: Reduce the preparation time for spells by 25%.\"\n                },\n                \"designStatus\": \"provisional-playtest\",\n                \"spellRank\": null\n              }\n            ]\n          },\n          {\n            \"classLevel\": 3,\n            \"cards\": [\n              {\n                \"id\": \"wizard.arch.floating-preparation\",\n                \"name\": \"Floating Preparation\",\n                \"className\": \"Wizard\",\n                \"band\": \"Arch\",\n                \"path\": null,\n                \"sourceKind\": \"passive\",\n                \"minimumClassLevel\": 3,\n                \"acquisition\": \"selection\",\n                \"activation\": \"Passive\",\n                \"cost\": \"0\",\n                \"rangeAndTarget\": \"Self\",\n                \"duration\": \"Daily preparation\",\n                \"frequency\": \"Always\",\n                \"effect\": \"Floating Preparation. Tags: arch, passive, matrix. Increase your maximum prepared Spell Matrix count by 1. The extra matrix can come from any school and obeys all ordinary spellbook and rank restrictions. It is a prepared matrix for every rule, including protected strain, duplicate-family tracking and Matrix Mastery modifications.\",\n                \"source\": {\n                  \"extract\": \"docs/reference/Player_Rulebook_v6_source_text.txt\",\n                  \"line\": 5213,\n                  \"originalText\": \"Floating Preparation: Prepare 1 extra spell from any school each day\"\n                },\n                \"designStatus\": \"provisional-playtest\",\n                \"spellRank\": null\n              },\n              {\n                \"id\": \"wizard.arch.arcane-lock\",\n                \"name\": \"Arcane Lock\",\n                \"className\": \"Wizard\",\n                \"band\": \"Arch\",\n                \"path\": null,\n                \"sourceKind\": \"active\",\n                \"minimumClassLevel\": 3,\n                \"acquisition\": \"selection\",\n                \"activation\": \"Action\",\n                \"cost\": \"2 RP\",\n                \"rangeAndTarget\": \"One door, chest, portal or unattended object within touch\",\n                \"duration\": \"8 hours\",\n                \"frequency\": \"Recharge 2 rounds\",\n                \"effect\": \"Arcane Lock. Tags: arch, active, wizard-spell, abjuration. Magically seal the target. Opening it without your permission requires a Strength check or thieves'/arcane-tool check against your Wizard spell DC. Dispel Magic can end the lock. You can designate up to M creatures who can bypass it. This does not make the object physically indestructible.\",\n                \"source\": {\n                  \"extract\": \"docs/reference/Player_Rulebook_v6_source_text.txt\",\n                  \"line\": 5223,\n                  \"originalText\": \"Arcane Lock: Create a magical barrier that prevents entry or access to an object or area.\"\n                },\n                \"designStatus\": \"provisional-playtest\",\n                \"spellRank\": 2\n              }\n            ]\n          },\n          {\n            \"classLevel\": 4,\n            \"cards\": [\n              {\n                \"id\": \"wizard.base.scholarly-mind\",\n                \"name\": \"Scholarly Mind\",\n                \"className\": \"Wizard\",\n                \"band\": \"Base\",\n                \"path\": null,\n                \"sourceKind\": \"passive\",\n                \"minimumClassLevel\": 1,\n                \"acquisition\": \"selection\",\n                \"activation\": \"Passive\",\n                \"cost\": \"0\",\n                \"rangeAndTarget\": \"Self\",\n                \"duration\": \"Permanent\",\n                \"frequency\": \"Always\",\n                \"effect\": \"Scholarly Mind. Tags: base, passive, knowledge. You have advantage on Intelligence checks whose primary purpose is recalling, researching or analyzing arcane theory, magical history, planar magical principles or constructed spell formulae. It does not grant advantage on spell attacks, Counterspell checks or general Investigation unrelated to arcane scholarship.\",\n                \"source\": {\n                  \"extract\": \"docs/reference/Player_Rulebook_v6_source_text.txt\",\n                  \"line\": 5200,\n                  \"originalText\": \"Scholarly Mind: Gain advantage on Intelligence checks related to arcane knowledge.\"\n                },\n                \"designStatus\": \"provisional-playtest\",\n                \"spellRank\": null\n              }\n            ]\n          },\n          {\n            \"classLevel\": 5,\n            \"cards\": [\n              {\n                \"id\": \"wizard.arch.dispel-magic\",\n                \"name\": \"Dispel Magic\",\n                \"className\": \"Wizard\",\n                \"band\": \"Arch\",\n                \"path\": null,\n                \"sourceKind\": \"active\",\n                \"minimumClassLevel\": 5,\n                \"acquisition\": \"selection\",\n                \"activation\": \"Action\",\n                \"cost\": \"3 RP\",\n                \"rangeAndTarget\": \"One creature, object or magical effect within 60 feet\",\n                \"duration\": \"Instantaneous\",\n                \"frequency\": \"Recharge 2 rounds\",\n                \"effect\": \"Dispel Magic. Tags: arch, active, wizard-spell, abjuration. Choose one ongoing spell effect you can perceive. If its rank is 3 or lower, end it. If it is rank 4 or higher, make an Intelligence check adding proficiency against DC 10 + spell rank; success ends it. Permanent artifact properties and effects explicitly immune to dispelling are unaffected.\",\n                \"source\": {\n                  \"extract\": \"docs/reference/Player_Rulebook_v6_source_text.txt\",\n                  \"line\": 5224,\n                  \"originalText\": \"Dispel Magic: End magical effects in an area or on a target.\"\n                },\n                \"designStatus\": \"provisional-playtest\",\n                \"spellRank\": 3\n              }\n            ]\n          },\n          {\n            \"classLevel\": 6,\n            \"cards\": [\n              {\n                \"id\": \"wizard.arch.arcane-sight\",\n                \"name\": \"Arcane Sight\",\n                \"className\": \"Wizard\",\n                \"band\": \"Arch\",\n                \"path\": null,\n                \"sourceKind\": \"active\",\n                \"minimumClassLevel\": 3,\n                \"acquisition\": \"selection\",\n                \"activation\": \"Action\",\n                \"cost\": \"2 RP\",\n                \"rangeAndTarget\": \"Self; 60-foot sight\",\n                \"duration\": \"Concentration, maximum 10 minutes\",\n                \"frequency\": \"Recharge 2 rounds\",\n                \"effect\": \"Arcane Sight. Tags: arch, active, wizard-spell, divination, concentration. While active you perceive magical auras within 60 feet and automatically know each visible aura's school or broad magical category. As an Action on a later turn, examine one aura to learn whether it is concentrated, summoned, cursed, warded or linked to another visible magical effect. Total cover blocks sight.\",\n                \"source\": {\n                  \"extract\": \"docs/reference/Player_Rulebook_v6_source_text.txt\",\n                  \"line\": 5226,\n                  \"originalText\": \"Arcane Sight: See magical auras and effects for a short duration.\"\n                },\n                \"designStatus\": \"provisional-playtest\",\n                \"spellRank\": 2\n              }\n            ]\n          },\n          {\n            \"classLevel\": 7,\n            \"cards\": [\n              {\n                \"id\": \"wizard.arch.dimensional-pocket\",\n                \"name\": \"Dimensional Pocket\",\n                \"className\": \"Wizard\",\n                \"band\": \"Arch\",\n                \"path\": null,\n                \"sourceKind\": \"active\",\n                \"minimumClassLevel\": 7,\n                \"acquisition\": \"selection\",\n                \"activation\": \"Ritual\",\n                \"cost\": \"3 RP\",\n                \"rangeAndTarget\": \"One point within 5 feet\",\n                \"duration\": \"8 hours\",\n                \"frequency\": \"1/long rest\",\n                \"effect\": \"Dimensional Pocket. Tags: arch, active, wizard-spell, conjuration, ritual. Create an extradimensional storage space holding up to 100 pounds or 10 cubic feet of unattended nonliving material. Retrieving or placing an item while adjacent to the opening uses an object interaction. Living creatures cannot enter. When duration ends, remaining contents appear harmlessly in the nearest unoccupied space.\",\n                \"source\": {\n                  \"extract\": \"docs/reference/Player_Rulebook_v6_source_text.txt\",\n                  \"line\": 5225,\n                  \"originalText\": \"Dimensional Pocket: Create a small extradimensional space to store items.\"\n                },\n                \"designStatus\": \"provisional-playtest\",\n                \"spellRank\": 4\n              }\n            ]\n          },\n          {\n            \"classLevel\": 8,\n            \"cards\": [\n              {\n                \"id\": \"wizard.base.analyze-magic\",\n                \"name\": \"Analyze Magic\",\n                \"className\": \"Wizard\",\n                \"band\": \"Base\",\n                \"path\": null,\n                \"sourceKind\": \"active\",\n                \"minimumClassLevel\": 1,\n                \"acquisition\": \"selection\",\n                \"activation\": \"Action\",\n                \"cost\": \"1 RP\",\n                \"rangeAndTarget\": \"One magical creature, object or effect within 30 feet\",\n                \"duration\": \"Instantaneous\",\n                \"frequency\": \"Recharge 1 round\",\n                \"effect\": \"Analyze Magic. Tags: base, active, wizard-spell, divination, knowledge. Make an Intelligence (Arcana) check against DC 10 + the effect's spell rank, treating a non-spell effect's Director-assigned tier as rank. On success learn its school or magical category, one active mechanical property and whether it is currently sustained, cursed or bound to another effect. Failure reveals only that magic is present.\",\n                \"source\": {\n                  \"extract\": \"docs/reference/Player_Rulebook_v6_source_text.txt\",\n                  \"line\": 5206,\n                  \"originalText\": \"Analyze Magic: Study a magical effect or item to gain insight into its properties and function.\"\n                },\n                \"designStatus\": \"provisional-playtest\",\n                \"spellRank\": 1\n              }\n            ]\n          },\n          {\n            \"classLevel\": 9,\n            \"cards\": [\n              {\n                \"id\": \"wizard.arch.sigil-rewrite\",\n                \"name\": \"Sigil Rewrite\",\n                \"className\": \"Wizard\",\n                \"band\": \"Arch\",\n                \"path\": null,\n                \"sourceKind\": \"passive\",\n                \"minimumClassLevel\": 3,\n                \"acquisition\": \"selection\",\n                \"activation\": \"Bonus Action\",\n                \"cost\": \"0\",\n                \"rangeAndTarget\": \"Self and spellbook\",\n                \"duration\": \"Instantaneous\",\n                \"frequency\": \"1/long rest\",\n                \"effect\": \"Sigil Rewrite. Tags: arch, passive-upgrade, matrix. Replace one prepared matrix with a different spell from your spellbook of exactly the same rank without performing the normal 10-minute ritual. The replacement receives no special Dissonance reset for a matrix family already used this encounter and must obey current Wizard rank eligibility.\",\n                \"source\": {\n                  \"extract\": \"docs/reference/Player_Rulebook_v6_source_text.txt\",\n                  \"line\": 5214,\n                  \"originalText\": \"Sigil Rewrite: Once/day, instantly swap a spell you know for another of the same tier\"\n                },\n                \"designStatus\": \"provisional-playtest\",\n                \"spellRank\": null\n              }\n            ]\n          },\n          {\n            \"classLevel\": 10,\n            \"cards\": [\n              {\n                \"id\": \"wizard.hero.spellbinder.spell-preservation\",\n                \"name\": \"Spell Preservation\",\n                \"className\": \"Wizard\",\n                \"band\": \"Hero\",\n                \"path\": \"Spellbinder\",\n                \"sourceKind\": \"passive\",\n                \"minimumClassLevel\": 10,\n                \"acquisition\": \"selection\",\n                \"activation\": \"Passive\",\n                \"cost\": \"0\",\n                \"rangeAndTarget\": \"Your spellbook\",\n                \"duration\": \"Permanent\",\n                \"frequency\": \"Always\",\n                \"effect\": \"Spell Preservation. Tags: hero, spellbinder, passive, spellbook. Your primary spellbook cannot be destroyed, erased or rendered permanently unreadable by non-artifact mundane or magical means. It can still be stolen, hidden, transported, suppressed, sealed by an artifact-level effect or voluntarily abandoned. Copies and backup books do not automatically receive this protection.\",\n                \"source\": {\n                  \"extract\": \"docs/reference/Player_Rulebook_v6_source_text.txt\",\n                  \"line\": 5243,\n                  \"originalText\": \"Spell Preservation: Your spellbook cannot be destroyed by non-artifact means.\"\n                },\n                \"designStatus\": \"provisional-playtest\",\n                \"spellRank\": null\n              },\n              {\n                \"id\": \"wizard.hero.spellbinder.seal-magic\",\n                \"name\": \"Seal Magic\",\n                \"className\": \"Wizard\",\n                \"band\": \"Hero\",\n                \"path\": \"Spellbinder\",\n                \"sourceKind\": \"active\",\n                \"minimumClassLevel\": 10,\n                \"acquisition\": \"selection\",\n                \"activation\": \"Action\",\n                \"cost\": \"4 RP\",\n                \"rangeAndTarget\": \"One creature within 60 feet\",\n                \"duration\": \"Maximum 3 rounds\",\n                \"frequency\": \"Recharge 3 rounds\",\n                \"effect\": \"Seal Magic. Tags: hero, spellbinder, wizard-spell, control. Choose one of the eight schools and target one creature. It makes a Wisdom save. On failure it cannot cast spells of the chosen school. At the end of each of its turns it repeats the save, ending the Seal on success. The effect ends automatically after 3 rounds and never prevents non-spell class techniques merely because they are magical.\",\n                \"source\": {\n                  \"extract\": \"docs/reference/Player_Rulebook_v6_source_text.txt\",\n                  \"line\": 5249,\n                  \"originalText\": \"Seal Magic: Prevent a target from casting spells of a specific school (WIS save, 3 rounds)\"\n                },\n                \"designStatus\": \"provisional-playtest\",\n                \"spellRank\": 5\n              }\n            ]\n          },\n          {\n            \"classLevel\": 11,\n            \"cards\": [\n              {\n                \"id\": \"wizard.base.arcane-shield\",\n                \"name\": \"Arcane Shield\",\n                \"className\": \"Wizard\",\n                \"band\": \"Base\",\n                \"path\": null,\n                \"sourceKind\": \"active\",\n                \"minimumClassLevel\": 1,\n                \"acquisition\": \"selection\",\n                \"activation\": \"Reaction\",\n                \"cost\": \"2 RP\",\n                \"rangeAndTarget\": \"Self\",\n                \"duration\": \"Until start of your next regular turn\",\n                \"frequency\": \"Recharge 2 rounds\",\n                \"effect\": \"Arcane Shield. Tags: base, active, wizard-spell, abjuration, protection. Trigger when an attack roll would hit you. Gain +2 AC against the triggering attack and until the start of your next regular turn, potentially causing the attack to miss. Temporary AC from another Arcane Shield does not stack.\",\n                \"source\": {\n                  \"extract\": \"docs/reference/Player_Rulebook_v6_source_text.txt\",\n                  \"line\": 5205,\n                  \"originalText\": \"Arcane Shield: Create a barrier of magical force that provides temporary protection.\"\n                },\n                \"designStatus\": \"provisional-playtest\",\n                \"spellRank\": 1\n              }\n            ]\n          },\n          {\n            \"classLevel\": 12,\n            \"cards\": [\n              {\n                \"id\": \"wizard.hero.spellbinder.counterpulse\",\n                \"name\": \"Counterpulse\",\n                \"className\": \"Wizard\",\n                \"band\": \"Hero\",\n                \"path\": \"Spellbinder\",\n                \"sourceKind\": \"active\",\n                \"minimumClassLevel\": 12,\n                \"acquisition\": \"selection\",\n                \"activation\": \"Triggered\",\n                \"cost\": \"1 RP\",\n                \"rangeAndTarget\": \"Caster whose spell you successfully Counterspelled\",\n                \"duration\": \"Until end of target's next turn\",\n                \"frequency\": \"At most once per round\",\n                \"effect\": \"Counterpulse. Tags: hero, spellbinder, counter, control. Immediately after your Counterspell succeeds, spend 1 RP. The countered caster is Silenced until the end of its next turn. This is part of the successful counter event rather than another spell cast and cannot trigger another Counterpulse.\",\n                \"source\": {\n                  \"extract\": \"docs/reference/Player_Rulebook_v6_source_text.txt\",\n                  \"line\": 5251,\n                  \"originalText\": \"Counterpulse: Countering a spell silences the caster for 1 round\"\n                },\n                \"designStatus\": \"provisional-playtest\",\n                \"spellRank\": null\n              }\n            ]\n          },\n          {\n            \"classLevel\": 13,\n            \"cards\": [\n              {\n                \"id\": \"wizard.base.spellbook-study\",\n                \"name\": \"Spellbook Study\",\n                \"className\": \"Wizard\",\n                \"band\": \"Base\",\n                \"path\": null,\n                \"sourceKind\": \"active\",\n                \"minimumClassLevel\": 1,\n                \"acquisition\": \"selection\",\n                \"activation\": \"Ritual\",\n                \"cost\": \"0 RP\",\n                \"rangeAndTarget\": \"Self and spellbook\",\n                \"duration\": \"10 minutes\",\n                \"frequency\": \"1/long rest\",\n                \"effect\": \"Spellbook Study. Tags: base, active, matrix, ritual. Replace one currently prepared matrix with one legal spell recorded in your spellbook. The replacement must be within your Wizard rank limit. This is the normal midday substitution permission; it does not alter the spellbook, create another prepared-matrix position or reset first-cast/Refrain history for an underlying matrix family already cast this encounter.\",\n                \"source\": {\n                  \"extract\": \"docs/reference/Player_Rulebook_v6_source_text.txt\",\n                  \"line\": 5207,\n                  \"originalText\": \"Spellbook Study: Spend time studying your spellbook to prepare a different selection of spells.\"\n                },\n                \"designStatus\": \"provisional-playtest\",\n                \"spellRank\": null\n              }\n            ]\n          }\n        ],\n        \"automaticCards\": [\n          {\n            \"id\": \"wizard.arch.arcane-tradition\",\n            \"name\": \"Arcane Tradition\",\n            \"className\": \"Wizard\",\n            \"band\": \"Arch\",\n            \"path\": null,\n            \"sourceKind\": \"passive\",\n            \"minimumClassLevel\": 3,\n            \"acquisition\": \"automatic\",\n            \"activation\": \"Passive\",\n            \"cost\": \"0\",\n            \"rangeAndTarget\": \"Your level-1 Arcane School\",\n            \"duration\": \"Permanent\",\n            \"frequency\": \"Automatic at Wizard 3; not a selection\",\n            \"effect\": \"Arcane Tradition. Tags: arch, school, automatic. Your level-1 Arcane School becomes your Arcanist tradition; do not choose a second school. Prepare one additional matrix from that same school each day without counting it against your normal prepared-matrix maximum. It otherwise obeys all ordinary rank, spellbook, Dissonance and duplicate-family rules.\",\n            \"source\": {\n              \"extract\": \"docs/reference/Player_Rulebook_v6_source_text.txt\",\n              \"line\": 5217,\n              \"originalText\": \"Arcane Tradition: Choose a school of magic to specialize in, gaining bonuses to spells of that school.\"\n            },\n            \"designStatus\": \"provisional-playtest\",\n            \"spellRank\": null\n          },\n          {\n            \"id\": \"wizard.base.counterspell\",\n            \"name\": \"Counterspell\",\n            \"className\": \"Wizard\",\n            \"band\": \"Base\",\n            \"path\": null,\n            \"sourceKind\": \"active\",\n            \"minimumClassLevel\": 2,\n            \"acquisition\": \"automatic\",\n            \"activation\": \"Reaction\",\n            \"cost\": \"3 RP\",\n            \"rangeAndTarget\": \"One creature you perceive casting a spell within 60 feet\",\n            \"duration\": \"Instantaneous\",\n            \"frequency\": \"Automatic at Wizard 2; recharge 2 rounds\",\n            \"effect\": \"Counterspell. Tags: arch-source, automatic, wizard-spell, abjuration, disruption. Trigger when a creature begins casting a spell. Make an Intelligence check adding proficiency against DC 10 + twice the spell's rank, treating rank 0 as 0. Success negates the triggering spell after its costs are paid; failure lets it resolve. This is gained automatically at Wizard 2 and is never also selected from the Arch pool.\",\n            \"source\": {\n              \"extract\": \"docs/reference/Player_Rulebook_v6_source_text.txt\",\n              \"line\": 5222,\n              \"originalText\": \"Counterspell: Disrupt an enemy's spellcasting, potentially negating their spell entirely.\"\n            },\n            \"designStatus\": \"provisional-playtest\",\n            \"spellRank\": 1\n          },\n          {\n            \"id\": \"wizard.supplement.ritual-casting\",\n            \"name\": \"Ritual Casting\",\n            \"className\": \"Wizard\",\n            \"band\": \"Base\",\n            \"path\": null,\n            \"sourceKind\": \"supplement\",\n            \"minimumClassLevel\": 2,\n            \"acquisition\": \"automatic\",\n            \"activation\": \"Ritual\",\n            \"cost\": \"0 RP unless the individual ritual explicitly states otherwise\",\n            \"rangeAndTarget\": \"As the ritual spell\",\n            \"duration\": \"As the ritual spell\",\n            \"frequency\": \"At will outside encounters with sufficient time\",\n            \"effect\": \"Source progression line 5184. Cast a Wizard spell bearing the Ritual tag directly from your spellbook without preparing it. Increase its casting time by at least 10 minutes. Ritual Casting cannot be completed during an encounter, does not use an ordinary prepared-matrix position and does not generate or vent normal casting Dissonance.\",\n            \"prerequisite\": \"See class engine and progression.\",\n            \"source\": {\n              \"line\": 5184,\n              \"reference\": null,\n              \"originalText\": \"| 2 | Counterspell Reaction, Ritual Casting |\",\n              \"status\": \"source-derived\"\n            },\n            \"designStatus\": \"provisional-playtest\",\n            \"spellRank\": null\n          },\n          {\n            \"id\": \"wizard.supplement.school-mastery\",\n            \"name\": \"School Mastery\",\n            \"className\": \"Wizard\",\n            \"band\": \"Arch\",\n            \"path\": null,\n            \"sourceKind\": \"supplement\",\n            \"minimumClassLevel\": 5,\n            \"acquisition\": \"automatic\",\n            \"activation\": \"Passive\",\n            \"cost\": \"0\",\n            \"rangeAndTarget\": \"Your level-1 Arcane School\",\n            \"duration\": \"Permanent\",\n            \"frequency\": \"Automatic at Wizard 5\",\n            \"effect\": \"Source progression line 5186. This is the one School Mastery progression grant, not a second school choice or duplicate feat. Increase the level-1 Arcane School spell-attack and spell-save bonus from +1 to +2 total. Its school passive and bonus-spell rules otherwise remain unchanged.\",\n            \"prerequisite\": \"See class engine and progression.\",\n            \"source\": {\n              \"line\": 5186,\n              \"reference\": null,\n              \"originalText\": \"| 5 | Bonus Feat: School Mastery |\",\n              \"status\": \"source-derived\"\n            },\n            \"designStatus\": \"provisional-playtest\",\n            \"spellRank\": null\n          },\n          {\n            \"id\": \"wizard.supplement.arcane-ward\",\n            \"name\": \"Arcane Ward\",\n            \"className\": \"Wizard\",\n            \"band\": \"Arch\",\n            \"path\": null,\n            \"sourceKind\": \"supplement\",\n            \"minimumClassLevel\": 6,\n            \"acquisition\": \"automatic\",\n            \"activation\": \"Passive\",\n            \"cost\": \"0\",\n            \"rangeAndTarget\": \"Self\",\n            \"duration\": \"Until next long rest\",\n            \"frequency\": \"Choose after each long rest\",\n            \"effect\": \"Source progression line 5187. After preparing spells, choose one of acid, cold, fire, force, lightning, necrotic, psychic, radiant or thunder that is dealt by at least one prepared spell of your Arcane School. Gain resistance to that damage type until your next long rest. If none of your prepared school spells deals a damage type, choose force. This is provisional completion of the source's ambiguous 'chosen school's element' wording.\",\n            \"prerequisite\": \"See class engine and progression.\",\n            \"source\": {\n              \"line\": 5187,\n              \"reference\": null,\n              \"originalText\": \"| 6 | Arcane Ward (resistance to chosen school's element) |\",\n              \"status\": \"source-derived\"\n            },\n            \"designStatus\": \"provisional-playtest\",\n            \"spellRank\": null\n          },\n          {\n            \"id\": \"wizard.supplement.dual-cast\",\n            \"name\": \"Dual Cast\",\n            \"className\": \"Wizard\",\n            \"band\": \"Arch\",\n            \"path\": null,\n            \"sourceKind\": \"supplement\",\n            \"minimumClassLevel\": 9,\n            \"acquisition\": \"automatic\",\n            \"activation\": \"Action\",\n            \"cost\": \"Pay the complete RP costs of both spells\",\n            \"rangeAndTarget\": \"As each spell\",\n            \"duration\": \"As each spell\",\n            \"frequency\": \"1/short rest\",\n            \"effect\": \"Source progression line 5188. Choose two DIFFERENT prepared Wizard spells of rank 1 or 2, neither of which summons a creature or grants an additional Action. Cast both sequentially as one Action, paying both RP costs. They cannot both require concentration. Each matrix separately updates first-cast/Refrain history. Features that trigger merely from 'casting a spell' may trigger once for each actual matrix unless that feature itself says once per turn; no trigger may create another Dual Cast or additional full Action.\",\n            \"prerequisite\": \"See class engine and progression.\",\n            \"source\": {\n              \"line\": 5188,\n              \"reference\": null,\n              \"originalText\": \"| 9 | Dual Cast (cast 2 Tier 1–2 spells in a round) |\",\n              \"status\": \"source-derived\"\n            },\n            \"designStatus\": \"provisional-playtest\",\n            \"spellRank\": null\n          },\n          {\n            \"id\": \"wizard.supplement.overchannel\",\n            \"name\": \"Overchannel\",\n            \"className\": \"Wizard\",\n            \"band\": \"Hero\",\n            \"path\": null,\n            \"sourceKind\": \"supplement\",\n            \"minimumClassLevel\": 13,\n            \"acquisition\": \"automatic\",\n            \"activation\": \"Triggered\",\n            \"cost\": \"Pay the Core V 2 RP cost for one rank above the spell's normal cast rank\",\n            \"rangeAndTarget\": \"One prepared spell you are beginning to cast\",\n            \"duration\": \"For that cast\",\n            \"frequency\": \"1/long rest\",\n            \"effect\": \"Source progression line 5190. Cast one prepared spell as though it were one rank higher than the highest rank at which you could normally cast that SAME spell, provided the spell has an explicit higher-rank scaling rule. Overchannel does not teach or prepare a higher-rank spell, cannot exceed effective rank 9 and cannot be combined with another generic Overcast rule during this pilot. All normal Dissonance/Refrain rules still apply.\",\n            \"prerequisite\": \"See class engine and progression.\",\n            \"source\": {\n              \"line\": 5190,\n              \"reference\": null,\n              \"originalText\": \"| 13 | Overchannel (cast a spell 1 tier higher once/day) |\",\n              \"status\": \"source-derived\"\n            },\n            \"designStatus\": \"provisional-playtest\",\n            \"spellRank\": null\n          }\n        ],\n        \"completeEngine\": [\n          \"PROVISIONAL PLAYTEST CONTRACT. Intelligence is the Wizard class ability. S = 1/2/3/4 at Wizard levels 1/5/11/17. M = max(1, Intelligence modifier). Wizard spell attack = d20 + normal character proficiency bonus + Intelligence modifier. Wizard spell save DC = 8 + normal character proficiency bonus + Intelligence modifier.\",\n          \"The Wizard remains three distinct stages: Base Wizard at levels 1-2, Arch Arcanist at levels 3-9, and one Hero path at levels 10-20: Spellbinder, Elementalist or Necromancer. Hero paths are not additional starting classes and their features cannot be selected before their Wizard class-level gates.\",\n          \"SPELLBOOK. At Wizard 1 your spellbook contains six chosen rank-1 Wizard spells. Arcane School Specialization also adds one legal rank-1 bonus spell of your chosen school without replacing one of those six. For this provisional progression, add 2 legal Wizard spells to the book at each Wizard level 2-4, 3 at each level 5-8, 4 at each level 9-12, 5 at each level 13-16 and 6 at each level 17-20. Level-up additions cost no money or scribing time.\",\n          \"LEGAL RANKS. Maximum Wizard spell rank by Wizard class level is: rank 1 at levels 1-2, rank 2 at 3-4, rank 3 at 5-6, rank 4 at 7-8, rank 5 at 9-10, rank 6 at 11-12, rank 7 at 13-14, rank 8 at 15-16 and rank 9 at 17-20. Grand Tier at level 20 is a special casting permission, not a tenth ordinary rank. A Wizard may learn Wizard-list spells from any school up to the legal rank unless a spell itself has an additional prerequisite.\",\n          \"PREPARED SPELL MATRIX. After a long rest, prepare a number of matrices equal to Wizard level + Intelligence modifier, minimum 1, selecting only spells currently recorded in your spellbook and within your legal rank. You cast ordinary Wizard spells only from prepared matrices unless a feature explicitly overrides that restriction. Preparing the full daily matrix set normally requires 1 hour of spellbook study. Matrix Efficiency reduces this to 45 minutes.\",\n          \"DUPLICATE PREPARATION. You may prepare the same spell more than once, primarily to carry different Matrix Mastery configurations. Duplicate copies never create additional first-cast Dissonance exemptions. For Refrain and the protected strain rule, all prepared copies sharing the same underlying spell name belong to one matrix family regardless of modification.\",\n          \"MIDDAY SUBSTITUTION. Once between long rests, you may perform a 10-minute Spellbook Study ritual to replace one prepared matrix with another legal spell from your spellbook. The replacement cannot exceed your legal Wizard rank. Sigil Rewrite and Matrix Mastery may improve this process as explicitly stated.\",\n          \"SPELL ACQUISITION BY SCRIBING. A found Wizard spell may be copied into the spellbook if its rank is legal for you. Baseline scribing requires 2 hours and 50 gp of inks/materials per spell rank, treating rank 0 as 1 for this calculation. Spell Scribing halves both values to 1 hour and 25 gp per rank. Failure to finish the work consumes no spellbook entry but materials already expended during an interrupted hour are lost.\",\n          \"SPELLBOOK LOSS. Losing the spellbook does not erase matrices currently prepared in memory; you may continue casting those prepared matrices until you next rebuild or change preparation. A blank replacement book can be seeded with your currently prepared spells at 1 hour and 25 gp per effective spell rank each. An unprepared spell you previously recorded can be reconstructed from memory with 8 hours, 100 gp per rank and an Intelligence (Arcana) check against DC 10 + spell rank. Failure consumes that attempt's time and half its materials; another attempt can be made after a long rest. Recovering the original book automatically restores access to its surviving entries.\",\n          \"ARCANE SCHOOL SPECIALIZATION is automatic at Wizard 1. Choose exactly one of the eight schools. Your spell attacks with that school gain +1 and your Wizard save DC for that school's spells gains +1. You also add one legal rank-1 spell of that school to the spellbook. The source table explicitly supplies seven school passives; the eighth core school, Abjuration, is named elsewhere but its passive row is missing. Its provisional playtest passive is identified below rather than silently presented as recovered text.\",\n          \"ABJURATION, provisional completion for the omitted eighth row: once per round after you cast an Abjuration spell, gain temporary HP equal to PB until the start of your next regular turn. CONJURATION: creatures summoned by your Wizard spells gain +1 maximum HP per Wizard level. DIVINATION: once per long rest reroll one failed saving throw and use the new result. ENCHANTMENT: when a creature fails its initial save against one of your Enchantment spells, a printed control duration of at least 1 round may last one additional round, but every normally allowed repeat save still occurs. EVOCATION: when casting an area Evocation spell, exclude one creature from its initial damaging area; that creature automatically succeeds and takes no damage if success normally halves damage. ILLUSION: gain +2 on concentration saves made to maintain Illusion spells. NECROMANCY: once per turn during a real encounter when a hostile non-summoned creature dies from your Necromancy spell, gain 1 temporary HP; it is not permanent healing. TRANSMUTATION: after casting a Transmutation spell, gain +5 feet Speed until the end of that turn.\",\n          \"PROTECTED DISSONANCE INTERFACE. The first cast of each different prepared matrix family during an encounter generates 0 BASE Dissonance. This exemption affects only base strain. Refrain and explicitly printed strain costs still apply; the suite disables generic Overcast and does not layer historical Burn onto Dissonance. Repeating a matrix family follows normal Refrain immediately. Preparing duplicates or differently modified copies of the same underlying spell never refreshes the exemption.\",\n          \"Core Systems V 2 Resonance Points and spell-rank RP costs are authoritative for Wizard spellcasting. There are no historical spell slots in this pilot. Wizard cards tagged wizard-spell are always-prepared class matrices once acquired, do not consume a daily prepared-matrix position and use the same RP, concentration, Refrain and protected first-distinct-matrix rules as other Wizard spells. Their printed RP cost replaces any generic rank cost; never pay both.\",\n          \"RITUAL CASTING is automatic at Wizard 2. A Wizard spell in your spellbook with the Ritual tag can be cast from the book without being prepared by increasing its casting time by at least 10 minutes. A ritual cast costs 0 RP unless that ritual explicitly lists a consumed RP cost, cannot be used during an encounter and cannot generate or vent Dissonance through ordinary casting strain.\",\n          \"Only one concentration effect can normally be maintained. Starting a second concentration effect ends the first. Damage uses the current Core Systems concentration rule; required half-damage rounding is down for this pilot. Spell Tether and the level-17 Tethered Cast are the only Wizard-specific exceptions in this draft, and each has an explicit RP price, duration and one-tether cap.\",\n          \"MATRIX MASTERY MODIFICATIONS. After acquiring Matrix Mastery, each prepared ordinary spell matrix may carry at most one modification chosen during preparation. QUICK SUBSTITUTION: once per short rest, replace one matrix marked Quick Substitution with another spellbook spell of exactly the same rank using a 1-minute ritual instead of the normal 10-minute midday swap; the replacement loses the modification until the next long rest. COMPONENT ENHANCEMENT: when casting a damaging or healing matrix, spend 1 additional RP to add one extra die of the spell's primary damage or healing die to one roll; if the spell has no such die this modification has no effect. MATRIX LINKING: pair two different prepared matrix families during preparation; after legally casting one, the other costs 1 less RP, minimum 1, if cast before the end of your next regular turn, at most once per pair per round. STABILITY REINFORCEMENT: gain +2 on concentration saves caused by damage while maintaining that matrix. A matrix modification never creates another spell cast or proc event.\",\n          \"All sources share a maximum of one additional full Action per creature per round. Additional Actions cannot grant another additional Action, Bonus Action or Reaction. Spell copies, Matrix Sharing, Arcane Fusion, Dual Cast and similar effects pay all explicitly required RP and do not produce duplicate resource, cast-proc or action-grant chains beyond their written resolution.\",\n          \"Round recharge counters decrease once at the start of your regular initiative turn even if you cannot act. Extra Actions and extra turns do not tick recharge. Outside initiative, each uninterrupted 6 seconds counts as one tick. Only positive counters can be reset or shortened and each named ability can receive at most one reset or shortening per round.\",\n          \"SUMMON COMMAND LIMIT. All Wizard-controlled conjured, raised and bound companions share one damaging/control Companion Command per Wizard regular turn. Spend one Bonus Action to command exactly one such creature to move up to its Speed and use one damaging or control action from its stat block. Uncommanded creatures may reposition defensively and take Dodge but cannot deal damage or impose conditions. No summoned or raised creature can create XP, treasure, RP, Dissonance relief, additional corpses or kill-resource farms.\",\n          \"NECROMANCER STANDARD UNDEAD. Corpse Harvest and Auto-Raise share a maximum of three standard raised minions. Skeleton: AC 14, HP 6 + 2 × Wizard level, Speed 30; Bone Shot, range 30 feet, Wizard spell attack, 1d6+S necrotic. Zombie: AC 12, HP 10 + 3 × Wizard level, Speed 20; Slam, reach 5 feet, Wizard spell attack, 1d8+S necrotic. Goblin Thrall, available only from a goblinoid corpse: AC 13, HP 8 + 2 × Wizard level, Speed 30; Shiv, reach 5 feet, Wizard spell attack, 1d6+S necrotic. These are pre-Flesh-Ascendant statistics.\",\n          \"NECROMANCER AUTO-RAISE. Once per round when one of your standard undead minions personally lands the killing blow on an eligible humanoid and your standard-minion count is below three, its corpse rises at the end of the current turn as the same mechanical minion type that scored the kill, if physically possible. A new minion cannot act during that same round. Auto-Raise costs no Action or RP but can never exceed the three-minion cap or generate a new resource, corpse chain, XP or treasure event. Without Infernal Pact only humanoids qualify.\",\n          \"ELITE UNDEAD PETS. Necromancers may bind Boneflayer, Dreadblade and Wraithbound, at most one of each and three elite pets total. They use the same shared Companion Command limit as standard undead. Boneflayer: AC 14, HP 12 + 2 × Wizard level, Speed 30. Bone Shards: range 60, Wizard spell attack, 2d6+S necrotic. Fear Pulse replaces its attack: enemies within 10 feet make Wisdom saves; failure Frightened until end of next turn; recharge 3. Grave Miasma replaces its attack: 10-foot-radius point within 30 feet until start of your next turn; enemies entering or starting there take 1d6 necrotic once; recharge 3.\",\n          \"Dreadblade: AC 16, HP 16 + 3 × Wizard level, Speed 30. Disrupting Blade: reach 5 feet, Wizard spell attack, 1d8+S necrotic; a concentrating target immediately makes its concentration save with disadvantage. On a natural 20 the target is Weakened until the end of its next turn, taking -1 on attack rolls. Dreadblade has advantage on saves against forced movement.\",\n          \"Wraithbound: AC 14, HP 10 + 2 × Wizard level, Fly 40 and hover. While it has not attacked or imposed control since the end of its previous turn it is Invisible; attacking ends that state until the end of its next turn. Wraith Strike: reach 5 feet, Wizard spell attack, 1d8+S necrotic. On natural 20 the target makes a Constitution save against your Wizard DC; failure Stuns until the end of its next turn.\",\n          \"Flesh Ascendant's bonus applies after the listed base statistics: every undead creature you control gains +2 maximum HP per Wizard level. If at least two of your undead creatures are active, each gains +1 AC and +1 on saving throws. This does not increase the standard-minion or elite-pet caps.\",\n          \"DARK-TRAUMA INTERFACE. Necromancer features involving corpse desecration, infernal bargains, domination, body control or Mind Prison remain subject to the project's existing dark-content and trauma boundaries. A table may fade description to black without changing mechanics. No feature changes a player's real belief, permanently transfers ownership of a player character or silently retires a PC.\",\n          \"PROPOSED ACQUISITION. Wizard 1 automatically gains Arcane School Specialization, Spell Matrix System and the starting spellbook, then chooses 4 selectable Base cards, at least 2 Active. Wizard 2 automatically gains Counterspell and Ritual Casting, then chooses 2 additional selectable Base cards. Counterspell is not also placed in the Arch selection pool.\",\n          \"At Wizard 3 enter Arcanist, automatically gain Arcane Tradition as an upgrade of the SAME level-1 school rather than choosing another school, and choose 2 selectable Arch cards, at least 1 Active. Wizard 4 grants one eligible Base/Arch choice. Wizard 5 grants one Base/Arch choice plus automatic School Mastery. Wizard 6 grants one Base/Arch choice plus automatic Arcane Ward. Wizard 7 grants one eligible Arch choice. Wizard 8 grants one Base/Arch choice. Wizard 9 grants one eligible Arch choice plus automatic Dual Cast.\",\n          \"At Wizard 10 choose Spellbinder, Elementalist or Necromancer and gain 2 Hero cards from that path. ELEMENTALIST EXCEPTION: Elemental Affinity is automatic at path selection and counts as one of those two level-10 Hero acquisitions, so an Elementalist chooses only one additional Hero card at level 10. Levels 11, 13, 15, 17 and 19 each grant one eligible unselected Base/Arch choice. Levels 12, 14, 16 and 18 each grant one Hero-path choice. The chosen Final Theorem is automatic at Wizard 20. School Mastery, Counterspell, Arcane Tradition and all progression-table automatic features are never duplicated as selections.\",\n          \"All acquisition gates use Wizard class level rather than total character level. Normal proficiency bonus follows the game's ordinary total-character-level rule. A multiclass dip cannot unlock higher spell ranks, Arcanist cards, Hero cards, Final Theorems or progression-table features.\",\n          \"Class matrices tagged wizard-spell receive a rank in normalized card data equal to maximum ordinary Wizard rank at their minimum class-level gate (cap 9). Printed RP cost replaces generic rank cost. Counterspell is rank 1 at its explicit level 2 automatic grant. This explicit convention closes rank-dependent Counterspell/Dissonance interactions without inventing extra costs.\",\n          \"Cantrip completion: know 3 Wizard cantrips at 1, 4 at 4, 5 at 10, using the shared missing-repertoire fallback. Cantrips are known directly and do not consume prepared matrices. Always-prepared class matrices are additional cards, not extra arbitrary ordinary spells. Class spell ranks and the normalized activation field resolve incomplete source terminology.\"\n        ],\n        \"source\": {\n          \"path\": \"DescentReviewChanges/ReviewBible/data/public/class_playtests/wizard.json\",\n          \"pointers\": [\n            \"/engine\",\n            \"/schedule\",\n            \"/cards\",\n            \"/rpByClassLevel/12\"\n          ]\n        },\n        \"optionalChoicesInCases\": \"No Matrix Mastery, Spell Efficiency, Improved Concentration, Sigil Authority or Knowledge Shield acquired. Dual Cast, Overchannel, class Arcane Shield and optional Counterpulse are not invoked unless expressly declared. No Arcane Feedback at13.\",\n        \"creatureType\": \"Humanoid\",\n        \"profileScope\": \"An explicitly supplied finite class-built teaching creature profile using the complete actual class engine/cards. Not a newly rated bestiary creature, not authenticated campaign or ancestry acquisition, and not permission to fill an absent future profile.\",\n        \"languages\": [\n          \"Common\"\n        ],\n        \"otherIntrinsicDefenses\": [],\n        \"additionalSkillProficienciesClaimed\": [],\n        \"checks\": \"Use current ability modifier and actual acquired named card when applicable; save proficiency is not an ability-check proficiency. No Athletics proficiency is claimed.\",\n        \"actualActionsAvailable\": \"Each annotated actual regular START supplies the normal Action/BonusAction/Reaction/movement according to the real source; the event trace explicitly consumes each used budget. No extra action source is assumed.\",\n        \"asiHistory\": {\n          \"rolledINT\": 16,\n          \"class4\": \"INT+2 to18\",\n          \"class8\": \"STR+2 from8 to10\",\n          \"class12\": \"CHA+2 from8 to10\",\n          \"DEX\": 14,\n          \"CON\": 14,\n          \"WIS\": 12,\n          \"note\": \"Explicit legal generated-score/ASI fixture inputs; no extra feat is claimed.\"\n        }\n      },\n      \"oldTarget\": {\n        \"kind\": \"Source-qualified illustrative character, not a verified campaign actor or rated monster\",\n        \"class\": \"Wizard\",\n        \"classLevel\": 13,\n        \"totalLevel\": 13,\n        \"PB\": 5,\n        \"S\": 3,\n        \"STR\": 10,\n        \"DEX\": 14,\n        \"CON\": 14,\n        \"INT\": 18,\n        \"WIS\": 12,\n        \"CHA\": 10,\n        \"maxHp\": 80,\n        \"hpConstruction\": \"d6 class: initial6+CON2=8, twelve supplied legal hit-die results4+CON2=6 each;8+72=80. This is a stated fixture history, not generated random character evidence.\",\n        \"maxRp\": 48,\n        \"maxRank\": 7,\n        \"Limit\": 11,\n        \"AC\": 12,\n        \"speedFeet\": 30,\n        \"size\": \"Medium\",\n        \"bodyBoxFeet\": [\n          5,\n          5,\n          5\n        ],\n        \"bodyMassLb\": 170,\n        \"actualGear\": {\n          \"focus-pack\": {\n            \"grossWeightLb\": 10,\n            \"load\": 1,\n            \"contents\": \"real ordinary wooden focus and mundane personal carrying effects; no consumed materials/charged item; gross figures include every item once\"\n          }\n        },\n        \"saves\": {\n          \"STR\": 0,\n          \"DEX\": 2,\n          \"CON\": 2,\n          \"INT\": 9,\n          \"WIS\": 6,\n          \"CHA\": 0\n        },\n        \"spellAttack\": 9,\n        \"spellDc\": 17,\n        \"school\": \"Illusion\",\n        \"schoolAttack\": 11,\n        \"schoolDc\": 19,\n        \"schoolConcentrationSave\": 4,\n        \"ordinaryConcentrationSave\": 2,\n        \"arcaneWard\": \"force resistance: this prepared Illusion set has no intrinsic damage type; no fire/cold/psychic resistance invented\",\n        \"hero\": \"Spellbinder\",\n        \"bookAndPreparation\": {\n          \"newRank7BookAdditionsAt13\": [\n            \"cast-echo\",\n            \"meta-surge\",\n            \"erase-from-reality\",\n            \"sequester\",\n            \"simulacrum\"\n          ],\n          \"ordinaryPrepared\": [\n            \"cast-echo\",\n            \"meta-surge\",\n            \"erase-from-reality\",\n            \"sequester\",\n            \"simulacrum\",\n            \"fireball\",\n            \"shield\",\n            \"counterspell\",\n            \"continual-flame\",\n            \"mirror-image\",\n            \"detect-magic\",\n            \"true-seeing\"\n          ],\n          \"count\": 12,\n          \"baseCapacity\": 17,\n          \"additionalFloatingAndSchoolSlotsUnused\": true,\n          \"olderSpells\": \"Actual source-qualified book/cantrip additions at earlier legal Wizard levels; ordinary Counterspell acquired at5+, True Seeing at11, Continual Flame at3; no feat or copying grant needed.\",\n          \"ordinaryKnownCantrips\": [\n            \"ray-of-frost\",\n            \"chill-touch\",\n            \"resonance-shield\",\n            \"minor-image\",\n            \"disrupt-memory\"\n          ],\n          \"unusedBaseMatrixPositions\": 5\n        },\n        \"selectedAcquisition\": [\n          {\n            \"classLevel\": 1,\n            \"cards\": [\n              {\n                \"id\": \"wizard.base.arcane-recovery\",\n                \"name\": \"Arcane Recovery\",\n                \"className\": \"Wizard\",\n                \"band\": \"Base\",\n                \"path\": null,\n                \"sourceKind\": \"passive\",\n                \"minimumClassLevel\": 1,\n                \"acquisition\": \"selection\",\n                \"activation\": \"Passive\",\n                \"cost\": \"0\",\n                \"rangeAndTarget\": \"Self\",\n                \"duration\": \"Instantaneous during a completed short rest\",\n                \"frequency\": \"1/long rest\",\n                \"effect\": \"Arcane Recovery. Tags: base, passive, resonance. Once between long rests when you complete a short rest, restore RP equal to half your Wizard class level rounded up, never above your normal maximum. This is RP recovery, not a second pool, and cannot trigger spell-cast, Refrain or Dissonance effects.\",\n                \"source\": {\n                  \"extract\": \"docs/reference/Player_Rulebook_v6_source_text.txt\",\n                  \"line\": 5196,\n                  \"originalText\": \"Arcane Recovery: Once per day during a short rest, recover RP equal to half your Wizard level (rounded up), up to your normal maximum.\"\n                },\n                \"designStatus\": \"provisional-playtest\",\n                \"spellRank\": null\n              },\n              {\n                \"id\": \"wizard.base.spell-scribing\",\n                \"name\": \"Spell Scribing\",\n                \"className\": \"Wizard\",\n                \"band\": \"Base\",\n                \"path\": null,\n                \"sourceKind\": \"passive\",\n                \"minimumClassLevel\": 1,\n                \"acquisition\": \"selection\",\n                \"activation\": \"Passive\",\n                \"cost\": \"0\",\n                \"rangeAndTarget\": \"Your spellbook\",\n                \"duration\": \"Permanent\",\n                \"frequency\": \"Always\",\n                \"effect\": \"Spell Scribing. Tags: base, passive, spellbook. Copying a legal found Wizard spell into your spellbook requires 1 hour and 25 gp of inks and components per spell rank, treating rank 0 as rank 1 for this calculation, instead of the pilot baseline 2 hours and 50 gp. Level-up spells remain free.\",\n                \"source\": {\n                  \"extract\": \"docs/reference/Player_Rulebook_v6_source_text.txt\",\n                  \"line\": 5197,\n                  \"originalText\": \"Spell Scribing: Copy spells into your spellbook at half the normal cost and time.\"\n                },\n                \"designStatus\": \"provisional-playtest\",\n                \"spellRank\": null\n              },\n              {\n                \"id\": \"wizard.base.arcane-bolt\",\n                \"name\": \"Arcane Bolt\",\n                \"className\": \"Wizard\",\n                \"band\": \"Base\",\n                \"path\": null,\n                \"sourceKind\": \"active\",\n                \"minimumClassLevel\": 1,\n                \"acquisition\": \"selection\",\n                \"activation\": \"Action\",\n                \"cost\": \"1 RP\",\n                \"rangeAndTarget\": \"One creature within 60 feet\",\n                \"duration\": \"Instantaneous\",\n                \"frequency\": \"At will while RP remains\",\n                \"effect\": \"Arcane Bolt. Tags: base, active, wizard-spell, universal, damage. Make a Wizard spell attack. On a hit deal S d6 + M force damage. Arcane Bolt is an always-prepared class matrix once acquired and uses the normal first-distinct-matrix and Refrain rules.\",\n                \"source\": {\n                  \"extract\": \"docs/reference/Player_Rulebook_v6_source_text.txt\",\n                  \"line\": 5203,\n                  \"originalText\": \"Arcane Bolt: Launch a bolt of pure arcane energy that deals force damage to a single target.\"\n                },\n                \"designStatus\": \"provisional-playtest\",\n                \"spellRank\": 1\n              },\n              {\n                \"id\": \"wizard.base.minor-conjuration\",\n                \"name\": \"Minor Conjuration\",\n                \"className\": \"Wizard\",\n                \"band\": \"Base\",\n                \"path\": null,\n                \"sourceKind\": \"active\",\n                \"minimumClassLevel\": 1,\n                \"acquisition\": \"selection\",\n                \"activation\": \"Action\",\n                \"cost\": \"1 RP\",\n                \"rangeAndTarget\": \"One unoccupied space within 10 feet\",\n                \"duration\": \"1 hour\",\n                \"frequency\": \"At will while RP remains; one object at a time\",\n                \"effect\": \"Minor Conjuration. Tags: base, active, wizard-spell, conjuration. Create one nonmagical unattended object that fits inside a 1-foot cube, weighs no more than 10 pounds and is made of common nonvaluable material such as wood, cloth, clay, iron or glass. It cannot be food, poison, currency, a spell component with listed cost, ammunition with special properties or a functional complex mechanism. Creating another dismisses the first.\",\n                \"source\": {\n                  \"extract\": \"docs/reference/Player_Rulebook_v6_source_text.txt\",\n                  \"line\": 5204,\n                  \"originalText\": \"Minor Conjuration: Create a temporary, small inanimate object that lasts for 1 hour.\"\n                },\n                \"designStatus\": \"provisional-playtest\",\n                \"spellRank\": 1\n              }\n            ]\n          },\n          {\n            \"classLevel\": 2,\n            \"cards\": [\n              {\n                \"id\": \"wizard.base.arcane-insight\",\n                \"name\": \"Arcane Insight\",\n                \"className\": \"Wizard\",\n                \"band\": \"Base\",\n                \"path\": null,\n                \"sourceKind\": \"passive\",\n                \"minimumClassLevel\": 1,\n                \"acquisition\": \"selection\",\n                \"activation\": \"Passive\",\n                \"cost\": \"0\",\n                \"rangeAndTarget\": \"Self\",\n                \"duration\": \"Permanent\",\n                \"frequency\": \"Always\",\n                \"effect\": \"Arcane Insight. Tags: base, passive, knowledge. Gain proficiency in Arcana, or expertise if already proficient. When examining an active magical effect, spell residue, magic item or arcane construction, you may make an Intelligence (Arcana) check to determine its broad school, function or unusual matrix behavior. The Director sets the normal knowledge DC; failure supplies no invented fact.\",\n                \"source\": {\n                  \"extract\": \"docs/reference/Player_Rulebook_v6_source_text.txt\",\n                  \"line\": 5198,\n                  \"originalText\": \"Arcane Insight: Identify magical effects and items with greater accuracy than non-wizards.\"\n                },\n                \"designStatus\": \"provisional-playtest\",\n                \"spellRank\": null\n              },\n              {\n                \"id\": \"wizard.base.matrix-efficiency\",\n                \"name\": \"Matrix Efficiency\",\n                \"className\": \"Wizard\",\n                \"band\": \"Base\",\n                \"path\": null,\n                \"sourceKind\": \"passive\",\n                \"minimumClassLevel\": 1,\n                \"acquisition\": \"selection\",\n                \"activation\": \"Passive\",\n                \"cost\": \"0\",\n                \"rangeAndTarget\": \"Self\",\n                \"duration\": \"Daily preparation\",\n                \"frequency\": \"Always\",\n                \"effect\": \"Matrix Efficiency. Tags: base, passive, matrix. Your normal full daily Spell Matrix preparation time is reduced from 1 hour to 45 minutes. This does not reduce the separate 10-minute midday substitution ritual, spell scribing, rituals or spellbook reconstruction unless another feature explicitly says so.\",\n                \"source\": {\n                  \"extract\": \"docs/reference/Player_Rulebook_v6_source_text.txt\",\n                  \"line\": 5199,\n                  \"originalText\": \"Matrix Efficiency: Reduce the preparation time for spells by 25%.\"\n                },\n                \"designStatus\": \"provisional-playtest\",\n                \"spellRank\": null\n              }\n            ]\n          },\n          {\n            \"classLevel\": 3,\n            \"cards\": [\n              {\n                \"id\": \"wizard.arch.floating-preparation\",\n                \"name\": \"Floating Preparation\",\n                \"className\": \"Wizard\",\n                \"band\": \"Arch\",\n                \"path\": null,\n                \"sourceKind\": \"passive\",\n                \"minimumClassLevel\": 3,\n                \"acquisition\": \"selection\",\n                \"activation\": \"Passive\",\n                \"cost\": \"0\",\n                \"rangeAndTarget\": \"Self\",\n                \"duration\": \"Daily preparation\",\n                \"frequency\": \"Always\",\n                \"effect\": \"Floating Preparation. Tags: arch, passive, matrix. Increase your maximum prepared Spell Matrix count by 1. The extra matrix can come from any school and obeys all ordinary spellbook and rank restrictions. It is a prepared matrix for every rule, including protected strain, duplicate-family tracking and Matrix Mastery modifications.\",\n                \"source\": {\n                  \"extract\": \"docs/reference/Player_Rulebook_v6_source_text.txt\",\n                  \"line\": 5213,\n                  \"originalText\": \"Floating Preparation: Prepare 1 extra spell from any school each day\"\n                },\n                \"designStatus\": \"provisional-playtest\",\n                \"spellRank\": null\n              },\n              {\n                \"id\": \"wizard.arch.arcane-lock\",\n                \"name\": \"Arcane Lock\",\n                \"className\": \"Wizard\",\n                \"band\": \"Arch\",\n                \"path\": null,\n                \"sourceKind\": \"active\",\n                \"minimumClassLevel\": 3,\n                \"acquisition\": \"selection\",\n                \"activation\": \"Action\",\n                \"cost\": \"2 RP\",\n                \"rangeAndTarget\": \"One door, chest, portal or unattended object within touch\",\n                \"duration\": \"8 hours\",\n                \"frequency\": \"Recharge 2 rounds\",\n                \"effect\": \"Arcane Lock. Tags: arch, active, wizard-spell, abjuration. Magically seal the target. Opening it without your permission requires a Strength check or thieves'/arcane-tool check against your Wizard spell DC. Dispel Magic can end the lock. You can designate up to M creatures who can bypass it. This does not make the object physically indestructible.\",\n                \"source\": {\n                  \"extract\": \"docs/reference/Player_Rulebook_v6_source_text.txt\",\n                  \"line\": 5223,\n                  \"originalText\": \"Arcane Lock: Create a magical barrier that prevents entry or access to an object or area.\"\n                },\n                \"designStatus\": \"provisional-playtest\",\n                \"spellRank\": 2\n              }\n            ]\n          },\n          {\n            \"classLevel\": 4,\n            \"cards\": [\n              {\n                \"id\": \"wizard.base.scholarly-mind\",\n                \"name\": \"Scholarly Mind\",\n                \"className\": \"Wizard\",\n                \"band\": \"Base\",\n                \"path\": null,\n                \"sourceKind\": \"passive\",\n                \"minimumClassLevel\": 1,\n                \"acquisition\": \"selection\",\n                \"activation\": \"Passive\",\n                \"cost\": \"0\",\n                \"rangeAndTarget\": \"Self\",\n                \"duration\": \"Permanent\",\n                \"frequency\": \"Always\",\n                \"effect\": \"Scholarly Mind. Tags: base, passive, knowledge. You have advantage on Intelligence checks whose primary purpose is recalling, researching or analyzing arcane theory, magical history, planar magical principles or constructed spell formulae. It does not grant advantage on spell attacks, Counterspell checks or general Investigation unrelated to arcane scholarship.\",\n                \"source\": {\n                  \"extract\": \"docs/reference/Player_Rulebook_v6_source_text.txt\",\n                  \"line\": 5200,\n                  \"originalText\": \"Scholarly Mind: Gain advantage on Intelligence checks related to arcane knowledge.\"\n                },\n                \"designStatus\": \"provisional-playtest\",\n                \"spellRank\": null\n              }\n            ]\n          },\n          {\n            \"classLevel\": 5,\n            \"cards\": [\n              {\n                \"id\": \"wizard.arch.dispel-magic\",\n                \"name\": \"Dispel Magic\",\n                \"className\": \"Wizard\",\n                \"band\": \"Arch\",\n                \"path\": null,\n                \"sourceKind\": \"active\",\n                \"minimumClassLevel\": 5,\n                \"acquisition\": \"selection\",\n                \"activation\": \"Action\",\n                \"cost\": \"3 RP\",\n                \"rangeAndTarget\": \"One creature, object or magical effect within 60 feet\",\n                \"duration\": \"Instantaneous\",\n                \"frequency\": \"Recharge 2 rounds\",\n                \"effect\": \"Dispel Magic. Tags: arch, active, wizard-spell, abjuration. Choose one ongoing spell effect you can perceive. If its rank is 3 or lower, end it. If it is rank 4 or higher, make an Intelligence check adding proficiency against DC 10 + spell rank; success ends it. Permanent artifact properties and effects explicitly immune to dispelling are unaffected.\",\n                \"source\": {\n                  \"extract\": \"docs/reference/Player_Rulebook_v6_source_text.txt\",\n                  \"line\": 5224,\n                  \"originalText\": \"Dispel Magic: End magical effects in an area or on a target.\"\n                },\n                \"designStatus\": \"provisional-playtest\",\n                \"spellRank\": 3\n              }\n            ]\n          },\n          {\n            \"classLevel\": 6,\n            \"cards\": [\n              {\n                \"id\": \"wizard.arch.arcane-sight\",\n                \"name\": \"Arcane Sight\",\n                \"className\": \"Wizard\",\n                \"band\": \"Arch\",\n                \"path\": null,\n                \"sourceKind\": \"active\",\n                \"minimumClassLevel\": 3,\n                \"acquisition\": \"selection\",\n                \"activation\": \"Action\",\n                \"cost\": \"2 RP\",\n                \"rangeAndTarget\": \"Self; 60-foot sight\",\n                \"duration\": \"Concentration, maximum 10 minutes\",\n                \"frequency\": \"Recharge 2 rounds\",\n                \"effect\": \"Arcane Sight. Tags: arch, active, wizard-spell, divination, concentration. While active you perceive magical auras within 60 feet and automatically know each visible aura's school or broad magical category. As an Action on a later turn, examine one aura to learn whether it is concentrated, summoned, cursed, warded or linked to another visible magical effect. Total cover blocks sight.\",\n                \"source\": {\n                  \"extract\": \"docs/reference/Player_Rulebook_v6_source_text.txt\",\n                  \"line\": 5226,\n                  \"originalText\": \"Arcane Sight: See magical auras and effects for a short duration.\"\n                },\n                \"designStatus\": \"provisional-playtest\",\n                \"spellRank\": 2\n              }\n            ]\n          },\n          {\n            \"classLevel\": 7,\n            \"cards\": [\n              {\n                \"id\": \"wizard.arch.dimensional-pocket\",\n                \"name\": \"Dimensional Pocket\",\n                \"className\": \"Wizard\",\n                \"band\": \"Arch\",\n                \"path\": null,\n                \"sourceKind\": \"active\",\n                \"minimumClassLevel\": 7,\n                \"acquisition\": \"selection\",\n                \"activation\": \"Ritual\",\n                \"cost\": \"3 RP\",\n                \"rangeAndTarget\": \"One point within 5 feet\",\n                \"duration\": \"8 hours\",\n                \"frequency\": \"1/long rest\",\n                \"effect\": \"Dimensional Pocket. Tags: arch, active, wizard-spell, conjuration, ritual. Create an extradimensional storage space holding up to 100 pounds or 10 cubic feet of unattended nonliving material. Retrieving or placing an item while adjacent to the opening uses an object interaction. Living creatures cannot enter. When duration ends, remaining contents appear harmlessly in the nearest unoccupied space.\",\n                \"source\": {\n                  \"extract\": \"docs/reference/Player_Rulebook_v6_source_text.txt\",\n                  \"line\": 5225,\n                  \"originalText\": \"Dimensional Pocket: Create a small extradimensional space to store items.\"\n                },\n                \"designStatus\": \"provisional-playtest\",\n                \"spellRank\": 4\n              }\n            ]\n          },\n          {\n            \"classLevel\": 8,\n            \"cards\": [\n              {\n                \"id\": \"wizard.base.analyze-magic\",\n                \"name\": \"Analyze Magic\",\n                \"className\": \"Wizard\",\n                \"band\": \"Base\",\n                \"path\": null,\n                \"sourceKind\": \"active\",\n                \"minimumClassLevel\": 1,\n                \"acquisition\": \"selection\",\n                \"activation\": \"Action\",\n                \"cost\": \"1 RP\",\n                \"rangeAndTarget\": \"One magical creature, object or effect within 30 feet\",\n                \"duration\": \"Instantaneous\",\n                \"frequency\": \"Recharge 1 round\",\n                \"effect\": \"Analyze Magic. Tags: base, active, wizard-spell, divination, knowledge. Make an Intelligence (Arcana) check against DC 10 + the effect's spell rank, treating a non-spell effect's Director-assigned tier as rank. On success learn its school or magical category, one active mechanical property and whether it is currently sustained, cursed or bound to another effect. Failure reveals only that magic is present.\",\n                \"source\": {\n                  \"extract\": \"docs/reference/Player_Rulebook_v6_source_text.txt\",\n                  \"line\": 5206,\n                  \"originalText\": \"Analyze Magic: Study a magical effect or item to gain insight into its properties and function.\"\n                },\n                \"designStatus\": \"provisional-playtest\",\n                \"spellRank\": 1\n              }\n            ]\n          },\n          {\n            \"classLevel\": 9,\n            \"cards\": [\n              {\n                \"id\": \"wizard.arch.sigil-rewrite\",\n                \"name\": \"Sigil Rewrite\",\n                \"className\": \"Wizard\",\n                \"band\": \"Arch\",\n                \"path\": null,\n                \"sourceKind\": \"passive\",\n                \"minimumClassLevel\": 3,\n                \"acquisition\": \"selection\",\n                \"activation\": \"Bonus Action\",\n                \"cost\": \"0\",\n                \"rangeAndTarget\": \"Self and spellbook\",\n                \"duration\": \"Instantaneous\",\n                \"frequency\": \"1/long rest\",\n                \"effect\": \"Sigil Rewrite. Tags: arch, passive-upgrade, matrix. Replace one prepared matrix with a different spell from your spellbook of exactly the same rank without performing the normal 10-minute ritual. The replacement receives no special Dissonance reset for a matrix family already used this encounter and must obey current Wizard rank eligibility.\",\n                \"source\": {\n                  \"extract\": \"docs/reference/Player_Rulebook_v6_source_text.txt\",\n                  \"line\": 5214,\n                  \"originalText\": \"Sigil Rewrite: Once/day, instantly swap a spell you know for another of the same tier\"\n                },\n                \"designStatus\": \"provisional-playtest\",\n                \"spellRank\": null\n              }\n            ]\n          },\n          {\n            \"classLevel\": 10,\n            \"cards\": [\n              {\n                \"id\": \"wizard.hero.spellbinder.spell-preservation\",\n                \"name\": \"Spell Preservation\",\n                \"className\": \"Wizard\",\n                \"band\": \"Hero\",\n                \"path\": \"Spellbinder\",\n                \"sourceKind\": \"passive\",\n                \"minimumClassLevel\": 10,\n                \"acquisition\": \"selection\",\n                \"activation\": \"Passive\",\n                \"cost\": \"0\",\n                \"rangeAndTarget\": \"Your spellbook\",\n                \"duration\": \"Permanent\",\n                \"frequency\": \"Always\",\n                \"effect\": \"Spell Preservation. Tags: hero, spellbinder, passive, spellbook. Your primary spellbook cannot be destroyed, erased or rendered permanently unreadable by non-artifact mundane or magical means. It can still be stolen, hidden, transported, suppressed, sealed by an artifact-level effect or voluntarily abandoned. Copies and backup books do not automatically receive this protection.\",\n                \"source\": {\n                  \"extract\": \"docs/reference/Player_Rulebook_v6_source_text.txt\",\n                  \"line\": 5243,\n                  \"originalText\": \"Spell Preservation: Your spellbook cannot be destroyed by non-artifact means.\"\n                },\n                \"designStatus\": \"provisional-playtest\",\n                \"spellRank\": null\n              },\n              {\n                \"id\": \"wizard.hero.spellbinder.seal-magic\",\n                \"name\": \"Seal Magic\",\n                \"className\": \"Wizard\",\n                \"band\": \"Hero\",\n                \"path\": \"Spellbinder\",\n                \"sourceKind\": \"active\",\n                \"minimumClassLevel\": 10,\n                \"acquisition\": \"selection\",\n                \"activation\": \"Action\",\n                \"cost\": \"4 RP\",\n                \"rangeAndTarget\": \"One creature within 60 feet\",\n                \"duration\": \"Maximum 3 rounds\",\n                \"frequency\": \"Recharge 3 rounds\",\n                \"effect\": \"Seal Magic. Tags: hero, spellbinder, wizard-spell, control. Choose one of the eight schools and target one creature. It makes a Wisdom save. On failure it cannot cast spells of the chosen school. At the end of each of its turns it repeats the save, ending the Seal on success. The effect ends automatically after 3 rounds and never prevents non-spell class techniques merely because they are magical.\",\n                \"source\": {\n                  \"extract\": \"docs/reference/Player_Rulebook_v6_source_text.txt\",\n                  \"line\": 5249,\n                  \"originalText\": \"Seal Magic: Prevent a target from casting spells of a specific school (WIS save, 3 rounds)\"\n                },\n                \"designStatus\": \"provisional-playtest\",\n                \"spellRank\": 5\n              }\n            ]\n          },\n          {\n            \"classLevel\": 11,\n            \"cards\": [\n              {\n                \"id\": \"wizard.base.arcane-shield\",\n                \"name\": \"Arcane Shield\",\n                \"className\": \"Wizard\",\n                \"band\": \"Base\",\n                \"path\": null,\n                \"sourceKind\": \"active\",\n                \"minimumClassLevel\": 1,\n                \"acquisition\": \"selection\",\n                \"activation\": \"Reaction\",\n                \"cost\": \"2 RP\",\n                \"rangeAndTarget\": \"Self\",\n                \"duration\": \"Until start of your next regular turn\",\n                \"frequency\": \"Recharge 2 rounds\",\n                \"effect\": \"Arcane Shield. Tags: base, active, wizard-spell, abjuration, protection. Trigger when an attack roll would hit you. Gain +2 AC against the triggering attack and until the start of your next regular turn, potentially causing the attack to miss. Temporary AC from another Arcane Shield does not stack.\",\n                \"source\": {\n                  \"extract\": \"docs/reference/Player_Rulebook_v6_source_text.txt\",\n                  \"line\": 5205,\n                  \"originalText\": \"Arcane Shield: Create a barrier of magical force that provides temporary protection.\"\n                },\n                \"designStatus\": \"provisional-playtest\",\n                \"spellRank\": 1\n              }\n            ]\n          },\n          {\n            \"classLevel\": 12,\n            \"cards\": [\n              {\n                \"id\": \"wizard.hero.spellbinder.counterpulse\",\n                \"name\": \"Counterpulse\",\n                \"className\": \"Wizard\",\n                \"band\": \"Hero\",\n                \"path\": \"Spellbinder\",\n                \"sourceKind\": \"active\",\n                \"minimumClassLevel\": 12,\n                \"acquisition\": \"selection\",\n                \"activation\": \"Triggered\",\n                \"cost\": \"1 RP\",\n                \"rangeAndTarget\": \"Caster whose spell you successfully Counterspelled\",\n                \"duration\": \"Until end of target's next turn\",\n                \"frequency\": \"At most once per round\",\n                \"effect\": \"Counterpulse. Tags: hero, spellbinder, counter, control. Immediately after your Counterspell succeeds, spend 1 RP. The countered caster is Silenced until the end of its next turn. This is part of the successful counter event rather than another spell cast and cannot trigger another Counterpulse.\",\n                \"source\": {\n                  \"extract\": \"docs/reference/Player_Rulebook_v6_source_text.txt\",\n                  \"line\": 5251,\n                  \"originalText\": \"Counterpulse: Countering a spell silences the caster for 1 round\"\n                },\n                \"designStatus\": \"provisional-playtest\",\n                \"spellRank\": null\n              }\n            ]\n          },\n          {\n            \"classLevel\": 13,\n            \"cards\": [\n              {\n                \"id\": \"wizard.base.spellbook-study\",\n                \"name\": \"Spellbook Study\",\n                \"className\": \"Wizard\",\n                \"band\": \"Base\",\n                \"path\": null,\n                \"sourceKind\": \"active\",\n                \"minimumClassLevel\": 1,\n                \"acquisition\": \"selection\",\n                \"activation\": \"Ritual\",\n                \"cost\": \"0 RP\",\n                \"rangeAndTarget\": \"Self and spellbook\",\n                \"duration\": \"10 minutes\",\n                \"frequency\": \"1/long rest\",\n                \"effect\": \"Spellbook Study. Tags: base, active, matrix, ritual. Replace one currently prepared matrix with one legal spell recorded in your spellbook. The replacement must be within your Wizard rank limit. This is the normal midday substitution permission; it does not alter the spellbook, create another prepared-matrix position or reset first-cast/Refrain history for an underlying matrix family already cast this encounter.\",\n                \"source\": {\n                  \"extract\": \"docs/reference/Player_Rulebook_v6_source_text.txt\",\n                  \"line\": 5207,\n                  \"originalText\": \"Spellbook Study: Spend time studying your spellbook to prepare a different selection of spells.\"\n                },\n                \"designStatus\": \"provisional-playtest\",\n                \"spellRank\": null\n              }\n            ]\n          }\n        ],\n        \"automaticCards\": [\n          {\n            \"id\": \"wizard.arch.arcane-tradition\",\n            \"name\": \"Arcane Tradition\",\n            \"className\": \"Wizard\",\n            \"band\": \"Arch\",\n            \"path\": null,\n            \"sourceKind\": \"passive\",\n            \"minimumClassLevel\": 3,\n            \"acquisition\": \"automatic\",\n            \"activation\": \"Passive\",\n            \"cost\": \"0\",\n            \"rangeAndTarget\": \"Your level-1 Arcane School\",\n            \"duration\": \"Permanent\",\n            \"frequency\": \"Automatic at Wizard 3; not a selection\",\n            \"effect\": \"Arcane Tradition. Tags: arch, school, automatic. Your level-1 Arcane School becomes your Arcanist tradition; do not choose a second school. Prepare one additional matrix from that same school each day without counting it against your normal prepared-matrix maximum. It otherwise obeys all ordinary rank, spellbook, Dissonance and duplicate-family rules.\",\n            \"source\": {\n              \"extract\": \"docs/reference/Player_Rulebook_v6_source_text.txt\",\n              \"line\": 5217,\n              \"originalText\": \"Arcane Tradition: Choose a school of magic to specialize in, gaining bonuses to spells of that school.\"\n            },\n            \"designStatus\": \"provisional-playtest\",\n            \"spellRank\": null\n          },\n          {\n            \"id\": \"wizard.base.counterspell\",\n            \"name\": \"Counterspell\",\n            \"className\": \"Wizard\",\n            \"band\": \"Base\",\n            \"path\": null,\n            \"sourceKind\": \"active\",\n            \"minimumClassLevel\": 2,\n            \"acquisition\": \"automatic\",\n            \"activation\": \"Reaction\",\n            \"cost\": \"3 RP\",\n            \"rangeAndTarget\": \"One creature you perceive casting a spell within 60 feet\",\n            \"duration\": \"Instantaneous\",\n            \"frequency\": \"Automatic at Wizard 2; recharge 2 rounds\",\n            \"effect\": \"Counterspell. Tags: arch-source, automatic, wizard-spell, abjuration, disruption. Trigger when a creature begins casting a spell. Make an Intelligence check adding proficiency against DC 10 + twice the spell's rank, treating rank 0 as 0. Success negates the triggering spell after its costs are paid; failure lets it resolve. This is gained automatically at Wizard 2 and is never also selected from the Arch pool.\",\n            \"source\": {\n              \"extract\": \"docs/reference/Player_Rulebook_v6_source_text.txt\",\n              \"line\": 5222,\n              \"originalText\": \"Counterspell: Disrupt an enemy's spellcasting, potentially negating their spell entirely.\"\n            },\n            \"designStatus\": \"provisional-playtest\",\n            \"spellRank\": 1\n          },\n          {\n            \"id\": \"wizard.supplement.ritual-casting\",\n            \"name\": \"Ritual Casting\",\n            \"className\": \"Wizard\",\n            \"band\": \"Base\",\n            \"path\": null,\n            \"sourceKind\": \"supplement\",\n            \"minimumClassLevel\": 2,\n            \"acquisition\": \"automatic\",\n            \"activation\": \"Ritual\",\n            \"cost\": \"0 RP unless the individual ritual explicitly states otherwise\",\n            \"rangeAndTarget\": \"As the ritual spell\",\n            \"duration\": \"As the ritual spell\",\n            \"frequency\": \"At will outside encounters with sufficient time\",\n            \"effect\": \"Source progression line 5184. Cast a Wizard spell bearing the Ritual tag directly from your spellbook without preparing it. Increase its casting time by at least 10 minutes. Ritual Casting cannot be completed during an encounter, does not use an ordinary prepared-matrix position and does not generate or vent normal casting Dissonance.\",\n            \"prerequisite\": \"See class engine and progression.\",\n            \"source\": {\n              \"line\": 5184,\n              \"reference\": null,\n              \"originalText\": \"| 2 | Counterspell Reaction, Ritual Casting |\",\n              \"status\": \"source-derived\"\n            },\n            \"designStatus\": \"provisional-playtest\",\n            \"spellRank\": null\n          },\n          {\n            \"id\": \"wizard.supplement.school-mastery\",\n            \"name\": \"School Mastery\",\n            \"className\": \"Wizard\",\n            \"band\": \"Arch\",\n            \"path\": null,\n            \"sourceKind\": \"supplement\",\n            \"minimumClassLevel\": 5,\n            \"acquisition\": \"automatic\",\n            \"activation\": \"Passive\",\n            \"cost\": \"0\",\n            \"rangeAndTarget\": \"Your level-1 Arcane School\",\n            \"duration\": \"Permanent\",\n            \"frequency\": \"Automatic at Wizard 5\",\n            \"effect\": \"Source progression line 5186. This is the one School Mastery progression grant, not a second school choice or duplicate feat. Increase the level-1 Arcane School spell-attack and spell-save bonus from +1 to +2 total. Its school passive and bonus-spell rules otherwise remain unchanged.\",\n            \"prerequisite\": \"See class engine and progression.\",\n            \"source\": {\n              \"line\": 5186,\n              \"reference\": null,\n              \"originalText\": \"| 5 | Bonus Feat: School Mastery |\",\n              \"status\": \"source-derived\"\n            },\n            \"designStatus\": \"provisional-playtest\",\n            \"spellRank\": null\n          },\n          {\n            \"id\": \"wizard.supplement.arcane-ward\",\n            \"name\": \"Arcane Ward\",\n            \"className\": \"Wizard\",\n            \"band\": \"Arch\",\n            \"path\": null,\n            \"sourceKind\": \"supplement\",\n            \"minimumClassLevel\": 6,\n            \"acquisition\": \"automatic\",\n            \"activation\": \"Passive\",\n            \"cost\": \"0\",\n            \"rangeAndTarget\": \"Self\",\n            \"duration\": \"Until next long rest\",\n            \"frequency\": \"Choose after each long rest\",\n            \"effect\": \"Source progression line 5187. After preparing spells, choose one of acid, cold, fire, force, lightning, necrotic, psychic, radiant or thunder that is dealt by at least one prepared spell of your Arcane School. Gain resistance to that damage type until your next long rest. If none of your prepared school spells deals a damage type, choose force. This is provisional completion of the source's ambiguous 'chosen school's element' wording.\",\n            \"prerequisite\": \"See class engine and progression.\",\n            \"source\": {\n              \"line\": 5187,\n              \"reference\": null,\n              \"originalText\": \"| 6 | Arcane Ward (resistance to chosen school's element) |\",\n              \"status\": \"source-derived\"\n            },\n            \"designStatus\": \"provisional-playtest\",\n            \"spellRank\": null\n          },\n          {\n            \"id\": \"wizard.supplement.dual-cast\",\n            \"name\": \"Dual Cast\",\n            \"className\": \"Wizard\",\n            \"band\": \"Arch\",\n            \"path\": null,\n            \"sourceKind\": \"supplement\",\n            \"minimumClassLevel\": 9,\n            \"acquisition\": \"automatic\",\n            \"activation\": \"Action\",\n            \"cost\": \"Pay the complete RP costs of both spells\",\n            \"rangeAndTarget\": \"As each spell\",\n            \"duration\": \"As each spell\",\n            \"frequency\": \"1/short rest\",\n            \"effect\": \"Source progression line 5188. Choose two DIFFERENT prepared Wizard spells of rank 1 or 2, neither of which summons a creature or grants an additional Action. Cast both sequentially as one Action, paying both RP costs. They cannot both require concentration. Each matrix separately updates first-cast/Refrain history. Features that trigger merely from 'casting a spell' may trigger once for each actual matrix unless that feature itself says once per turn; no trigger may create another Dual Cast or additional full Action.\",\n            \"prerequisite\": \"See class engine and progression.\",\n            \"source\": {\n              \"line\": 5188,\n              \"reference\": null,\n              \"originalText\": \"| 9 | Dual Cast (cast 2 Tier 1–2 spells in a round) |\",\n              \"status\": \"source-derived\"\n            },\n            \"designStatus\": \"provisional-playtest\",\n            \"spellRank\": null\n          },\n          {\n            \"id\": \"wizard.supplement.overchannel\",\n            \"name\": \"Overchannel\",\n            \"className\": \"Wizard\",\n            \"band\": \"Hero\",\n            \"path\": null,\n            \"sourceKind\": \"supplement\",\n            \"minimumClassLevel\": 13,\n            \"acquisition\": \"automatic\",\n            \"activation\": \"Triggered\",\n            \"cost\": \"Pay the Core V 2 RP cost for one rank above the spell's normal cast rank\",\n            \"rangeAndTarget\": \"One prepared spell you are beginning to cast\",\n            \"duration\": \"For that cast\",\n            \"frequency\": \"1/long rest\",\n            \"effect\": \"Source progression line 5190. Cast one prepared spell as though it were one rank higher than the highest rank at which you could normally cast that SAME spell, provided the spell has an explicit higher-rank scaling rule. Overchannel does not teach or prepare a higher-rank spell, cannot exceed effective rank 9 and cannot be combined with another generic Overcast rule during this pilot. All normal Dissonance/Refrain rules still apply.\",\n            \"prerequisite\": \"See class engine and progression.\",\n            \"source\": {\n              \"line\": 5190,\n              \"reference\": null,\n              \"originalText\": \"| 13 | Overchannel (cast a spell 1 tier higher once/day) |\",\n              \"status\": \"source-derived\"\n            },\n            \"designStatus\": \"provisional-playtest\",\n            \"spellRank\": null\n          }\n        ],\n        \"completeEngine\": [\n          \"PROVISIONAL PLAYTEST CONTRACT. Intelligence is the Wizard class ability. S = 1/2/3/4 at Wizard levels 1/5/11/17. M = max(1, Intelligence modifier). Wizard spell attack = d20 + normal character proficiency bonus + Intelligence modifier. Wizard spell save DC = 8 + normal character proficiency bonus + Intelligence modifier.\",\n          \"The Wizard remains three distinct stages: Base Wizard at levels 1-2, Arch Arcanist at levels 3-9, and one Hero path at levels 10-20: Spellbinder, Elementalist or Necromancer. Hero paths are not additional starting classes and their features cannot be selected before their Wizard class-level gates.\",\n          \"SPELLBOOK. At Wizard 1 your spellbook contains six chosen rank-1 Wizard spells. Arcane School Specialization also adds one legal rank-1 bonus spell of your chosen school without replacing one of those six. For this provisional progression, add 2 legal Wizard spells to the book at each Wizard level 2-4, 3 at each level 5-8, 4 at each level 9-12, 5 at each level 13-16 and 6 at each level 17-20. Level-up additions cost no money or scribing time.\",\n          \"LEGAL RANKS. Maximum Wizard spell rank by Wizard class level is: rank 1 at levels 1-2, rank 2 at 3-4, rank 3 at 5-6, rank 4 at 7-8, rank 5 at 9-10, rank 6 at 11-12, rank 7 at 13-14, rank 8 at 15-16 and rank 9 at 17-20. Grand Tier at level 20 is a special casting permission, not a tenth ordinary rank. A Wizard may learn Wizard-list spells from any school up to the legal rank unless a spell itself has an additional prerequisite.\",\n          \"PREPARED SPELL MATRIX. After a long rest, prepare a number of matrices equal to Wizard level + Intelligence modifier, minimum 1, selecting only spells currently recorded in your spellbook and within your legal rank. You cast ordinary Wizard spells only from prepared matrices unless a feature explicitly overrides that restriction. Preparing the full daily matrix set normally requires 1 hour of spellbook study. Matrix Efficiency reduces this to 45 minutes.\",\n          \"DUPLICATE PREPARATION. You may prepare the same spell more than once, primarily to carry different Matrix Mastery configurations. Duplicate copies never create additional first-cast Dissonance exemptions. For Refrain and the protected strain rule, all prepared copies sharing the same underlying spell name belong to one matrix family regardless of modification.\",\n          \"MIDDAY SUBSTITUTION. Once between long rests, you may perform a 10-minute Spellbook Study ritual to replace one prepared matrix with another legal spell from your spellbook. The replacement cannot exceed your legal Wizard rank. Sigil Rewrite and Matrix Mastery may improve this process as explicitly stated.\",\n          \"SPELL ACQUISITION BY SCRIBING. A found Wizard spell may be copied into the spellbook if its rank is legal for you. Baseline scribing requires 2 hours and 50 gp of inks/materials per spell rank, treating rank 0 as 1 for this calculation. Spell Scribing halves both values to 1 hour and 25 gp per rank. Failure to finish the work consumes no spellbook entry but materials already expended during an interrupted hour are lost.\",\n          \"SPELLBOOK LOSS. Losing the spellbook does not erase matrices currently prepared in memory; you may continue casting those prepared matrices until you next rebuild or change preparation. A blank replacement book can be seeded with your currently prepared spells at 1 hour and 25 gp per effective spell rank each. An unprepared spell you previously recorded can be reconstructed from memory with 8 hours, 100 gp per rank and an Intelligence (Arcana) check against DC 10 + spell rank. Failure consumes that attempt's time and half its materials; another attempt can be made after a long rest. Recovering the original book automatically restores access to its surviving entries.\",\n          \"ARCANE SCHOOL SPECIALIZATION is automatic at Wizard 1. Choose exactly one of the eight schools. Your spell attacks with that school gain +1 and your Wizard save DC for that school's spells gains +1. You also add one legal rank-1 spell of that school to the spellbook. The source table explicitly supplies seven school passives; the eighth core school, Abjuration, is named elsewhere but its passive row is missing. Its provisional playtest passive is identified below rather than silently presented as recovered text.\",\n          \"ABJURATION, provisional completion for the omitted eighth row: once per round after you cast an Abjuration spell, gain temporary HP equal to PB until the start of your next regular turn. CONJURATION: creatures summoned by your Wizard spells gain +1 maximum HP per Wizard level. DIVINATION: once per long rest reroll one failed saving throw and use the new result. ENCHANTMENT: when a creature fails its initial save against one of your Enchantment spells, a printed control duration of at least 1 round may last one additional round, but every normally allowed repeat save still occurs. EVOCATION: when casting an area Evocation spell, exclude one creature from its initial damaging area; that creature automatically succeeds and takes no damage if success normally halves damage. ILLUSION: gain +2 on concentration saves made to maintain Illusion spells. NECROMANCY: once per turn during a real encounter when a hostile non-summoned creature dies from your Necromancy spell, gain 1 temporary HP; it is not permanent healing. TRANSMUTATION: after casting a Transmutation spell, gain +5 feet Speed until the end of that turn.\",\n          \"PROTECTED DISSONANCE INTERFACE. The first cast of each different prepared matrix family during an encounter generates 0 BASE Dissonance. This exemption affects only base strain. Refrain and explicitly printed strain costs still apply; the suite disables generic Overcast and does not layer historical Burn onto Dissonance. Repeating a matrix family follows normal Refrain immediately. Preparing duplicates or differently modified copies of the same underlying spell never refreshes the exemption.\",\n          \"Core Systems V 2 Resonance Points and spell-rank RP costs are authoritative for Wizard spellcasting. There are no historical spell slots in this pilot. Wizard cards tagged wizard-spell are always-prepared class matrices once acquired, do not consume a daily prepared-matrix position and use the same RP, concentration, Refrain and protected first-distinct-matrix rules as other Wizard spells. Their printed RP cost replaces any generic rank cost; never pay both.\",\n          \"RITUAL CASTING is automatic at Wizard 2. A Wizard spell in your spellbook with the Ritual tag can be cast from the book without being prepared by increasing its casting time by at least 10 minutes. A ritual cast costs 0 RP unless that ritual explicitly lists a consumed RP cost, cannot be used during an encounter and cannot generate or vent Dissonance through ordinary casting strain.\",\n          \"Only one concentration effect can normally be maintained. Starting a second concentration effect ends the first. Damage uses the current Core Systems concentration rule; required half-damage rounding is down for this pilot. Spell Tether and the level-17 Tethered Cast are the only Wizard-specific exceptions in this draft, and each has an explicit RP price, duration and one-tether cap.\",\n          \"MATRIX MASTERY MODIFICATIONS. After acquiring Matrix Mastery, each prepared ordinary spell matrix may carry at most one modification chosen during preparation. QUICK SUBSTITUTION: once per short rest, replace one matrix marked Quick Substitution with another spellbook spell of exactly the same rank using a 1-minute ritual instead of the normal 10-minute midday swap; the replacement loses the modification until the next long rest. COMPONENT ENHANCEMENT: when casting a damaging or healing matrix, spend 1 additional RP to add one extra die of the spell's primary damage or healing die to one roll; if the spell has no such die this modification has no effect. MATRIX LINKING: pair two different prepared matrix families during preparation; after legally casting one, the other costs 1 less RP, minimum 1, if cast before the end of your next regular turn, at most once per pair per round. STABILITY REINFORCEMENT: gain +2 on concentration saves caused by damage while maintaining that matrix. A matrix modification never creates another spell cast or proc event.\",\n          \"All sources share a maximum of one additional full Action per creature per round. Additional Actions cannot grant another additional Action, Bonus Action or Reaction. Spell copies, Matrix Sharing, Arcane Fusion, Dual Cast and similar effects pay all explicitly required RP and do not produce duplicate resource, cast-proc or action-grant chains beyond their written resolution.\",\n          \"Round recharge counters decrease once at the start of your regular initiative turn even if you cannot act. Extra Actions and extra turns do not tick recharge. Outside initiative, each uninterrupted 6 seconds counts as one tick. Only positive counters can be reset or shortened and each named ability can receive at most one reset or shortening per round.\",\n          \"SUMMON COMMAND LIMIT. All Wizard-controlled conjured, raised and bound companions share one damaging/control Companion Command per Wizard regular turn. Spend one Bonus Action to command exactly one such creature to move up to its Speed and use one damaging or control action from its stat block. Uncommanded creatures may reposition defensively and take Dodge but cannot deal damage or impose conditions. No summoned or raised creature can create XP, treasure, RP, Dissonance relief, additional corpses or kill-resource farms.\",\n          \"NECROMANCER STANDARD UNDEAD. Corpse Harvest and Auto-Raise share a maximum of three standard raised minions. Skeleton: AC 14, HP 6 + 2 × Wizard level, Speed 30; Bone Shot, range 30 feet, Wizard spell attack, 1d6+S necrotic. Zombie: AC 12, HP 10 + 3 × Wizard level, Speed 20; Slam, reach 5 feet, Wizard spell attack, 1d8+S necrotic. Goblin Thrall, available only from a goblinoid corpse: AC 13, HP 8 + 2 × Wizard level, Speed 30; Shiv, reach 5 feet, Wizard spell attack, 1d6+S necrotic. These are pre-Flesh-Ascendant statistics.\",\n          \"NECROMANCER AUTO-RAISE. Once per round when one of your standard undead minions personally lands the killing blow on an eligible humanoid and your standard-minion count is below three, its corpse rises at the end of the current turn as the same mechanical minion type that scored the kill, if physically possible. A new minion cannot act during that same round. Auto-Raise costs no Action or RP but can never exceed the three-minion cap or generate a new resource, corpse chain, XP or treasure event. Without Infernal Pact only humanoids qualify.\",\n          \"ELITE UNDEAD PETS. Necromancers may bind Boneflayer, Dreadblade and Wraithbound, at most one of each and three elite pets total. They use the same shared Companion Command limit as standard undead. Boneflayer: AC 14, HP 12 + 2 × Wizard level, Speed 30. Bone Shards: range 60, Wizard spell attack, 2d6+S necrotic. Fear Pulse replaces its attack: enemies within 10 feet make Wisdom saves; failure Frightened until end of next turn; recharge 3. Grave Miasma replaces its attack: 10-foot-radius point within 30 feet until start of your next turn; enemies entering or starting there take 1d6 necrotic once; recharge 3.\",\n          \"Dreadblade: AC 16, HP 16 + 3 × Wizard level, Speed 30. Disrupting Blade: reach 5 feet, Wizard spell attack, 1d8+S necrotic; a concentrating target immediately makes its concentration save with disadvantage. On a natural 20 the target is Weakened until the end of its next turn, taking -1 on attack rolls. Dreadblade has advantage on saves against forced movement.\",\n          \"Wraithbound: AC 14, HP 10 + 2 × Wizard level, Fly 40 and hover. While it has not attacked or imposed control since the end of its previous turn it is Invisible; attacking ends that state until the end of its next turn. Wraith Strike: reach 5 feet, Wizard spell attack, 1d8+S necrotic. On natural 20 the target makes a Constitution save against your Wizard DC; failure Stuns until the end of its next turn.\",\n          \"Flesh Ascendant's bonus applies after the listed base statistics: every undead creature you control gains +2 maximum HP per Wizard level. If at least two of your undead creatures are active, each gains +1 AC and +1 on saving throws. This does not increase the standard-minion or elite-pet caps.\",\n          \"DARK-TRAUMA INTERFACE. Necromancer features involving corpse desecration, infernal bargains, domination, body control or Mind Prison remain subject to the project's existing dark-content and trauma boundaries. A table may fade description to black without changing mechanics. No feature changes a player's real belief, permanently transfers ownership of a player character or silently retires a PC.\",\n          \"PROPOSED ACQUISITION. Wizard 1 automatically gains Arcane School Specialization, Spell Matrix System and the starting spellbook, then chooses 4 selectable Base cards, at least 2 Active. Wizard 2 automatically gains Counterspell and Ritual Casting, then chooses 2 additional selectable Base cards. Counterspell is not also placed in the Arch selection pool.\",\n          \"At Wizard 3 enter Arcanist, automatically gain Arcane Tradition as an upgrade of the SAME level-1 school rather than choosing another school, and choose 2 selectable Arch cards, at least 1 Active. Wizard 4 grants one eligible Base/Arch choice. Wizard 5 grants one Base/Arch choice plus automatic School Mastery. Wizard 6 grants one Base/Arch choice plus automatic Arcane Ward. Wizard 7 grants one eligible Arch choice. Wizard 8 grants one Base/Arch choice. Wizard 9 grants one eligible Arch choice plus automatic Dual Cast.\",\n          \"At Wizard 10 choose Spellbinder, Elementalist or Necromancer and gain 2 Hero cards from that path. ELEMENTALIST EXCEPTION: Elemental Affinity is automatic at path selection and counts as one of those two level-10 Hero acquisitions, so an Elementalist chooses only one additional Hero card at level 10. Levels 11, 13, 15, 17 and 19 each grant one eligible unselected Base/Arch choice. Levels 12, 14, 16 and 18 each grant one Hero-path choice. The chosen Final Theorem is automatic at Wizard 20. School Mastery, Counterspell, Arcane Tradition and all progression-table automatic features are never duplicated as selections.\",\n          \"All acquisition gates use Wizard class level rather than total character level. Normal proficiency bonus follows the game's ordinary total-character-level rule. A multiclass dip cannot unlock higher spell ranks, Arcanist cards, Hero cards, Final Theorems or progression-table features.\",\n          \"Class matrices tagged wizard-spell receive a rank in normalized card data equal to maximum ordinary Wizard rank at their minimum class-level gate (cap 9). Printed RP cost replaces generic rank cost. Counterspell is rank 1 at its explicit level 2 automatic grant. This explicit convention closes rank-dependent Counterspell/Dissonance interactions without inventing extra costs.\",\n          \"Cantrip completion: know 3 Wizard cantrips at 1, 4 at 4, 5 at 10, using the shared missing-repertoire fallback. Cantrips are known directly and do not consume prepared matrices. Always-prepared class matrices are additional cards, not extra arbitrary ordinary spells. Class spell ranks and the normalized activation field resolve incomplete source terminology.\"\n        ],\n        \"source\": {\n          \"path\": \"DescentReviewChanges/ReviewBible/data/public/class_playtests/wizard.json\",\n          \"pointers\": [\n            \"/engine\",\n            \"/schedule\",\n            \"/cards\",\n            \"/rpByClassLevel/12\"\n          ]\n        },\n        \"optionalChoicesInCases\": \"No Matrix Mastery, Spell Efficiency, Improved Concentration, Sigil Authority or Knowledge Shield acquired. Dual Cast, Overchannel, class Arcane Shield and optional Counterpulse are not invoked unless expressly declared. No Arcane Feedback at13.\",\n        \"creatureType\": \"Humanoid\",\n        \"profileScope\": \"An explicitly supplied finite class-built teaching creature profile using the complete actual class engine/cards. Not a newly rated bestiary creature, not authenticated campaign or ancestry acquisition, and not permission to fill an absent future profile.\",\n        \"languages\": [\n          \"Common\"\n        ],\n        \"otherIntrinsicDefenses\": [],\n        \"additionalSkillProficienciesClaimed\": [],\n        \"checks\": \"Use current ability modifier and actual acquired named card when applicable; save proficiency is not an ability-check proficiency. No Athletics proficiency is claimed.\",\n        \"actualActionsAvailable\": \"Each annotated actual regular START supplies the normal Action/BonusAction/Reaction/movement according to the real source; the event trace explicitly consumes each used budget. No extra action source is assumed.\",\n        \"asiHistory\": {\n          \"rolledINT\": 16,\n          \"class4\": \"INT+2 to18\",\n          \"class8\": \"STR+2 from8 to10\",\n          \"class12\": \"CHA+2 from8 to10\",\n          \"DEX\": 14,\n          \"CON\": 14,\n          \"WIS\": 12,\n          \"note\": \"Explicit legal generated-score/ASI fixture inputs; no extra feat is claimed.\"\n        }\n      },\n      \"newTarget\": {\n        \"kind\": \"Source-qualified illustrative character, not a verified campaign actor or rated monster\",\n        \"class\": \"Wizard\",\n        \"classLevel\": 13,\n        \"totalLevel\": 13,\n        \"PB\": 5,\n        \"S\": 3,\n        \"STR\": 10,\n        \"DEX\": 14,\n        \"CON\": 14,\n        \"INT\": 18,\n        \"WIS\": 12,\n        \"CHA\": 10,\n        \"maxHp\": 80,\n        \"hpConstruction\": \"d6 class: initial6+CON2=8, twelve supplied legal hit-die results4+CON2=6 each;8+72=80. This is a stated fixture history, not generated random character evidence.\",\n        \"maxRp\": 48,\n        \"maxRank\": 7,\n        \"Limit\": 11,\n        \"AC\": 12,\n        \"speedFeet\": 30,\n        \"size\": \"Medium\",\n        \"bodyBoxFeet\": [\n          5,\n          5,\n          5\n        ],\n        \"bodyMassLb\": 170,\n        \"actualGear\": {\n          \"focus-pack\": {\n            \"grossWeightLb\": 10,\n            \"load\": 1,\n            \"contents\": \"real ordinary wooden focus and mundane personal carrying effects; no consumed materials/charged item; gross figures include every item once\"\n          }\n        },\n        \"saves\": {\n          \"STR\": 0,\n          \"DEX\": 2,\n          \"CON\": 2,\n          \"INT\": 9,\n          \"WIS\": 6,\n          \"CHA\": 0\n        },\n        \"spellAttack\": 9,\n        \"spellDc\": 17,\n        \"school\": \"Illusion\",\n        \"schoolAttack\": 11,\n        \"schoolDc\": 19,\n        \"schoolConcentrationSave\": 4,\n        \"ordinaryConcentrationSave\": 2,\n        \"arcaneWard\": \"force resistance: this prepared Illusion set has no intrinsic damage type; no fire/cold/psychic resistance invented\",\n        \"hero\": \"Spellbinder\",\n        \"bookAndPreparation\": {\n          \"newRank7BookAdditionsAt13\": [\n            \"cast-echo\",\n            \"meta-surge\",\n            \"erase-from-reality\",\n            \"sequester\",\n            \"simulacrum\"\n          ],\n          \"ordinaryPrepared\": [\n            \"cast-echo\",\n            \"meta-surge\",\n            \"erase-from-reality\",\n            \"sequester\",\n            \"simulacrum\",\n            \"fireball\",\n            \"shield\",\n            \"counterspell\",\n            \"continual-flame\",\n            \"mirror-image\",\n            \"detect-magic\",\n            \"true-seeing\"\n          ],\n          \"count\": 12,\n          \"baseCapacity\": 17,\n          \"additionalFloatingAndSchoolSlotsUnused\": true,\n          \"olderSpells\": \"Actual source-qualified book/cantrip additions at earlier legal Wizard levels; ordinary Counterspell acquired at5+, True Seeing at11, Continual Flame at3; no feat or copying grant needed.\",\n          \"ordinaryKnownCantrips\": [\n            \"ray-of-frost\",\n            \"chill-touch\",\n            \"resonance-shield\",\n            \"minor-image\",\n            \"disrupt-memory\"\n          ],\n          \"unusedBaseMatrixPositions\": 5\n        },\n        \"selectedAcquisition\": [\n          {\n            \"classLevel\": 1,\n            \"cards\": [\n              {\n                \"id\": \"wizard.base.arcane-recovery\",\n                \"name\": \"Arcane Recovery\",\n                \"className\": \"Wizard\",\n                \"band\": \"Base\",\n                \"path\": null,\n                \"sourceKind\": \"passive\",\n                \"minimumClassLevel\": 1,\n                \"acquisition\": \"selection\",\n                \"activation\": \"Passive\",\n                \"cost\": \"0\",\n                \"rangeAndTarget\": \"Self\",\n                \"duration\": \"Instantaneous during a completed short rest\",\n                \"frequency\": \"1/long rest\",\n                \"effect\": \"Arcane Recovery. Tags: base, passive, resonance. Once between long rests when you complete a short rest, restore RP equal to half your Wizard class level rounded up, never above your normal maximum. This is RP recovery, not a second pool, and cannot trigger spell-cast, Refrain or Dissonance effects.\",\n                \"source\": {\n                  \"extract\": \"docs/reference/Player_Rulebook_v6_source_text.txt\",\n                  \"line\": 5196,\n                  \"originalText\": \"Arcane Recovery: Once per day during a short rest, recover RP equal to half your Wizard level (rounded up), up to your normal maximum.\"\n                },\n                \"designStatus\": \"provisional-playtest\",\n                \"spellRank\": null\n              },\n              {\n                \"id\": \"wizard.base.spell-scribing\",\n                \"name\": \"Spell Scribing\",\n                \"className\": \"Wizard\",\n                \"band\": \"Base\",\n                \"path\": null,\n                \"sourceKind\": \"passive\",\n                \"minimumClassLevel\": 1,\n                \"acquisition\": \"selection\",\n                \"activation\": \"Passive\",\n                \"cost\": \"0\",\n                \"rangeAndTarget\": \"Your spellbook\",\n                \"duration\": \"Permanent\",\n                \"frequency\": \"Always\",\n                \"effect\": \"Spell Scribing. Tags: base, passive, spellbook. Copying a legal found Wizard spell into your spellbook requires 1 hour and 25 gp of inks and components per spell rank, treating rank 0 as rank 1 for this calculation, instead of the pilot baseline 2 hours and 50 gp. Level-up spells remain free.\",\n                \"source\": {\n                  \"extract\": \"docs/reference/Player_Rulebook_v6_source_text.txt\",\n                  \"line\": 5197,\n                  \"originalText\": \"Spell Scribing: Copy spells into your spellbook at half the normal cost and time.\"\n                },\n                \"designStatus\": \"provisional-playtest\",\n                \"spellRank\": null\n              },\n              {\n                \"id\": \"wizard.base.arcane-bolt\",\n                \"name\": \"Arcane Bolt\",\n                \"className\": \"Wizard\",\n                \"band\": \"Base\",\n                \"path\": null,\n                \"sourceKind\": \"active\",\n                \"minimumClassLevel\": 1,\n                \"acquisition\": \"selection\",\n                \"activation\": \"Action\",\n                \"cost\": \"1 RP\",\n                \"rangeAndTarget\": \"One creature within 60 feet\",\n                \"duration\": \"Instantaneous\",\n                \"frequency\": \"At will while RP remains\",\n                \"effect\": \"Arcane Bolt. Tags: base, active, wizard-spell, universal, damage. Make a Wizard spell attack. On a hit deal S d6 + M force damage. Arcane Bolt is an always-prepared class matrix once acquired and uses the normal first-distinct-matrix and Refrain rules.\",\n                \"source\": {\n                  \"extract\": \"docs/reference/Player_Rulebook_v6_source_text.txt\",\n                  \"line\": 5203,\n                  \"originalText\": \"Arcane Bolt: Launch a bolt of pure arcane energy that deals force damage to a single target.\"\n                },\n                \"designStatus\": \"provisional-playtest\",\n                \"spellRank\": 1\n              },\n              {\n                \"id\": \"wizard.base.minor-conjuration\",\n                \"name\": \"Minor Conjuration\",\n                \"className\": \"Wizard\",\n                \"band\": \"Base\",\n                \"path\": null,\n                \"sourceKind\": \"active\",\n                \"minimumClassLevel\": 1,\n                \"acquisition\": \"selection\",\n                \"activation\": \"Action\",\n                \"cost\": \"1 RP\",\n                \"rangeAndTarget\": \"One unoccupied space within 10 feet\",\n                \"duration\": \"1 hour\",\n                \"frequency\": \"At will while RP remains; one object at a time\",\n                \"effect\": \"Minor Conjuration. Tags: base, active, wizard-spell, conjuration. Create one nonmagical unattended object that fits inside a 1-foot cube, weighs no more than 10 pounds and is made of common nonvaluable material such as wood, cloth, clay, iron or glass. It cannot be food, poison, currency, a spell component with listed cost, ammunition with special properties or a functional complex mechanism. Creating another dismisses the first.\",\n                \"source\": {\n                  \"extract\": \"docs/reference/Player_Rulebook_v6_source_text.txt\",\n                  \"line\": 5204,\n                  \"originalText\": \"Minor Conjuration: Create a temporary, small inanimate object that lasts for 1 hour.\"\n                },\n                \"designStatus\": \"provisional-playtest\",\n                \"spellRank\": 1\n              }\n            ]\n          },\n          {\n            \"classLevel\": 2,\n            \"cards\": [\n              {\n                \"id\": \"wizard.base.arcane-insight\",\n                \"name\": \"Arcane Insight\",\n                \"className\": \"Wizard\",\n                \"band\": \"Base\",\n                \"path\": null,\n                \"sourceKind\": \"passive\",\n                \"minimumClassLevel\": 1,\n                \"acquisition\": \"selection\",\n                \"activation\": \"Passive\",\n                \"cost\": \"0\",\n                \"rangeAndTarget\": \"Self\",\n                \"duration\": \"Permanent\",\n                \"frequency\": \"Always\",\n                \"effect\": \"Arcane Insight. Tags: base, passive, knowledge. Gain proficiency in Arcana, or expertise if already proficient. When examining an active magical effect, spell residue, magic item or arcane construction, you may make an Intelligence (Arcana) check to determine its broad school, function or unusual matrix behavior. The Director sets the normal knowledge DC; failure supplies no invented fact.\",\n                \"source\": {\n                  \"extract\": \"docs/reference/Player_Rulebook_v6_source_text.txt\",\n                  \"line\": 5198,\n                  \"originalText\": \"Arcane Insight: Identify magical effects and items with greater accuracy than non-wizards.\"\n                },\n                \"designStatus\": \"provisional-playtest\",\n                \"spellRank\": null\n              },\n              {\n                \"id\": \"wizard.base.matrix-efficiency\",\n                \"name\": \"Matrix Efficiency\",\n                \"className\": \"Wizard\",\n                \"band\": \"Base\",\n                \"path\": null,\n                \"sourceKind\": \"passive\",\n                \"minimumClassLevel\": 1,\n                \"acquisition\": \"selection\",\n                \"activation\": \"Passive\",\n                \"cost\": \"0\",\n                \"rangeAndTarget\": \"Self\",\n                \"duration\": \"Daily preparation\",\n                \"frequency\": \"Always\",\n                \"effect\": \"Matrix Efficiency. Tags: base, passive, matrix. Your normal full daily Spell Matrix preparation time is reduced from 1 hour to 45 minutes. This does not reduce the separate 10-minute midday substitution ritual, spell scribing, rituals or spellbook reconstruction unless another feature explicitly says so.\",\n                \"source\": {\n                  \"extract\": \"docs/reference/Player_Rulebook_v6_source_text.txt\",\n                  \"line\": 5199,\n                  \"originalText\": \"Matrix Efficiency: Reduce the preparation time for spells by 25%.\"\n                },\n                \"designStatus\": \"provisional-playtest\",\n                \"spellRank\": null\n              }\n            ]\n          },\n          {\n            \"classLevel\": 3,\n            \"cards\": [\n              {\n                \"id\": \"wizard.arch.floating-preparation\",\n                \"name\": \"Floating Preparation\",\n                \"className\": \"Wizard\",\n                \"band\": \"Arch\",\n                \"path\": null,\n                \"sourceKind\": \"passive\",\n                \"minimumClassLevel\": 3,\n                \"acquisition\": \"selection\",\n                \"activation\": \"Passive\",\n                \"cost\": \"0\",\n                \"rangeAndTarget\": \"Self\",\n                \"duration\": \"Daily preparation\",\n                \"frequency\": \"Always\",\n                \"effect\": \"Floating Preparation. Tags: arch, passive, matrix. Increase your maximum prepared Spell Matrix count by 1. The extra matrix can come from any school and obeys all ordinary spellbook and rank restrictions. It is a prepared matrix for every rule, including protected strain, duplicate-family tracking and Matrix Mastery modifications.\",\n                \"source\": {\n                  \"extract\": \"docs/reference/Player_Rulebook_v6_source_text.txt\",\n                  \"line\": 5213,\n                  \"originalText\": \"Floating Preparation: Prepare 1 extra spell from any school each day\"\n                },\n                \"designStatus\": \"provisional-playtest\",\n                \"spellRank\": null\n              },\n              {\n                \"id\": \"wizard.arch.arcane-lock\",\n                \"name\": \"Arcane Lock\",\n                \"className\": \"Wizard\",\n                \"band\": \"Arch\",\n                \"path\": null,\n                \"sourceKind\": \"active\",\n                \"minimumClassLevel\": 3,\n                \"acquisition\": \"selection\",\n                \"activation\": \"Action\",\n                \"cost\": \"2 RP\",\n                \"rangeAndTarget\": \"One door, chest, portal or unattended object within touch\",\n                \"duration\": \"8 hours\",\n                \"frequency\": \"Recharge 2 rounds\",\n                \"effect\": \"Arcane Lock. Tags: arch, active, wizard-spell, abjuration. Magically seal the target. Opening it without your permission requires a Strength check or thieves'/arcane-tool check against your Wizard spell DC. Dispel Magic can end the lock. You can designate up to M creatures who can bypass it. This does not make the object physically indestructible.\",\n                \"source\": {\n                  \"extract\": \"docs/reference/Player_Rulebook_v6_source_text.txt\",\n                  \"line\": 5223,\n                  \"originalText\": \"Arcane Lock: Create a magical barrier that prevents entry or access to an object or area.\"\n                },\n                \"designStatus\": \"provisional-playtest\",\n                \"spellRank\": 2\n              }\n            ]\n          },\n          {\n            \"classLevel\": 4,\n            \"cards\": [\n              {\n                \"id\": \"wizard.base.scholarly-mind\",\n                \"name\": \"Scholarly Mind\",\n                \"className\": \"Wizard\",\n                \"band\": \"Base\",\n                \"path\": null,\n                \"sourceKind\": \"passive\",\n                \"minimumClassLevel\": 1,\n                \"acquisition\": \"selection\",\n                \"activation\": \"Passive\",\n                \"cost\": \"0\",\n                \"rangeAndTarget\": \"Self\",\n                \"duration\": \"Permanent\",\n                \"frequency\": \"Always\",\n                \"effect\": \"Scholarly Mind. Tags: base, passive, knowledge. You have advantage on Intelligence checks whose primary purpose is recalling, researching or analyzing arcane theory, magical history, planar magical principles or constructed spell formulae. It does not grant advantage on spell attacks, Counterspell checks or general Investigation unrelated to arcane scholarship.\",\n                \"source\": {\n                  \"extract\": \"docs/reference/Player_Rulebook_v6_source_text.txt\",\n                  \"line\": 5200,\n                  \"originalText\": \"Scholarly Mind: Gain advantage on Intelligence checks related to arcane knowledge.\"\n                },\n                \"designStatus\": \"provisional-playtest\",\n                \"spellRank\": null\n              }\n            ]\n          },\n          {\n            \"classLevel\": 5,\n            \"cards\": [\n              {\n                \"id\": \"wizard.arch.dispel-magic\",\n                \"name\": \"Dispel Magic\",\n                \"className\": \"Wizard\",\n                \"band\": \"Arch\",\n                \"path\": null,\n                \"sourceKind\": \"active\",\n                \"minimumClassLevel\": 5,\n                \"acquisition\": \"selection\",\n                \"activation\": \"Action\",\n                \"cost\": \"3 RP\",\n                \"rangeAndTarget\": \"One creature, object or magical effect within 60 feet\",\n                \"duration\": \"Instantaneous\",\n                \"frequency\": \"Recharge 2 rounds\",\n                \"effect\": \"Dispel Magic. Tags: arch, active, wizard-spell, abjuration. Choose one ongoing spell effect you can perceive. If its rank is 3 or lower, end it. If it is rank 4 or higher, make an Intelligence check adding proficiency against DC 10 + spell rank; success ends it. Permanent artifact properties and effects explicitly immune to dispelling are unaffected.\",\n                \"source\": {\n                  \"extract\": \"docs/reference/Player_Rulebook_v6_source_text.txt\",\n                  \"line\": 5224,\n                  \"originalText\": \"Dispel Magic: End magical effects in an area or on a target.\"\n                },\n                \"designStatus\": \"provisional-playtest\",\n                \"spellRank\": 3\n              }\n            ]\n          },\n          {\n            \"classLevel\": 6,\n            \"cards\": [\n              {\n                \"id\": \"wizard.arch.arcane-sight\",\n                \"name\": \"Arcane Sight\",\n                \"className\": \"Wizard\",\n                \"band\": \"Arch\",\n                \"path\": null,\n                \"sourceKind\": \"active\",\n                \"minimumClassLevel\": 3,\n                \"acquisition\": \"selection\",\n                \"activation\": \"Action\",\n                \"cost\": \"2 RP\",\n                \"rangeAndTarget\": \"Self; 60-foot sight\",\n                \"duration\": \"Concentration, maximum 10 minutes\",\n                \"frequency\": \"Recharge 2 rounds\",\n                \"effect\": \"Arcane Sight. Tags: arch, active, wizard-spell, divination, concentration. While active you perceive magical auras within 60 feet and automatically know each visible aura's school or broad magical category. As an Action on a later turn, examine one aura to learn whether it is concentrated, summoned, cursed, warded or linked to another visible magical effect. Total cover blocks sight.\",\n                \"source\": {\n                  \"extract\": \"docs/reference/Player_Rulebook_v6_source_text.txt\",\n                  \"line\": 5226,\n                  \"originalText\": \"Arcane Sight: See magical auras and effects for a short duration.\"\n                },\n                \"designStatus\": \"provisional-playtest\",\n                \"spellRank\": 2\n              }\n            ]\n          },\n          {\n            \"classLevel\": 7,\n            \"cards\": [\n              {\n                \"id\": \"wizard.arch.dimensional-pocket\",\n                \"name\": \"Dimensional Pocket\",\n                \"className\": \"Wizard\",\n                \"band\": \"Arch\",\n                \"path\": null,\n                \"sourceKind\": \"active\",\n                \"minimumClassLevel\": 7,\n                \"acquisition\": \"selection\",\n                \"activation\": \"Ritual\",\n                \"cost\": \"3 RP\",\n                \"rangeAndTarget\": \"One point within 5 feet\",\n                \"duration\": \"8 hours\",\n                \"frequency\": \"1/long rest\",\n                \"effect\": \"Dimensional Pocket. Tags: arch, active, wizard-spell, conjuration, ritual. Create an extradimensional storage space holding up to 100 pounds or 10 cubic feet of unattended nonliving material. Retrieving or placing an item while adjacent to the opening uses an object interaction. Living creatures cannot enter. When duration ends, remaining contents appear harmlessly in the nearest unoccupied space.\",\n                \"source\": {\n                  \"extract\": \"docs/reference/Player_Rulebook_v6_source_text.txt\",\n                  \"line\": 5225,\n                  \"originalText\": \"Dimensional Pocket: Create a small extradimensional space to store items.\"\n                },\n                \"designStatus\": \"provisional-playtest\",\n                \"spellRank\": 4\n              }\n            ]\n          },\n          {\n            \"classLevel\": 8,\n            \"cards\": [\n              {\n                \"id\": \"wizard.base.analyze-magic\",\n                \"name\": \"Analyze Magic\",\n                \"className\": \"Wizard\",\n                \"band\": \"Base\",\n                \"path\": null,\n                \"sourceKind\": \"active\",\n                \"minimumClassLevel\": 1,\n                \"acquisition\": \"selection\",\n                \"activation\": \"Action\",\n                \"cost\": \"1 RP\",\n                \"rangeAndTarget\": \"One magical creature, object or effect within 30 feet\",\n                \"duration\": \"Instantaneous\",\n                \"frequency\": \"Recharge 1 round\",\n                \"effect\": \"Analyze Magic. Tags: base, active, wizard-spell, divination, knowledge. Make an Intelligence (Arcana) check against DC 10 + the effect's spell rank, treating a non-spell effect's Director-assigned tier as rank. On success learn its school or magical category, one active mechanical property and whether it is currently sustained, cursed or bound to another effect. Failure reveals only that magic is present.\",\n                \"source\": {\n                  \"extract\": \"docs/reference/Player_Rulebook_v6_source_text.txt\",\n                  \"line\": 5206,\n                  \"originalText\": \"Analyze Magic: Study a magical effect or item to gain insight into its properties and function.\"\n                },\n                \"designStatus\": \"provisional-playtest\",\n                \"spellRank\": 1\n              }\n            ]\n          },\n          {\n            \"classLevel\": 9,\n            \"cards\": [\n              {\n                \"id\": \"wizard.arch.sigil-rewrite\",\n                \"name\": \"Sigil Rewrite\",\n                \"className\": \"Wizard\",\n                \"band\": \"Arch\",\n                \"path\": null,\n                \"sourceKind\": \"passive\",\n                \"minimumClassLevel\": 3,\n                \"acquisition\": \"selection\",\n                \"activation\": \"Bonus Action\",\n                \"cost\": \"0\",\n                \"rangeAndTarget\": \"Self and spellbook\",\n                \"duration\": \"Instantaneous\",\n                \"frequency\": \"1/long rest\",\n                \"effect\": \"Sigil Rewrite. Tags: arch, passive-upgrade, matrix. Replace one prepared matrix with a different spell from your spellbook of exactly the same rank without performing the normal 10-minute ritual. The replacement receives no special Dissonance reset for a matrix family already used this encounter and must obey current Wizard rank eligibility.\",\n                \"source\": {\n                  \"extract\": \"docs/reference/Player_Rulebook_v6_source_text.txt\",\n                  \"line\": 5214,\n                  \"originalText\": \"Sigil Rewrite: Once/day, instantly swap a spell you know for another of the same tier\"\n                },\n                \"designStatus\": \"provisional-playtest\",\n                \"spellRank\": null\n              }\n            ]\n          },\n          {\n            \"classLevel\": 10,\n            \"cards\": [\n              {\n                \"id\": \"wizard.hero.spellbinder.spell-preservation\",\n                \"name\": \"Spell Preservation\",\n                \"className\": \"Wizard\",\n                \"band\": \"Hero\",\n                \"path\": \"Spellbinder\",\n                \"sourceKind\": \"passive\",\n                \"minimumClassLevel\": 10,\n                \"acquisition\": \"selection\",\n                \"activation\": \"Passive\",\n                \"cost\": \"0\",\n                \"rangeAndTarget\": \"Your spellbook\",\n                \"duration\": \"Permanent\",\n                \"frequency\": \"Always\",\n                \"effect\": \"Spell Preservation. Tags: hero, spellbinder, passive, spellbook. Your primary spellbook cannot be destroyed, erased or rendered permanently unreadable by non-artifact mundane or magical means. It can still be stolen, hidden, transported, suppressed, sealed by an artifact-level effect or voluntarily abandoned. Copies and backup books do not automatically receive this protection.\",\n                \"source\": {\n                  \"extract\": \"docs/reference/Player_Rulebook_v6_source_text.txt\",\n                  \"line\": 5243,\n                  \"originalText\": \"Spell Preservation: Your spellbook cannot be destroyed by non-artifact means.\"\n                },\n                \"designStatus\": \"provisional-playtest\",\n                \"spellRank\": null\n              },\n              {\n                \"id\": \"wizard.hero.spellbinder.seal-magic\",\n                \"name\": \"Seal Magic\",\n                \"className\": \"Wizard\",\n                \"band\": \"Hero\",\n                \"path\": \"Spellbinder\",\n                \"sourceKind\": \"active\",\n                \"minimumClassLevel\": 10,\n                \"acquisition\": \"selection\",\n                \"activation\": \"Action\",\n                \"cost\": \"4 RP\",\n                \"rangeAndTarget\": \"One creature within 60 feet\",\n                \"duration\": \"Maximum 3 rounds\",\n                \"frequency\": \"Recharge 3 rounds\",\n                \"effect\": \"Seal Magic. Tags: hero, spellbinder, wizard-spell, control. Choose one of the eight schools and target one creature. It makes a Wisdom save. On failure it cannot cast spells of the chosen school. At the end of each of its turns it repeats the save, ending the Seal on success. The effect ends automatically after 3 rounds and never prevents non-spell class techniques merely because they are magical.\",\n                \"source\": {\n                  \"extract\": \"docs/reference/Player_Rulebook_v6_source_text.txt\",\n                  \"line\": 5249,\n                  \"originalText\": \"Seal Magic: Prevent a target from casting spells of a specific school (WIS save, 3 rounds)\"\n                },\n                \"designStatus\": \"provisional-playtest\",\n                \"spellRank\": 5\n              }\n            ]\n          },\n          {\n            \"classLevel\": 11,\n            \"cards\": [\n              {\n                \"id\": \"wizard.base.arcane-shield\",\n                \"name\": \"Arcane Shield\",\n                \"className\": \"Wizard\",\n                \"band\": \"Base\",\n                \"path\": null,\n                \"sourceKind\": \"active\",\n                \"minimumClassLevel\": 1,\n                \"acquisition\": \"selection\",\n                \"activation\": \"Reaction\",\n                \"cost\": \"2 RP\",\n                \"rangeAndTarget\": \"Self\",\n                \"duration\": \"Until start of your next regular turn\",\n                \"frequency\": \"Recharge 2 rounds\",\n                \"effect\": \"Arcane Shield. Tags: base, active, wizard-spell, abjuration, protection. Trigger when an attack roll would hit you. Gain +2 AC against the triggering attack and until the start of your next regular turn, potentially causing the attack to miss. Temporary AC from another Arcane Shield does not stack.\",\n                \"source\": {\n                  \"extract\": \"docs/reference/Player_Rulebook_v6_source_text.txt\",\n                  \"line\": 5205,\n                  \"originalText\": \"Arcane Shield: Create a barrier of magical force that provides temporary protection.\"\n                },\n                \"designStatus\": \"provisional-playtest\",\n                \"spellRank\": 1\n              }\n            ]\n          },\n          {\n            \"classLevel\": 12,\n            \"cards\": [\n              {\n                \"id\": \"wizard.hero.spellbinder.counterpulse\",\n                \"name\": \"Counterpulse\",\n                \"className\": \"Wizard\",\n                \"band\": \"Hero\",\n                \"path\": \"Spellbinder\",\n                \"sourceKind\": \"active\",\n                \"minimumClassLevel\": 12,\n                \"acquisition\": \"selection\",\n                \"activation\": \"Triggered\",\n                \"cost\": \"1 RP\",\n                \"rangeAndTarget\": \"Caster whose spell you successfully Counterspelled\",\n                \"duration\": \"Until end of target's next turn\",\n                \"frequency\": \"At most once per round\",\n                \"effect\": \"Counterpulse. Tags: hero, spellbinder, counter, control. Immediately after your Counterspell succeeds, spend 1 RP. The countered caster is Silenced until the end of its next turn. This is part of the successful counter event rather than another spell cast and cannot trigger another Counterpulse.\",\n                \"source\": {\n                  \"extract\": \"docs/reference/Player_Rulebook_v6_source_text.txt\",\n                  \"line\": 5251,\n                  \"originalText\": \"Counterpulse: Countering a spell silences the caster for 1 round\"\n                },\n                \"designStatus\": \"provisional-playtest\",\n                \"spellRank\": null\n              }\n            ]\n          },\n          {\n            \"classLevel\": 13,\n            \"cards\": [\n              {\n                \"id\": \"wizard.base.spellbook-study\",\n                \"name\": \"Spellbook Study\",\n                \"className\": \"Wizard\",\n                \"band\": \"Base\",\n                \"path\": null,\n                \"sourceKind\": \"active\",\n                \"minimumClassLevel\": 1,\n                \"acquisition\": \"selection\",\n                \"activation\": \"Ritual\",\n                \"cost\": \"0 RP\",\n                \"rangeAndTarget\": \"Self and spellbook\",\n                \"duration\": \"10 minutes\",\n                \"frequency\": \"1/long rest\",\n                \"effect\": \"Spellbook Study. Tags: base, active, matrix, ritual. Replace one currently prepared matrix with one legal spell recorded in your spellbook. The replacement must be within your Wizard rank limit. This is the normal midday substitution permission; it does not alter the spellbook, create another prepared-matrix position or reset first-cast/Refrain history for an underlying matrix family already cast this encounter.\",\n                \"source\": {\n                  \"extract\": \"docs/reference/Player_Rulebook_v6_source_text.txt\",\n                  \"line\": 5207,\n                  \"originalText\": \"Spellbook Study: Spend time studying your spellbook to prepare a different selection of spells.\"\n                },\n                \"designStatus\": \"provisional-playtest\",\n                \"spellRank\": null\n              }\n            ]\n          }\n        ],\n        \"automaticCards\": [\n          {\n            \"id\": \"wizard.arch.arcane-tradition\",\n            \"name\": \"Arcane Tradition\",\n            \"className\": \"Wizard\",\n            \"band\": \"Arch\",\n            \"path\": null,\n            \"sourceKind\": \"passive\",\n            \"minimumClassLevel\": 3,\n            \"acquisition\": \"automatic\",\n            \"activation\": \"Passive\",\n            \"cost\": \"0\",\n            \"rangeAndTarget\": \"Your level-1 Arcane School\",\n            \"duration\": \"Permanent\",\n            \"frequency\": \"Automatic at Wizard 3; not a selection\",\n            \"effect\": \"Arcane Tradition. Tags: arch, school, automatic. Your level-1 Arcane School becomes your Arcanist tradition; do not choose a second school. Prepare one additional matrix from that same school each day without counting it against your normal prepared-matrix maximum. It otherwise obeys all ordinary rank, spellbook, Dissonance and duplicate-family rules.\",\n            \"source\": {\n              \"extract\": \"docs/reference/Player_Rulebook_v6_source_text.txt\",\n              \"line\": 5217,\n              \"originalText\": \"Arcane Tradition: Choose a school of magic to specialize in, gaining bonuses to spells of that school.\"\n            },\n            \"designStatus\": \"provisional-playtest\",\n            \"spellRank\": null\n          },\n          {\n            \"id\": \"wizard.base.counterspell\",\n            \"name\": \"Counterspell\",\n            \"className\": \"Wizard\",\n            \"band\": \"Base\",\n            \"path\": null,\n            \"sourceKind\": \"active\",\n            \"minimumClassLevel\": 2,\n            \"acquisition\": \"automatic\",\n            \"activation\": \"Reaction\",\n            \"cost\": \"3 RP\",\n            \"rangeAndTarget\": \"One creature you perceive casting a spell within 60 feet\",\n            \"duration\": \"Instantaneous\",\n            \"frequency\": \"Automatic at Wizard 2; recharge 2 rounds\",\n            \"effect\": \"Counterspell. Tags: arch-source, automatic, wizard-spell, abjuration, disruption. Trigger when a creature begins casting a spell. Make an Intelligence check adding proficiency against DC 10 + twice the spell's rank, treating rank 0 as 0. Success negates the triggering spell after its costs are paid; failure lets it resolve. This is gained automatically at Wizard 2 and is never also selected from the Arch pool.\",\n            \"source\": {\n              \"extract\": \"docs/reference/Player_Rulebook_v6_source_text.txt\",\n              \"line\": 5222,\n              \"originalText\": \"Counterspell: Disrupt an enemy's spellcasting, potentially negating their spell entirely.\"\n            },\n            \"designStatus\": \"provisional-playtest\",\n            \"spellRank\": 1\n          },\n          {\n            \"id\": \"wizard.supplement.ritual-casting\",\n            \"name\": \"Ritual Casting\",\n            \"className\": \"Wizard\",\n            \"band\": \"Base\",\n            \"path\": null,\n            \"sourceKind\": \"supplement\",\n            \"minimumClassLevel\": 2,\n            \"acquisition\": \"automatic\",\n            \"activation\": \"Ritual\",\n            \"cost\": \"0 RP unless the individual ritual explicitly states otherwise\",\n            \"rangeAndTarget\": \"As the ritual spell\",\n            \"duration\": \"As the ritual spell\",\n            \"frequency\": \"At will outside encounters with sufficient time\",\n            \"effect\": \"Source progression line 5184. Cast a Wizard spell bearing the Ritual tag directly from your spellbook without preparing it. Increase its casting time by at least 10 minutes. Ritual Casting cannot be completed during an encounter, does not use an ordinary prepared-matrix position and does not generate or vent normal casting Dissonance.\",\n            \"prerequisite\": \"See class engine and progression.\",\n            \"source\": {\n              \"line\": 5184,\n              \"reference\": null,\n              \"originalText\": \"| 2 | Counterspell Reaction, Ritual Casting |\",\n              \"status\": \"source-derived\"\n            },\n            \"designStatus\": \"provisional-playtest\",\n            \"spellRank\": null\n          },\n          {\n            \"id\": \"wizard.supplement.school-mastery\",\n            \"name\": \"School Mastery\",\n            \"className\": \"Wizard\",\n            \"band\": \"Arch\",\n            \"path\": null,\n            \"sourceKind\": \"supplement\",\n            \"minimumClassLevel\": 5,\n            \"acquisition\": \"automatic\",\n            \"activation\": \"Passive\",\n            \"cost\": \"0\",\n            \"rangeAndTarget\": \"Your level-1 Arcane School\",\n            \"duration\": \"Permanent\",\n            \"frequency\": \"Automatic at Wizard 5\",\n            \"effect\": \"Source progression line 5186. This is the one School Mastery progression grant, not a second school choice or duplicate feat. Increase the level-1 Arcane School spell-attack and spell-save bonus from +1 to +2 total. Its school passive and bonus-spell rules otherwise remain unchanged.\",\n            \"prerequisite\": \"See class engine and progression.\",\n            \"source\": {\n              \"line\": 5186,\n              \"reference\": null,\n              \"originalText\": \"| 5 | Bonus Feat: School Mastery |\",\n              \"status\": \"source-derived\"\n            },\n            \"designStatus\": \"provisional-playtest\",\n            \"spellRank\": null\n          },\n          {\n            \"id\": \"wizard.supplement.arcane-ward\",\n            \"name\": \"Arcane Ward\",\n            \"className\": \"Wizard\",\n            \"band\": \"Arch\",\n            \"path\": null,\n            \"sourceKind\": \"supplement\",\n            \"minimumClassLevel\": 6,\n            \"acquisition\": \"automatic\",\n            \"activation\": \"Passive\",\n            \"cost\": \"0\",\n            \"rangeAndTarget\": \"Self\",\n            \"duration\": \"Until next long rest\",\n            \"frequency\": \"Choose after each long rest\",\n            \"effect\": \"Source progression line 5187. After preparing spells, choose one of acid, cold, fire, force, lightning, necrotic, psychic, radiant or thunder that is dealt by at least one prepared spell of your Arcane School. Gain resistance to that damage type until your next long rest. If none of your prepared school spells deals a damage type, choose force. This is provisional completion of the source's ambiguous 'chosen school's element' wording.\",\n            \"prerequisite\": \"See class engine and progression.\",\n            \"source\": {\n              \"line\": 5187,\n              \"reference\": null,\n              \"originalText\": \"| 6 | Arcane Ward (resistance to chosen school's element) |\",\n              \"status\": \"source-derived\"\n            },\n            \"designStatus\": \"provisional-playtest\",\n            \"spellRank\": null\n          },\n          {\n            \"id\": \"wizard.supplement.dual-cast\",\n            \"name\": \"Dual Cast\",\n            \"className\": \"Wizard\",\n            \"band\": \"Arch\",\n            \"path\": null,\n            \"sourceKind\": \"supplement\",\n            \"minimumClassLevel\": 9,\n            \"acquisition\": \"automatic\",\n            \"activation\": \"Action\",\n            \"cost\": \"Pay the complete RP costs of both spells\",\n            \"rangeAndTarget\": \"As each spell\",\n            \"duration\": \"As each spell\",\n            \"frequency\": \"1/short rest\",\n            \"effect\": \"Source progression line 5188. Choose two DIFFERENT prepared Wizard spells of rank 1 or 2, neither of which summons a creature or grants an additional Action. Cast both sequentially as one Action, paying both RP costs. They cannot both require concentration. Each matrix separately updates first-cast/Refrain history. Features that trigger merely from 'casting a spell' may trigger once for each actual matrix unless that feature itself says once per turn; no trigger may create another Dual Cast or additional full Action.\",\n            \"prerequisite\": \"See class engine and progression.\",\n            \"source\": {\n              \"line\": 5188,\n              \"reference\": null,\n              \"originalText\": \"| 9 | Dual Cast (cast 2 Tier 1–2 spells in a round) |\",\n              \"status\": \"source-derived\"\n            },\n            \"designStatus\": \"provisional-playtest\",\n            \"spellRank\": null\n          },\n          {\n            \"id\": \"wizard.supplement.overchannel\",\n            \"name\": \"Overchannel\",\n            \"className\": \"Wizard\",\n            \"band\": \"Hero\",\n            \"path\": null,\n            \"sourceKind\": \"supplement\",\n            \"minimumClassLevel\": 13,\n            \"acquisition\": \"automatic\",\n            \"activation\": \"Triggered\",\n            \"cost\": \"Pay the Core V 2 RP cost for one rank above the spell's normal cast rank\",\n            \"rangeAndTarget\": \"One prepared spell you are beginning to cast\",\n            \"duration\": \"For that cast\",\n            \"frequency\": \"1/long rest\",\n            \"effect\": \"Source progression line 5190. Cast one prepared spell as though it were one rank higher than the highest rank at which you could normally cast that SAME spell, provided the spell has an explicit higher-rank scaling rule. Overchannel does not teach or prepare a higher-rank spell, cannot exceed effective rank 9 and cannot be combined with another generic Overcast rule during this pilot. All normal Dissonance/Refrain rules still apply.\",\n            \"prerequisite\": \"See class engine and progression.\",\n            \"source\": {\n              \"line\": 5190,\n              \"reference\": null,\n              \"originalText\": \"| 13 | Overchannel (cast a spell 1 tier higher once/day) |\",\n              \"status\": \"source-derived\"\n            },\n            \"designStatus\": \"provisional-playtest\",\n            \"spellRank\": null\n          }\n        ],\n        \"completeEngine\": [\n          \"PROVISIONAL PLAYTEST CONTRACT. Intelligence is the Wizard class ability. S = 1/2/3/4 at Wizard levels 1/5/11/17. M = max(1, Intelligence modifier). Wizard spell attack = d20 + normal character proficiency bonus + Intelligence modifier. Wizard spell save DC = 8 + normal character proficiency bonus + Intelligence modifier.\",\n          \"The Wizard remains three distinct stages: Base Wizard at levels 1-2, Arch Arcanist at levels 3-9, and one Hero path at levels 10-20: Spellbinder, Elementalist or Necromancer. Hero paths are not additional starting classes and their features cannot be selected before their Wizard class-level gates.\",\n          \"SPELLBOOK. At Wizard 1 your spellbook contains six chosen rank-1 Wizard spells. Arcane School Specialization also adds one legal rank-1 bonus spell of your chosen school without replacing one of those six. For this provisional progression, add 2 legal Wizard spells to the book at each Wizard level 2-4, 3 at each level 5-8, 4 at each level 9-12, 5 at each level 13-16 and 6 at each level 17-20. Level-up additions cost no money or scribing time.\",\n          \"LEGAL RANKS. Maximum Wizard spell rank by Wizard class level is: rank 1 at levels 1-2, rank 2 at 3-4, rank 3 at 5-6, rank 4 at 7-8, rank 5 at 9-10, rank 6 at 11-12, rank 7 at 13-14, rank 8 at 15-16 and rank 9 at 17-20. Grand Tier at level 20 is a special casting permission, not a tenth ordinary rank. A Wizard may learn Wizard-list spells from any school up to the legal rank unless a spell itself has an additional prerequisite.\",\n          \"PREPARED SPELL MATRIX. After a long rest, prepare a number of matrices equal to Wizard level + Intelligence modifier, minimum 1, selecting only spells currently recorded in your spellbook and within your legal rank. You cast ordinary Wizard spells only from prepared matrices unless a feature explicitly overrides that restriction. Preparing the full daily matrix set normally requires 1 hour of spellbook study. Matrix Efficiency reduces this to 45 minutes.\",\n          \"DUPLICATE PREPARATION. You may prepare the same spell more than once, primarily to carry different Matrix Mastery configurations. Duplicate copies never create additional first-cast Dissonance exemptions. For Refrain and the protected strain rule, all prepared copies sharing the same underlying spell name belong to one matrix family regardless of modification.\",\n          \"MIDDAY SUBSTITUTION. Once between long rests, you may perform a 10-minute Spellbook Study ritual to replace one prepared matrix with another legal spell from your spellbook. The replacement cannot exceed your legal Wizard rank. Sigil Rewrite and Matrix Mastery may improve this process as explicitly stated.\",\n          \"SPELL ACQUISITION BY SCRIBING. A found Wizard spell may be copied into the spellbook if its rank is legal for you. Baseline scribing requires 2 hours and 50 gp of inks/materials per spell rank, treating rank 0 as 1 for this calculation. Spell Scribing halves both values to 1 hour and 25 gp per rank. Failure to finish the work consumes no spellbook entry but materials already expended during an interrupted hour are lost.\",\n          \"SPELLBOOK LOSS. Losing the spellbook does not erase matrices currently prepared in memory; you may continue casting those prepared matrices until you next rebuild or change preparation. A blank replacement book can be seeded with your currently prepared spells at 1 hour and 25 gp per effective spell rank each. An unprepared spell you previously recorded can be reconstructed from memory with 8 hours, 100 gp per rank and an Intelligence (Arcana) check against DC 10 + spell rank. Failure consumes that attempt's time and half its materials; another attempt can be made after a long rest. Recovering the original book automatically restores access to its surviving entries.\",\n          \"ARCANE SCHOOL SPECIALIZATION is automatic at Wizard 1. Choose exactly one of the eight schools. Your spell attacks with that school gain +1 and your Wizard save DC for that school's spells gains +1. You also add one legal rank-1 spell of that school to the spellbook. The source table explicitly supplies seven school passives; the eighth core school, Abjuration, is named elsewhere but its passive row is missing. Its provisional playtest passive is identified below rather than silently presented as recovered text.\",\n          \"ABJURATION, provisional completion for the omitted eighth row: once per round after you cast an Abjuration spell, gain temporary HP equal to PB until the start of your next regular turn. CONJURATION: creatures summoned by your Wizard spells gain +1 maximum HP per Wizard level. DIVINATION: once per long rest reroll one failed saving throw and use the new result. ENCHANTMENT: when a creature fails its initial save against one of your Enchantment spells, a printed control duration of at least 1 round may last one additional round, but every normally allowed repeat save still occurs. EVOCATION: when casting an area Evocation spell, exclude one creature from its initial damaging area; that creature automatically succeeds and takes no damage if success normally halves damage. ILLUSION: gain +2 on concentration saves made to maintain Illusion spells. NECROMANCY: once per turn during a real encounter when a hostile non-summoned creature dies from your Necromancy spell, gain 1 temporary HP; it is not permanent healing. TRANSMUTATION: after casting a Transmutation spell, gain +5 feet Speed until the end of that turn.\",\n          \"PROTECTED DISSONANCE INTERFACE. The first cast of each different prepared matrix family during an encounter generates 0 BASE Dissonance. This exemption affects only base strain. Refrain and explicitly printed strain costs still apply; the suite disables generic Overcast and does not layer historical Burn onto Dissonance. Repeating a matrix family follows normal Refrain immediately. Preparing duplicates or differently modified copies of the same underlying spell never refreshes the exemption.\",\n          \"Core Systems V 2 Resonance Points and spell-rank RP costs are authoritative for Wizard spellcasting. There are no historical spell slots in this pilot. Wizard cards tagged wizard-spell are always-prepared class matrices once acquired, do not consume a daily prepared-matrix position and use the same RP, concentration, Refrain and protected first-distinct-matrix rules as other Wizard spells. Their printed RP cost replaces any generic rank cost; never pay both.\",\n          \"RITUAL CASTING is automatic at Wizard 2. A Wizard spell in your spellbook with the Ritual tag can be cast from the book without being prepared by increasing its casting time by at least 10 minutes. A ritual cast costs 0 RP unless that ritual explicitly lists a consumed RP cost, cannot be used during an encounter and cannot generate or vent Dissonance through ordinary casting strain.\",\n          \"Only one concentration effect can normally be maintained. Starting a second concentration effect ends the first. Damage uses the current Core Systems concentration rule; required half-damage rounding is down for this pilot. Spell Tether and the level-17 Tethered Cast are the only Wizard-specific exceptions in this draft, and each has an explicit RP price, duration and one-tether cap.\",\n          \"MATRIX MASTERY MODIFICATIONS. After acquiring Matrix Mastery, each prepared ordinary spell matrix may carry at most one modification chosen during preparation. QUICK SUBSTITUTION: once per short rest, replace one matrix marked Quick Substitution with another spellbook spell of exactly the same rank using a 1-minute ritual instead of the normal 10-minute midday swap; the replacement loses the modification until the next long rest. COMPONENT ENHANCEMENT: when casting a damaging or healing matrix, spend 1 additional RP to add one extra die of the spell's primary damage or healing die to one roll; if the spell has no such die this modification has no effect. MATRIX LINKING: pair two different prepared matrix families during preparation; after legally casting one, the other costs 1 less RP, minimum 1, if cast before the end of your next regular turn, at most once per pair per round. STABILITY REINFORCEMENT: gain +2 on concentration saves caused by damage while maintaining that matrix. A matrix modification never creates another spell cast or proc event.\",\n          \"All sources share a maximum of one additional full Action per creature per round. Additional Actions cannot grant another additional Action, Bonus Action or Reaction. Spell copies, Matrix Sharing, Arcane Fusion, Dual Cast and similar effects pay all explicitly required RP and do not produce duplicate resource, cast-proc or action-grant chains beyond their written resolution.\",\n          \"Round recharge counters decrease once at the start of your regular initiative turn even if you cannot act. Extra Actions and extra turns do not tick recharge. Outside initiative, each uninterrupted 6 seconds counts as one tick. Only positive counters can be reset or shortened and each named ability can receive at most one reset or shortening per round.\",\n          \"SUMMON COMMAND LIMIT. All Wizard-controlled conjured, raised and bound companions share one damaging/control Companion Command per Wizard regular turn. Spend one Bonus Action to command exactly one such creature to move up to its Speed and use one damaging or control action from its stat block. Uncommanded creatures may reposition defensively and take Dodge but cannot deal damage or impose conditions. No summoned or raised creature can create XP, treasure, RP, Dissonance relief, additional corpses or kill-resource farms.\",\n          \"NECROMANCER STANDARD UNDEAD. Corpse Harvest and Auto-Raise share a maximum of three standard raised minions. Skeleton: AC 14, HP 6 + 2 × Wizard level, Speed 30; Bone Shot, range 30 feet, Wizard spell attack, 1d6+S necrotic. Zombie: AC 12, HP 10 + 3 × Wizard level, Speed 20; Slam, reach 5 feet, Wizard spell attack, 1d8+S necrotic. Goblin Thrall, available only from a goblinoid corpse: AC 13, HP 8 + 2 × Wizard level, Speed 30; Shiv, reach 5 feet, Wizard spell attack, 1d6+S necrotic. These are pre-Flesh-Ascendant statistics.\",\n          \"NECROMANCER AUTO-RAISE. Once per round when one of your standard undead minions personally lands the killing blow on an eligible humanoid and your standard-minion count is below three, its corpse rises at the end of the current turn as the same mechanical minion type that scored the kill, if physically possible. A new minion cannot act during that same round. Auto-Raise costs no Action or RP but can never exceed the three-minion cap or generate a new resource, corpse chain, XP or treasure event. Without Infernal Pact only humanoids qualify.\",\n          \"ELITE UNDEAD PETS. Necromancers may bind Boneflayer, Dreadblade and Wraithbound, at most one of each and three elite pets total. They use the same shared Companion Command limit as standard undead. Boneflayer: AC 14, HP 12 + 2 × Wizard level, Speed 30. Bone Shards: range 60, Wizard spell attack, 2d6+S necrotic. Fear Pulse replaces its attack: enemies within 10 feet make Wisdom saves; failure Frightened until end of next turn; recharge 3. Grave Miasma replaces its attack: 10-foot-radius point within 30 feet until start of your next turn; enemies entering or starting there take 1d6 necrotic once; recharge 3.\",\n          \"Dreadblade: AC 16, HP 16 + 3 × Wizard level, Speed 30. Disrupting Blade: reach 5 feet, Wizard spell attack, 1d8+S necrotic; a concentrating target immediately makes its concentration save with disadvantage. On a natural 20 the target is Weakened until the end of its next turn, taking -1 on attack rolls. Dreadblade has advantage on saves against forced movement.\",\n          \"Wraithbound: AC 14, HP 10 + 2 × Wizard level, Fly 40 and hover. While it has not attacked or imposed control since the end of its previous turn it is Invisible; attacking ends that state until the end of its next turn. Wraith Strike: reach 5 feet, Wizard spell attack, 1d8+S necrotic. On natural 20 the target makes a Constitution save against your Wizard DC; failure Stuns until the end of its next turn.\",\n          \"Flesh Ascendant's bonus applies after the listed base statistics: every undead creature you control gains +2 maximum HP per Wizard level. If at least two of your undead creatures are active, each gains +1 AC and +1 on saving throws. This does not increase the standard-minion or elite-pet caps.\",\n          \"DARK-TRAUMA INTERFACE. Necromancer features involving corpse desecration, infernal bargains, domination, body control or Mind Prison remain subject to the project's existing dark-content and trauma boundaries. A table may fade description to black without changing mechanics. No feature changes a player's real belief, permanently transfers ownership of a player character or silently retires a PC.\",\n          \"PROPOSED ACQUISITION. Wizard 1 automatically gains Arcane School Specialization, Spell Matrix System and the starting spellbook, then chooses 4 selectable Base cards, at least 2 Active. Wizard 2 automatically gains Counterspell and Ritual Casting, then chooses 2 additional selectable Base cards. Counterspell is not also placed in the Arch selection pool.\",\n          \"At Wizard 3 enter Arcanist, automatically gain Arcane Tradition as an upgrade of the SAME level-1 school rather than choosing another school, and choose 2 selectable Arch cards, at least 1 Active. Wizard 4 grants one eligible Base/Arch choice. Wizard 5 grants one Base/Arch choice plus automatic School Mastery. Wizard 6 grants one Base/Arch choice plus automatic Arcane Ward. Wizard 7 grants one eligible Arch choice. Wizard 8 grants one Base/Arch choice. Wizard 9 grants one eligible Arch choice plus automatic Dual Cast.\",\n          \"At Wizard 10 choose Spellbinder, Elementalist or Necromancer and gain 2 Hero cards from that path. ELEMENTALIST EXCEPTION: Elemental Affinity is automatic at path selection and counts as one of those two level-10 Hero acquisitions, so an Elementalist chooses only one additional Hero card at level 10. Levels 11, 13, 15, 17 and 19 each grant one eligible unselected Base/Arch choice. Levels 12, 14, 16 and 18 each grant one Hero-path choice. The chosen Final Theorem is automatic at Wizard 20. School Mastery, Counterspell, Arcane Tradition and all progression-table automatic features are never duplicated as selections.\",\n          \"All acquisition gates use Wizard class level rather than total character level. Normal proficiency bonus follows the game's ordinary total-character-level rule. A multiclass dip cannot unlock higher spell ranks, Arcanist cards, Hero cards, Final Theorems or progression-table features.\",\n          \"Class matrices tagged wizard-spell receive a rank in normalized card data equal to maximum ordinary Wizard rank at their minimum class-level gate (cap 9). Printed RP cost replaces generic rank cost. Counterspell is rank 1 at its explicit level 2 automatic grant. This explicit convention closes rank-dependent Counterspell/Dissonance interactions without inventing extra costs.\",\n          \"Cantrip completion: know 3 Wizard cantrips at 1, 4 at 4, 5 at 10, using the shared missing-repertoire fallback. Cantrips are known directly and do not consume prepared matrices. Always-prepared class matrices are additional cards, not extra arbitrary ordinary spells. Class spell ranks and the normalized activation field resolve incomplete source terminology.\"\n        ],\n        \"source\": {\n          \"path\": \"DescentReviewChanges/ReviewBible/data/public/class_playtests/wizard.json\",\n          \"pointers\": [\n            \"/engine\",\n            \"/schedule\",\n            \"/cards\",\n            \"/rpByClassLevel/12\"\n          ]\n        },\n        \"optionalChoicesInCases\": \"No Matrix Mastery, Spell Efficiency, Improved Concentration, Sigil Authority or Knowledge Shield acquired. Dual Cast, Overchannel, class Arcane Shield and optional Counterpulse are not invoked unless expressly declared. No Arcane Feedback at13.\",\n        \"creatureType\": \"Humanoid\",\n        \"profileScope\": \"An explicitly supplied finite class-built teaching creature profile using the complete actual class engine/cards. Not a newly rated bestiary creature, not authenticated campaign or ancestry acquisition, and not permission to fill an absent future profile.\",\n        \"languages\": [\n          \"Common\"\n        ],\n        \"otherIntrinsicDefenses\": [],\n        \"additionalSkillProficienciesClaimed\": [],\n        \"checks\": \"Use current ability modifier and actual acquired named card when applicable; save proficiency is not an ability-check proficiency. No Athletics proficiency is claimed.\",\n        \"actualActionsAvailable\": \"Each annotated actual regular START supplies the normal Action/BonusAction/Reaction/movement according to the real source; the event trace explicitly consumes each used budget. No extra action source is assumed.\",\n        \"asiHistory\": {\n          \"rolledINT\": 16,\n          \"class4\": \"INT+2 to18\",\n          \"class8\": \"STR+2 from8 to10\",\n          \"class12\": \"CHA+2 from8 to10\",\n          \"DEX\": 14,\n          \"CON\": 14,\n          \"WIS\": 12,\n          \"note\": \"Explicit legal generated-score/ASI fixture inputs; no extra feat is claimed.\"\n        }\n      }\n    },\n    \"initialState\": {\n      \"actors\": {\n        \"echoer\": {\n          \"profile\": \"W13I\",\n          \"hp\": 80,\n          \"maxHp\": 80,\n          \"tem