 are prerequisites. Correction02 state accounting: the supplied regular START is processed before this event; wizard's successful ordinary Action is then debited once. No new Action permission is supplied. The complete Wizard13 variant takes Adept at class12 in place of CHA+2: permanent Reach/Sculpt, CHA8 and natural CHA save-1. INT18/PB5, FireballDC17, maxRP48, Limit11 and Sculpt allowance4 are unchanged. Operational feat availability remains conditional.\",\n            \"before\": {\n              \"actors\": {\n                \"wizard\": {\n                  \"profile\": \"W13I_ADEPT_C12\",\n                  \"hp\": 80,\n                  \"maxHp\": 80,\n                  \"tempHp\": 0,\n                  \"rp\": 31,\n                  \"maxRp\": 48,\n                  \"dissonance\": 0,\n                  \"lastSpell\": \"meta-surge\",\n                  \"refrain\": 0,\n                  \"preparedFamiliesUsed\": [\n                    \"meta-surge\"\n                  ],\n                  \"position\": [\n                    0,\n                    0,\n                    0\n                  ],\n                  \"alive\": true,\n                  \"conscious\": true,\n                  \"conditions\": [],\n                  \"concentration\": null,\n                  \"reaction\": true,\n                  \"action\": true,\n                  \"bonusAction\": true,\n                  \"movementSpent\": 0,\n                  \"regularStart\": 6,\n                  \"nextRegularStart\": 12,\n                  \"counterRecharge\": 0,\n                  \"wounds\": 0,\n                  \"critical\": false,\n                  \"companionCommandUsed\": false,\n                  \"companionOffenseUsed\": false,\n                  \"featSorceryPoints\": 0\n                },\n                \"ally\": {\n                  \"profile\": \"W13I\",\n                  \"hp\": 80,\n                  \"maxHp\": 80,\n                  \"tempHp\": 0,\n                  