    ],\n              \"hp\": 5,\n              \"maxHp\": 80,\n              \"rp\": 5,\n              \"state\": \"active\",\n              \"sourceOwnerLineageId\": \"derivative/creator/donor\"\n            }\n          },\n          \"privateMemories\": {\n            \"donor\": {\n              \"accessible\": [\n                \"a personally remembered room description\"\n              ],\n              \"inaccessible\": [\n                \"sealed-memory-placeholder-no-access\"\n              ]\n            }\n          },\n          \"sourceLedger\": {\n            \"account\": {\n              \"rp\": 5,\n              \"dissonance\": 4,\n              \"casterLineageId\": \"derivative/creator/donor\"\n            }\n          },\n          \"note\": \"Complete stated finite fixture state; unspecified optional reactions are declined. No actual encounter runtime is asserted.\"\n        },\n        \"timeline\": [\n          {\n            \"timeSeconds\": 1,\n            \"event\": \"Actual ordinarycoldpacket6 afterdefenses\",\n            \"source\": [],\n            \"rng\": {\n              \"1d8\": [\n                6\n              ]\n            },\n            \"explanation\": \"Finitecreatedbodyendsfromactual5HPloss+1overkill. Nocorpse/loot/refill. Thisbranchdoesnotinventtheattacker; acompleteactualattacksource/eventisrequired.\",\n            \"before\": {\n              \"actors\": {\n                \"creator\": {\n                  \"profile\": \"W13I\",\n                  \"hp\": 80,\n                  \"maxHp\": 80,\n                  \"tempHp\": 0,\n                  \"rp\": 48,\n                  \"maxRp\": 48,\n                  \"dissonance\": 0,\n                  \"lastSpell\": null,\n                  \"refrain\": 0,\n                  \"preparedFamiliesUsed\": [],\n                  \"position\": [\n                    0,\n                    0,\n                    0\n                  ],\n                  \"alive\": true,\n        