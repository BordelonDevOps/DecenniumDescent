  \"simulacrum\"\n              ],\n              \"concentration\": null,\n              \"ordinaryFocusReplica\": true,\n              \"replicaGearLb\": 10,\n              \"replicaGearLoad\": 1,\n              \"noBirthRoundVoluntaryAction\": true,\n              \"reaction\": false,\n              \"copyFunctionsExecutable\": false,\n              \"sourceOwnerLineageId\": \"derivative/creator/creator\"\n            }\n          },\n          \"privateMemories\": {},\n          \"sourceLedger\": {\n            \"derivativeAccount\": {\n              \"key\": [\n                \"creator\",\n                \"creator\"\n              ],\n              \"rp\": 31,\n              \"dissonance\": 0,\n              \"lastSpell\": \"simulacrum\",\n              \"refrain\": 0,\n              \"usedFamilies\": [\n                \"simulacrum\"\n              ],\n              \"liveBody\": \"SI-A\",\n              \"casterLineageId\": \"derivative/creator/creator\"\n            }\n          },\n          \"note\": \"Complete stated finite fixture state; unspecified optional reactions are declined. No actual encounter runtime is asserted.\"\n        },\n        \"regularStartsBeforeEvent\": [],\n        \"sourceRefs\": []\n      },\n      {\n        \"timeSeconds\": 6,\n        \"event\": \"CreatorrealregularSTART andpaidBonusActioncommand\",\n        \"source\": [],\n        \"rng\": {},\n        \"explanation\": \"Creatorperceivesbody10ftaway,within60LoE,actualrootbudgetsfree. No newcopyfromextraAction. NativeRank0Rayisnottheforbiddencopyfunction.\",\n        \"before\": {\n          \"actors\": {\n            \"creator\": {\n              \"profile\": \"W13I\",\n              \"hp\": 52,\n              \"maxHp\": 80,\n              \"tempHp\": 0,\n              \"rp\": 31,\n              \"maxRp\": 48,\n              \"dissonance\": 0,\n              \"lastSpell\": \"simulacrum\",\n              \"refrain\": 0,\n              \"preparedFamiliesUsed\": [\n           