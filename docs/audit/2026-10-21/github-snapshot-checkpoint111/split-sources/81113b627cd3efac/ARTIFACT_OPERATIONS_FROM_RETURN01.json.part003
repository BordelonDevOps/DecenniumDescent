n                0\n              ],\n              \"alive\": true,\n              \"conscious\": true,\n              \"conditions\": [],\n              \"concentration\": null,\n              \"reaction\": true,\n              \"action\": true,\n              \"bonusAction\": true,\n              \"movementSpent\": 0,\n              \"regularStart\": 3,\n              \"nextRegularStart\": 9,\n              \"counterRecharge\": 0,\n              \"wounds\": 0,\n              \"critical\": false,\n              \"companionCommandUsed\": false,\n              \"companionOffenseUsed\": false\n            }\n          },\n          \"applications\": {},\n          \"objects\": {},\n          \"privateMemories\": {},\n          \"sourceLedger\": {\n            \"observed\": {\n              \"spell\": \"counterspell\",\n              \"timestamp\": -1.9,\n              \"rank\": 3,\n              \"resolved\": true,\n              \"directObservation\": true\n            }\n          },\n          \"note\": \"Complete stated finite fixture state; unspecified optional reactions are declined. No actual encounter runtime is asserted.\"\n        },\n        \"timeline\": [\n          {\n            \"timeSeconds\": 0,\n            \"event\": \"Compute only the bare sequential price17+26=43\",\n            \"source\": [],\n            \"rng\": {},\n            \"explanation\": \"Actual complete rank9 child/source credentials are not supplied in this branch. A hypothetical rank is not executed; no payment, target, outcome or adapter is asserted.\",\n            \"before\": {\n              \"actors\": {\n                \"echoer\": {\n                  \"profile\": \"W13I\",\n                  \"hp\": 80,\n                  \"maxHp\": 80,\n                  \"tempHp\": 0,\n                  \"rp\": 48,\n                  \"maxRp\": 48,\n                  \"dissonance\": 0,\n                  \"lastSpell\": null,\n                  \"refrain\": 0,\n                  \"prepar