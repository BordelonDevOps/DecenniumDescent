    0\n              ],\n              \"alive\": true,\n              \"conscious\": true,\n              \"conditions\": [],\n              \"concentration\": null,\n              \"reaction\": true,\n              \"action\": false,\n              \"bonusAction\": true,\n              \"movementSpent\": 0,\n              \"regularStart\": 0,\n              \"nextRegularStart\": 6,\n              \"counterRecharge\": 0,\n              \"wounds\": 0,\n              \"critical\": false,\n              \"companionCommandUsed\": false,\n              \"companionOffenseUsed\": false\n            },\n            \"patient\": {\n              \"profile\": \"W13I\",\n              \"hp\": 50,\n              \"maxHp\": 80,\n              \"tempHp\": 0,\n              \"rp\": 48,\n              \"maxRp\": 48,\n              \"dissonance\": 0,\n              \"lastSpell\": null,\n              \"refrain\": 0,\n              \"preparedFamiliesUsed\": [],\n              \"position\": [\n                10,\n                0,\n                0\n              ],\n              \"alive\": true,\n              \"conscious\": true,\n              \"conditions\": [\n                \"Incapacitated\",\n                \"Invisible\",\n                \"Speed0\"\n              ],\n              \"concentration\": null,\n              \"reaction\": true,\n              \"action\": true,\n              \"bonusAction\": true,\n              \"movementSpent\": 0,\n              \"regularStart\": 0,\n              \"nextRegularStart\": 6,\n              \"counterRecharge\": 0,\n              \"wounds\": 0,\n              \"critical\": false,\n              \"companionCommandUsed\": false,\n              \"companionOffenseUsed\": false\n            },\n            \"carrier\": {\n              \"profile\": \"W13I\",\n              \"hp\": 80,\n              \"maxHp\": 80,\n              \"tempHp\": 0,\n              \"rp\": 48,\n              \"maxRp\": 48,\n              \"dissonance\": 0,\n              \"lastSpell\": null,\n              \"refrain\": 0,\n              \"preparedFamiliesUsed\": [],\n              \"position\": [\n                15,\n                0,\n                0\n              ],\n              \"alive\": true,\n              \"conscious\": true,\n              \"conditions\": [],\n              \"concentration\": null,\n              \"reaction\": true,\n              \"action\": true,\n              \"bonusAction\": true,\n              \"movementSpent\": 0,\n              \"regularStart\": 0,\n              \"nextRegularStart\": 6,\n              \"counterRecharge\": 0,\n              \"wounds\": 0,\n              \"critical\": false,\n              \"companionCommandUsed\": false,\n              \"companionOffenseUsed\": false,\n              \"strengthOverride\": 14,\n              \"gearInCustody\": []\n            }\n          },\n          \"applications\": {\n            \"SEQ\": {\n              \"deadline\": 20,\n              \"guardConsumed\": true,\n              \"optionalTrigger\": {\n                \"kind\": \"ordinary audible wake-word\",\n                \"range\": 30,\n                \"phrase\": \"wake now\",\n                \"authentication\": false\n              }\n            }\n          },\n          \"objects\": {\n            \"supportFloor\": {\n              \"continuous\": true\n            }\n          },\n          \"privateMemories\": {},\n          \"sourceLedger\": {\n            \"patientBiology\": {\n              \"breathRemaining\": 60,\n              \"metabolicRemaining\": 3600\n            },\n            \"biologyPaused\": true\n          },\n          \"note\": \"Complete stated finite fixture state; unspecified optional reactions are declined. No actual encounter runtime is asserted.\"\n        },\n        \"regularStartsBeforeEvent\": []\n      },\n      {\n        \"timeSeconds\": 1,\n        \"event\": \"Carrier uses actual Action to lift known realbody\",\n        \"source\": [\n          \"BODY#Carrying and Load\"\n        ],\n        \"rng\": {},\n        \"explanation\": \"ActualMediumbody170+inclusivegear10=180lb, bodyLoad6+gear1=7. STR14 capacities210lb/14Load;7atleasthalfcapmakesBurdened. Carrierhasbothhandsavailable,andowngearplacedaside. Noinvented0mass or invisibilityhaulingexemption.\",\n        \"before\": {\n          \"actors\": {\n            \"caster\": {\n              \"profile\": \"W13I\",\n              \"hp\": 80,\n              \"maxHp\": 80,\n              \"tempHp\": 0,\n              \"rp\": 31,\n              \"maxRp\": 48,\n              \"dissonance\": 0,\n              \"lastSpell\": \"sequester\",\n              \"refrain\": 0,\n              \"preparedFamiliesUsed\": [\n                \"sequester\"\n              ],\n              \"position\": [\n                0,\n                0,\n                0\n              ],\n              \"alive\": true,\n              \"conscious\": true,\n              \"conditions\": [],\n              \"concentration\": null,\n              \"reaction\": true,\n              \"action\": false,\n              \"bonusAction\": true,\n              \"movementSpent\": 0,\n              \"regularStart\": 0,\n              \"nextRegularStart\": 6,\n              \"counterRecharge\": 0,\n              \"wounds\": 0,\n              \"critical\": false,\n              \"companionCommandUsed\": false,\n              \"companionOffenseUsed\": false\n            },\n            \"patient\": {\n              \"profile\": \"W13I\",\n              \"hp\": 50,\n              \"maxHp\": 80,\n              \"tempHp\": 0,\n              \"rp\": 48,\n              \"maxRp\": 48,\n              \"dissonance\": 0,\n              \"lastSpell\": null,\n              \"refrain\": 0,\n              \"preparedFamiliesUsed\": [],\n              \"position\": [\n                10,\n                0,\n                0\n              ],\n              \"alive\": true,\n              \"conscio