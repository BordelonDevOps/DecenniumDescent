                0,\n                0\n              ],\n              \"alive\": true,\n              \"conscious\": true,\n              \"conditions\": [],\n              \"concentration\": \"true-seeing\",\n              \"reaction\": true,\n              \"action\": true,\n              \"bonusAction\": true,\n              \"movementSpent\": 5,\n              \"regularStart\": 7,\n              \"nextRegularStart\": 13,\n              \"counterRecharge\": 0,\n              \"wounds\": 0,\n              \"critical\": false,\n              \"companionCommandUsed\": false,\n              \"companionOffenseUsed\": false\n            }\n          },\n          \"applications\": {\n            \"detect-magic\": {\n              \"owner\": \"patient\",\n              \"deadline\": 590,\n              \"actualPriorPreparation\": \"Actual ordinary rank1/2RP firstprepared cast at−10, Action/V/S,30foot perceived-target scope,concentration10minutes; sourcebook/preparation real.\",\n              \"state\": \"ended-by-incapacitated\"\n            },\n            \"true-seeing\": {\n              \"owner\": \"enemy\",\n              \"recipient\": \"enemy\",\n              \"establishedAt\": -5,\n              \"deadline\": 55,\n              \"priorActualCost\": 13,\n              \"priorWizardFirstPreparedStrain\": 0,\n              \"source\": \"context/ILLUSION13_MODEL.json#/spells/6\"\n            },\n            \"chill\": {\n              \"owner\": \"enemy\",\n              \"target\": \"patient\",\n              \"hpGainForbidden\": true,\n              \"deadline\": 6.4,\n              \"state\": \"expired\"\n            },\n            \"SEQ\": {\n              \"owner\": \"caster\",\n              \"recipient\": \"patient\",\n              \"deadline\": 120,\n              \"guardConsumed\": true,\n              \"pausedBiologyAt\": 2.1,\n              \"state\": \"ended-by-damage\",\n              \"originalDeadline\": 120\n            }\n          },\n        