"companionOffenseUsed\": false\n                }\n              },\n              \"applications\": {},\n              \"objects\": {},\n              \"privateMemories\": {},\n              \"sourceLedger\": {\n                \"observed\": {\n                  \"spell\": \"counterspell\",\n                  \"timestamp\": -1.9,\n                  \"rank\": 3,\n                  \"resolved\": true,\n                  \"directObservation\": true\n                },\n                \"hold\": {\n                  \"deadline\": 6,\n                  \"childReservation\": 5,\n                  \"state\": \"held\"\n                }\n              },\n              \"note\": \"Complete stated finite fixture state; unspecified optional reactions are declined. No actual encounter runtime is asserted.\"\n            },\n            \"after\": {\n              \"actors\": {\n                \"echoer\": {\n                  \"profile\": \"W13I\",\n                  \"hp\": 80,\n                  \"maxHp\": 80,\n                  \"tempHp\": 0,\n                  \"rp\": 31,\n                  \"maxRp\": 48,\n                  \"dissonance\": 0,\n                  \"lastSpell\": \"cast-echo\",\n                  \"refrain\": 0,\n                  \"preparedFamiliesUsed\": [\n                    \"cast-echo\"\n                  ],\n                  \"position\": [\n                    0,\n                    0,\n                    0\n                  ],\n                  \"alive\": true,\n                  \"conscious\": true,\n                  \"conditions\": [],\n                  \"concentration\": \"CE-held\",\n                  \"reaction\": false,\n                  \"action\": false,\n                  \"bonusAction\": true,\n                  \"movementSpent\": 0,\n                  \"regularStart\": 0,\n                  \"nextRegularStart\": 6,\n                  \"counterRecharge\": 0,\n                  \"wounds\": 0,\n                  \"critical\": false,\n                  \"companionCommandUsed\": false,\n                  \"companionOffenseUsed\": false\n                },\n                \"donor\": {\n                  \"profile\": \"W13I\",\n                  \"hp\": 80,\n                  \"maxHp\": 80,\n                  \"tempHp\": 0,\n                  \"rp\": 48,\n                  \"maxRp\": 48,\n                  \"dissonance\": 0,\n                  \"lastSpell\": null,\n                  \"refrain\": 0,\n                  \"preparedFamiliesUsed\": [],\n                  \"position\": [\n                    20,\n                    0,\n                    0\n                  ],\n                  \"alive\": true,\n                  \"conscious\": true,\n                  \"conditions\": [],\n                  \"concentration\": null,\n                  \"reaction\": true,\n                  \"action\": true,\n                  \"bonusAction\": true,\n                  \"movementSpent\": 0,\n                  \"regularStart\": 0,\n                  \"nextRegularStart\": 6,\n                  \"counterRecharge\": 0,\n                  \"wounds\": 0,\n                  \"critical\": false,\n                  \"companionCommandUsed\": false,\n                  \"companionOffenseUsed\": false\n                },\n                \"enemy\": {\n                  \"profile\": \"W13I\",\n                  \"hp\": 80,\n                  \"maxHp\": 80,\n                  \"tempHp\": 0,\n                  \"rp\": 48,\n                  \"maxRp\": 48,\n                  \"dissonance\": 0,\n                  \"lastSpell\": null,\n                  \"refrain\": 0,\n                  \"preparedFamiliesUsed\": [],\n                  \"position\": [\n                    30,\n                    0,\n                    0\n                  ],\n                  \"alive\": true,\n                  \"conscious\": true,\n                  \"conditions\": [],\n                  \"concentration\": null,\n                  \"re