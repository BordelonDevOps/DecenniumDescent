       0,\n                    0\n                  ],\n                  \"alive\": true,\n                  \"conscious\": true,\n                  \"conditions\": [],\n                  \"concentration\": null,\n                  \"reaction\": true,\n                  \"action\": true,\n                  \"bonusAction\": true,\n                  \"movementSpent\": 0,\n                  \"regularStart\": 0,\n                  \"nextRegularStart\": 6,\n                  \"counterRecharge\": 0,\n                  \"wounds\": 0,\n                  \"critical\": false,\n                  \"companionCommandUsed\": false,\n                  \"companionOffenseUsed\": false\n                }\n              },\n              \"applications\": {},\n              \"objects\": {\n                \"realLantern\": {\n                  \"owner\": \"creator\",\n                  \"position\": [\n                    10,\n                    0,\n                    0\n                  ],\n                  \"weightLb\": 2,\n                  \"load\": 0.2,\n                  \"actualCharges\": 0,\n                  \"custodian\": null\n                },\n                \"duplicate\": {\n                  \"id\": \"SI-existing\",\n                  \"position\": [\n                    10,\n                    0,\n                    0\n                  ],\n                  \"hp\": 35,\n                  \"rp\": 5,\n                  \"state\": \"absent-suppressed\",\n                  \"sourceOwnerLineageId\": \"derivative/creator/donor\"\n                }\n              },\n              \"privateMemories\": {\n                \"donor\": {\n                  \"accessible\": [\n                    \"a personally remembered room description\"\n                  ],\n                  \"inaccessible\": [\n                    \"sealed-memory-placeholder-no-access\"\n                  ]\n                }\n              },\n              \"sourceLedger\": {\n                \"account\": {\n                  \"rp\": 5,\n                  \"dissonance\": 4,\n                  \"casterLineageId\": \"derivative/creator/donor\"\n                }\n              },\n              \"note\": \"Complete stated finite fixture state; unspecified optional reactions are declined. No actual encounter runtime is asserted.\"\n            },\n            \"regularStartsBeforeEvent\": []\n          },\n          {\n            \"timeSeconds\": 4,\n            \"event\": \"Suppressionends butsavedbodyvolume occupied by realwall\",\n            \"source\": [],\n            \"rng\": {},\n            \"explanation\": \"No freepush,remote relocation,healing orcaprelease.\",\n            \"before\": {\n              \"actors\": {\n                \"creator\": {\n                  \"profile\": \"W13I\",\n                  \"hp\": 80,\n                  \"maxHp\": 80,\n                  \"tempHp\": 0,\n                  \"rp\": 31,\n                  \"maxRp\": 48,\n                  \"dissonance\": 0,\n                  \"lastSpell\": \"simulacrum\",\n                  \"refrain\": 0,\n                  \"preparedFamiliesUsed\": [\n                    \"simulacrum\"\n                  ],\n                  \"position\": [\n                    0,\n                    0,\n                    0\n                  ],\n                  \"alive\": true,\n                  \"conscious\": true,\n                  \"conditions\": [],\n                  \"concentration\": null,\n                  \"reaction\": true,\n                  \"action\": true,\n                  \"bonusAction\": true,\n                  \"movementSpent\": 0,\n                  \"regularStart\": 0,\n                  \"nextRegularStart\": 6,\n                  \"counterRecharge\": 0,\n                  \"wounds\": 0,\n                  \"critical\": false,\n                  \"companionCommandUsed\": false,\n                  \"companionOffenseUsed\": false\n                },\n                \"donor\": {\n                  \"profile\": \"W13I\",\n                  \"hp\": 35,\n                  \"maxHp\": 80,\n                  \"tempHp\": 0,\n                  \"rp\": 6,\n                  \"maxRp\": 48,\n                  \"dissonance\": 4,\n                  \"lastSpell\": \"ray-of-frost\",\n                  \"refrain\": 1,\n                  \"preparedFamiliesUsed\": [\n                    \"ray-of-frost\"\n                  ],\n                  \"position\": [\n                    20,\n                    0,\n                    0\n                  ],\n                  \"alive\": true,\n                  \"conscious\": true,\n                  \"conditions\": [],\n                  \"concentration\": null,\n                  \"reaction\": true,\n                  \"action\": true,\n                  \"bonusAction\": true,\n                  \"movementSpent\": 0,\n                  \"regularStart\": 0,\n                  \"nextRegularStart\": 6,\n                  \"counterRecharge\": 0,\n                  \"wounds\": 0,\n                  \"critical\": false,\n                  \"companionCommandUsed\": false,\n                  \"companionOffenseUsed\": false\n                }\n              },\n              \"applications\": {},\n              \"objects\": {\n                \"realLantern\": {\n                  \"owner\": \"creator\",\n                  \"position\": [\n                    10,\n                    0,\n                    0\n                  ],\n                  \"weightLb\": 2,\n                  \"load\": 0.2,\n                  \"actualCharges\": 0,\n                  \"custodian\": null\n                },\n                \"duplicate\": {\n                  \"id\": \"SI-existing\",\n                  \"position\": [\n                    10,\n                    0,\n                    0\n                  ],\n                  \"hp\": 35,\n                  \"rp\": 5,\n                  \"state\": \"absent-suppressed\",\n                  \"sourceOwnerLineageId\": \"derivative/creator/donor\"\n                }\n              },\n              \"privateMemories\": {\n                \"donor\": {\n                  \"accessible\": [\n                    \"a personally remembered room description\"\n                  ],\n                  \"inaccessible\": [\n                    \"sealed-memory-placeholder-no-access\"\n                  ]\n                }\n              },\n              \"sourceLedger\": {\n                \"account\": {\n                  \"rp\": 5,\n                  \"dissonance\": 4,\n                  \"casterLineageId\": \"derivative/creator/donor\"\n                }\n              },\n              \"note\": \"Complete stated finite fixture state; unspecified optional reactions are declined. No actual encounter runtime is asserted.\"\n            },\n            \"after\": {\n              \"actors\": {\n                \"creator\": {\n                  \"profile\": \"W13I\",\n                  \"hp\": 80,\n                  \"maxHp\": 80,\n                  \"tempHp\": 0,\n                  \"rp\": 31,\n                  \"maxRp\": 48,\n                  \"dissonance\": 0,\n                  \"lastSpell\": \"simulacrum\",\n                  \"refrain\": 0,\n                  \"preparedFamiliesUsed\": [\n                    \"simulacrum\"\n                  ],\n                  \"position\": [\n                    0,\n                    0,\n                    0\n                  ],\n                  \"alive\": true,\n                  \"conscious\": true,\n                  \"conditions\": [],\n                  \"concentration\": null,\n                  \"reaction\": true,\n                  \"action\": true,\n                  \"bonusAction\": true,\n                  \"movementSpent\": 0,\n                  \"regularStart\": 0,\n                  \"nextRegularStart\": 6,\n                  \"counterRecharge\": 0,\n                  \"wounds\": 0,\n 