egularStart\": 0,\n                  \"nextRegularStart\": 6,\n                  \"counterRecharge\": 0,\n                  \"wounds\": 0,\n                  \"critical\": false,\n                  \"companionCommandUsed\": false,\n                  \"companionOffenseUsed\": false\n                }\n              },\n              \"applications\": {},\n              \"objects\": {\n                \"oldLantern\": {\n                  \"position\": [\n                    20,\n                    0,\n                    0\n                  ],\n                  \"ordinary\": true,\n                  \"surfaceSquareFeet\": 1\n                },\n                \"newLantern\": {\n                  \"position\": [\n                    15,\n                    0,\n                    0\n                  ],\n                  \"ordinary\": true,\n                  \"surfaceSquareFeet\": 1\n                }\n              },\n              \"privateMemories\": {},\n              \"sourceLedger\": {},\n              \"note\": \"Complete stated finite fixture state; unspecified optional reactions are declined. No actual encounter runtime is asserted.\"\n            },\n            \"after\": {\n              \"actors\": {\n                \"echoer\": {\n                  \"profile\": \"W13I\",\n                  \"hp\": 80,\n                  \"maxHp\": 80,\n                  \"tempHp\": 0,\n                  \"rp\": 48,\n                  \"maxRp\": 48,\n                  \"dissonance\": 0,\n                  \"lastSpell\": null,\n                  \"refrain\": 0,\n                  \"preparedFamiliesUsed\": [],\n                  \"position\": [\n                    0,\n                    0,\n                    0\n                  ],\n                  \"alive\": true,\n                  \"conscious\": true,\n                  \"conditions\": [],\n                  \"concentration\": null,\n                  \"reaction\": true,\n                  \"action\": true,\n                  \"bonusAction\": true,\n                  \"movementSpent\": 0,\n                  \"regularStart\": 0,\n                  \"nextRegularStart\": 6,\n                  \"counterRecharge\": 0,\n                  \"wounds\": 0,\n                  \"critical\": false,\n                  \"companionCommandUsed\": false,\n                  \"companionOffenseUsed\": false\n                },\n                \"donor\": {\n                  \"profile\": \"W13I\",\n                  \"hp\": 80,\n                  \"maxHp\": 80,\n                  \"tempHp\": 0,\n                  \"rp\": 45,\n                  \"maxRp\": 48,\n                  \"dissonance\": 0,\n                  \"lastSpell\": \"continual-flame\",\n                  \"refrain\": 0,\n                  \"preparedFamiliesUsed\": [\n                    \"continual-flame\"\n                  ],\n                  \"position\": [\n                    10,\n                    0,\n                    0\n                  ],\n                  \"alive\": true,\n                  \"conscious\": true,\n                  \"conditions\": [],\n                  \"concentration\": null,\n                  \"reaction\": true,\n                  \"action\": true,\n                  \"bonusAction\": true,\n                  \"movementSpent\": 0,\n                  \"regularStart\": 0,\n                  \"nextRegularStart\": 6,\n                  \"counterRecharge\": 0,\n                  \"wounds\": 0,\n                  \"critical\": false,\n                  \"companionCommandUsed\": false,\n                  \"companionOffenseUsed\": false\n                }\n              },\n              \"applications\": {},\n              \"objects\": {\n                \"oldLantern\": {\n                  \"position\": [\n                    20,\n                    0,\n                    0\n                  ],\n                  \"ordinary\": true,\n                  \"surfaceSquareFeet\": 1,\n               