            },\n                \"observer\": {\n                  \"profile\": \"W13I\",\n                  \"hp\": 80,\n                  \"maxHp\": 80,\n                  \"tempHp\": 0,\n                  \"rp\": 48,\n                  \"maxRp\": 48,\n                  \"dissonance\": 0,\n                  \"lastSpell\": null,\n                  \"refrain\": 0,\n                  \"preparedFamiliesUsed\": [],\n                  \"position\": [\n                    20,\n                    0,\n                    0\n                  ],\n                  \"alive\": true,\n                  \"conscious\": true,\n                  \"conditions\": [],\n                  \"concentration\": null,\n                  \"reaction\": true,\n                  \"action\": true,\n                  \"bonusAction\": true,\n                  \"movementSpent\": 0,\n                  \"regularStart\": 6,\n                  \"nextRegularStart\": 12,\n                  \"counterRecharge\": 0,\n                  \"wounds\": 0,\n                  \"critical\": false,\n                  \"companionCommandUsed\": false,\n                  \"companionOffenseUsed\": false\n                },\n                \"outsider\": {\n                  \"profile\": \"W13I\",\n                  \"hp\": 80,\n                  \"maxHp\": 80,\n                  \"tempHp\": 0,\n                  \"rp\": 48,\n                  \"maxRp\": 48,\n                  \"dissonance\": 0,\n                  \"lastSpell\": null,\n                  \"refrain\": 0,\n                  \"preparedFamiliesUsed\": [],\n                  \"position\": [\n                    150,\n                    0,\n                    0\n                  ],\n                  \"alive\": true,\n                  \"conscious\": true,\n                  \"conditions\": [],\n                  \"concentration\": null,\n                  \"reaction\": true,\n                  \"action\": true,\n                  \"bonusAction\": true,\n   