  "cases": [
    {
      "id": "LOCAL-COPY-INACTIVE-MEND-ABSENT",
      "status": "defect-reproduced",
      "premise": "Existing paid Wizard Mend fixture with an explicitly absent or suppressed prior next-healing reducer; valid pending paid declaration and nativeDice [4,4].",
      "reducer": {
        "application_id": "old",
        "group": "actual-reducer",
        "kind": "flat",
        "value": 1,
        "present": false,
        "suppressed": false,
        "next_healing": true
      },
      "expectedByExistingHealingHelper": {
        "hp": 32,
        "nextHealingCandidates": []
      },
      "actual": {
        "hp": 30,
        "error": "New next-healing source needs its actual consumption adapter",
        "failureAtomic": true
      },
      "finding": "The copy adapter rejects every next_healing record without filtering present/suppressed state. Existing healing arithmetic correctly ignores the inactive record. Active next-healing consumption remains a separate explicitly unimplemented adapter."
    },
