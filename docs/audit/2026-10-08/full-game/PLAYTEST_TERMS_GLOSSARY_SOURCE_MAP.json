  "entries": [
    {
      "section": "Character and card notation",
      "term": "Ability score and modifier",
      "definition": "STR, DEX, CON, INT, WIS and CHA are scores. Their modifiers are `floor((score − 10) / 2)`, including negative results.",
      "sourceLinks": [
        {
          "link": "../mechanics/CHARACTER_CREATION_PLAYTEST.md#abilities-and-training",
          "file": "DescentReviewChanges/ReviewBible/docs/mechanics/CHARACTER_CREATION_PLAYTEST.md",
          "sha256": "e59456f4430f7f72db0392c3a52be8ec8b7d804b4b765c0a73f81c72f060a49e",
          "targetHeading": "Abilities and training",
          "targetAnchor": "abilities-and-training"
        }
      ]
    },
    {
      "section": "Character and card notation",
      "term": "Character level",
      "definition": "Total levels across the character's classes. Keep the chronological level record.",
      "sourceLinks": [
        {
          "link": "../mechanics/CHARACTER_CREATION_PLAYTEST.md#multiclass-entry-and-class-features",
          "file": "DescentReviewChanges/ReviewBible/docs/mechanics/CHARACTER_CREATION_PLAYTEST.md",
          "sha256": "e59456f4430f7f72db0392c3a52be8ec8b7d804b4b765c0a73f81c72f060a49e",
          "targetHeading": "Multiclass entry and class features",
          "targetAnchor": "multiclass-entry-and-class-features"
        }
      ]
    },
    {
      "section": "Character and card notation",
      "term": "Class level",
      "definition": "Levels in the particular class supplying a card, spell access or engine. Check that class's own prerequisites.",
      "sourceLinks": [
        {
          "link": "../mechanics/CHARACTER_CREATION_PLAYTEST.md#multiclass-entry-and-class-features",
          "file": "DescentReviewChanges/ReviewBible/docs/mechanics/CHARACTER_CREATION_PLAYTEST.md",
          "sha256": "e59456f4430f7f72db0392c3a52be8ec8b7d804b4b765c0a73f81c72f060a49e",
          "targetHeading": "Multiclass entry and class features",
          "targetAnchor": "multiclass-entry-and-class-features"
        }
      ]
    },
    {
      "section": "Character and card notation",
      "term": "Base, Arch and Hero",
      "definition": "Stages within a class. Follow its own acquisition schedule, including its explicit exceptions.",
      "sourceLinks": [
        {
          "link": "../mechanics/CLASS_PLAYTEST_INDEX.md#class-playtest-library",
          "file": "DescentReviewChanges/ReviewBible/docs/mechanics/CLASS_PLAYTEST_INDEX.md",
          "sha256": "33b24880889bb210f8d42f4d91bf5364ddee3f08eb56638cc1985934d82bc1b2",
          "targetHeading": "Class playtest library",
          "targetAnchor": "class-playtest-library"
        }
      ]
    },
    {
      "section": "Character and card notation",
      "term": "PB",
      "definition": "Proficiency bonus from total character level. Apply it when actually trained or otherwise authorized; two relevant proficiencies do not automatically add it twice.",
      "sourceLinks": [
        {
          "link": "../mechanics/CHARACTER_CREATION_PLAYTEST.md#gain-a-level",
          "file": "DescentReviewChanges/ReviewBible/docs/mechanics/CHARACTER_CREATION_PLAYTEST.md",
          "sha256": "e59456f4430f7f72db0392c3a52be8ec8b7d804b4b765c0a73f81c72f060a49e",
          "targetHeading": "Gain a level",
          "targetAnchor": "gain-a-level"
        }
      ]
    },
    {
      "section": "Character and card notation",
      "term": "L on a class card",
      "definition": "That card's class level.",
      "sourceLinks": [
        {
          "link": "../mechanics/CLASS_PLAYTEST_RULES.md#reading-a-class-card",
          "file": "DescentReviewChanges/ReviewBible/docs/mechanics/CLASS_PLAYTEST_RULES.md",
          "sha256": "adb2f4752b45dc70ce792a675bb30dda362aab5056588061bcde3ba31c4c8a81",
          "targetHeading": "Reading a class card",
          "targetAnchor": "reading-a-class-card"
        }
      ]
    },
    {
      "section": "Character and card notation",
      "term": "S on a class card",
      "definition": "The scaling value: 1, 2, 3 or 4 at that class's levels 1, 5, 11 or 17.",
      "sourceLinks": [
        {
          "link": "../mechanics/CLASS_PLAYTEST_RULES.md#reading-a-class-card",
          "file": "DescentReviewChanges/ReviewBible/docs/mechanics/CLASS_PLAYTEST_RULES.md",
          "sha256": "adb2f4752b45dc70ce792a675bb30dda362aab5056588061bcde3ba31c4c8a81",
          "targetHeading": "Reading a class card",
          "targetAnchor": "reading-a-class-card"
        }
      ]
    },
    {
      "section": "Character and card notation",
      "term": "M on a class card",
      "definition": "`max(1, the class ability modifier)` for effect amounts. Attacks and save DCs use the actual appropriate modifier, including negative values.",
      "sourceLinks": [
        {
          "link": "../mechanics/CLASS_PLAYTEST_RULES.md#reading-a-class-card",
          "file": "DescentReviewChanges/ReviewBible/docs/mechanics/CLASS_PLAYTEST_RULES.md",
          "sha256": "adb2f4752b45dc70ce792a675bb30dda362aab5056588061bcde3ba31c4c8a81",
          "targetHeading": "Reading a class card",
          "targetAnchor": "reading-a-class-card"
        }
      ]
    },
    {
      "section": "Rolls and results",
      "term": "AC",
      "definition": "Armor Class: the number an attack must meet. Use one applicable AC formula, then its legal modifiers.",
      "sourceLinks": [
        {
          "link": "../mechanics/CHARACTER_CREATION_PLAYTEST.md#begin-a-character-sheet",
          "file": "DescentReviewChanges/ReviewBible/docs/mechanics/CHARACTER_CREATION_PLAYTEST.md",
          "sha256": "e59456f4430f7f72db0392c3a52be8ec8b7d804b4b765c0a73f81c72f060a49e",
          "targetHeading": "Begin a character sheet",
          "targetAnchor": "begin-a-character-sheet"
        }
      ]
    },
    {
      "section": "Rolls and results",
      "term": "DC",
      "definition": "Difficulty Class: the threshold for the particular check or save. A printed failure margin compares the final total with that DC.",
      "sourceLinks": [
        {
          "link": "../mechanics/CORE_RESOLUTION_PLAYTEST.md#rolls",
          "file": "DescentReviewChanges/ReviewBible/docs/mechanics/CORE_RESOLUTION_PLAYTEST.md",
          "sha256": "69d0e64394de58c4d86a3ec57cf282978d131a1a9c1eaa21632bb7d3b72562da",
          "targetHeading": "Rolls",
          "targetAnchor": "rolls"
        }
      ]
    },
    {
      "section": "Rolls and results",
      "term": "Attack roll",
      "definition": "Meets AC to hit. Natural 1 misses; natural 20 hits and critically doubles damage dice. Flat modifiers are unchanged.",
      "sourceLinks": [
        {
          "link": "../mechanics/CORE_RESOLUTION_PLAYTEST.md#rolls",
          "file": "DescentReviewChanges/ReviewBible/docs/mechanics/CORE_RESOLUTION_PLAYTEST.md",
          "sha256": "69d0e64394de58c4d86a3ec57cf282978d131a1a9c1eaa21632bb7d3b72562da",
          "targetHeading": "Rolls",
          "targetAnchor": "rolls"
        }
      ]
    },
    {
      "section": "Rolls and results",
      "term": "Task, skill or tool check",
      "definition": "Uses the task procedure and its four outcome degrees. If the task provides only success/failure effects, use those effects without inventing extra critical consequences.",
      "sourceLinks": [
        {
          "link": "../mechanics/CORE_RESOLUTION_PLAYTEST.md#rolls",
          "file": "DescentReviewChanges/ReviewBible/docs/mechanics/CORE_RESOLUTION_PLAYTEST.md",
          "sha256": "69d0e64394de58c4d86a3ec57cf282978d131a1a9c1eaa21632bb7d3b72562da",
          "targetHeading": "Rolls",
          "targetAnchor": "rolls"
        }
      ]
    },
    {
      "section": "Rolls and results",
      "term": "Saving throw",
      "definition": "Meets DC to succeed. Ordinary saves have no generic natural-1/20 effect; use any explicitly printed failure margins. Death saves have their own procedure.",
      "sourceLinks": [
        {
          "link": "../mechanics/CORE_RESOLUTION_PLAYTEST.md#rolls",
          "file": "DescentReviewChanges/ReviewBible/docs/mechanics/CORE_RESOLUTION_PLAYTEST.md",
          "sha256": "69d0e64394de58c4d86a3ec57cf282978d131a1a9c1eaa21632bb7d3b72562da",
          "targetHeading": "Rolls",
          "targetAnchor": "rolls"
        }
      ]
    },
    {
      "section": "Rolls and results",
      "term": "Opposed check",
      "definition": "Compares final totals. An exact tie preserves the existing state.",
      "sourceLinks": [
        {
          "link": "../mechanics/CORE_RESOLUTION_PLAYTEST.md#rolls",
          "file": "DescentReviewChanges/ReviewBible/docs/mechanics/CORE_RESOLUTION_PLAYTEST.md",
          "sha256": "69d0e64394de58c4d86a3ec57cf282978d131a1a9c1eaa21632bb7d3b72562da",
          "targetHeading": "Rolls",
          "targetAnchor": "rolls"
        }
      ]
    },
    {
      "section": "Rolls and results",
      "term": "Advantage / disadvantage",
      "definition": "Roll two d20s and use the higher/lower. Multiple sources do not stack; any advantage and disadvantage cancel.",
      "sourceLinks": [
        {
          "link": "../mechanics/CORE_RESOLUTION_PLAYTEST.md#rolls",
          "file": "DescentReviewChanges/ReviewBible/docs/mechanics/CORE_RESOLUTION_PLAYTEST.md",
          "sha256": "69d0e64394de58c4d86a3ec57cf282978d131a1a9c1eaa21632bb7d3b72562da",
          "targetHeading": "Rolls",
          "targetAnchor": "rolls"
        }
      ]
    },
    {
      "section": "Time and actions",
      "term": "Round",
      "definition": "One numbered pass through initiative, representing approximately six seconds. Shared per-round limits use that numbered round.",
      "sourceLinks": [
        {
          "link": "../mechanics/COMBAT_ACTION_PLAYTEST.md#encounter-and-action-resources",
          "file": "DescentReviewChanges/ReviewBible/docs/mechanics/COMBAT_ACTION_PLAYTEST.md",
          "sha256": "f90d039142145fbd31c37992ebece70d7926dc4b6081e340f9a2fd9dc7237bc6",
          "targetHeading": "Encounter and action resources",
          "targetAnchor": "encounter-and-action-resources"
        }
      ]
    },
    {
      "section": "Time and actions",
      "term": "Tile",
      "definition": "Five feet on the map. Apply the combat guide's actual geometry, terrain and movement-cost procedures.",
      "sourceLinks": [
        {
          "link": "../mechanics/CORE_RESOLUTION_PLAYTEST.md#rolls",
          "file": "DescentReviewChanges/ReviewBible/docs/mechanics/CORE_RESOLUTION_PLAYTEST.md",
          "sha256": "69d0e64394de58c4d86a3ec57cf282978d131a1a9c1eaa21632bb7d3b72562da",
          "targetHeading": "Rolls",
          "targetAnchor": "rolls"
        },
        {
          "link": "../mechanics/COMBAT_ACTION_PLAYTEST.md#movement-and-geometry",
          "file": "DescentReviewChanges/ReviewBible/docs/mechanics/COMBAT_ACTION_PLAYTEST.md",
          "sha256": "f90d039142145fbd31c37992ebece70d7926dc4b6081e340f9a2fd9dc7237bc6",
          "targetHeading": "Movement and geometry",
          "targetAnchor": "movement-and-geometry"
        }
      ]
    },
    {
      "section": "Time and actions",
      "term": "Regular turn",
      "definition": "A creature's normal initiative slot, including when it cannot act. An extra Action and an extra turn have their own limits.",
      "sourceLinks": [
        {
          "link": "../mechanics/COMBAT_ACTION_PLAYTEST.md#encounter-and-action-resources",
          "file": "DescentReviewChanges/ReviewBible/docs/mechanics/COMBAT_ACTION_PLAYTEST.md",
          "sha256": "f90d039142145fbd31c37992ebece70d7926dc4b6081e340f9a2fd9dc7237bc6",
          "targetHeading": "Encounter and action resources",
          "targetAnchor": "encounter-and-action-resources"
        }
      ]
    },
    {
      "section": "Time and actions",
      "term": "Action",
      "definition": "The normal turn's main action allowance. A technique saying “make one weapon attack” uses its printed activation and attacks.",
      "sourceLinks": [
        {
          "link": "../mechanics/COMBAT_ACTION_PLAYTEST.md#standard-actions",
          "file": "DescentReviewChanges/ReviewBible/docs/mechanics/COMBAT_ACTION_PLAYTEST.md",
          "sha256": "f90d039142145fbd31c37992ebece70d7926dc4b6081e340f9a2fd9dc7237bc6",
          "targetHeading": "Standard Actions",
          "targetAnchor": "standard-actions"
        }
      ]
    },
    {
      "section": "Time and actions",
      "term": "Bonus Action",
      "definition": "An allowance with uses granted by actual rules. Check both an available use and the card's cost.",
      "sourceLinks": [
        {
          "link": "../mechanics/COMBAT_ACTION_PLAYTEST.md#encounter-and-action-resources",
          "file": "DescentReviewChanges/ReviewBible/docs/mechanics/COMBAT_ACTION_PLAYTEST.md",
          "sha256": "f90d039142145fbd31c37992ebece70d7926dc4b6081e340f9a2fd9dc7237bc6",
          "targetHeading": "Encounter and action resources",
          "targetAnchor": "encounter-and-action-resources"
        }
      ]
    },
    {
      "section": "Time and actions",
      "term": "Reaction",
      "definition": "A response to a legal trigger. The ordinary resource refreshes at the start of your regular turn; specific extra grants retain their own limits.",
      "sourceLinks": [
        {
          "link": "../mechanics/COMBAT_ACTION_PLAYTEST.md#encounter-and-action-resources",
          "file": "DescentReviewChanges/ReviewBible/docs/mechanics/COMBAT_ACTION_PLAYTEST.md",
          "sha256": "f90d039142145fbd31c37992ebece70d7926dc4b6081e340f9a2fd9dc7237bc6",
          "targetHeading": "Encounter and action resources",
          "targetAnchor": "encounter-and-action-resources"
        }
      ]
    },
    {
      "section": "Time and actions",
      "term": "Extra full Action",
      "definition": "The shared limit is one per creature per numbered round. It cannot grant another extra Action, Bonus Action or Reaction.",
      "sourceLinks": [
        {
          "link": "../mechanics/COMBAT_ACTION_PLAYTEST.md#encounter-and-action-resources",
          "file": "DescentReviewChanges/ReviewBible/docs/mechanics/COMBAT_ACTION_PLAYTEST.md",
          "sha256": "f90d039142145fbd31c37992ebece70d7926dc4b6081e340f9a2fd9dc7237bc6",
          "targetHeading": "Encounter and action resources",
          "targetAnchor": "encounter-and-action-resources"
        }
      ]
    },
    {
      "section": "Time and actions",
      "term": "Recharge",
      "definition": "A card's countdown to reuse. In combat, tick at regular own-turn starts; extra Actions/turns do not advance it. Outside combat, use its elapsed-time procedure.",
      "sourceLinks": [
        {
          "link": "../mechanics/CLASS_PLAYTEST_RULES.md#action-and-timing-limits",
          "file": "DescentReviewChanges/ReviewBible/docs/mechanics/CLASS_PLAYTEST_RULES.md",
          "sha256": "adb2f4752b45dc70ce792a675bb30dda362aab5056588061bcde3ba31c4c8a81",
          "targetHeading": "Action and timing limits",
          "targetAnchor": "action-and-timing-limits"
        }
      ]
    },
    {
      "section": "Time and actions",
      "term": "Encounter",
      "definition": "A genuine scene of uncertain opposition established by the Director. Resource resets require their actual conditions.",
      "sourceLinks": [
        {
          "link": "../mechanics/CLASS_PLAYTEST_RULES.md#action-and-timing-limits",
          "file": "DescentReviewChanges/ReviewBible/docs/mechanics/CLASS_PLAYTEST_RULES.md",
          "sha256": "adb2f4752b45dc70ce792a675bb30dda362aab5056588061bcde3ba31c4c8a81",
          "targetHeading": "Action and timing limits",
          "targetAnchor": "action-and-timing-limits"
        }
      ]
    },
    {
      "section": "Time and actions",
      "term": "Concentration",
      "definition": "A shared slot for effects that expressly require it, with only explicit exceptions. A duration or maintenance cost alone does not create a concentration requirement.",
      "sourceLinks": [
        {
          "link": "../mechanics/CLASS_PLAYTEST_RULES.md#targets-concentration-and-control",
          "file": "DescentReviewChanges/ReviewBible/docs/mechanics/CLASS_PLAYTEST_RULES.md",
          "sha256": "adb2f4752b45dc70ce792a675bb30dda362aab5056588061bcde3ba31c4c8a81",
          "targetHeading": "Targets, concentration and control",
          "targetAnchor": "targets-concentration-and-control"
        }
      ]
    },
    {
      "section": "Time and actions",
      "term": "Beneficial rest",
      "definition": "A completed rest satisfying its time, activity, availability and campaign requirements. Read each resource's actual recovery rule.",
      "sourceLinks": [
        {
          "link": "../mechanics/STRAIN_PLAYTEST.md#recovery-and-actual-elapsed-time",
          "file": "DescentReviewChanges/ReviewBible/docs/mechanics/STRAIN_PLAYTEST.md",
          "sha256": "32ca16894c29ba2906f8d510ef9781951bc8780e4a91ee84671f250f4de62b5f",
          "targetHeading": "Recovery and actual elapsed time",
          "targetAnchor": "recovery-and-actual-elapsed-time"
        }
      ]
    },
    {
      "section": "Magic and resources",
      "term": "RP",
      "definition": "Resonance Points used by eligible casting classes and their actual features. Access, preparation and costs all remain required.",
      "sourceLinks": [
        {
          "link": "RESONANCE_CHEATSHEET.md#before-casting",
          "file": "DescentReviewChanges/ReviewBible/docs/playtest/RESONANCE_CHEATSHEET.md",
          "sha256": "74d09481e47c13d17a420e476f66dba3cf88407dd61e26245faf4d0cd13f8751",
          "targetHeading": "Before casting",
          "targetAnchor": "before-casting"
        }
      ]
    },
    {
      "section": "Magic and resources",
      "term": "RC",
      "definition": "Oracle Revelation Charges, governed by the Oracle engine and its own costs, capacity and recovery.",
      "sourceLinks": [
        {
          "link": "RESONANCE_CHEATSHEET.md#oracle-revelations",
          "file": "DescentReviewChanges/ReviewBible/docs/playtest/RESONANCE_CHEATSHEET.md",
          "sha256": "74d09481e47c13d17a420e476f66dba3cf88407dd61e26245faf4d0cd13f8751",
          "targetHeading": "Oracle Revelations",
          "targetAnchor": "oracle-revelations"
        }
      ]
    },
    {
      "section": "Magic and resources",
      "term": "Ordinary spell rank",
      "definition": "The rank of a spell for the chosen casting class. Its class-level gate, school and repertoire determine access.",
      "sourceLinks": [
        {
          "link": "../mechanics/SPELL_INTEGRATION_RULES.md#select-a-spell",
          "file": "DescentReviewChanges/ReviewBible/docs/mechanics/SPELL_INTEGRATION_RULES.md",
          "sha256": "256bb99fce3855a78b381577d7c4c1ec448c41d7cde79a6b238b01ca47ff35a3",
          "targetHeading": "Select a spell",
          "targetAnchor": "select-a-spell"
        }
      ]
    },
    {
      "section": "Magic and resources",
      "term": "Dissonance",
      "definition": "The current casting-strain amount used by the active ordinary-magic configuration. Check its pre-cast thresholds and actual class exceptions.",
      "sourceLinks": [
        {
          "link": "RESONANCE_CHEATSHEET.md#dissonance-and-refrain",
          "file": "DescentReviewChanges/ReviewBible/docs/playtest/RESONANCE_CHEATSHEET.md",
          "sha256": "74d09481e47c13d17a420e476f66dba3cf88407dd61e26245faf4d0cd13f8751",
          "targetHeading": "Dissonance and Refrain",
          "targetAnchor": "dissonance-and-refrain"
        }
      ]
    },
    {
      "section": "Magic and resources",
      "term": "Refrain",
      "definition": "The remembered ordinary-spell repetition counter. Changing spells clears that counter while accumulated Dissonance follows its own rules.",
      "sourceLinks": [
        {
          "link": "RESONANCE_CHEATSHEET.md#dissonance-and-refrain",
          "file": "DescentReviewChanges/ReviewBible/docs/playtest/RESONANCE_CHEATSHEET.md",
          "sha256": "74d09481e47c13d17a420e476f66dba3cf88407dd61e26245faf4d0cd13f8751",
          "targetHeading": "Dissonance and Refrain",
          "targetAnchor": "dissonance-and-refrain"
        }
      ]
    },
    {
      "section": "Magic and resources",
      "term": "Class resource or gauge",
      "definition": "A named pool such as Crescendo, Blood Gauge or a class store. Use that engine's grants, caps, costs and recovery.",
      "sourceLinks": [
        {
          "link": "../mechanics/CLASS_PLAYTEST_INDEX.md#class-playtest-library",
          "file": "DescentReviewChanges/ReviewBible/docs/mechanics/CLASS_PLAYTEST_INDEX.md",
          "sha256": "33b24880889bb210f8d42f4d91bf5364ddee3f08eb56638cc1985934d82bc1b2",
          "targetHeading": "Class playtest library",
          "targetAnchor": "class-playtest-library"
        }
      ]
    },
    {
      "section": "Health and named states",
      "term": "HP",
      "definition": "Current and maximum Hit Points are separate values. Living at zero HP and being Dead are different states with different procedures.",
      "sourceLinks": [
        {
          "link": "../mechanics/CORE_RESOLUTION_PLAYTEST.md#zero-hp-and-recovery",
          "file": "DescentReviewChanges/ReviewBible/docs/mechanics/CORE_RESOLUTION_PLAYTEST.md",
          "sha256": "69d0e64394de58c4d86a3ec57cf282978d131a1a9c1eaa21632bb7d3b72562da",
          "targetHeading": "Zero HP and recovery",
          "targetAnchor": "zero-hp-and-recovery"
        }
      ]
    },
    {
      "section": "Health and named states",
      "term": "Temporary HP",
      "definition": "Absorbs damage before normal HP. It does not stack or restore ordinary HP; use the applicable temporary-HP rule.",
      "sourceLinks": [
        {
          "link": "../mechanics/CORE_RESOLUTION_PLAYTEST.md#resolve-a-damage-event",
          "file": "DescentReviewChanges/ReviewBible/docs/mechanics/CORE_RESOLUTION_PLAYTEST.md",
          "sha256": "69d0e64394de58c4d86a3ec57cf282978d131a1a9c1eaa21632bb7d3b72562da",
          "targetHeading": "Resolve a damage event",
          "targetAnchor": "resolve-a-damage-event"
        }
      ]
    },
    {
      "section": "Health and named states",
      "term": "Hit Dice",
      "definition": "Class-sized recovery dice tracked as available or spent. Their size, spending and recovery follow the character's actual class record.",
      "sourceLinks": [
        {
          "link": "../mechanics/CHARACTER_CREATION_PLAYTEST.md#begin-a-character-sheet",
          "file": "DescentReviewChanges/ReviewBible/docs/mechanics/CHARACTER_CREATION_PLAYTEST.md",
          "sha256": "e59456f4430f7f72db0392c3a52be8ec8b7d804b4b765c0a73f81c72f060a49e",
          "targetHeading": "Begin a character sheet",
          "targetAnchor": "begin-a-character-sheet"
        }
      ]
    },
    {
      "section": "Health and named states",
      "term": "Wounds and Wounded",
      "definition": "The lasting Wound count and its consequences. The Wounded condition refers to that same count. Ordinary HP healing does not automatically remove a Wound.",
      "sourceLinks": [
        {
          "link": "../mechanics/CORE_RESOLUTION_PLAYTEST.md#wounds-and-critical-state",
