  "additionalFocusedObligations": [
    {
      "id": "SC6-N01",
      "spellIds": [
        "planar-binding-minor"
      ],
      "question": "Keep the ordinary rank6 Divination Minor identity separate from the unavailable rank5 Planar Binding payload held in exact335. A future accepted Minor procedure cannot silently populate that null payload or clear its hold; an exact intended source would need its own review. Current feat335 acceptance is complete at its explicit hold scope."
    },
    {
      "id": "SC6-N02",
      "spellIds": [
        "planar-summons-lesser",
        "planar-summons-greater",
        "soul-cage"
      ],
      "question": "Apply class features from actual generating school and native eligibility,not the name. These Summons are Divination,so no Conjuration-school HP creation bonus follows merely because a creature was summoned. SoulCage Wizard access remains Enchantment/creature,while Cleric/Druid/Shaman Necromancy uses the distinct humanoid promise. Every case must retain that real provenance through shared commands,damage and capture receipts."
    },
    {
      "id": "SC6-N03",
      "spellIds": [
        "planar-summons-greater"
      ],
      "question": "Make two-body placement and partial-arrival behavior concrete. A hypothetical10x10receiving footprint cannot contain two distinct10x10nonoverlapping bodies at the same height; two qualifying identities alone do not prove arrival. Choose explicit atomic versus partial behavior before outcomes,conserve unique identity/cargo and demonstrate actual whole-body clearance. Do not satisfy two-allies source by duplicating an existing individual or reusing one arrival receipt."
    }
