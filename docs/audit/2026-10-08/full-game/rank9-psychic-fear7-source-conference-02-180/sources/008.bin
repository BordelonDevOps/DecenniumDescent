            "corePath": "data/public/Decennium_Descent_Core_Systems_Data_v2_Known_Descent.json",
            "coreSha256": "50c3e9683349e93192191381ab6354ca7d675a24fcc9bb9b039c23e67fecca4f",
            "coreEntries": [
              {
                "index": 585,
