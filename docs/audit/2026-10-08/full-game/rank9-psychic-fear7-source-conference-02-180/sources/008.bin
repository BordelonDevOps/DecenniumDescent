            "sha256": "c5603e7e22cc3b46ca52d816662c49285848530795596aae71e60ff304168478"
          },
          "candidatePointer": "/completeOriginalSharedProposals/2/completeOriginalSharedProposal/snapshots",
          "scope": "Only listed accepted Illusion14 cards. Named rules for other cards grant no capability here. Actual accepted interfaces and each selected current procedure control their explicit scopes and exceptions."
        },
        "IP14-SOURCE3-clocks": {
          "id": "IP14-SOURCE3-clocks",
          "completeText": "NEW minute-long proposals use a recorded absolute60-second deadline from resolution, including in initiative; expiry takes precedence at that deadline. Longer hour/day durations use actual elapsed campaign seconds, never a calendar label or a rest counter. Preserve original regular START/END identities through initiative transitions; extra turns do not add orders, saves or allowances. Suppression preserves costs, source identity, original expiry and spent history, skips ineligible execution without catch-up, and cannot revive an ended application. Scheduled repeat saves remain available during suppression when the procedure provides them; they are not additional casts. No ongoing range tether is added to established target-attached spells unless expressly stated. An ended/dead target creature ends its attached magical applications; reaching0HP without death alone does not.",
          "applicableSpellIds": [
            "mass-mirage",
            "echofield",
            "seeming",
            "dream"
          ],
          "source": {
            "path": "DescentReviewChanges/ReviewBible/data/director/spell_proposals/enchantment_illusion_rank5.json",
