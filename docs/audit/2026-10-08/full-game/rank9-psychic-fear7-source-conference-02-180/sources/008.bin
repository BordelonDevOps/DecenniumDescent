          },
          "candidatePointer": "/completeOriginalSharedProposals/1/completeOriginalSharedProposal/damageAndControl",
          "scope": "Only listed accepted Illusion14 cards. Named rules for other cards grant no capability here. Actual accepted interfaces and each selected current procedure control their explicit scopes and exceptions."
        },
        "IP14-SOURCE2-identity": {
          "id": "IP14-SOURCE2-identity",
          "completeText": "Keep actual physical body, source owner, controller, originating spell, current HP, inventory and all histories distinct. A conjured body provides no corpse, harvest or transferable intrinsic gear. A converted real corpse is consumed once and never becomes fresh raising/recipe fuel by destruction, release or renaming. Actual carried gear stays real and changes custody only through physical actions. No new resurrection permission, soul capture, afterlife destination, planar route or identity lore follows from a spell name. Mechanical creature type is not a decision about cosmology.",
          "applicableSpellIds": [
            "true-seeing",
            "spectral-army",
            "reality-fracture",
            "programmed-illusion"
          ],
          "source": {
            "path": "DescentReviewChanges/ReviewBible/data/director/spell_proposals/illusion_necromancy_rank6.json",
            "bytes": 4578509,
            "sha256": "b59b1d520bb63d306198805e2f76cb85ff1c051f10545fe708f07e7a9d1cf06d"
          },
          "candidatePointer": "/completeOriginalSharedProposals/1/completeOriginalSharedProposal/identity",
          "scope": "Only listed accepted Illusion14 cards. Named rules for other cards grant no capability here. Actual accepted interfaces and each selected current procedure control their explicit scopes and exceptions."
        },
        "IP14-SOURCE3-casting": {
          "id": "IP14-SOURCE3-casting",
          "completeText": "KEEP each actual rank-five/base10RP class-access row, minimum class level, repertoire and casting ability. All use V/S/F, Action and60-foot range except Mental Bomb keeps Reaction and20-foot casting-point range. Actual components/hands/voice/focus, legal commitment, RP/strain surcharge, Dissonance/Refrain and the Counterspell window apply. A legal attempted cast pays before hidden eligibility and countering; counter/failure refunds nothing and restores no displaced concentration. Only the explicitly stated spells require concentration. Save DC=8+actual total PB+actual source casting modifier; Investigation uses an actual Core task check against that DC, not a save. No generic upcast, automatic cantrip/rank scaling, substitute class levels, missing RP pool or new access is granted.",
          "applicableSpellIds": [
            "mass-mirage",
            "echofield",
            "seeming",
            "dream"
          ],
          "source": {
            "path": "DescentReviewChanges/ReviewBible/data/director/spell_proposals/enchantment_illusion_rank5.json",
