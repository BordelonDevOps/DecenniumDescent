      {
        "id": "PL-05",
        "topic": "Connections and tributary realms",
        "disposition": "RESOLVED-SOURCE-CONNECTIONS-ONLY",
        "decision": "Retain explicit Confluence Straits, inter-realm exchanges, and the four tributary realms as source facts. Do not derive endpoint, capacity, cost, consent, return, clock, rest, cargo, or hazard procedures from descriptive connection language.",
        "retainedFacts": [
          "Confluence Straits are named diplomatic corridors managed by Choir virtues in the original account.",
          "P71 names Molten Glass Tapestries, Luminous Dusk, Whispering Archive, and Calculated Pyre as tributary realms."
        ],
        "mortalBeliefs": [
