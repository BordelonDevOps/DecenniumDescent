      {
        "id": "PL-04",
        "topic": "Dream, thought, Astral and Fey",
        "disposition": "RESOLVED-NO-THEMATIC-MERGE",
        "decision": "Radiant Currents, Boundless Void, Astral Plane, and Verdant Reflection are not merged by shared dream/thought/Fey motifs. Identity requires explicit source linkage, not thematic resemblance.",
        "retainedFacts": [
          "Radiant Currents is the original possibility/dream dominion with unpredictable time.",
          "Boundless Void is the original questioning/thought dominion."
        ],
        "mortalBeliefs": [
