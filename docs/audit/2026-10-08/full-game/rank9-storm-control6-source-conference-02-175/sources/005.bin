    "issues": [
      {
        "id": "PL-01",
        "topic": "Two plane maps have different authority",
        "disposition": "RESOLVED-AS-LAYERED-AUTHORITY",
        "decision": "Preserve the original four-primary-realm account and the 32-label Wheel as different-authority presentations. No one-to-one equivalence is adopted, and the mortal Wheel is not evidence that its named worlds are fictitious.",
        "retainedFacts": [
          "Original Planes Ascendant names four primary dominions: Bastion of Flame, Veiled Expanse, Radiant Currents, Boundless Void.",
          "Original P71 separately names four tributary realms.",
          "Current Appendix B contains 32 named plane labels."
        ],
        "mortalBeliefs": [
          "The Wheel/Great Wheel is mortal cosmography/theology under Q5; it is sincerely taught but not objective cosmic proof."
        ],
        "proposedClarifications": [
          "PROPOSAL (editorial only): every future diagram/index should carry an authority field such as original account, mortal teaching, saved visualization, or operational interface."
        ],
        "unresolvedDependencies": [
          "Objective correspondences among the four original realms, the 32 mortal labels, website shells and viewer bodies remain unproved unless a source explicitly states one."
