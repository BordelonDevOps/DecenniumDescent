        "label": "Shadow Ascendancy",
        "kind": "campaign tension",
        "group": "Current Planar Tensions",
        "authority": "mortal cosmographic/religious account in current Appendix B; not objective cosmic proof",
        "evidence": [
          {
            "path": "books/player/Decennium_Descent_Player_Rulebook_v6.docx",
            "part": "word/document.xml",
            "paragraphIndexZeroBased": 10405,
            "excerpt": "The Shadow Ascendancy",
            "excerptSha256": "6bdfab5a95a5aa03dfe98b83985644c84774ec5a515c21c0e8662443ea9e16c9",
            "evidenceKind": "exact-source-paragraph"
          },
          {
            "path": "books/player/Decennium_Descent_Player_Rulebook_v6.docx",
            "part": "word/document.xml",
            "paragraphIndexZeroBased": 10407,
            "excerpt": "Something is stirring in the deepest regions of the Veiled Expanse, an ancient entity known only as the Void Sovereign is awakening after eons of dormancy. Its influence is spreading through the plane, corrupting even powerful shadow beings and threatening to extend into the Material Plane through shadow touchpoints.",
