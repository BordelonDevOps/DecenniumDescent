    "records": [
      {
        "id": "PC-01",
        "label": "Material Plane",
        "kind": "plane",
        "group": "Material",
        "authority": "mortal cosmographic/religious account in current Appendix B; not objective cosmic proof",
        "evidence": [
          {
            "path": "books/player/Decennium_Descent_Player_Rulebook_v6.docx",
            "part": "word/document.xml",
            "paragraphIndexZeroBased": 10115,
            "excerpt": "The Material Plane",
            "excerptSha256": "f305acd2ab3b26b773b138d1f6681562eb01008f2aff8fcc1431699acb7bd986",
            "evidenceKind": "exact-source-paragraph"
          },
          {
            "path": "books/player/Decennium_Descent_Player_Rulebook_v6.docx",
            "part": "word/document.xml",
            "paragraphIndexZeroBased": 10117,
            "excerpt": "At the center of the cosmology lies the Material Plane, the world of Aethel itself. This is the primary realm of mortal existence, where the influences of all other planes converge in balance. The Material Plane is the most physically \"real\" of all planes, with consistent natural laws and the clearest separation between past, present, and future.",
            "excerptSha256": "5b6a872b740ab98932adb943ee2a153adec4addc915f1aa07e0212b223c73408",
            "evidenceKind": "exact-source-paragraph"
          }
        ],
        "objectiveEquivalenceAdopted": false,
        "conferenceTreatment": "retain source claim at stated authority; no objective equivalence adopted unless explicitly sourced"
      },
      {
        "id": "PC-02",
        "label": "Ethereal Plane",
        "kind": "plane",
        "group": "Transitive",
        "authority": "mortal cosmographic/religious account in current Appendix B; not objective cosmic proof",
        "evidence": [
          {
            "path": "books/player/Decennium_Descent_Player_Rulebook_v6.docx",
            "part": "word/document.xml",
            "paragraphIndexZeroBased": 10131,
            "excerpt": "The Ethereal Plane",
            "excerptSha256": "c04c12728798ac6f4d45f8e92c2f78c9048f17992268e7882c7911313bc1b4fd",
            "evidenceKind": "exact-source-paragraph"
          },
          {
            "path": "books/player/Decennium_Descent_Player_Rulebook_v6.docx",
            "part": "word/document.xml",
            "paragraphIndexZeroBased": 10133,
            "excerpt": "The Ethereal Plane overlaps with the Material Plane completely but exists in a different phase of reality. From the Ethereal, the Material world appears ghostly and insubstantial, while solid objects on the Material Plane cannot normally interact with ethereal entities.",
            "excerptSha256": "df415bab986a8fbb5093fc982a78a3a54aa16a298e879e8f4a8846c49eee2669",
            "evidenceKind": "exact-source-paragraph"
          }
        ],
        "objectiveEquivalenceAdopted": false,
        "conferenceTreatment": "retain source claim at stated authority; no objective equivalence adopted unless explicitly sourced"
      },
      {
        "id": "PC-03",
        "label": "Astral Plane",
        "kind": "plane",
        "group": "Transitive",
        "authority": "mortal cosmographic/religious account in current Appendix B; not objective cosmic proof",
        "evidence": [
          {
            "path": "books/player/Decennium_Descent_Player_Rulebook_v6.docx",
            "part": "word/document.xml",
            "paragraphIndexZeroBased": 10143,
            "excerpt": "The Astral Plane",
            "excerptSha256": "05e4486a241e99600713de1bc26383a295b67a9dfcd0ed97fba9da1ea5278560",
            "evidenceKind": "exact-source-paragraph"
          },
          {
            "path": "books/player/Decennium_Descent_Player_Rulebook_v6.docx",
            "part": "word/document.xml",
            "paragraphIndexZeroBased": 10145,
            "excerpt": "The Astral Plane is a realm of thought and dream, a silver void where distance and time have little meaning. It serves as the medium through which souls travel after death and the pathway between the Material Plane and the Outer Planes.",
            "excerptSha256": "e6e358162a3607ec5f0fd25b5744b96ed6b30c0b5b29dfc4fb74c58db0b318fd",
            "evidenceKind": "exact-source-paragraph"
          }
        ],
        "objectiveEquivalenceAdopted": false,
        "conferenceTreatment": "retain source claim at stated authority; no objective equivalence adopted unless explicitly sourced"
      },
      {
        "id": "PC-04",
        "label": "Veiled Expanse",
        "kind": "plane",
        "group": "Transitive",
        "authority": "mortal cosmographic/religious account in current Appendix B; not objective cosmic proof",
        "evidence": [
          {
            "path": "books/player/Decennium_Descent_Player_Rulebook_v6.docx",
            "part": "word/document.xml",
            "paragraphIndexZeroBased": 10155,
            "excerpt": "The Veiled Expanse",
            "excerptSha256": "12f6bb6573fe96828e74a5eb5753ceb2f98e0d002950c57aa18de194fe2a5193",
            "evidenceKind": "exact-source-paragraph"
          },
          {
            "path": "books/player/Decennium_Descent_Player_Rulebook_v6.docx",
            "part": "word/document.xml",
            "paragraphIndexZeroBased": 10157,
            "excerpt": "The Veiled Expanse is a darkened reflection of the Material Plane, where light, emotion, and life itself are muted. It overlaps with the Material Plane in places where death, despair, or darkness hold sway, graveyards, battlefields, abandoned ruins, and places of great tragedy.",
            "excerptSha256": "e74f2a09f7c3e2001f3d2fe921e89a92e4bcb3a8604be5a45645bffce447db46",
            "evidenceKind": "exact-source-paragraph"
