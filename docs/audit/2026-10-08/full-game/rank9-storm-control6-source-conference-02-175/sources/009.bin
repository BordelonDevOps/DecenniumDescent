      "registryPointer": "/entries/7",
      "completeEntryUnchanged": {
        "id": "docs/mechanics/CORE_RESOLUTION_PLAYTEST.md#rolls",
        "name": "Attack/save/task procedures",
        "acceptanceStatus": "current-authoritative-provisional-interface",
        "acceptanceBasis": {
