        "operationPrerequisites": [
          "Actual legal access/repertoire, current source and target state, components, range/line, time and resources under the stated finite procedure; these are use-time facts, not missing source-conference questions."
        ],
        "authoredBoundary": {
          "kind": "Authored expectation, not executed runtime or campaign authentication",
          "wording": "A rank-2 payload with base 3 RP and a lawful +1 strain surcharge replays for 1 RP, not zero. The separate Echo Cast arming price remains spent and cannot itself be the copied payload."
        },
        "newDecisionNotice": "Every concrete target bound, resistance, unsupported metadata replacement, mode, action/clock/lifecycle detail and numerical default not printed in the preserved original is NEW source-authoring direction, never a claim that it was printed. Explicit retained clauses and LR-G KEEP rules are not rewritten.",
        "reviewEvidence": {
          "sourceReviewId": "LR-SOURCE-2026-10-11",
          "exactCandidateApproval": true,
          "catalogPromotionAuthorized": true,
          "runtimeVerified": false,
          "humanPlaytested": false,
          "exactReviewId": "LRX-EXACT-2026-10-11",
