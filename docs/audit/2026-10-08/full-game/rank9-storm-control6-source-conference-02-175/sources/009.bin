  "questions": [
    {
      "id": "R8IT4-CASTING-01",
      "spellIds": [
        "alignment-revelation-mass",
        "moment-of-prescience",
        "telepathy",
        "time-echo"
      ],
      "exactSourceOrConflict": "All four Core records use Action/V,S,F/Instantaneous with actual rank8/base21RP/minimum class level15. Moment says Gain and Time Echo says You; Core120ft does not independently authorize transferring a self benefit.",
      "options": [
        "Retain every actual class/school and supply explicit finite pending records or communication duration where needed.",
        "Keep unresolved recipient/clock semantics blocked until separate source direction."
      ],
      "recommendationAndConsequences": "Recommend first with explicit NEW decisions. Cleric/Wizard Divination for alignment and prescience; Cleric/Mage/Wizard Universal for telepathy and Time Echo. Ordinary acquisition, costs, strain, casting and Ready rules remain real. No ambient ability to change time, moral facts, cosmology or another source’s resource ledger.",
      "decisionSelected": false
    },
    {
      "id": "R8IT4-ALIGN-AREA-02",
      "spellIds": [
        "alignment-revelation-mass"
      ],
      "exactSourceOrConflict": "Native ALL CREATURES in30ft radius reveal true alignment; Core range30ft/Instantaneous. Current single-target revelation uses CHA save and two public axis sigils.",
      "options": [
        "Fixed30ft-radius sphere centered at a perceived point within30ft; each actual creature with centerLoE independently savesCHA.",
        "Self-centered sphere with automatic revelation and no save."
      ],
      "recommendationAndConsequences": "Recommend first as explicit NEW extension of the existing reader, retaining all creatures including allies/self and hidden audience. No selective omission or no-save upgrade merely from rank. No individually perceived-target requirement is inherited into an area snapshot. Identify geometry/body inclusion and total-cover exclusions without disclosing hidden immunity or source records.",
      "decisionSelected": false
    },
    {
      "id": "R8IT4-ALIGN-TRUTH-03",
      "spellIds": [
        "alignment-revelation-mass"
      ],
      "exactSourceOrConflict": "True alignment must use actual mechanical axes, not inferred belief. Accepted Lock/Anchor and information protections have exact scopes; rank8 Mind Blank/Alignment Immunity remain pending.",
      "options": [
        "Use the actual current effective Lawful/Neutral/Chaotic and Good/Neutral/Evil fields, applying only exact source masking/protection.",
        "Pierce every temporary effect and protection to reveal original alignment."
      ],
      "recommendationAndConsequences": "Recommend first, with each undefined/protected axis Indeterminate as in the accepted source. Preserve exact order for temporary effective alignment versus base alignment and explicitly select any change to the single-target rule. Do not invent missing axes, cleanse a source, equate social standing with alignment or infer creature moral history. Pending wards are questions/comparisons, not already accepted blanket immunity.",
      "decisionSelected": false
    },
    {
      "id": "R8IT4-ALIGN-DISCLOSURE-04",
      "spellIds": [
        "alignment-revelation-mass"
      ],
      "exactSourceOrConflict": "Public reveal could otherwise expose hidden bodies or force communication. Existing sigils require actual observer ability to see the target and do not emit useful light.",
      "options": [
        "Same brief public two-sigil display per actually revealed creature, read only by observers who actually perceive that body.",
        "Private caster-only roster with alignment/location pairs."
      ],
      "recommendationAndConsequences": "Recommend first to preserve force-to-reveal and avoid a hidden-target oracle. No forced confession, speech, oath breach, faction penalty or changed alignment. Blindness, actual opaque cover and invisible/hidden body remain real; perceived sigils confer no new name or location. Knowledge legitimately observed persists after the instantaneous display, while no automatic camera/log is granted.",
      "decisionSelected": false
    },
    {
      "id": "R8IT4-PRESCIENCE-RECIPIENT-05",
      "spellIds": [
        "moment-of-prescience"
      ],
      "exactSourceOrConflict": "GAIN tremendous insight+10 toONE ROLL; Core range120ft/Instantaneous. No recipient or lifetime beyond the implied pending roll is supplied.",
      "options": [
        "Self-only benefit for one hour or until consumed; nonconcentration, one live pending use per recipient.",
        "One willing perceived creature within120ft, concentration1minute."
      ],
      "recommendationAndConsequences": "Recommend first to retain Gain as self wording; preserve120ft as unresolved source metadata, not silently erased. GPT must select the actual finite window and replacement policy. New paid casting cannot restore a consumed previous source, stack several+10s, transfer the use or supply hidden information.",
      "decisionSelected": false
    },
    {
      "id": "R8IT4-PRESCIENCE-ROLL-06",
      "spellIds": [
        "moment-of-prescience"
      ],
      "exactSourceOrConflict": "ONE ROLL is broad; Guidance is explicitly only one ability check and is not authority to shrink this source. Core has attack,save,task,opposed,initiative and damage categories.",
      "options": [
        "One actual d20 attack/save/ability/opposed/initiative roll, explicitly excluding damage and random tables as NEW boundary.",
        "Any one legitimate numeric roll event including damage, with complete pool/recipient semantics."
      ],
      "recommendationAndConsequences": "Recommend first but require explicit source-fidelity decision rather than quietly substituting Guidance. Keep the full+10. If damage is admitted, define shared area pool versus one recipient, mixed types, critical dice and downstream modifiers completely. Do not grant a roll to an impossible action, make a passive score a roll, or use the modifier as an unidentified random-table selector.",
      "decisionSelected": false
    },
    {
      "id": "R8IT4-PRESCIENCE-CONSUME-07",
      "spellIds": [
        "moment-of-prescience"
      ],
      "exactSourceOrConflict": "No declaration window, reroll lifetime or stacking family supplied.",
      "options": [
        "Consume before the chosen roll is generated; apply+10 once to the final selected die result of that one roll event.",
        "Declare after seeing dice but before outcome, requiring exact hidden/public information window."
      ],
      "recommendationAndConsequences": "Recommend first NEW window. Advantage/disadvantage is one roll event with multiple candidate dice, not multiple uses. Preserve the same event across source-authorized rerolls/replacements, applying+10 once and no second consumption; a fresh distinct roll needs a fresh benefit. Natural attack1/20 and task degree shifts retain their actual rules; +10 is not automatic success. Same-name benefits do not stack; other sources apply only their actual comparison rules. Suppression disallows use without stopping the original clock.",
      "decisionSelected": false
    },
    {
      "id": "R8IT4-TELEPATHY-CHANNEL-08",
      "spellIds": [
        "telepathy"
      ],
      "exactSourceOrConflict": "Communicate telepathically with ANY CREATURE;120ft/Instantaneous. Native Message is one brief one-way audible whisper without reply or comprehension.",
      "options": [
        "One selected perceived creature within120ft/LoE, two-way voluntary mental channel, concentration60seconds.",
        "One instantaneous mental message and optional immediate reply only."
      ],
      "recommendationAndConsequences": "Recommend first NEW communication window, but do not import a same-plane unlimited bond. Any creature type can be selected subject to actual mental-communication defenses; names such as Construct/Undead alone grant no immunity. State whether recipient assent is needed to establish versus whether it can ignore and decline every reply. No exchange creates command authority, spell V, hearing, location sensing or mind reading.",
      "decisionSelected": false
    },
    {
      "id": "R8IT4-TELEPATHY-COMPREHENSION-09",
      "spellIds": [
        "telepathy"
      ],
      "exactSourceOrConflict": "Any-creature promise may include language-less or low-cognition creatures; no shared-language requirement, mind-reading or cognitive upgrade is printed.",
      "options": [
        "Convey chosen concepts/imagery in a form each actual mind can comprehend, with no new knowledge or intelligence.",
        "Words only, requiring a shared known language."
      ],
      "recommendationAndConsequences": "Recommend first if GPT agrees it preserves the broad promise. Specify what happens with a genuinely absent or unconscious receptive mind without inventing a response or granting universal immunity. A simple animal may convey only its actual impressions/needs; no numerical Intelligence cutoff is imported. Unconsciousness does not wake by default; sleeping dream access needs explicit permission. No hidden memory can be pulled out, unwilling reply compelled, or lie identified automatically.",
      "decisionSelected": false
    },
    {
      "id": "R8IT4-TELEPATHY-RANGE-10",
      "spellIds": [
        "telepathy"
      ],
      "exactSourceOrConflict": "Initial120ft does not settle later distance, walls, plane changes, suppression or secrecy.",
      "options": [
        "Maintain120ft and actual mental communication path/LoE; loss suspends exchange while original clock continues.",
        "Initial range only, with a separately authored finite long-distance extent."
      ],
      "recommendationAndConsequences": "Recommend first bounded NEW channel. Define whether a physical opaque barrier blocks this mental source or only establishment; do not copy audible Message mechanics automatically. Ordinary Silence/Deafened does not itself block a genuinely mental channel. Actual communication/mental protection does. No delayed message queue after resumption, no magic authentication or guaranteed privacy against an actually authorized interceptor. Death, removal, concentration or expiry ends it.",
      "decisionSelected": false
    },
    {
      "id": "R8IT4-ECHO-HISTORY-11",
      "spellIds": [
        "time-echo"
      ],
      "exactSourceOrConflict": "YOU AND1ALLY repeat FULL LAST ROUND OF ACTIONS;120ft/Instantaneous. The relevant historical round and classification of Actions/BA/Reaction/movement are absent.",
      "options": [
        "Select caster and one willing perceived allied creature; replay each actor’s complete logged sequence from the immediately preceding completed numbered round.",
        "Replay only each actor’s last regular turn."
      ],
      "recommendationAndConsequences": "Recommend first to preserve full ROUND rather than silently narrow to one attack or turn. Explicitly include or exclude all real fullActions,BonusActions,Reactions,movement,extra-turn actions and command events from that interval. Snapshot immutable event order, original source/mode/choices, actual provider and lineage at Time Echo preparation if readied. Missing history is missing evidence, not a fabricated idle/successful round. Define outside-initiative equivalent six-second interval without resetting schedules.",
      "decisionSelected": false
    },
    {
      "id": "R8IT4-ECHO-BUDGETS-12",
      "spellIds": [
        "time-echo"
      ],
      "exactSourceOrConflict": "A complete full-round repeat exceeds ordinary one-extra-full-Action slot and may require BA/Reaction/movement which have already been spent. No precise exception is supplied.",
      "options": [
        "An explicit finite replay phase per recipient with exactly the historical event entitlements and no discretionary replacement actions.",
        "Consume only currently remaining normal budgets, skipping every repeat that lacks them."
      ],
      "recommendationAndConsequences": "Recommend first only as NEW source-specific exception needed to honor the full repeat; GPT must choose exact timing and interaction with the accepted extraAction cap rather than hide the conflict. Preserve every eligible historical event, with no fresh full turn/START/END/deathsave/recharge. Specify order between the two recipients and real reaction windows for outsiders. An invalid former event consumes only its own replay opportunity, not an invented replacement. Additional optional action-grant events and copy chains require separate lineage exclusion, not truncation of the whole ordinary sequence.",
      "decisionSelected": false
    },
    {
      "id": "R8IT4-ECHO-RESOURCES-13",
      "spellIds": [
        "time-echo"
      ],
      "exactSourceOrConflict": "Repeat can mean new attempts, historical outcome duplication, or rewind. Actual resource/material consumption and concentration already exist.",
      "options": [
        "Fresh source-qualified attempts paid from current resources, no restoration of old payments or outcomes.",
        "Repeat results without paying again or rerolling."
      ],
      "recommendationAndConsequences": "Recommend first as NEW full transaction rules, retaining every actual source component, independent use, cooldown,RP/strain and equipment predicate. Do not copy old damage/heal outcomes, reinsert consumed items, revive dead actors, undo position/history or refill charges. Resolve each new cast’s current price and concentration in real chronological order; no blanket resource waiver is printed. A now-unaffordable event fails its opportunity without negative resource balance or restoration of earlier spent costs. Previous costs remain historical, not paid twice for the same eventID.",
      "decisionSelected": false
    },
    {
      "id": "R8IT4-ECHO-CHOICES-14",
      "spellIds": [
        "time-echo"
      ],
      "exactSourceOrConflict": "Whether original choices, targets, paths and RNG are fixed is unspecified; current world state may make them impossible.",
      "options": [
        "Repeat the original selected action/mode with fresh legal targets but no substituted source or extra amount of movement.",
        "Keep all original targets and exact paths, skipping impossible events."
      ],
      "recommendationAndConsequences": "Recommend first to make full repetition usable without old-world restoration, requiring explicit bounds on target/mode/path choices. Paths start from actual present position and use genuine current locomotion/geometry; retain a finite historical movement entitlement rather than teleporting to recorded coordinates. Roll fresh permitted outcomes. Dead/missing targets, invalid geometry and changed consent remain real; do not silently grant another action for a failed source. A Reaction replay must either satisfy its real trigger or receive a precisely stated NEW echo exception; old triggers are not present facts.",
      "decisionSelected": false
    },
    {
      "id": "R8IT4-ECHO-LINEAGE-15",
      "spellIds": [
        "time-echo"
      ],
      "exactSourceOrConflict": "Copies/echoes/action grants and resulting caster hooks can recursively replay Time Echo or replenish grants/resources.",
      "options": [
        "Exclude Time Echo and all replay/copy-descended or further-action-access events from eligible history; preserve ordinary intrinsic finite outcomes and actual necessary payment.",
        "Allow all events with only a per-cast iteration cap."
      ],
      "recommendationAndConsequences": "Recommend first finite lineage gate with exact treatment of Echo Cast,Fate Echo,featcopy,Mirrorsage release and child spells. Do not simply describe every summon or healing spell as forbidden because it could support a later independent act; use exact current no-copy predicates. A repeated owner command cannot manufacture another companion phase/offense use. Decide optional resource-refund/cast-proc/on-hit hooks explicitly under existing no-duplicate-copy rules; no generic exception may reset hard-control or source-wide capacity. Keep live and historical eventIDs distinct and save/load idempotent.",
      "decisionSelected": false
    },
    {
      "id": "R8IT4-ECHO-SOURCE-16",
      "spellIds": [
        "time-echo"
      ],
      "exactSourceOrConflict": "An echoing actor may use multiple actual class routes, granted actions or persistent manifestations. Source ownership/stats/Null roots cannot be copied blindly from a past result.",
      "options": [
        "The real recipient performs each new attempt through the same actual acquired source route using current body/stats and owns its result.",
        "Time Echo caster becomes the provider of every recipient action."
      ],
      "recommendationAndConsequences": "Recommend first. Retain actual recipient provider, school/rank/action restrictions and independently owned resources; original historical knowledge does not acquire a lost grant. New damage roots follow actual action/cast provenance with current eligible Null state; descendants retain the created flags. Existing summons/effects remain the same identities unless a new lawful cast creates/replaces one under its limits. Full source-ended concentration and child lifecycle transitions remain real.",
      "decisionSelected": false
    },
    {
      "id": "R8IT4-ECHO-INTERRUPTION-17",
      "spellIds": [
        "time-echo"
      ],
      "exactSourceOrConflict": "Instantaneous outer spell may authorize a multi-event replay phase; death,incapacity,countering,suppression and initiative changes can intervene.",
      "options": [
        "One queued finite sequence per accepted actor after outer resolution, each event revalidated; terminal cancellation consumes remaining entitlement.",
        "A persistent hour-long permission to replay at leisure."
      ],
      "recommendationAndConsequences": "Recommend first with explicit phase/deadline and no new regular turn. Countering outer prevents all sequences after retaining actual outer costs; countering an actual child cast preserves earlier completed events and current child payments. Hard control, lost body, death, absent required phase and interrupted movement constrain later events without rewinding prior effects. Define whether instantaneous granted sequence can be dispelled/suppressed, rather than assuming a continuing spell. Save/load cannot resume already consumed events twice.",
      "decisionSelected": false
    }
  ],
