      "textSha256": "1f5d64b92820f8238635b90ae69a38c12661a7b03c6d0d7f689711f12af7b7f9"
    },
    {
      "path": "books/player/Decennium_Descent_Core_Systems_Bible_v2_Known_Descent.docx",
      "part": "word/document.xml",
      "paragraphIndexZeroBased": 8429,
      "text": "Free",
      "textSha256": "f411a1fb62758b4c54690d0a702b4955b54dd22115416fa7b1ce51b4a084818d"
    },
    {
      "path": "books/player/Decennium_Descent_Core_Systems_Bible_v2_Known_Descent.docx",
      "part": "word/document.xml",
      "paragraphIndexZeroBased": 8430,
      "text": "May leave employment subject only to ordinary contract.",
      "textSha256": "464fa2c67056fdaf12ad03720bfb0a7a954c325c80133ef98e46333d079d5809"
    },
    {
      "path": "books/player/Decennium_Descent_Core_Systems_Bible_v2_Known_Descent.docx",
      "part": "word/document.xml",
      "paragraphIndexZeroBased": 8431,
      "text": "Contract-bound",
      "textSha256": "0ba26ca32fc100607ba03617792031568349f50d5fc249c679ce4a5c1452898a"
    },
    {
      "path": "books/player/Decennium_Descent_Core_Systems_Bible_v2_Known_Descent.docx",
      "part": "word/document.xml",
      "paragraphIndexZeroBased": 8432,
      "text": "Owes a defined term or task; receives agreed compensation.",
      "textSha256": "076944d935876e2b5ec3f8de6e68e4fc29b7e784850b45417138dd95866368cd"
    },
    {
      "path": "books/player/Decennium_Descent_Core_Systems_Bible_v2_Known_Descent.docx",
      "part": "word/document.xml",
      "paragraphIndexZeroBased": 8433,
      "text": "Debt-bound",
      "textSha256": "60fc21bb0a4f57eef5af761d285b63fbb0298d1e72112e8250225600f562fd5a"
    },
    {
      "path": "books/player/Decennium_Descent_Core_Systems_Bible_v2_Known_Descent.docx",
      "part": "word/document.xml",
      "paragraphIndexZeroBased": 8434,
      "text": "Labor secures a debt; abuse and indefinite terms are common.",
      "textSha256": "230051af8b877c71cc14a1c41943fa56bca8b09527ca45c1bc79002beb8a8427"
    },
    {
      "path": "books/player/Decennium_Descent_Core_Systems_Bible_v2_Known_Descent.docx",
      "part": "word/document.xml",
      "paragraphIndexZeroBased": 8435,
      "text": "Penal",
      "textSha256": "e2184b4fd384b7ba7d68c6676b5ec94ec8f3f173dbcf9293d55ca4cf5d54ecf5"
    },
    {
      "path": "books/player/Decennium_Descent_Core_Systems_Bible_v2_Known_Descent.docx",
      "part": "word/document.xml",
      "paragraphIndexZeroBased": 8436,
      "text": "State or faction compels labor as punishment.",
      "textSha256": "6097cf31aaca1d1afdc0c502a77c22a1271f7ddf4fe44754b79f68ac5952c2e6"
    },
    {
      "path": "books/player/Decennium_Descent_Core_Systems_Bible_v2_Known_Descent.docx",
      "part": "word/document.xml",
      "paragraphIndexZeroBased": 8437,
      "text": "Enslaved",
      "textSha256": "a193f10fbdd780e692bb85aec4f994aa6b4a2afd5b724344779130bd1edc6941"
    },
