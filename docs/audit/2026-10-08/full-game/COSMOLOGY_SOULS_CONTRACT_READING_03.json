      "paragraphIndexZeroBased": 8954,
      "text": "Recovery",
      "textSha256": "48f6a8d5688b0cf59fb8109b7903507ed9d2e1580be2ad7ae169df659e1ddeea"
    },
    {
      "path": "books/player/Decennium_Descent_Core_Systems_Bible_v2_Known_Descent.docx",
      "part": "word/document.xml",
      "paragraphIndexZeroBased": 8955,
      "text": "1",
      "textSha256": "6b86b273ff34fce19d6b804eff5a3f5747ada4eaa22f1d49c01e52ddb7875b4b"
    },
    {
      "path": "books/player/Decennium_Descent_Core_Systems_Bible_v2_Known_Descent.docx",
      "part": "word/document.xml",
      "paragraphIndexZeroBased": 8956,
      "text": "Extract a named artifact intact; payment falls 20% per damaged condition.",
      "textSha256": "ebf0e053821249135a2ad2fb7210117f29b09327aac0488ddf9ac1dbc789475c"
    },
