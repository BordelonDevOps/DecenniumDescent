      "part": "word/document.xml",
      "paragraphIndexZeroBased": 8438,
      "text": "Treated as property and denied lawful exit.",
      "textSha256": "f87b9a0c9a2235d4df0ef5c3e5623d03887dc8783e374e4313e3d8b3f33d4d71"
    },
    {
      "path": "books/player/Decennium_Descent_Core_Systems_Bible_v2_Known_Descent.docx",
      "part": "word/document.xml",
      "paragraphIndexZeroBased": 8439,
      "text": "Liberated",
      "textSha256": "c7da421f4e19cd88055e0816333c621cf91348270bde1e09a850552d02833a3c"
    },
    {
      "path": "books/player/Decennium_Descent_Core_Systems_Bible_v2_Known_Descent.docx",
      "part": "word/document.xml",
      "paragraphIndexZeroBased": 8440,
      "text": "Recently freed; may carry claims, trauma, enemies, or bounty rights.",
