  "docxPassages": [
    {
      "path": "docs/manuals/The_Directors_Crucible_Complete_Director_Edition.docx",
      "part": "word/document.xml",
      "paragraphIndexZeroBased": 1726,
      "text": "Rescued survivor",
      "textSha256": "1d16b623887c4194a7a2de197ec00f987a9132006af1cafce7ca90d309ba8250"
    },
    {
      "path": "docs/manuals/The_Directors_Crucible_Complete_Director_Edition.docx",
      "part": "word/document.xml",
      "paragraphIndexZeroBased": 1727,
      "text": "Useful in a deep floor; begins with a debt and incomplete information",
      "textSha256": "1beb3bd20510ec5298bc2b530d8a57cd1c486227a8b612db8ce92f7ab69938e7"
    },
    {
      "path": "docs/manuals/The_Directors_Crucible_Complete_Director_Edition.docx",
      "part": "word/document.xml",
      "paragraphIndexZeroBased": 1728,
      "text": "Rival defector",
      "textSha256": "09e28c1ef801039716565558f102739d8950be41ff26c7e6efb20a8ff67f2730"
    },
    {
      "path": "docs/manuals/The_Directors_Crucible_Complete_Director_Edition.docx",
      "part": "word/document.xml",
      "paragraphIndexZeroBased": 1729,
      "text": "Creates trust questions and immediate leverage",
      "textSha256": "552c59fa703b75ac3223d399d7123af89661d52fa8cd851aae7b7cfe60dc81f6"
    },
    {
      "path": "docs/manuals/The_Directors_Crucible_Complete_Director_Edition.docx",
      "part": "word/document.xml",
      "paragraphIndexZeroBased": 1730,
      "text": "Surface replacement",
      "textSha256": "6e74879db9b1d1ad3837638ec3fe4a33a1214c089df4580b58612841b4c0e167"
    },
    {
      "path": "docs/manuals/The_Directors_Crucible_Complete_Director_Edition.docx",
      "part": "word/document.xml",
      "paragraphIndexZeroBased": 1731,
      "text": "Appropriate after extraction or when a route allows reinforcement",
      "textSha256": "a29b08e9824465a37ba77e261428a4aa789a647d7c08f739caed3d5855229e82"
    },
    {
      "path": "docs/manuals/The_Directors_Crucible_Complete_Director_Edition.docx",
      "part": "word/document.xml",
      "paragraphIndexZeroBased": 1732,
      "text": "Trapped descendant or native",
      "textSha256": "3b18a18ac25c401a8b41964b2bcb94cfcd4ce62f244f0557c47992f1be421819"
    },
    {
      "path": "docs/manuals/The_Directors_Crucible_Complete_Director_Edition.docx",
      "part": "word/document.xml",
      "paragraphIndexZeroBased": 1733,
      "text": "Best for Tier 6 or multi-Cycle play; requires cultural grounding",
      "textSha256": "6690d69d07fa0e663707f0f12dd891d56b78b913a1d1f2d54ac00af027f9df69"
    },
    {
      "path": "docs/manuals/The_Directors_Crucible_Complete_Director_Edition.docx",
      "part": "word/document.xml",
      "paragraphIndexZeroBased": 1734,
      "text": "",
      "textSha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
    },
    {
      "path": "docs/manuals/The_Directors_Crucible_Complete_Director_Edition.docx",
      "part": "word/document.xml",
      "paragraphIndexZeroBased": 1735,
      "text": "The Body as a Campaign Object",
      "textSha256": "b9dff7e430e6adaacc130575cc22ffd0cc8d0cad7f2013a307c075e1b5255a40"
    },
    {
      "path": "docs/manuals/The_Directors_Crucible_Complete_Director_Edition.docx",
      "part": "word/document.xml",
      "paragraphIndexZeroBased": 1736,
      "text": "Recovery may matter because of religion, family, evidence, inheritance, resurrection methods, or what dungeon-touched equipment remains attached. Do not force every group into body-recovery play. Ask at Session Zero how the table treats remains, funerals, and the possibility of undeath. When recovery is chosen, make the objective meaningful but not grotesquely punitive.",
      "textSha256": "fdbc6685303463d987ab87d217dcba06735867804008f0b59e2a51bec5e18edb"
    },
    {
      "path": "docs/manuals/The_Directors_Crucible_Complete_Director_Edition.docx",
      "part": "word/document.xml",
      "paragraphIndexZeroBased": 1737,
      "text": "Near-Death Without Cheapening Death",
      "textSha256": "1c351296696f0a32ea556ffd51b4bd6d7ece906db9fc1bee7aea489aa86f6141"
    },
    {
      "path": "docs/manuals/The_Directors_Crucible_Complete_Director_Edition.docx",
      "part": "word/document.xml",
      "paragraphIndexZeroBased": 1738,
      "text": "Capture, scarring, lost equipment, oath-bound release, and separation can replace death when they arise credibly from enemy motives. They should not be used secretly to guarantee survival. Players need to believe the rules and choices can kill characters, even when not every defeat does.",
      "textSha256": "f100d2e1cb6d7ea6ee604e5e17f6d14c5f7738f52fe78b37926f19ec30a7c6e1"
    },
    {
      "path": "docs/manuals/The_Directors_Crucible_Complete_Director_Edition.docx",
      "part": "word/document.xml",
      "paragraphIndexZeroBased": 1739,
      "text": "Chapter 42 — Surface Politics, War, and the Divine Pact",
      "textSha256": "b9858382623e9ffbbfeba8809d32c2275ff805e0c97c3347a2d57a4939abf584"
    },
    {
      "path": "docs/manuals/The_Directors_Crucible_Complete_Director_Edition.docx",
      "part": "word/document.xml",
      "paragraphIndexZeroBased": 1740,
      "text": "The surface exists to receive what the dungeon sends back: wealth, survivors, stories, weapons, panic, and arguments about what the Opening means. Politics should not be a pause from the descent. It is the second half of the bait cycle.",
      "textSha256": "3f65e2e1755f524d885d855e78d68dae768e9e101b0fd7bd497f5656ad582d73"
    },
    {
      "path": "docs/manuals/The_Directors_Crucible_Complete_Director_Edition.docx",
      "part": "word/document.xml",
      "paragraphIndexZeroBased": 1793,
      "text": "Chapter 45 — Directing Advanced and Deep-Tier Expeditions",
      "textSha256": "57a579e43908a4dc8c31530404805ecb9e1bbe49ca55624cd70833082e796237"
    },
    {
      "path": "docs/manuals/The_Directors_Crucible_Complete_Director_Edition.docx",
      "part": "word/document.xml",
      "paragraphIndexZeroBased": 1794,
      "text": "High-level characters possess broad movement, strong defenses, rapid information tools, and combinations that can bypass ordinary obstacles. Do not respond by making every door immune, every enemy omniscient, or every clue magically unreadable. Deep play challenges priorities, scale, and consequences rather than merely increasing numbers.",
      "textSha256": "d8f437a4a3cf4eb2b15c3a40ebba16a86c2a69ff53d19e3cbf001d55aba0c1f8"
    },
    {
      "path": "docs/manuals/The_Directors_Crucible_Complete_Director_Edition.docx",
      "part": "word/document.xml",
      "paragraphIndexZeroBased": 1795,
      "text": "Design for Capabilities",
      "textSha256": "065f0c3b790e7c99423d2d8d0b31bb7705aeca757e1dd4ba22d867fb12d35fda"
    },
    {
      "path": "docs/manuals/The_Directors_Crucible_Complete_Director_Edition.docx",
      "part": "word/document.xml",
      "paragraphIndexZeroBased": 1796,
      "text": "Teleportation and flight. Make destination knowledge, moving geometry, cargo, separated teams, and consequences of bypass matter. Let movement abilities remain powerful.",
      "textSha256": "5a640cb05cad0ed9ceace102be70b295b652fd81dfaa989eca8f832cb48d87d4"
    },
    {
      "path": "docs/manuals/The_Directors_Crucible_Complete_Director_Edition.docx",
      "part": "word/document.xml",
      "paragraphIndexZeroBased": 1797,
      "text": "Divination. Answer honestly within the spell or feature’s scope. The challenge can be interpretation, competing futures, protected offices, or what acting on the answer changes.",
      "textSha256": "ee4d2796a0422499b69f6ac1ff8918566d0afad9443c1b90888c4ba5a427434a"
    },
    {
      "path": "docs/manuals/The_Directors_Crucible_Complete_Director_Edition.docx",
      "part": "word/document.xml",
      "paragraphIndexZeroBased": 1798,
      "text": "Resurrection and death prevention. Use access, time, body recovery, faction law, and what returns with the character as story questions. Do not arbitrarily switch abilities off.",
      "textSha256": "22eea048b3c5fafd5c41a2566d8db71714e7267abbe1a3d46dcbd0c50c23072c"
    },
    {
      "path": "docs/manuals/The_Directors_Crucible_Complete_Director_Edition.docx",
      "part": "word/document.xml",
      "paragraphIndexZeroBased": 1799,
      "text": "Mass damage. Use objectives, dispersed threats, moral and structural consequences, and enemies who value survival. Do not inflate every minor creature’s HP.",
      "textSha256": "49d83166490b1ace079aa0396c3660054bac9bf6c77ffb968f04b5057914c87f"
    },
    {
      "path": "docs/manuals/The_Directors_Crucible_Complete_Director_Edition.docx",
      "part": "word/document.xml",
      "paragraphIndexZeroBased": 1800,
      "text": "Social dominance. Powerful reputations attract formal obligations, rivals, scrutiny, and requests proportional to the Expedition’s status.",
      "textSha256": "ea7413d41f4a06890b420eb37c97fc14909b4816d723d46ecae94642392615ae"
    },
    {
      "path": "docs/manuals/The_Directors_Crucible_Complete_Director_Edition.docx",
      "part": "word/document.xml",
      "paragraphIndexZeroBased": 2362,
      "text": "Chapter 64 — Tier 7 Operations: Pactbound Arena",
      "textSha256": "d9b8f43aeaece9ca60feb77d528c9d02b477d00886572d2ea80dd91f3460a70b"
    },
    {
      "path": "docs/manuals/The_Directors_Crucible_Complete_Director_Edition.docx",
      "part": "word/document.xml",
      "paragraphIndexZeroBased": 2363,
      "text": "Director Purpose",
      "textSha256": "e1abb410e801ef11c54bda88c2d8b6feff62cd11646cd31b9af4e49e6c08ac1b"
    },
    {
      "path": "docs/manuals/The_Directors_Crucible_Complete_Director_Edition.docx",
      "part": "word/document.xml",
      "paragraphIndexZeroBased": 2364,
      "text": "Tier 7 turns exact words, public promises, and chosen obligations into terrain. The Arena is not merely a sequence of gladiatorial fights. It is a jurisdiction where conflict becomes contract and spectatorship gives force to claims.",
      "textSha256": "55d8464afc24e9e894fa57627b69ebd1e0013ab1c2d9b75b33b377441adf0ebf"
    },
    {
      "path": "docs/manuals/The_Directors_Crucible_Complete_Director_Edition.docx",
      "part": "word/document.xml",
      "paragraphIndexZeroBased": 2365,
      "text": "Core Pressures",
      "textSha256": "744ef45c7d2558b5d98bb3f7eb135a74a69fbd1b3962acad39b1fab77dba59a6"
    },
    {
      "path": "docs/manuals/The_Directors_Crucible_Complete_Director_Edition.docx",
      "part": "word/document.xml",
      "paragraphIndexZeroBased": 2366,
      "text": "Oath accumulation. Every promise can become leverage, restriction, protection, or fuel.",
      "textSha256": "82c19b24018789c3ddb0fd6d91cf033d33adaa0e83a2270dc7ad5052aed84cd5"
    },
    {
      "path": "docs/manuals/The_Directors_Crucible_Complete_Director_Edition.docx",
      "part": "word/document.xml",
      "paragraphIndexZeroBased": 2367,
      "text": "Audience. Unseen or remembered witnesses may validate terms and punish private reinterpretation.",
      "textSha256": "8767e687166d5d2ca6e2b76e437701caa33e376498248aad59fae109e2c0f4a4"
    },
    {
      "path": "docs/manuals/The_Directors_Crucible_Complete_Director_Edition.docx",
      "part": "word/document.xml",
      "paragraphIndexZeroBased": 2368,
      "text": "Escalating stakes. Victories attract stronger challengers, broader claims, and more valuable offers.",
      "textSha256": "ecbab756cb7803dfbdfd0b68fac5ca14d27851d3d74cf4abca8068c0aa96ad42"
    },
    {
      "path": "docs/manuals/The_Directors_Crucible_Complete_Director_Edition.docx",
      "part": "word/document.xml",
      "paragraphIndexZeroBased": 2369,
      "text": "Identity as office. Titles, team roles, reputations, and inherited obligations may matter more than personal names.",
      "textSha256": "1e73c2e6b090fd2d03178ef72212853dc0a3bdb987c2e0a4573eb47533dac161"
    },
    {
      "path": "docs/manuals/The_Directors_Crucible_Complete_Director_Edition.docx",
      "part": "word/document.xml",
      "paragraphIndexZeroBased": 2370,
      "text": "Running Bargains",
      "textSha256": "9634438da03ec06eb40aa6adbc6dd3cc08b10197da4b423fe03765e18b34e66d"
    },
    {
      "path": "docs/manuals/The_Directors_Crucible_Complete_Director_Edition.docx",
      "part": "word/document.xml",
      "paragraphIndexZeroBased": 2371,
      "text": "Write important terms down. State what each side believes the wording means and what mechanism or witness enforces it. Allow players to exploit language when they earned the interpretation, but give intelligent NPCs the same opportunity. Do not spring clauses that no character could perceive or understand.",
      "textSha256": "52d59658924027d37afe70dbc22724a5eed586628de5a0f69b0b622b605033d2"
    },
    {
      "path": "docs/manuals/The_Directors_Crucible_Complete_Director_Edition.docx",
      "part": "word/document.xml",
      "paragraphIndexZeroBased": 2372,
      "text": "Arena Encounters",
      "textSha256": "dea048289c7cff50c8b0a65c5222f7b4128d0e3e941a22d0b93d738e8cf5ef61"
    },
    {
      "path": "docs/manuals/The_Directors_Crucible_Complete_Director_Edition.docx",
      "part": "word/document.xml",
      "paragraphIndexZeroBased": 2373,
      "text": "Each encounter should contain a contest and a term. The contest may be combat, endurance, testimony, rescue, or public refusal. The term determines what the winner can claim. A party can win the fight and lose the legal result if it ignored the stated objective.",
      "textSha256": "781851fa8a9db0b70c59609d942fc2db6a9fcd896f816e857f20de3fada5e293"
    },
    {
      "path": "docs/manuals/The_Directors_Crucible_Complete_Director_Edition.docx",
      "part": "word/document.xml",
      "paragraphIndexZeroBased": 2374,
      "text": "Revelation Ceiling",
      "textSha256": "1768dfabdd2a500a89fb1275c3e034803df0bee54cb49dbbbae272f971016538"
    },
    {
      "path": "docs/manuals/The_Directors_Crucible_Complete_Director_Edition.docx",
      "part": "word/document.xml",
      "paragraphIndexZeroBased": 2375,
      "text": "The Arena can preserve signatures from offices older than the Divine Pact. A contract may show Calan’thir and Asmodeus assuming responsibilities rather than creating the jurisdiction. This can strongly support rung three and prepare the party for the Interstice.",
      "textSha256": "76a28762bdc929984889819a7a0b260bb34d33aa52a2e7af5ccc5da88b32beb7"
    },
    {
      "path": "docs/manuals/The_Directors_Crucible_Complete_Director_Edition.docx",
      "part": "word/document.xml",
      "paragraphIndexZeroBased": 2376,
      "text": "Gate Preparation",
      "textSha256": "fc6b8dfa3d0511371e481142bf3e75e4c8ca0d3cc70f311e82a39e0ddbaa0286"
    },
    {
      "path": "docs/manuals/The_Directors_Crucible_Complete_Director_Edition.docx",
      "part": "word/document.xml",
      "paragraphIndexZeroBased": 2377,
      "text": "Xarog, the Pactbound Furnace, should force the Expedition to decide which promises it is willing to make permanent. The Furnace may burn away false, impossible, or contradictory obligations while empowering those willingly accepted. Passage should leave at least one binding term that matters in Tier 8.",
      "textSha256": "ae7f788e44ea37feafe7e24be31b0eb5e15309dd8469cdc4e57a567133b938bd"
    },
    {
      "path": "docs/manuals/The_Directors_Crucible_Complete_Director_Edition.docx",
      "part": "word/document.xml",
      "paragraphIndexZeroBased": 2378,
      "text": "Sample Floor Seed: The Empty Grandstand",
      "textSha256": "6cc70c8b5c190507f0c582bc3fd21ff585857d348a8686dd68a8212148269eca"
    },
