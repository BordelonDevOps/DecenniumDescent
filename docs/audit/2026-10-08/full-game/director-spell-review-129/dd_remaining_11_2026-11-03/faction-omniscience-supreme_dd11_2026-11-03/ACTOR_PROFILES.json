      "background": {
        "id": "arcane-academy-dropout",
        "name": "Arcane Academy Dropout",
        "status": "source-package-reviewed; integration-guide-and-stated-equipment-dependencies-apply",
        "source": [
          {
            "line": 6004,
            "text": "Skill Proficiencies: Arcana, History"
          },
          {
            "line": 6005,
            "text": "Languages: Two of your choice"
          },
          {
            "line": 6006,
            "text": "Equipment: A spellbook or arcane focus (perhaps damaged or modified), a letter of expulsion or resignation, a set of common clothes, a student's robe, and a pouch containing 10 gp."
          },
          {
            "line": 6007,
            "text": "Feature: Theoretical Knowledge: Despite your incomplete education, you retain substantial theoretical knowledge. You have advantage on Intelligence (Arcana) checks related to identifying magical effects, traditions, or items, even if you can't replicate them yourself. Your academic background grants you Disliked starting Reputation with formal arcane institutions but Neutral starting Reputation with independent mages and magical researchers who value unorthodox thinking."
          }
        ],
