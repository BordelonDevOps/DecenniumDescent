  "findings": [
    {
      "path": "engine/com.decennium.foundation/Laboratory/Model/SharedWorldCombatPolicy.cs",
      "locator": "ResolvedConflict",
      "requiredText": "return s.Lives.Single(x => x.ActorId == opponent).Dead;",
      "finding": "Lawful resolved encounter end requires the existing opponent dead."
    },
    {
      "path": "engine/com.decennium.foundation/Laboratory/Model/SharedLaterEncounter.cs",
      "locator": "RecordActualCombatExit",
      "requiredText": "if (command.Kind == CommandKind.EndFixedEncounter) RecordClericObjectiveCompletion(state, closed);",
      "finding": "Retreat closure does not call the accepted Cleric2 objective completion producer."
    },
    {
      "path": "engine/com.decennium.foundation/Laboratory/Model/SharedReengagement.cs",
      "locator": "AssessReengagement",
      "requiredText": "CapableWorker(s, x) && TestOnlyClubAttackPolicy.Aware(s, x)",
      "finding": "The same existing defender must be capable and aware for re-engagement."
    },
    {
      "path": "engine/com.decennium.foundation/Laboratory/Model/SharedFrightened.cs",
      "locator": "AssessIntimidatingPresence",
      "requiredText": "state.Encounter?.Id != state.Reinforcement.Definition.EncounterId",
      "finding": "Current fear producer is restricted to the original reinforced encounter."
    }
  ],
  "conclusion": "Existing post-retreat re-engagement cannot furnish a genuine post-Cleric2 opponent without altering settled milestone semantics; later real source/context requires explicit review."
