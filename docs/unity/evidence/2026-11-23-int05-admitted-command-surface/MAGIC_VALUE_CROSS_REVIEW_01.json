  "findings": [
    {
      "id": "MAGIC-VN-CROSS-01",
      "severity": "ContractCorrection",
      "jsonPointers": [
        "/exactGlobalRules/unavailable",
        "/factDefinitions/*/valuePresenceRule"
      ],
      "problem": "Unrepresented is listed as an unavailable Availability state. The agreed closed DTO has Immediate,Retained,NotRetained,NotApplicable,Withheld,ProjectionUnavailable,ObservedCurrent only. GPT05 uses Unrepresented as an authorized knowledge Code, not an eighth Availability.",
      "correction": "Remove Unrepresented from the unavailable-state lists and shared valuePresenceRule. Preserve actual Knowledge Code semantics separately where an explicit registry key defines them. Do not add an Availability enum member or discard an available knowledge Code value.",
      "evidence": [
        "docs/unity/evidence/2026-11-23-int05-admitted-command-surface/V1_DTO_PROPOSAL.md:37-46",
        "docs/unity/evidence/2026-11-23-int05-admitted-command-surface/V1_VALUE_ENCODING_PROPOSAL.md:17",
        "docs/unity/evidence/2026-11-23-int05-admitted-command-surface/GPT_ARCHITECTURE_REVIEW_05.json"
      ],
      "counterexample": "A report Knowledge field may have an available Code value Unrepresented while its absent numeric companion is NotRetained. Treating the code as availability would omit the knowledge value or invent a state outside the closed DTO.",
      "runtimeDefect": false
    }
  ],
  "dispositions": {
    "closedTypesAndWidths": "All262 facts use the seven agreed scalar kinds; four fact Lists keep fixed Code/Identity elements.91 integer definitions resolve directly in the static declaration locator without mismatch; remaining34 nested/helper properties were checked against SpellTurnIdentity Int64 origin markers, HealingRiteRecord Int32RP/Int64HP, RadianceUseRecord.PreRadianceHp Int64, Aura qualification Int64revision, CharacterFeatureGrantRecord Int32level/Int64revision and KnownSpellRecord Int32level/rank/Int64revision. CommandCost.Amount remainsInt64 distinct from native Int32pool/payment facts.",
    "fixedLists": "cast.purify.removals and consecrate.attack-contributions remain fixed Withheld even when no native rows exist; omit Values rather than[] and expose no hidden count/filtered flag. Selected-feature and current-owned-card Lists preserve native sorted order under own/recipient authority. Parameter Lists are actual constructor input collections, not filtered result lists; native order and selected domain remain unchanged.",
    "sourceRevisionAndProcedureSha": "PublicSourceRevision40/PublicSourceSha256 aliases are consistently mapped to Identity with explicit40/64hex source role. KnownSpellRecord/ExpeditionKnownSpellView expose these public source identifiers. They are neither runtime/snapshot fingerprints nor authority tokens; no case conversion or newentityownership. Native ValidId bounds are not incorrectly treated as sufficient source authority.",
    "groundSettlementStatus": "GroundSettlementStatus is explicitly derived symbolic Code PendingAsObserved|Settled with no fictitious enum width. It requires the exact existing J_GROUND_SETTLE causal row and current N_ACTIVITY gate. Pending describes current absence of a matching settled row, not promised reduction. Tactical CastingTurnEndRecord and OMA MagicalSettlementRecord retain their own actual time/cause/Int32before-after semantics.",
    "nullZeroEmpty": "Initial spell acquisition revision0 and noncarried admission revision0 remain real documented sentinels; optional focus/effect/last-spell strings never become empty Identity. Active effect end sentinels are not terminal history. Owned Invocation view legitimately returns0 without a recharge row; direct Consecrate recharge field stays absent without its row, as proposed. Unsupported Conviction is not0. Unfocused school absence is NotApplicable; withheld school/owner identity remains Withheld.",
    "purifyUnit": "The sole Quantity fact retains native RuleQuantity and actual whole-lot UnitId. Existing ProjectItems membership does not independently disclose UnitId and food admission does not universally impose FoodUnit. MVD01 correctly keeps exact source/unit authority unresolved. No CommandScalar or blanket food-unit substitution is allowed.",
    "constructorFields": "Atomic read-only receipt flags and FeatureOne/FeatureTwo aliases are not new caller-settable inputs. Advancement AsiAbilityIncreases is an actual enum collection, empty at selected levels; generic constructor acceptance creates no ASI opportunity. Corrected advancement milestone Target remains exact selected source target.",
    "limits": "Missing Consecration terminal causes, immediate carrier capture, transitive purity, parser/roundtrip execution and all-profile qualification remain open. The one correction above and existing MVD decisions must be resolved in final contract; this review supplies no fullHC acceptance."
  },
