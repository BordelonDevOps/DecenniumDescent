  "finding": {
    "id": "VN-CROSS-01",
    "severity": "DocumentationCorrection",
    "path": "engine/artifacts/admitted-command-surface/management-value-normalization.json",
    "jsonPointer": "/branchBindings/5/rule",
    "definition": "MW-F156",
    "problem": "MW-B-LEGITIMATE-ZERO calls the field actual free capacity after completion. This key is fill.reserved_capacity.current. Native code returns Pending ? Amount : default(RuleQuantity), not the vessel free capacity.",
    "requiredCorrection": "Replace that phrase with actual zero reserved destination capacity after completion/cancellation. Preserve the separate amount binding and current destination ownership predicate.",
    "nativeEvidence": [
      "engine/com.decennium.foundation/Laboratory/Model/ConnectedWorkControlHost.cs:147-153",
      "engine/com.decennium.foundation/Runtime/Core/WaterVesselRecords.cs:41-48"
    ],
    "counterexample": "A completed fill can leave the vessel full while this reservation value is0. Describing it as free capacity would imply space that does not exist.",
    "runtimeDefect": false
  },
  "tacticalDisposition": {
    "definitionsReviewed": 253,
    "fieldIdAndKeySetMatchesOriginal": true,
    "integerWidths": "All21 specified Int32 overrides agree with actual ordinal/grid/remaining/Command.X-Y declarations. Retained revisions, interval indices, HP/temporaryHP, incoming damage and CostPaid remainInt64. Actual payment-count DTOs and historical placeholders are explicitly not invented retained journal properties.",
    "quantity": "18 scalar native RuleQuantity fields retain Int64 rational components. DistanceFeet/GridCoordinate are named technical proposals without fake ResourceLot units and remain OPEN. Native movement distance versus exact grid coordinate semantics are distinct.",
    "lists": "TO-F018 uses actual ConditionClause enum projection,14closed codes and the own-character condition context gate; native ConditionClauses.Active order is fixed by its source. TO-F124 retains independently visible supplied Presence targets only. Both fixed List kinds obey GPT06 authorized-subset/empty/no-filter-flag rules. No raw condition object export.",
