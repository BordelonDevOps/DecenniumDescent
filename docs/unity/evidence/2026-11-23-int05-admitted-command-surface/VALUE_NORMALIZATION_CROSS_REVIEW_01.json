    "operatorClockContact": {
      "definition": "TO-F241",
      "disposition": "Proposed two-code mapping is source-grounded and coarse, but exact concurrence remains OPEN as labeled. Reengagement.Entered is Failure==empty; Recovery/Ferry failure-null path creates actual admission and failure path records contact without admission. Later.Entry is actual admission. All are exact receipt-bound committed endpoints, not candidate rollback effects.",
      "sources": [
        "Runtime/Core/ReengagementRecords.cs:48-66",
